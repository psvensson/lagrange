{
  "schemaVersion": 1,
  "productMaturity": {
    "state": "experimental_alpha",
    "summary": "Experimental alpha; substantial implementation, but no general production-support or backward-compatibility guarantee on 0.x."
  },
  "productBoundary": {
    "summary": "A self-managed distributed runtime with an integrated, partitioned SQL storage layer; not a plug-in for an existing PostgreSQL cluster.",
    "dataLocalRequirement": "The rows used by a data-local operation must live in Lagrange partitions."
  },
  "listeners": {
    "rest": {
      "defaultPort": 8080,
      "environmentVariable": "REST_API_PORT"
    },
    "adminWebSocket": {
      "defaultPort": 8081,
      "defaultRule": "REST + 1",
      "environmentVariable": "ADMIN_WS_PORT",
      "overrideSupported": true
    },
    "transportWebSocket": {
      "defaultPort": 8082,
      "defaultRule": "REST + 2",
      "environmentVariable": "TRANSPORT_WS_PORT",
      "overrideSupported": true
    }
  },
  "probes": {
    "liveness": "/livez",
    "startup": "/startupz",
    "readiness": "/readyz",
    "compatibility": "/health"
  },
  "dataAndQueries": {
    "tablePartitioning": "range",
    "defaultReplicaCount": 3,
    "sqlIngress": [
      "admin WebSocket",
      "PostgreSQL wire"
    ],
    "secondaryIndexes": "unsupported",
    "globalSecondaryIndexes": false
  },
  "replication": {
    "partitionConsensus": "raft",
    "runtimeCellConsensus": "none",
    "runtimeCellDurableState": "ordinary replicated tables",
    "snapshotCheckpointCreation": "active_sqlite_partition_path",
    "snapshotTransferInstall": "active_sqlite_partition_path",
    "physicalLogCompaction": "active_sqlite_partition_path",
    "messageGroupLogCompaction": "unsupported",
    "learnerPromotion": "time_based_not_progress_based"
  },
  "deployment": {
    "publicModel": [
      "Artifact",
      "Binding",
      "Cell"
    ],
    "recommendedAuthoring": "code_first_javascript_service",
    "lifecycleSql": [
      "INSTALL SERVICE $1",
      "UPGRADE SERVICE $1",
      "REMOVE SERVICE $1",
      "SHOW SERVICE $1",
      "SHOW SERVICES",
      "CONFIGURE SERVICE ACCESS $1",
      "CREATE BINDING $1",
      "CALL BINDING $1"
    ],
    "publicInvocation": [
      "request",
      "call"
    ],
    "acceptedButNotPubliclyInvocable": [
      "change",
      "time",
      "once",
      "boot",
      "pushdown"
    ],
    "servicePortabilityContract": "docs/service-portability-capabilities.json"
  },
  "callExecution": {
    "selector": "literal_single_table_select_fixed_at_deployment",
    "selectorInterpolation": false,
    "defaultShardRowBound": 4096,
    "defaultEmitBound": 64,
    "defaultPartialEntryBound": 1024,
    "defaultConcurrentShardRuns": 8,
    "sameHostShardConcurrency": "serialized_per_component_instance",
    "partialValues": "finite_numbers",
    "partialKeys": "must_be_disjoint_across_shards",
    "nestedCallsPerRequest": 1,
    "globalCrossPartitionSnapshot": false,
    "callerCancellation": false,
    "directCallCallerIdempotencyKey": false
  },
  "postgresWire": {
    "authenticationModes": [
      "trust",
      "password"
    ],
    "scramSupported": false,
    "tlsModes": [
      "disable",
      "prefer",
      "require"
    ],
    "compatibilityClaim": "bounded measured SQL slice, not complete PostgreSQL or ORM compatibility"
  },
  "security": {
    "requestHttpAuthentication": "basic_against_configured_pgwire_credentials",
    "nodeTransport": "plain_websocket_trusted_network_only",
    "adminWebSocket": "unauthenticated_loopback_by_default",
    "externalAdminBind": "explicit_insecure_opt_in_requires_authenticated_ingress",
    "serviceIsolation": "wasi_component_with_declared_host_capabilities",
    "scram": false,
    "oidcOrSso": false,
    "mtlsNodeIdentity": false
  },
  "operations": {
    "storageAdmissionDefault": "enforce",
    "backupRestorePitr": "unsupported",
    "rollingUpgradeContract": "unsupported_on_0x",
    "crossRegionReplication": "unsupported",
    "generalProductionSupport": "unsupported"
  },
  "evidence": {
    "publicCodeFirstDemo": "single_node_two_partition_functional_proof",
    "multiNodeDataLocalComparison": "internal_native_js_service_path",
    "sqliteSnapshotLiveRebuild": "five_node_certification_window",
    "publicPathScaleBenchmark": "not_available"
  },
  "limitations": [
    {
      "id": "partition-key-resolution",
      "area": "Query routing",
      "summary": "Production partition narrowing effectively requires a key column named id; other predicates may scatter to every partition."
    },
    {
      "id": "partition-key-comparison",
      "area": "Query routing",
      "summary": "Partition range comparison is string-based, so numeric strings sort lexicographically."
    },
    {
      "id": "secondary-indexes",
      "area": "Indexes",
      "summary": "CREATE INDEX is unsupported and no secondary-index runtime path is active."
    },
    {
      "id": "message-group-log-lifecycle",
      "area": "Replication",
      "summary": "SQLite partition logs use the active snapshot and proof-gated compaction path; in-memory message-group logs still grow without bound and recover by full replay."
    },
    {
      "id": "learner-promotion",
      "area": "Replication",
      "summary": "Learner promotion waits for a time threshold and safety arithmetic; it does not compare follower and leader progress."
    },
    {
      "id": "binding-invocation",
      "area": "Service execution",
      "summary": "Request and call Bindings are publicly invocable. Change, time, once, boot, and pushdown Bindings may be declared but have no public invocation adapter."
    },
    {
      "id": "bounded-call-input",
      "area": "Service execution",
      "summary": "A call selects one bounded shard batch; the public path does not stream or page an unbounded partition scan."
    },
    {
      "id": "numeric-partials",
      "area": "Service execution",
      "summary": "Coordinated partial values are finite numbers and their keys must be disjoint across shards."
    },
    {
      "id": "oci-runtime",
      "area": "Service portability",
      "summary": "Managed OCI container activation is unsupported; the recommended service path is a WASI component."
    },
    {
      "id": "postgres-compatibility",
      "area": "PostgreSQL compatibility",
      "summary": "Password authentication and TLS are implemed, but SCRAM and arbitrary PostgreSQL or ORM compatibility are not claimed."
    },
    {
      "id": "node-transport-security",
      "area": "Security",
      "summary": "Node-to-node transport is plain WebSocket without cryptographic peer authentication; deploy it only on a trusted private network."
    },
    {
      "id": "backup-and-upgrades",
      "area": "Operations",
      "summary": "Backup/restore/PITR and a supported rolling-upgrade contract are not available on 0.x."
    }
  ]
}
