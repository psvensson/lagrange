{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Work Package Metadata Schema",
  "description": "Validation schema for work package metadata in work-package-v2 format.",
  "type": "object",
  "definitions": {
    "proofItem": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "falsifier": { "type": "string" }
          },
          "additionalProperties": false,
          "required": ["falsifier"]
        },
        {
          "type": "object",
          "properties": {
            "regression": { "type": "string" }
          },
          "additionalProperties": false,
          "required": ["regression"]
        },
        {
          "type": "object",
          "properties": {
            "supporting": { "type": "string" }
          },
          "additionalProperties": false,
          "required": ["supporting"]
        },
        {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["falsifier", "regression", "supporting"] },
            "command": { "type": "string" }
          },
          "required": ["role", "command"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "intent",
    "scope",
    "gates",
    "modelFit"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["work-package-v2"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "done", "todo", "superseded"]
    },
    "intent": {
      "type": "object",
      "required": [
        "opened",
        "lane",
        "scenario",
        "owner",
        "boundary",
        "currentState",
        "nextAction"
      ],
      "properties": {
        "opened": {
          "type": "string",
          "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"
        },
        "closed": {
          "type": "string",
          "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"
        },
        "lane": {
          "type": "string",
          "enum": [
            "read-review-doc-only",
            "mechanical-maintenance",
            "lightweight-maintenance",
            "test-only-proof",
            "diagnostic-classification",
            "experiment",
            "bounded-experiment",
            "single-file-runtime",
            "runtime-owner-boundary",
            "scenario-release-gate",
            "causal-escalation",
            "fast-spike",
            "discovery"
          ]
        },
        "scenario": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "playback": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "currentState": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "dominantReason": {
          "type": "string"
        },
        "discoveryRef": {
          "type": "string"
        },
        "epicRef": {
          "type": "string"
        },
        "predecessor": {
          "type": "string"
        },
        "successor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "writeScope",
        "handoffFiles",
        "generatedFiles",
        "candidateRuntimeFiles",
        "commitScope"
      ],
      "properties": {
        "writeScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "handoffFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generatedFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidateRuntimeFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "commitScope": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": [
        "whyHighestLeverageNow",
        "stabilityCredit"
      ],
      "properties": {
        "whyHighestLeverageNow": {
          "type": "string"
        },
        "stabilityCredit": {
          "type": "string",
          "enum": [
            "representative-green",
            "representative-migrated",
            "representative-reduced",
            "local-proof-only",
            "instrumentation-only"
          ]
        },
        "companionGatesFile": {
          "type": "string"
        },
        "representativeRerunCadence": {
          "type": "string",
          "enum": [
            "fresh-representative-rerun",
            "scheduled-rerun-command",
            "explicit-invalid-rerun-reason",
            "architecture-stop-reason"
          ]
        },
        "codeQualityAdmission": {
          "type": "string",
          "enum": [
            "removes-duplicate-decision-paths",
            "preserves-owner-outcomes",
            "improves-evidence-fidelity",
            "prevents-regression",
            "active-guardrail-requirement"
          ]
        }
      },
      "additionalProperties": false
    },
    "modelFit": {
      "type": "object",
      "required": [
        "packageClass",
        "intendedMinimumModel",
        "scopeShape",
        "outputProfile"
      ],
      "properties": {
        "packageClass": {
          "type": "string"
        },
        "intendedMinimumModel": {
          "type": "string"
        },
        "scopeShape": {
          "type": "string"
        },
        "outputProfile": {
          "type": "string",
          "enum": ["small", "medium", "high", "extra-high"]
        },
        "escalationTriggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ambiguityScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "theoryLedgerRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proof": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/proofItem"
              }
            },
            {
              "type": "object",
              "properties": {
                "commands": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/proofItem"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "implementation": {
          "type": "object",
          "properties": {
            "parentRevalidatedFocusedProof": { "type": "boolean" },
            "filesChanged": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["parentRevalidatedFocusedProof"],
          "additionalProperties": false
        },
        "verificationFix": {
          "type": "object",
          "properties": {
            "parentRevalidatedFocusedProof": { "type": "boolean" }
          },
          "required": ["parentRevalidatedFocusedProof"],
          "additionalProperties": false
        },
        "repair": {
          "type": "object",
          "properties": {
            "validationCommand": { "type": "string" }
          },
          "required": ["validationCommand"],
          "additionalProperties": false
        },
        "theoryLedger": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mechanismCard": {
      "type": "object",
      "properties": {
        "failureMechanism": { "type": "string" },
        "stableFacts": { "type": "string" },
        "changedFacts": { "type": "string" },
        "rejectedAlternatives": { "type": "string" },
        "ownerWhoDecides": { "type": "string" },
        "currentAction": { "type": "string" },
        "missingTransitionOrObservation": { "type": "string" },
        "smallestFalsifyingProbe": { "type": "string" },
        "expectedMovement": { "type": "string" },
        "negativeResultMeans": { "type": "string" },
        "escalationRule": { "type": "string" }
      },
      "additionalProperties": false
    },
    "systemTheory": {
      "type": "object",
      "required": [
        "problemStatement",
        "phaseChain",
        "ownerBoundaryMap",
        "stableFacts",
        "changedFacts",
        "competingTheories",
        "eliminatedTheories",
        "downstreamSymptoms",
        "transitionTable",
        "ownershipMigrationTriggers",
        "architectureGapTriggers",
        "wholeSystemInvariant"
      ],
      "properties": {
        "problemStatement": { "type": "string" },
        "phaseChain": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "ownerBoundaryMap": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "stableFacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "changedFacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "competingTheories": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "eliminatedTheories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "downstreamSymptoms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "transitionTable": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "inputSignal",
              "owner",
              "missingTransition",
              "expectedEvidence",
              "falsifier",
              "migrationTrigger"
            ],
            "properties": {
              "inputSignal": { "type": "string" },
              "owner": { "type": "string" },
              "missingTransition": { "type": "string" },
              "expectedEvidence": { "type": "string" },
              "falsifier": { "type": "string" },
              "migrationTrigger": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "ownershipMigrationTriggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "architectureGapTriggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "wholeSystemInvariant": { "type": "string" },
        "wholeSystemInvariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["invariant"],
            "properties": {
              "invariant": { "type": "string" },
              "coupledWith": {
                "type": "array",
                "items": { "type": "string" }
              },
              "couplingNote": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sliceTheory": {
      "type": "object",
      "required": [
        "systemTheoryRef",
        "selectedSystemTheory",
        "selectedMechanism",
        "sourceTestContract",
        "falsifier",
        "representativeExpectedMovement",
        "killRule",
        "theoryFitScore",
        "wrongSliceTriggers"
      ],
      "properties": {
        "systemTheoryRef": { "type": "string" },
        "selectedSystemTheory": { "type": "string" },
        "selectedMechanism": { "type": "string" },
        "sourceTestContract": { "type": "string" },
        "falsifier": { "type": "string" },
        "representativeExpectedMovement": { "type": "string" },
        "killRule": { "type": "string" },
        "theoryFitScore": {
          "type": "object",
          "required": [
            "evidenceFit",
            "ownerBoundaryFit",
            "falsifiability",
            "representativeMovement",
            "downstreamRiskContainment"
          ],
          "properties": {
            "evidenceFit": { "type": "string" },
            "ownerBoundaryFit": { "type": "string" },
            "falsifiability": { "type": "string" },
            "representativeMovement": { "type": "string" },
            "downstreamRiskContainment": { "type": "string" }
          },
          "additionalProperties": false
        },
        "wrongSliceTriggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "theoryLoop": {
      "type": "object",
      "properties": {
        "enforcement": {
          "type": "string",
          "enum": ["source-code-package-required"]
        },
        "promotedTheory": {
          "type": "string"
        },
        "sprintGoalDelta": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "fixed",
            "avoided",
            "supported",
            "falsified",
            "migrated",
            "representative-green",
            "architecture-gap",
            "needs-rerun"
          ]
        },
        "successorPackage": {
          "type": "string"
        },
        "sourceChangeRequired": {
          "type": "boolean",
          "enum": [true]
        },
        "successorRequired": {
          "type": "boolean",
          "enum": [true]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "theory-confirmed",
            "theory-falsified",
            "inconclusive",
            "migrated"
          ]
        },
        "jointFalsifierCommand": {
          "type": "string"
        },
        "gateMarker": {
          "type": "string",
          "enum": [
            "same-mechanism-repeat",
            "compositional-pair-alternation",
            "pair-alternation-post-rederive",
            "emergent-class-present"
          ]
        }
      },
      "additionalProperties": false,
      "if": { "required": ["enforcement"] },
      "then": {
        "required": [
          "enforcement",
          "promotedTheory",
          "sprintGoalDelta",
          "sourceChangeRequired",
          "successorRequired"
        ]
      }
    }
  }
}
