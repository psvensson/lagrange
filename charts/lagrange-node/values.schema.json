{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "admin": {
      "type": "object",
      "required": [
        "websocketHost",
        "allowInsecureExternalBind"
      ],
      "properties": {
        "websocketHost": {
          "const": "127.0.0.1",
          "description": "The Helm chart supports only loopback admin binding."
        },
        "allowInsecureExternalBind": {
          "const": false,
          "description": "The chart cannot opt into an unauthenticated external admin bind."
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "not": {
              "required": ["name"],
              "properties": {
                "name": {
                  "enum": [
                    "ADMIN_WEBSOCKET_HOST",
                    "ADMIN_ALLOW_INSECURE_EXTERNAL_BIND",
                    "ADMIN_WEBSOCKET_PORT"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["admin", "node"]
}
