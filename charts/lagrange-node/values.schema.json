{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "admin": {
      "type": "object",
      "required": [
        "websocketHost",
        "allowInsecureExternalBind"
      ],
      "properties": {
        "websocketHost": {
          "const": "127.0.0.1",
          "description": "The Helm chart supports only loopback admin binding."
        },
        "allowInsecureExternalBind": {
          "const": false,
          "description": "The chart cannot opt into an unauthenticated external admin bind."
        },
        "websocketPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Optional admin WebSocket port; defaults to node.restPort + 1."
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "restPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "REST base port for the listener-port family."
        },
        "wsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Optional transport WebSocket port; defaults to node.restPort + 2."
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "not": {
              "required": ["name"],
              "properties": {
                "name": {
                  "enum": [
                    "ADMIN_WS_HOST",
                    "ADMIN_ALLOW_INSECURE_EXTERNAL_BIND",
                    "ADMIN_WS_PORT",
                    "REST_API_PORT",
                    "TRANSPORT_WS_PORT"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["admin", "node"]
}
