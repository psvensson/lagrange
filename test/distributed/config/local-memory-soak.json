{
  "size": 7,
  "docker": {
    "socketPath": "/var/run/docker.sock"
  },
  "image": "distributed-db:test",
  "timeouts": {
    "nodeStartup": 60000,
    "convergence": 120000,
    "quietWindow": 10000,
    "scenarioDefault": 10800000
  },
  "convergence": {
    "targetVoterCount": 3,
    "settleTimeoutMs": 120000,
    "quietWindowMs": 10000,
    "maxSustainedOverTargetMs": 10000,
    "sampleIntervalMs": 500
  },
  "resourceLimits": {
    "memory": "2g",
    "cpus": "2.0"
  },
  "load": {
    "defaultOpsPerSec": 120,
    "defaultDuration": "1800s"
  },
  "memoryLeak": {
    "enabled": true,
    "failOnDetection": true,
    "requireSamples": true,
    "minSamplesPerNode": 30,
    "warmupFraction": 0.2,
    "minWarmupMs": 300000,
    "minAnalysisWindowMs": 900000,
    "maxPositiveSlopeBytesPerMin": 524288,
    "minGrowthBytes": 33554432,
    "minPositiveDeltaRatio": 0.7,
    "captureHeapArtifacts": true,
    "heapSnapshotNearLimitCount": 2
  }
}
