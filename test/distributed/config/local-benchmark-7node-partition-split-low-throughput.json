{
  "size": 7,
  "docker": {
    "socketPath": "/var/run/docker.sock"
  },
  "image": "distributed-db:test",
  "timeouts": {
    "nodeStartup": 90000,
    "convergence": 90000,
    "quietWindow": 5000,
    "scenarioDefault": 900000
  },
  "resourceLimits": {
    "memory": "2g",
    "cpus": "1.0"
  },
  "partition": {
    "evaluationIntervalMs": 60000
  },
  "benchmark": {
    "baselineImage": "postgres:16",
    "user": "benchmark",
    "password": "benchmark",
    "database": "benchmark",
    "port": 5432,
    "durationSeconds": 75,
    "clients": 7,
    "jobs": 2,
    "loadOpsPerSec": 24,
    "loadDuration": "75s",
    "loadMaxInFlight": 24,
    "loadQueryTimeoutMs": 4000,
    "controlQueryTimeoutMs": 15000,
    "loadNodeMaxInFlight": 1,
    "nodeFailureThreshold": 3,
    "nodeFailureCooldownMs": 1500,
    "failOnLoadParityMismatch": false,
    "strictDiscovery": true,
    "strictParity": true,
    "strictPreloadReadiness": true,
    "preloadRequiredStableMs": 1000,
    "preloadMaxReplicaOpsInFlight": 0,
    "insufficientEvidencePolicy": "soft",
    "readyTimeoutMs": 36000,
    "readyPollIntervalMs": 500,
    "quiescentTimeoutMs": 36000,
    "quiescentPollIntervalMs": 500,
    "quiescentStableWindowMs": 2000,
    "quiescentNoProgressTimeoutMs": 8000,
    "postLoadDrainTimeoutMs": 90000,
    "postLoadDrainPollIntervalMs": 500,
    "postLoadDrainStableWindowMs": 2000,
    "postLoadDrainNoProgressTimeoutMs": 30000,
    "tableName": "benchmark_partition_split_events",
    "replicationFactor": 3,
    "syncReplicaAcks": 1
  },
  "benchmarkGate": {
    "enabled": false,
    "maxThroughputRegressionRatio": 0.1,
    "minimumThroughputRatioSutToBaseline": 0.1,
    "baselineProvider": "liferaft",
    "parityMismatchPolicy": "warn",
    "failIfBaselineMissing": false,
    "approvedMitigationId": null
  },
  "raftProvider": "liferaft",
  "memoryLeak": {
    "enabled": false,
    "failOnDetection": false,
    "requireSamples": false
  }
}
