{
  "size": 5,
  "docker": {
    "socketPath": "/var/run/docker.sock"
  },
  "image": "distributed-db:test",
  "timeouts": {
    "nodeStartup": 30000,
    "convergence": 60000,
    "quietWindow": 3000,
    "scenarioDefault": 120000,
    "bootstrapReadyStableWindowMs": 1000
  },
  "convergence": {
    "targetVoterCount": 3,
    "settleTimeoutMs": 30000,
    "quietWindowMs": 3000,
    "maxSustainedOverTargetMs": 2000,
    "sampleIntervalMs": 250
  },
  "resourceLimits": {
    "memory": "2g",
    "cpus": "2.0"
  },
  "benchmark": {
    "loadQueryTimeoutMs": 10000,
    "controlQueryTimeoutMs": 15000
  },
  "scenarios": {
    "rollingRestart": {
      "loadDuration": "150s",
      "preRestartSettleMs": 1000,
      "perRestartActiveTimeoutMs": 120000,
      "perNodeConvergenceTimeoutMs": 120000,
      "interRestartDelayMs": 250,
      "postRestartLoadSoakMs": 1000,
      "postRestartQuietWindowMs": 5000,
      "postRestartActiveTimeoutMs": 120000
    },
    "seedRestartUnderLoad": {
      "loadDuration": "35s",
      "preRestartDelayMs": 2000,
      "preRestartActiveTimeoutMs": 60000,
      "restartReadinessTimeoutMs": 90000,
      "postRestartActiveTimeoutMs": 90000,
      "postRestartQuietWindowMs": 3000,
      "convergenceTimeoutMs": 90000,
      "consistencyTimeoutMs": 90000
    },
    "nodeJoinUnderLoad": {
      "loadDuration": "30s",
      "preJoinSettleMs": 1000,
      "loadReadinessStableWindowMs": 1000,
      "loadReadinessStabilizationTimeoutMs": 10000,
      "postJoinConvergenceTimeoutMs": 60000,
      "postJoinActiveTimeoutMs": 60000,
      "consistencyTimeoutMs": 90000,
      "consistencyPollIntervalMs": 250
    },
    "snapshotLiveRebuild": {
      "floorBytes": 25165824,
      "preloadRows": 3072,
      "preloadPayloadBytes": 8192,
      "preloadBatchSize": 64,
      "loadDuration": "180s",
      "loadOpsPerSec": 30,
      "preWipeSettleMs": 3000,
      "rejoinReadinessTimeoutMs": 180000,
      "rejoinActiveTimeoutMs": 180000,
      "perNodeConvergenceTimeoutMs": 180000,
      "postRebuildSoakMs": 15000,
      "consistencyTimeoutMs": 180000,
      "restartabilityLegEnabled": false
    }
  },
  "memoryLeak": {
    "enabled": true,
    "failOnDetection": false,
    "requireSamples": false
  },
  "load": {
    "defaultOpsPerSec": 100,
    "defaultDuration": "30s"
  }
}
