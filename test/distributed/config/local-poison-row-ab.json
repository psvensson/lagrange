{
  "size": 7,
  "docker": {
    "socketPath": "/var/run/docker.sock"
  },
  "image": "distributed-db:test",
  "timeouts": {
    "nodeStartup": 90000,
    "convergence": 90000,
    "quietWindow": 5000,
    "scenarioDefault": 900000,
    "restartRecoveryHoldRecheckMs": 5000
  },
  "resourceLimits": {
    "memory": "2g",
    "cpus": "2.0"
  },
  "partition": {
    "evaluationIntervalMs": 600000,
    "splitThresholdBytes": 1073741824,
    "splitThresholdQpm": 1000000000,
    "mergeThresholdBytes": 1048576,
    "mergeThresholdQpm": 1
  },
  "benchmark": {
    "baselineImage": "postgres:16",
    "user": "benchmark",
    "password": "benchmark",
    "database": "benchmark",
    "port": 5432,
    "durationSeconds": 30,
    "clients": 8,
    "jobs": 4,
    "loadOpsPerSec": 120,
    "loadDuration": "30s",
    "loadMaxInFlight": 128,
    "loadQueryTimeoutMs": 4000,
    "controlQueryTimeoutMs": 15000,
    "loadNodeMaxInFlight": 2,
    "nodeFailureThreshold": 3,
    "nodeFailureCooldownMs": 1500,
    "failOnLoadParityMismatch": false,
    "strictDiscovery": false,
    "strictParity": true,
    "strictPreloadReadiness": false,
    "enforceBenchmarkLoadAdmission": false,
    "preloadRequiredStableMs": 2000,
    "preloadMaxReplicaOpsInFlight": 0,
    "insufficientEvidencePolicy": "soft",
    "readyTimeoutMs": 120000,
    "readyPollIntervalMs": 500,
    "quiescentTimeoutMs": 180000,
    "quiescentPollIntervalMs": 500,
    "quiescentStableWindowMs": 2000,
    "quiescentNoProgressTimeoutMs": 90000,
    "postLoadDrainTimeoutMs": 120000,
    "postLoadDrainPollIntervalMs": 500,
    "postLoadDrainStableWindowMs": 2000,
    "postLoadDrainNoProgressTimeoutMs": 60000,
    "tableName": "benchmark_events",
    "replicationFactor": 3,
    "syncReplicaAcks": 1
  },
  "benchmarkGate": {
    "enabled": false,
    "maxThroughputRegressionRatio": 0.1,
    "minimumThroughputRatioSutToBaseline": 0.1,
    "baselineProvider": "liferaft",
    "parityMismatchPolicy": "warn",
    "failIfBaselineMissing": false,
    "approvedMitigationId": null
  },
  "raftProvider": "liferaft",
  "memoryLeak": {
    "enabled": false,
    "failOnDetection": false,
    "requireSamples": false
  },
  "scenarios": {
    "transaction-recovery-poison-row-live": {
      "expectedNodeCount": 7,
      "expectedRouteSources": [
        "ddb-test-reuse-7-1:8080",
        "ddb-test-reuse-7-2:8080",
        "ddb-test-reuse-7-3:8080",
        "ddb-test-reuse-7-4:8080",
        "ddb-test-reuse-7-5:8080",
        "ddb-test-reuse-7-6:8080",
        "ddb-test-reuse-7-7:8080"
      ]
    }
  }
}
