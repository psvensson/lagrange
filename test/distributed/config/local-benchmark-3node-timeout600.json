{
  "size": 3,
  "docker": {
    "socketPath": "/var/run/docker.sock"
  },
  "image": "distributed-db:test",
  "timeouts": {
    "nodeStartup": 600000,
    "convergence": 60000,
    "quietWindow": 5000,
    "scenarioDefault": 900000
  },
  "resourceLimits": {
    "memory": "2g",
    "cpus": "1.0"
  },
  "benchmark": {
    "baselineImage": "postgres:16",
    "user": "benchmark",
    "password": "benchmark",
    "database": "benchmark",
    "port": 5432,
    "durationSeconds": 30,
    "clients": 8,
    "jobs": 4,
    "loadOpsPerSec": 120,
    "loadDuration": "30s",
    "loadMaxInFlight": 128,
    "loadQueryTimeoutMs": 4000,
    "controlQueryTimeoutMs": 15000,
    "loadNodeMaxInFlight": 2,
    "nodeFailureThreshold": 3,
    "nodeFailureCooldownMs": 1500,
    "failOnLoadParityMismatch": false,
    "strictDiscovery": true,
    "requiredSutLoadNodeCount": 3,
    "strictParity": true,
    "strictPreloadReadiness": true,
    "preloadRequiredStableMs": 2000,
    "preloadMaxReplicaOpsInFlight": 0,
    "insufficientEvidencePolicy": "soft",
    "readyTimeoutMs": 30000,
    "readyPollIntervalMs": 500,
    "tableName": "benchmark_events",
    "replicationFactor": 3,
    "syncReplicaAcks": 1
  },
  "benchmarkGate": {
    "enabled": false,
    "maxThroughputRegressionRatio": 0.1,
    "minimumThroughputRatioSutToBaseline": 0.1,
    "baselineProvider": "liferaft",
    "parityMismatchPolicy": "warn",
    "failIfBaselineMissing": false,
    "approvedMitigationId": null
  },
  "raftProvider": "liferaft",
  "memoryLeak": {
    "enabled": false,
    "failOnDetection": false,
    "requireSamples": false
  }
}
