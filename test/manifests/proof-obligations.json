{
  "schemaVersion": 1,
  "id": "proof-obligations",
  "contract": "Every whole-tree check the gate runs declares the repository paths whose change makes it meaningful, and scripts/run-static-audits.js runs only the checks whose inputs the pushed range touched. Every declaration names scripts/** because a checker's own implementation decides what it proves. With no range to compare against, every check runs: an unknown range is not an unchanged tree. Skipping is admissible only when every changed path in the range is declared by some obligation: an undeclared path, or an empty range, runs every check. A check whose scope is the whole tree declares wholeTree true and is never skipped: no input list can be complete for a grep over every tracked file.",
  "obligations": [
    {
      "id": "npm-run-test-unused-prod",
      "command": "npm run test:unused:prod",
      "inputs": [
        "knip.json",
        "package-lock.json",
        "package.json",
        "scripts/**",
        "src/**"
      ]
    },
