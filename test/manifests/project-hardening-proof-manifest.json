{
  "schemaVersion": 1,
  "id": "project-hardening-proof-integrity-cutover",
  "environment": {
    "inherit": true,
    "set": {
      "FORCE_COLOR": "0"
    }
  },
  "commands": [
    {
      "id": "owner-debt-report-inputs",
      "executable": "node",
      "argv": [
        "scripts/generate-global-owner-debt-inventory.js",
        "--refresh",
        "--output",
        "test-output/analysis/owner-debt-live-inventory.json"
      ],
      "timeoutMs": 1800000,
      "acceptableExitCodes": [0],
      "requiredArtifact": {
        "mode": "captured-output",
        "path": "test-output/acceptance/project-hardening/owner-debt-report-inputs.json"
      }
    },
    {
      "id": "static-analysis",
      "executable": "npm",
      "argv": ["run", "test:static"],
      "timeoutMs": 1800000,
      "acceptableExitCodes": [0],
      "requiredArtifact": {
        "mode": "captured-output",
        "path": "test-output/acceptance/project-hardening/static-analysis.json"
      }
    },
    {
      "id": "model-contracts",
      "executable": "npm",
      "argv": ["run", "model:contracts"],
      "timeoutMs": 1800000,
      "acceptableExitCodes": [0],
      "requiredArtifact": {
        "mode": "captured-output",
        "path": "test-output/acceptance/project-hardening/model-contracts.json"
      }
    },
    {
      "id": "complete-tests",
      "executable": "npm",
      "argv": ["run", "test:all"],
      "timeoutMs": 3600000,
      "acceptableExitCodes": [0],
      "requiredArtifact": {
        "mode": "captured-output",
        "path": "test-output/acceptance/project-hardening/complete-tests.json"
      }
    },
    {
      "id": "chart-endpoint-sync",
      "executable": "npm",
      "argv": ["run", "test:chart:endpoint-sync"],
      "timeoutMs": 600000,
      "acceptableExitCodes": [0],
      "requiredArtifact": {
        "mode": "captured-output",
        "path": "test-output/acceptance/project-hardening/chart-endpoint-sync.json"
      }
    },
    {
      "id": "golden-capability-guard-scenarios",
      "executable": "node",
      "argv": ["scripts/checks/run-golden-capability-guard-scenarios.js"],
      "timeoutMs": 600000,
      "acceptableExitCodes": [0],
      "requiredArtifact": {
        "mode": "captured-output",
        "path": "test-output/acceptance/project-hardening/golden-capability-guard-scenarios.json"
      }
    }
  ]
}
