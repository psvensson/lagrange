{
  "entry": [
    "src/sea-entry.js!",
    "src/index.js!",
    "src/cli/bin/lagrange-admin.js!",
    "src/threading/service-worker.js!",
    "src/runtime/wasi-component-cell-worker.js!",
    "src/test-helpers/worker/entry-runner.js",
    "src/test-helpers/worker/admin-cli-direct-runner.js",
    "test/**/*.test.js",
    "test/**/*.test-part-*.js",
    "test/**/*test-cases.js",
    "test/distributed/validate-node-join-under-load.js",
    "test/storage-load/run-storage-load.js",
    "test/integration/cdc-debug-test.js",
    "test/distributed/scenarios/*.js",
    "test/runtime/pgwire-test-matrix.js",
    // Spawned one process per hostile shape by the ingress receipt, because a
    // raft-rs trap makes the runtime it happened in unusable.
    "test/raft/raft-rs-backend/hostile-message-probe.js",
    "scripts/**/*.js",
    "examples/**/*.js"
  ],
  "project": [
    "src/**/*.js!",
    "test/**/*.js",
    "scripts/**/*.js",
    "examples/**/*.js"
  ],
  "ignore": [
    "dist/**",
    "data/**",
    "data2/**",
    "data3/**",
    // wasm-pack output for the experimental raft-rs backend: a vendored build
    // artifact no human maintains, regenerated by src/raft/raft-rs-wasm/BUILD.md
    // and pinned by artifact-digest.json.
    "src/raft/raft-rs-wasm/pkg/**"
  ],
  "ignoreDependencies": [
    "lagrange",
    "postject",
    "@pulumi/pulumi",
    "@pulumi/gcp",
    "jscpd",
    "node-fetch"
  ]
}
