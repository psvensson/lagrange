#!/usr/bin/env bash
# Fast structural guards (<2s). Bypass for a single commit with
# git commit --no-verify (emergencies only).
set -euo pipefail
npm run -s audit:file-size
npm run -s audit:guideline:hot-path-diagnostics
node scripts/check-staged-constant-names.js
# Lint only the staged JS files (--cache keeps repeat runs inside the hook
# budget); the whole-repo lint gate lives in test:static.
STAGED_JS="$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.js' 'test/*.js' 'scripts/*.js' || true)"
if [ -n "${STAGED_JS}" ]; then
  # shellcheck disable=SC2086
  npx eslint --cache --cache-location node_modules/.cache/eslint/ ${STAGED_JS}
fi
