#!/usr/bin/env bash
# Staged-file pre-commit gate: the cheap per-file checks the push gate
# would otherwise discover one 15-minute cycle at a time (2026-08-04
# retrospective: nine push-gate failures, six of them commit-time
# catchable). Scoped to STAGED files only, so it stays in single-digit
# seconds; whole-corpus ratchets (duplication, file-size, cycles,
# unused-exports) remain push-time concerns.
#
# Also regenerates the checked-in deterministic inventories whenever
# staged work touches their source surface - their freshness guards
# re-stale on EVERY src commit by construction, so freshness is
# automated here instead of failed later.
#
# Extends the original fast structural guards (file-size,
# hot-path-diagnostics, staged constant names, cached staged eslint)
# with the staged guideline checks and inventory freshness.
#
# Skip (emergencies / WIP commits): LAGRANGE_SKIP_PRECOMMIT=1 git commit
# (git commit --no-verify also bypasses, as before)
set -euo pipefail

COMMIT_AUTHORIZATION="$({ node scripts/solve/commit-authorization.js check; } 2>&1)" || {
  echo "${COMMIT_AUTHORIZATION}"
  exit 1
}
SOLVER_AUTHORIZED=0
if [ "${COMMIT_AUTHORIZATION}" = "solver-authorized" ]; then
  SOLVER_AUTHORIZED=1
fi

if [ -n "${LAGRANGE_SKIP_PRECOMMIT:-}" ]; then
  echo "pre-commit: LAGRANGE_SKIP_PRECOMMIT set - skipping staged checks"
  exit 0
fi

# Staged (added/copied/modified/renamed) paths only; deletions need no scan.
# Capture the command result before parsing it. A process-substitution failure
# is not governed by `set -e` and previously became an empty staged set.
STAGED_OUTPUT="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "${STAGED_OUTPUT}" ]; then
  exit 0
fi
mapfile -t STAGED <<< "${STAGED_OUTPUT}"

JS_FILES=()
DOC_FILES=()
REGEN_INVENTORIES=0
for f in "${STAGED[@]}"; do
  [ -f "$f" ] || continue
  case "$f" in
    *.js|*.mjs|*.cjs)
      JS_FILES+=("$f")
      ;;
  esac
  case "$f" in
    docs/*.md|examples/*) DOC_FILES+=("$f") ;;
  esac
  case "$f" in
    src/*|scripts/*|test/*) REGEN_INVENTORIES=1 ;;
  esac
done

FAILURES=0
run_check() {
  local label="$1"; shift
  if ! "$@"; then
    echo "pre-commit: FAIL - ${label}"
    FAILURES=$((FAILURES + 1))
  fi
}

# Fast structural guards inherited from the original hook (<2s).
run_check "file-size ratchet" npm run -s audit:file-size
run_check "hot-path diagnostics guideline" \
  npm run -s audit:guideline:hot-path-diagnostics
run_check "staged constant names" \
  node scripts/check-staged-constant-names.js

if [ "${#JS_FILES[@]}" -gt 0 ]; then
  run_check "literal guideline (staged files)" \
    node scripts/check-guideline-literals.js "${JS_FILES[@]}"
  run_check "decision boundaries (staged files)" \
    node scripts/check-guideline-decision-boundaries.js "${JS_FILES[@]}"
  run_check "ambient intrinsics (staged files)" \
    node scripts/check-guideline-ambient-intrinsics.js "${JS_FILES[@]}"
  run_check "silent catch (staged files)" \
    node scripts/check-guideline-silent-catch.js "${JS_FILES[@]}"
fi
if [ "${#DOC_FILES[@]}" -gt 0 ]; then
  run_check "doc ascii hyphens (staged docs/examples)" \
    node scripts/checks/check-doc-ascii-hyphens.js "${DOC_FILES[@]}"
fi

# Derived-state freshness: regenerate and stage the deterministic
# inventories so their push-gate freshness guards can never stale-fail
# (they re-stale on every js commit by construction - the import graph
# is digest-pinned over all js sources). The fast path needs a current
# import-graph report; when stale, fall back to the ~2-minute --refresh
# rather than deferring the failure to a ~15-minute gate cycle. Skip for
# rapid WIP loops: LAGRANGE_SKIP_INVENTORY_REGEN=1 (the push gate's
# freshness guard then catches it).
if [ "$REGEN_INVENTORIES" = "1" ] \
  && [ "$SOLVER_AUTHORIZED" = "0" ] \
  && [ -z "${LAGRANGE_SKIP_INVENTORY_REGEN:-}" ]; then
  if ! node scripts/generate-global-owner-debt-inventory.js \
    > /dev/null 2>&1; then
    echo "pre-commit: import graph stale - refreshing inventories" \
      "(~2 min; skip with LAGRANGE_SKIP_INVENTORY_REGEN=1)"
    node scripts/generate-global-owner-debt-inventory.js --refresh \
      > /dev/null
  fi
  node scripts/generate-priority-recovery-owner-inventory.js > /dev/null
  git add solve/changes/global-owner-debt-inventory/inventory.json \
    solve/changes/priority-recovery-owner-inventory/inventory.json
fi

if [ "$FAILURES" -gt 0 ]; then
  echo "pre-commit: ${FAILURES} staged check(s) failed - fix and re-commit"
  echo "pre-commit: (bypass for WIP: LAGRANGE_SKIP_PRECOMMIT=1 git commit)"
  exit 1
fi

# The canonical affected proof runs LAST, after inventory regeneration and
# staging, against an exact materialization of the final index. Its PASS receipt
# is content-addressed; no worktree-only or pre-regeneration result can satisfy
# this boundary.
node scripts/run-verification.js --profile affected --boundary index
