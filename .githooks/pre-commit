#!/usr/bin/env bash
# Staged-file pre-commit gate: the cheap per-file checks the push gate
# would otherwise discover one 15-minute cycle at a time (2026-08-04
# retrospective: nine push-gate failures, six of them commit-time
# catchable). Scoped to STAGED files only, so it stays in single-digit
# seconds; whole-corpus ratchets (duplication, file-size, cycles,
# unused-exports) remain push-time concerns.
#
# Also regenerates the checked-in deterministic inventories AND test
# classification metadata whenever staged work touches their source surface.
# Their freshness guards are intentionally fail-closed; automating the derived
# state here prevents CI from discovering one stale manifest/seal per push.
#
# Extends the original fast structural guards (file-size,
# hot-path-diagnostics, staged constant names, cached staged eslint)
# with the staged guideline checks and inventory freshness.
#
# Skip (emergencies / WIP commits): LAGRANGE_SKIP_PRECOMMIT=1 git commit
# (git commit --no-verify also bypasses, as before)
set -euo pipefail

# A Solver landing (`node scripts/solve.js land`) sets LAGRANGE_SOLVER_LANDING=1:
# it has already refreshed the inventories and run the change proof, so the
# regeneration below is skipped for that commit (solve-v2 phase 2).
SOLVER_AUTHORIZED=0
if [ "${LAGRANGE_SOLVER_LANDING:-}" = "1" ]; then
  SOLVER_AUTHORIZED=1
fi

if [ -n "${LAGRANGE_SKIP_PRECOMMIT:-}" ]; then
  echo "pre-commit: LAGRANGE_SKIP_PRECOMMIT set - skipping staged checks"
  exit 0
fi

# Staged paths used by content scanners exclude deletions because there is no
# file left to scan. Derived test metadata MUST include deletions: removing a
# test/helper changes the complete census and observation closure.
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)
mapfile -t STAGED_METADATA < <(git diff --cached --name-only --diff-filter=ACMRD)
if [ "${#STAGED_METADATA[@]}" -eq 0 ]; then
  exit 0
fi

JS_FILES=()
CODE_JS_FILES=()
DOC_FILES=()
REGEN_INVENTORIES=0
REGEN_TEST_METADATA=0
for f in "${STAGED[@]}"; do
  [ -f "$f" ] || continue
  case "$f" in
    *.js|*.mjs|*.cjs)
      JS_FILES+=("$f")
      case "$f" in
        src/*|scripts/*) CODE_JS_FILES+=("$f") ;;
      esac
      ;;
  esac
  case "$f" in
    docs/*.md|examples/*) DOC_FILES+=("$f") ;;
  esac
  case "$f" in
    src/*|scripts/*|test/*) REGEN_INVENTORIES=1 ;;
  esac
done

# Test classification metadata is a complete census, not a per-file lint.
# Any test change (including deletion) can change the three manifests. Tests
# also inherit observation surfaces from helpers under test/ and scripts/, so
# helper edits must refresh the subsystem observation census too.
for f in "${STAGED_METADATA[@]}"; do
  case "$f" in
    src/*|scripts/*|test/*) REGEN_INVENTORIES=1 ;;
  esac
  case "$f" in
    test/*|scripts/*) REGEN_TEST_METADATA=1 ;;
  esac
done

FAILURES=0
run_check() {
  local label="$1"; shift
  if ! "$@"; then
    echo "pre-commit: FAIL - ${label}"
    FAILURES=$((FAILURES + 1))
  fi
}

# Fast structural guards inherited from the original hook (<2s).
# Solver evidence rule (solve-v2 phase 1): no archive and nothing over 1 MB
# under solve/ enters git; binaries go to the evidence store.
run_check "solve binary guard" node scripts/checks/check-solve-binary-guard.js
run_check "file-size ratchet" npm run -s audit:file-size
run_check "hot-path diagnostics guideline" \
  npm run -s audit:guideline:hot-path-diagnostics
run_check "staged constant names" \
  node scripts/check-staged-constant-names.js

if [ "${#JS_FILES[@]}" -gt 0 ]; then
  # --cache keeps repeat runs inside the hook budget; the cache lives in
  # this worktree's private git dir, NOT node_modules/.cache (node_modules
  # is commonly symlinked into agent worktrees, so a cache there is shared
  # and thrashed by concurrent sessions).
  ESLINT_CACHE_DIR="$(git rev-parse --git-path eslint-cache)/"
  run_check "eslint (staged files)" \
    npx eslint --cache --cache-location "${ESLINT_CACHE_DIR}" \
      --no-warn-ignored "${JS_FILES[@]}"
  run_check "literal guideline (staged files)" \
    node scripts/check-guideline-literals.js "${JS_FILES[@]}"
  run_check "decision boundaries (staged files)" \
    node scripts/check-guideline-decision-boundaries.js "${JS_FILES[@]}"
  run_check "ambient intrinsics (staged files)" \
    node scripts/check-guideline-ambient-intrinsics.js "${JS_FILES[@]}"
  run_check "silent catch (staged files)" \
    node scripts/check-guideline-silent-catch.js "${JS_FILES[@]}"
fi
if [ "${#CODE_JS_FILES[@]}" -gt 0 ]; then
  # Report-only: scoped mode lists violations in the staged files (exit 0
  # even for pre-existing ones, so an edit to an already-over-threshold
  # file is not blocked); the aggregate ratchet still gates at push time.
  node scripts/check-complexity.js --scoped "${CODE_JS_FILES[@]}" || true
fi
if [ "${#DOC_FILES[@]}" -gt 0 ]; then
  run_check "doc ascii hyphens (staged docs/examples)" \
    node scripts/checks/check-doc-ascii-hyphens.js "${DOC_FILES[@]}"
fi

# Derived-state freshness: regenerate and stage the deterministic
# inventories so their push-gate freshness guards can never stale-fail
# (they re-stale on every js commit by construction - the import graph
# is digest-pinned over all js sources). The fast path needs a current
# import-graph report; when stale, fall back to the ~2-minute --refresh
# rather than deferring the failure to a ~15-minute gate cycle. Skip for
# rapid WIP loops: LAGRANGE_SKIP_INVENTORY_REGEN=1 (the push gate's
# freshness guard then catches it).
# Generators read repository bytes from the worktree. Before auto-refreshing,
# require the derived-state source roots to match the staged index; otherwise an
# unstaged or untracked test/helper/source file could leak into a committed
# manifest/seal that does not describe the commit being made.
if { [ "$REGEN_INVENTORIES" = "1" ] || [ "$REGEN_TEST_METADATA" = "1" ]; } \
  && [ "$SOLVER_AUTHORIZED" = "0" ] \
  && [ -z "${LAGRANGE_SKIP_INVENTORY_REGEN:-}" ]; then
  mapfile -t UNSTAGED_DERIVED_INPUTS < <(
    {
      git diff --name-only -- src scripts test
      git ls-files --others --exclude-standard -- src scripts test
    } | sort -u
  )
  if [ "${#UNSTAGED_DERIVED_INPUTS[@]}" -gt 0 ]; then
    echo "pre-commit: derived metadata needs src/scripts/test to match the staged index"
    printf 'pre-commit: stage/stash or remove: %s\n' "${UNSTAGED_DERIVED_INPUTS[@]}"
    echo "pre-commit: WIP bypass: LAGRANGE_SKIP_INVENTORY_REGEN=1 git commit"
    exit 1
  fi
fi

if [ "$REGEN_INVENTORIES" = "1" ] \
  && [ "$SOLVER_AUTHORIZED" = "0" ] \
  && [ -z "${LAGRANGE_SKIP_INVENTORY_REGEN:-}" ]; then
  if ! node scripts/generate-global-owner-debt-inventory.js \
    > /dev/null 2>&1; then
    echo "pre-commit: import graph stale - refreshing inventories" \
      "(~2 min; skip with LAGRANGE_SKIP_INVENTORY_REGEN=1)"
    node scripts/generate-global-owner-debt-inventory.js --refresh \
      > /dev/null
  fi
  node scripts/generate-priority-recovery-owner-inventory.js > /dev/null
  # The --refresh fallback also rewrites the tracked import-graph seal; ship
  # it with the same commit or the publisher's exact-HEAD worktree check fails.
  git add solve/changes/global-owner-debt-inventory/inventory.json \
    solve/changes/priority-recovery-owner-inventory/inventory.json \
    test/shards/impact-graph-seal.json
fi

if [ "$REGEN_TEST_METADATA" = "1" ] \
  && [ "$SOLVER_AUTHORIZED" = "0" ] \
  && [ -z "${LAGRANGE_SKIP_INVENTORY_REGEN:-}" ]; then
  echo "pre-commit: refreshing generated test metadata"
  npm run -s test:metadata:refresh > /dev/null
  git add \
    test/shards/primary-classes.json \
    test/shards/resource-classes.json \
    test/shards/subsystem-classes.json \
    test/shards/impact-graph-seal.json
fi

if [ "$FAILURES" -gt 0 ]; then
  echo "pre-commit: ${FAILURES} staged check(s) failed - fix and re-commit"
  echo "pre-commit: (bypass for WIP: LAGRANGE_SKIP_PRECOMMIT=1 git commit)"
  exit 1
fi
