#!/usr/bin/env bash
# Push gate: unused-code check (~7s) + whole-repo cached lint (~30s cold,
# seconds warm — cache shared with pre-commit at node_modules/.cache/eslint/)
# + the static ratchet trio (duplication ~40s, unused-exports ~60s,
# circular-deps ~10s). This hook is the only per-push run of these checks:
# the per-push CI gate (test:gate:postpush) deliberately skips them and only
# the nightly full-gate workflow re-runs them remotely, so drift must be
# caught BEFORE it lands on the remote (core.md Must-Not #20).
# Bypass with git push --no-verify (emergencies only).
# Unused-file findings on untracked paths do not block: untracked files are
# never part of a push (a concurrent session's in-flight work must not gate
# this one). See scripts/checks/push-gate-unused-files.js.
set -euo pipefail

# Only a push that updates refs/heads/main can compound drift on a red main,
# so the red-main guard below is scoped to main pushes: an agent pushing a
# feature branch must not be blocked by main's state (decoupling parallel
# sessions). Git feeds pre-push one "<local-ref> <local-sha> <remote-ref>
# <remote-sha>" line per pushed ref on stdin; with no stdin lines (manual
# hook invocation) the guard fail-closes to checking. The local-sha of the
# first pushed ref is also captured so the corpus gates below measure the
# tree being pushed rather than the working tree (epic item 6).
PUSHING_MAIN=0
SAW_REF=0
PUSHED_SHA=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  SAW_REF=1
  if [ -z "${PUSHED_SHA}" ]; then
    PUSHED_SHA="${local_sha}"
  fi
  if [ "${remote_ref}" = "refs/heads/main" ]; then
    PUSHING_MAIN=1
  fi
done
if [ "${SAW_REF}" = "0" ]; then
  PUSHING_MAIN=1
fi

# Red-main guard: refuse to push while the latest completed CI run on main is
# red, so drift cannot silently compound on top of a broken gate (the
# 2026-07-26..28 dark period). Fails OPEN when gh/network is unavailable —
# the guard targets ignoring a known-red signal, not offline work. Bypass
# with LAGRANGE_PUSH_ON_RED=1 git push (NOT --no-verify, which would also
# skip every check below); use it only for a push that fixes CI itself.
if [ "${PUSHING_MAIN}" = "1" ] && [ -z "${LAGRANGE_PUSH_ON_RED:-}" ]; then
  if command -v gh >/dev/null 2>&1; then
    ci_json="$(timeout 15 gh run list --workflow ci.yml --branch main \
      --status completed --limit 1 --json conclusion,headSha \
      --jq '.[0] | "\(.conclusion) \(.headSha)"' 2>/dev/null || echo unavailable)"
    ci_conclusion="${ci_json%% *}"
    ci_head="${ci_json#* }"
    case "$ci_conclusion" in
      success|'') ;;
      unavailable)
        echo "pre-push: warning — could not query CI status (offline or gh unauthenticated); proceeding" ;;
      *)
        # Known-attributed-red exemption (epic item 7 follow-up): when THIS
        # exact red head has been acknowledged in the shared registry dir, an
        # unrelated main push may proceed while a fix is in flight. A red run
        # at any OTHER head is a new, unattributed signal and still blocks.
        if node scripts/solve/red-main-exemption.js is-exempt "${ci_head}" 2>/dev/null; then
          echo "pre-push: main CI is red at acknowledged head ${ci_head}; proceeding (exemption on record)"
        else
          echo "pre-push: the latest completed CI run on main concluded '$ci_conclusion' at ${ci_head}."
          echo "pre-push: pushing onto a red main compounds unmeasured drift. Fix CI first;"
          echo "pre-push: if this red is known and a fix is in flight, record it:"
          echo "pre-push:   node scripts/solve/red-main-exemption.js ack ${ci_head} --reason <why>"
          echo "pre-push: or, for a push that itself fixes CI: LAGRANGE_PUSH_ON_RED=1 git push"
          exit 1
        fi ;;
    esac
  else
    echo "pre-push: warning — gh CLI not installed; skipping red-main CI guard"
  fi
fi

npm run -s test:unused:push
# Lint TRACKED files only, honoring the same principle as the unused-files
# check above: untracked files are never part of a push, so a concurrent
# session's in-flight new files must not gate this one (measured 2026-07-29:
# a push was blocked twice by another session's mid-refactor untracked file).
# Tracked-but-modified files still gate — their committed versions ship.
# Cache in this worktree's private git dir, not the (possibly symlink-shared)
# node_modules/.cache — see the matching note in pre-commit.
ESLINT_CACHE_DIR="$(git rev-parse --git-path eslint-cache)/"
git ls-files -z -- 'src/**/*.js' 'src/**/*.mjs' 'src/**/*.cjs' \
  'test/**/*.js' 'test/**/*.mjs' 'test/**/*.cjs' \
  'scripts/**/*.js' 'scripts/**/*.mjs' 'scripts/**/*.cjs' |
  xargs -0 -r npx eslint --cache \
    --cache-location "${ESLINT_CACHE_DIR}" \
    --no-warn-ignored --ignore-pattern 'test/.gitkeep'
# Whole-corpus ratchets (duplication, file-size) run against the tree being
# PUSHED, materialized into a throwaway worktree, not against this working
# tree: corpus baselines make subset runs vacuous, and a concurrent session's
# in-flight files must neither dilute nor false-fail this push (parallel-
# session architecture epic, item 6). With a captured pushed sha the exact
# committed tree is gated; manual invocation gates the working-tree state.
if [ -n "${PUSHED_SHA}" ] && [ "${PUSHED_SHA}" != "0000000000000000000000000000000000000000" ]; then
  node scripts/checks/push-gate-corpus-worktree.js --ref "${PUSHED_SHA}"
else
  node scripts/checks/push-gate-corpus-worktree.js
fi
node scripts/check-unused-exports.js
node scripts/check-circular-dependencies.js
