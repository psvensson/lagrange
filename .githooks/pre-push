#!/usr/bin/env bash
# Push gate, fast-fail ordered: cheap static checks first (unused-code ~7s,
# cached whole-repo lint ~30s cold / seconds warm, corpus ratchets:
# duplication + file-size ~40s, circular-deps ~10s, unused-exports ~60s),
# then — only once everything static is green — the long-running post-push
# test corpus (test:gate:postpush) as the final stage. This hook is the only
# per-push run of the static checks: the remote per-push CI gate deliberately
# skips them and only the nightly full-gate workflow re-runs them remotely,
# so drift must be caught BEFORE it lands on the remote (core.md Must-Not
# #20). The test stage runs the same corpus CI runs after the push, so a
# push that passes this hook should not turn main red.
# Bypass with git push --no-verify (emergencies only; skips EVERYTHING).
# Skip only the test stage with LAGRANGE_PUSH_SKIP_TESTS=1 git push — for
# when the exact working tree was already gated green this session.
# Unused-file findings on untracked paths do not block: untracked files are
# never part of a push (a concurrent session's in-flight work must not gate
# this one). See scripts/checks/push-gate-unused-files.js.
set -euo pipefail

# --- Stage feedback + loud failure (operator request 2026-09-02) ---------
# Every gate stage announces itself with elapsed time, and any non-zero exit
# names the stage that failed instead of dying silently mid-gate.
GATE_STARTED_AT=$(date +%s)
CURRENT_STAGE="preflight"
stage() {
  CURRENT_STAGE="$1"
  echo "[pre-push +$(( $(date +%s) - GATE_STARTED_AT ))s] >> ${CURRENT_STAGE}"
}
report_gate_exit() {
  status=$?
  elapsed=$(( $(date +%s) - GATE_STARTED_AT ))
  if [ "${status}" -ne 0 ]; then
    echo "" >&2
    echo "[pre-push +${elapsed}s] XX FAILED in stage: ${CURRENT_STAGE} (exit ${status})" >&2
    echo "[pre-push] fix the stage above and re-run; nothing was pushed" >&2
  else
    echo "[pre-push +${elapsed}s] all stages green"
  fi
}
trap report_gate_exit EXIT
# -------------------------------------------------------------------------

# Only a push that updates refs/heads/main can compound drift on a red main,
# so the red-main guard below is scoped to main pushes: an agent pushing a
# feature branch must not be blocked by main's state (decoupling parallel
# sessions). Git feeds pre-push one "<local-ref> <local-sha> <remote-ref>
# <remote-sha>" line per pushed ref on stdin; with no stdin lines (manual
# hook invocation) the guard fail-closes to checking. The local-sha of the
stage "reading pushed refs"
# first pushed ref is also captured so the corpus gates below measure the
# tree being pushed rather than the working tree (epic item 6).
PUSHING_MAIN=0
SAW_REF=0
PUSHED_SHA=""
ALL_PROVEN_TAG_REFS=1
ZERO_SHA="0000000000000000000000000000000000000000"
while read -r _local_ref local_sha remote_ref _remote_sha; do
  SAW_REF=1
  if [ -z "${PUSHED_SHA}" ]; then
    PUSHED_SHA="${local_sha}"
  fi
  if [ "${remote_ref}" = "refs/heads/main" ]; then
    PUSHING_MAIN=1
  fi
  case "${remote_ref}" in
    refs/tags/*)
      if [ "${local_sha}" != "${ZERO_SHA}" ]; then
        # Resolve annotated tags to the commit they point at.
        tag_commit="$(git rev-parse --verify --quiet "${local_sha}^{commit}"           || echo "${local_sha}")"
        git fetch origin main --quiet 2>/dev/null || true
        if ! git merge-base --is-ancestor "${tag_commit}"           "$(git rev-parse origin/main)" 2>/dev/null; then
          ALL_PROVEN_TAG_REFS=0
        fi
      fi
      ;;
    *)
      ALL_PROVEN_TAG_REFS=0
      ;;
  esac
done
if [ "${SAW_REF}" = "0" ]; then
  PUSHING_MAIN=1
  ALL_PROVEN_TAG_REFS=0
fi

# A push consisting only of tags whose target commits already sit on
# origin/main (or tag deletions) introduces NO new tree: everything a tag
stage "tag-only fast path check"
# points at was proven when its commit was pushed. Re-running the corpus
# for the release-tag push added ~15 min and two terminal timeouts on
# 2026-08-23; skip the gauntlet entirely for that case.
if [ "${ALL_PROVEN_TAG_REFS}" = "1" ]; then
  echo "pre-push: tag-only push of commits already on origin/main - skipping gate"
  exit 0
fi

# Red-main guard: refuse to push while the latest completed CI run on main is
# red, so drift cannot silently compound on top of a broken gate (the
# 2026-07-26..28 dark period). Fails OPEN when gh/network is unavailable —
# the guard targets ignoring a known-red signal, not offline work. Bypass
# with LAGRANGE_PUSH_ON_RED=1 git push (NOT --no-verify, which would also
# skip every check below); use it only for a push that fixes CI itself.
if [ "${PUSHING_MAIN}" = "1" ] && [ -z "${LAGRANGE_PUSH_ON_RED:-}" ]; then
stage "red-main CI guard (queries GitHub)"
  if command -v gh >/dev/null 2>&1; then
    ci_json="$(timeout 15 gh run list --workflow ci.yml --branch main \
      --status completed --limit 1 --json conclusion,headSha \
      --jq '.[0] | "\(.conclusion) \(.headSha)"' 2>/dev/null || echo unavailable)"
    ci_conclusion="${ci_json%% *}"
    ci_head="${ci_json#* }"
    case "$ci_conclusion" in
      success|'') ;;
      unavailable)
        echo "pre-push: warning — could not query CI status (offline or gh unauthenticated); proceeding" ;;
      *)
        # Known-attributed-red exemption (epic item 7 follow-up): when THIS
        # exact red head has been acknowledged in the shared registry dir, an
        # unrelated main push may proceed while a fix is in flight. A red run
        # at any OTHER head is a new, unattributed signal and still blocks.
        if node scripts/solve/red-main-exemption.js is-exempt "${ci_head}" 2>/dev/null; then
          echo "pre-push: main CI is red at acknowledged head ${ci_head}; proceeding (exemption on record)"
        else
          echo "pre-push: the latest completed CI run on main concluded '$ci_conclusion' at ${ci_head}."
          echo "pre-push: pushing onto a red main compounds unmeasured drift. Fix CI first;"
          echo "pre-push: if this red is known and a fix is in flight, record it:"
          echo "pre-push:   node scripts/solve/red-main-exemption.js ack ${ci_head} --reason <why>"
          echo "pre-push: or, for a push that itself fixes CI: LAGRANGE_PUSH_ON_RED=1 git push"
          exit 1
        fi ;;
    esac
  else
    echo "pre-push: warning — gh CLI not installed; skipping red-main CI guard"
  fi
fi

stage "unused-files check"
npm run -s test:unused:push
# Lint TRACKED files only, honoring the same principle as the unused-files
# check above: untracked files are never part of a push, so a concurrent
# session's in-flight new files must not gate this one (measured 2026-07-29:
# a push was blocked twice by another session's mid-refactor untracked file).
# Tracked-but-modified files still gate — their committed versions ship.
# Cache in this worktree's private git dir, not the (possibly symlink-shared)
# node_modules/.cache — see the matching note in pre-commit.
stage "tracked-files lint (eslint, cached; ~30s cold)"
ESLINT_CACHE_DIR="$(git rev-parse --git-path eslint-cache)/"
git ls-files -z -- 'src/**/*.js' 'src/**/*.mjs' 'src/**/*.cjs' \
  'test/**/*.js' 'test/**/*.mjs' 'test/**/*.cjs' \
  'scripts/**/*.js' 'scripts/**/*.mjs' 'scripts/**/*.cjs' |
  xargs -0 -r npx eslint --cache \
    --cache-location "${ESLINT_CACHE_DIR}" \
    --no-warn-ignored --ignore-pattern 'test/.gitkeep'
# Whole-corpus ratchets (duplication, file-size) run against the tree being
# PUSHED, materialized into a throwaway worktree, not against this working
# tree: corpus baselines make subset runs vacuous, and a concurrent session's
# in-flight files must neither dilute nor false-fail this push (parallel-
# session architecture epic, item 6). With a captured pushed sha the exact
# committed tree is gated; manual invocation gates the working-tree state.
stage "corpus ratchets in throwaway worktree (duplication/file-size; minutes)"
if [ -n "${PUSHED_SHA}" ] && [ "${PUSHED_SHA}" != "0000000000000000000000000000000000000000" ]; then
  node scripts/checks/push-gate-corpus-worktree.js --ref "${PUSHED_SHA}"
else
  node scripts/checks/push-gate-corpus-worktree.js
fi
# Fast-fail ordering: circular-deps (~10s) before unused-exports (~60s).
stage "circular-dependency check (~10s)"
node scripts/check-circular-dependencies.js
stage "unused-exports ratchet (~60s)"
node scripts/check-unused-exports.js

# Final stage — the long-running post-push test corpus. Everything cheap has
# already passed, so a failure here is a real test regression, not a lint
# nit discovered after minutes of test time. Runs against the working tree
# (the same surface the manual pre-flight gates); the remote CI gate re-runs
# it against the pushed tree after the push.
if [ -n "${LAGRANGE_PUSH_SKIP_TESTS:-}" ]; then
  echo "pre-push: LAGRANGE_PUSH_SKIP_TESTS set — skipping test:gate:postpush (static checks all green)"
else
  # Thermal staging: back-to-back gate runs must not start the heavy
  # corpus on an already-hot machine (session thermal policy: hold at
  # CPU >=75C / NVMe Sensor 2 >=78C). Waits up to 10 minutes, then
  # aborts; fail-open where lm-sensors is absent (CI runners).
  # Short stages are done; before paying for the long corpus, prove none of
  # them mutated tracked content - inside the publisher's exact-HEAD worktree
  # a mutation is a hard failure NOW, not after 30 more minutes (operator
  # ordering principle 2026-09-02: short checks up front, long runs last).
  if [ -n "${LAGRANGE_WORKSPACE_INJECTIONS:-}" ]; then
    stage "worktree cleanliness after the short stages"
    GATE_DIRTY="$(git status --porcelain)"
    if [ -n "${GATE_DIRTY}" ]; then
      echo "pre-push: a short stage mutated tracked content:" >&2
      echo "${GATE_DIRTY}" >&2
      exit 1
    fi
  fi
  stage "thermal headroom gate"
  node scripts/checks/wait-for-thermal-headroom.js
  echo "pre-push: static checks green — running the post-push test corpus (long)"
  # Retry-failed-once (same owner policy as the CI lanes, 2026-08-24): a
  # single intermittent among ~2000 files must not block a push; a failed
  # file reruns standalone once, reported never hidden, and a standalone
  # failure stays red (run-test-files.js owns the mechanics and the 5-file
  # breakage cap).
  stage "full test corpus - runs BEFORE the push; CI re-runs it after (LONG: ~30-45 min; per-file results stream below)"
  LAGRANGE_RETRY_FAILED_ONCE=1 npm run -s test:gate:postpush
fi
