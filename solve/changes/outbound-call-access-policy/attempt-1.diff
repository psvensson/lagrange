+      writeStored({
+        ...policy,
+        calls: [{binding: 'dup-worker'}, {binding: 'dup-worker'}],
+      });
+      await expectInvalid();
+      writeStored({...policy, schema_version: 1});
+      await expectInvalid();
+      const {calls: _ignored, ...v2WithoutCalls} = policy;
