+spec:
+  replicas: 1
+  serviceName: {{ include "lagrange-node.headlessService" . }}
+  selector:
+    matchLabels:
+      {{- include "lagrange-node.selectorLabels" . | nindent 6 }}
+      app.kubernetes.io/component: seed
+  template:
+    metadata:
+      labels:
+        {{- include "lagrange-node.selectorLabels" . | nindent 8 }}
+        app.kubernetes.io/component: seed
+      {{- with .Values.podAnnotations }}
+      annotations:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+    spec:
+      containers:
+        - name: lagrange
+          {{- include "lagrange-node.containerCommon" . | nindent 10 }}
+          env:
+            {{- include "lagrange-node.envCommon" . | nindent 12 }}
+      {{- with .Values.nodeSelector }}
+      nodeSelector:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      {{- with .Values.tolerations }}
+      tolerations:
+        {{- toYaml . | nindent 8 }}
