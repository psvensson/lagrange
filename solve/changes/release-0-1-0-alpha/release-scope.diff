--- /dev/null
+++ b/.forgejo/workflows/release.yml
@@ -0,0 +1,76 @@
+# Forgejo Actions release — runs on Codeberg when a `v*` tag is pushed.
+# Syntax is GitHub-Actions-compatible.
+#
+# Prerequisites (one-time):
+#   * Codeberg Actions enabled for the repo, with a runner that provides Docker
+#     (the `docker` label below; a self-hosted runner with the docker socket, or
+#     Codeberg's hosted runners).
+#   * A `helm` binary on the runner (installed in-step below) and Node 22.
+#   * Secrets:
+#       REGISTRY_USER  - Codeberg username (package registry push)
+#       REGISTRY_TOKEN - Codeberg token with package:write scope
+#     GITHUB_TOKEN is provided automatically by Forgejo for release upload.
+name: release
+
+on:
+  push:
+    tags: ["v*"]
+
+env:
+  IMAGE: codeberg.org/psvensson/lagrange
+
+jobs:
+  release:
+    runs-on: docker
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Node 22
+        uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+
+      - name: Install dependencies
+        run: npm ci
+
+      # Full pre-release gate. Fails the release if the tagged tree is not green.
+      - name: Full gate (test:ci)
+        run: npm run test:ci
+
+      # Bundle + single-executable (SEA) builds -> ./dist
+      - name: Build bundle and SEA binaries
+        run: npm run build:all
+
+      - name: Package Helm chart
+        run: |
+          curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
+          helm package charts/lagrange-node --destination dist/
+
+      # Checksum every release artifact (SEA binaries + Helm chart tarball).
+      - name: Checksum release artifacts
+        run: |
+          cd dist
+          sha256sum * > SHA256SUMS
+          cat SHA256SUMS
+
+      - name: Build and push Docker image
+        run: |
+          echo "${{ secrets.REGISTRY_TOKEN }}" | \
+            docker login codeberg.org -u "${{ secrets.REGISTRY_USER }}" --password-stdin
+          TAG="${GITHUB_REF_NAME#v}"
+          docker build -t "$IMAGE:$TAG" -t "$IMAGE:latest" .
+          docker push "$IMAGE:$TAG"
+          docker push "$IMAGE:latest"
+
+      # Publishes the tag as a Forgejo Release and attaches the artifacts.
+      - name: Publish Forgejo release
+        uses: actions/forgejo-release@v2
+        with:
+          direction: upload
+          token: ${{ secrets.GITHUB_TOKEN }}
+          tag: ${{ github.ref_name }}
+          release-dir: dist
+          release-notes: |
+            Lagrange ${{ github.ref_name }} (experimental / alpha).
+            See CHANGELOG.md and RELEASE.md. Docker image: ${{ env.IMAGE }}:${{ github.ref_name }}
