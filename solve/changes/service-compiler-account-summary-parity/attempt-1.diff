+const SERVICE_MODULE_URL = new URL('lagrange.service.js', EXAMPLE_DIRECTORY);
+const GENERATED_ENTRY_PATH = fileURLToPath(
+  new URL('generated-entry.js', EXAMPLE_DIRECTORY),
