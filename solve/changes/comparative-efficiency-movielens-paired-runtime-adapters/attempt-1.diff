+  };
+}
+
+function lagrangeSession(semanticOracleDigest) {
+  const executableDigest = digestBenchmarkSemanticData({wasm: 'fixture'});
+  return {
+    artifact: {executableDigest},
+    prepared: {
+      deployment: {
+        binding: {name: 'movielens-public-grouped-reduce'},
