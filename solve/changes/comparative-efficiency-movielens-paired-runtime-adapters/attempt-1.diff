+  cancelled: 0,
+});
+const REJECTED = Object.freeze({
+  queueFull: 0,
+  flowControl: 0,
+  admission: 0,
+});
+
+function coordinate(sideId) {
+  return {
+    blockIndex: 0,
+    blockedOrderIndex: 0,
