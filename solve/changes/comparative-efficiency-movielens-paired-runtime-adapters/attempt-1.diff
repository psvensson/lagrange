+        return {
+          oracle: {
+            observed: ALTERNATIVE.topMovies.map((row, index) => ({
+              movieId: row.movieId,
+              rank: index + 1,
+              scoreMicros: Math.trunc(row.score * 1_000_000),
+            })),
+          },
+          response: {
+            status: 200,
+            requestWitness: {
