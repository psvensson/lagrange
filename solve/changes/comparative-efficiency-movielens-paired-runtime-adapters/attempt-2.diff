+    producer: 'comparative-efficiency-movielens-paired-runtime-live',
+    fidelity:
+      'live-public-wasm-and-postgresql-with-cgroup-container-metering',
+    summary: {total: scenarios.length, passed: scenarios.length, failed: 0},
+    optimizationSummary: {totalPriorityItems: 0},
+    standardSummary: {scenarios},
+  };
+  await mkdir(REPORT_DIRECTORY, {recursive: true});
+  const stamp = timestamp.replace(/[:.]/gu, '-');
+  const reportPath = resolve(
+    REPORT_DIRECTORY,
