+  createBenchmarkCapacityAdapterOwnerReceipt,
+  createBenchmarkCapacityHeadroomReceipt,
+  createBenchmarkCapacityHeterogeneousOperationReceipt,
+} from '../benchmark-capacity-heterogeneous-observation.js';
+import {
