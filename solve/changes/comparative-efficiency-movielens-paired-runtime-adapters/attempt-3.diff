+      memoryMax: POSTGRESQL_CLIENT_MEMORY,
+      cpuQuota: POSTGRESQL_CLIENT_CPU,
+      cpuSet: POSTGRESQL_CLIENT_CPU_SET,
+      tasksMax: POSTGRESQL_TASKS,
+      startOptions: {
+        ratingsPath: dataset.path,
+        ratingsDigest: dataset.digest,
+        replicationFactor: 1,
