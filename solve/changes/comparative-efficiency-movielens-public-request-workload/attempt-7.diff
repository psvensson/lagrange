+      resolved.raw.observationArtifact,
+      observationArtifact.retained.descriptor,
+    ) ||
+    !plainDataEqual(
+      resolved.raw.sourceState,
+      sourceStateArtifact.value,
+    ) ||
+    !plainDataEqual(
+      resolved.raw.sourceState,
+      observation.sourceState,
+    ) ||
+    !plainDataEqual(
