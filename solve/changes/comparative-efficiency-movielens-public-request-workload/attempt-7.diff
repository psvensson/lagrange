+        querySql,
+      ),
+      regexpMatches(
+        /SUM\s*\(\s*rating\s*\)\s+AS\s+rating_sum/iu,
+        querySql,
+      ),
+      regexpMatches(
+        /\(\s*rating_sum\s*\+\s*87\.5\s*\)\s*\/\s*\(\s*rating_count\s*\+\s*25\s*\)/iu,
+        querySql,
+      ),
+      regexpMatches(
+        /0\.5\s*\/\s*SQRT\s*\(\s*rating_count\s*\)/iu,
+        querySql,
+      ),
+      regexpMatches(
+        /ORDER\s+BY\s+score\s+DESC\s*,\s*movie_id\s+ASC/iu,
+        querySql,
