+      operationId: 'operation-key',
+    }), {
+      idempotencyKey: 'request-key',
+      operationId: 'operation-key',
+    });
+    let getterReads = 0;
+    const accessor = {operationId: 'operation-key'};
+    Object.defineProperty(accessor, 'idempotencyKey', {
+      enumerable: true,
+      get() {
+        getterReads += 1;
