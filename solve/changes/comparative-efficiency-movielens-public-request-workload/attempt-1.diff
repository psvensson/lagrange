+
+function mapHas(map, key) {
+  return reflectApply(mapHasMethod, map, [key]);
+}
+
+function mapSet(map, key, value) {
+  reflectApply(mapSetMethod, map, [key, value]);
+}
+
+function mapGet(map, key) {
+  return reflectApply(mapGetMethod, map, [key]);
+}
