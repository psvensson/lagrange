diff --git a/src/raft/sqlite-log-adapter-batch-api.js b/src/raft/sqlite-log-adapter-batch-api.js
new file mode 100644
index 0000000000000000000000000000000000000000..16e5a522c863c20bc2c366142bff3e7b19ab76de
--- /dev/null
+++ b/src/raft/sqlite-log-adapter-batch-api.js
@@ -0,0 +1,39 @@
+/**
+ * Install the SQLite-only batch operations consumed by the Lagrange Liferaft
+ * wrapper. Keeping them on the adapter preserves its single-writer ownership
+ * of _raft_log and _raft_state.
+ * @param {Function} SQLiteLogAdapter
+ */
+function installSQLiteLogAdapterBatchApi(SQLiteLogAdapter) {
+  SQLiteLogAdapter.prototype.saveCommands = function(entries) {
+    const saveAll = this.db.transaction((batch) => batch.map((entry) =>
+      this.saveCommand(entry.command, entry.term, entry.index),
+    ));
+    try {
+      return saveAll(entries);
+    } catch (error) {
+      this.refreshCommittedIndexCacheFromStore();
+      throw error;
+    }
+  };
+
+  SQLiteLogAdapter.prototype.commitBatch = function(entries) {
+    if (!this.isOpen()) {
+      return entries;
+    }
+    const commitAll = this.db.transaction((batch) => {
+      for (const entry of batch) {
+        this.commit(entry.index);
+      }
+      return batch;
+    });
+    try {
+      return commitAll(entries);
+    } catch (error) {
+      this.refreshCommittedIndexCacheFromStore();
+      throw error;
+    }
+  };
+}
+
+export {installSQLiteLogAdapterBatchApi};
