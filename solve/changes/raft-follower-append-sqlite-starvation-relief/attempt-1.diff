@@ -0,0 +1,74 @@
+#!/usr/bin/env node
+
+import fs from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {runTestFileSync} from './run-test-files.js';
+
+const SCENARIO = 'raft-follower-append-sqlite-starvation-relief';
+const GUARD_FILE = 'test/raft/liferaft-catchup-batching.test.js';
+const REPORT_DIRECTORY = 'test-output/reports';
+const GUARD_TIMEOUT_MS = 300000;
+const LIVE_PROFILE_PENDING = 'live_profile_pending';
+const GUARD_TEST_FAILED = 'guard_test_failed';
+const VERDICT_PASS = 'PASS';
+const VERDICT_FAIL = 'FAIL';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const guard = runTestFileSync(GUARD_FILE, {
+  print: false,
+  timeoutMs: GUARD_TIMEOUT_MS,
+});
+const timestamp = new Date().toISOString();
+const guardPassed = guard.ok === true;
+
+// This runner is intentionally a measuring RED when the deterministic guard
+// passes: the sealed Quest additionally requires a profiled GCP formation run,
+// so local proof must never masquerade as terminal live evidence.
+const report = {
+  timestamp,
+  scenario: SCENARIO,
+  producer: 'raft-follower-append-sqlite-starvation-relief-guard',
+  fidelity: 'deterministic-guard',
+  summary: {
+    total: 2,
+    passed: guardPassed ? 1 : 0,
+    failed: guardPassed ? 1 : 2,
+  },
+  optimizationSummary: {
+    totalPriorityItems: guardPassed ? 1 : 2,
+  },
+  standardSummary: {
+    scenarios: [{
+      scenario: SCENARIO,
+      passed: false,
+      current: {
+        passed: false,
+        verdict: 'FAIL',
+        verdictReason: guardPassed ? LIVE_PROFILE_PENDING : GUARD_TEST_FAILED,
+      },
+      detail: {
+        deterministicGuard: {
+          file: GUARD_FILE,
+          passed: guardPassed,
+          assertions: guard.assertions,
+          reasons: guard.reasons,
+          elapsedMs: guard.elapsedMs,
+        },
+        liveProfile: {passed: false, reason: LIVE_PROFILE_PENDING},
+      },
+    }],
+  },
+};
+
+const reportDir = path.join(root, REPORT_DIRECTORY);
+fs.mkdirSync(reportDir, {recursive: true});
+const stamp = timestamp.replace(/[:.]/g, '-');
+const reportPath = path.join(reportDir, `${SCENARIO}-${stamp}.report.json`);
+fs.writeFileSync(reportPath, `${JSON.stringify(report, null, 2)}\n`);
+
+process.stdout.write(
+  `${guardPassed ? VERDICT_PASS : VERDICT_FAIL} deterministic guard; ` +
+  `live profile pending\nreport: ${path.relative(root, reportPath)}\n`,
+);
+process.exitCode = guardPassed ? 0 : 1;
diff --git a/src/raft/liferaft-commit-scheduler.js b/src/raft/liferaft-commit-scheduler.js
new file mode 100644
index 0000000000000000000000000000000000000000..b9f8bd9a76141acda3a0b9b60b1ecb56796bf897
--- /dev/null
+++ b/src/raft/liferaft-commit-scheduler.js
@@ -0,0 +1,47 @@
+const COMMIT_APPLY_CHUNK_SIZE = 8;
+const RAFT_COMMIT_EVENT = 'commit';
+
+function yieldEventLoopTurn() {
+  return new Promise((resolve) => setImmediate(resolve));
+}
+
+async function emitCommittedEntries(raft, entries) {
+  for (let offset = 0; offset < entries.length; offset += 1) {
+    raft.emit(RAFT_COMMIT_EVENT, entries[offset].command);
+    const appliedCount = offset + 1;
+    if (
+      appliedCount < entries.length &&
+      appliedCount % COMMIT_APPLY_CHUNK_SIZE === 0
+    ) {
+      await yieldEventLoopTurn();
+    }
+  }
+}
+
+/**
+ * Persist one SQLite commit prefix transactionally, then apply it in bounded
+ * event-loop chunks. Persistence remains ahead of acknowledgement/application
+ * exactly as in upstream Liferaft, while the application microtask chain can
+ * no longer starve Raft timers indefinitely.
+ * @param {Object} raft
+ * @param {Array} entries
+ * @param {Function} fallback
+ * @return {Promise<void>}
+ */
+function commitEntriesCooperatively(raft, entries, fallback) {
+  if (!Array.isArray(entries) || entries.length === 0) {
+    return Promise.resolve();
+  }
+  if (typeof raft.log?.commitBatch !== 'function') {
+    return fallback(entries);
+  }
+
+  const committedEntries = raft.log.commitBatch(entries);
+  const apply = () => emitCommittedEntries(raft, committedEntries);
+  const prior = raft._commitApplyTail || Promise.resolve();
+  const current = prior.then(apply, apply);
+  raft._commitApplyTail = current;
+  return current;
+}
+
+export {commitEntriesCooperatively, yieldEventLoopTurn};
diff --git a/src/raft/liferaft-follower-batch.js b/src/raft/liferaft-follower-batch.js
