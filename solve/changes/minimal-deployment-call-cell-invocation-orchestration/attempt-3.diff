+function extractQuotedString(sql, marker) {
+  const start = sql.indexOf(marker);
+  if (start < 0) return null;
+  let cursor = start + marker.length;
+  let value = '';
+  while (cursor < sql.length) {
+    const char = sql[cursor];
+    if (char !== '\'') {
+      value += char;
+      cursor += 1;
+      continue;
+    }
+    if (sql[cursor + 1] === '\'') {
+      value += '\'';
+      cursor += 2;
+      continue;
+    }
+    return value;
+  }
+  return value;
