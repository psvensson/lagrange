+function readNoContexts() {
+  return [];
+}
+
+function writeNoEffects() {}
+
+function cancelNoop() {}
+
+function createWorkerStatementAdapter(componentBytes) {
+  const cellRuntime = new WasiComponentCellRuntime();
+  const runInvocations = [];
+  const reduceInvocations = [];
+  const replicaIdOf = new Map();
+  // The invoker does not forward the resolved route to the statement
+  // adapter (see CallCellInvoker.invoke), so the adapter serves the one
+  // installed call-cell component for whichever service it is asked about.
+  const fallbackServiceId = 'call-cell-live-component';
+
+  function cellFor(serviceId) {
+    return Object.freeze({
+      budgets: CELL_BUDGETS,
+      bytes: new Uint8Array(componentBytes),
+      capabilities: [],
+      exportName: CALL_EXPORT,
+      serviceId,
+      world: WORLD_NAME,
+    });
+  }
+
+  async function invokeComponent(serviceId, exportName, args) {
+    return cellRuntime.invoke(
+      serviceId,
+      args,
+      readNoContexts,
+      writeNoEffects,
+      cancelNoop,
+      {
+        callContext: {
+          emitBudget: EMIT_BUDGET,
+          nestedCallBudget: NESTED_CALL_BUDGET,
+          onCallBounded: false,
+        },
+        exportName,
+      },
+    );
+  }
+
+  const adapter = {
+    async invoke(request) {
+      const serviceId = request.serviceId || fallbackServiceId;
+      if (!replicaIdOf.has(serviceId)) {
+        const replicaId = `${serviceId}-r1`;
+        await cellRuntime.start(cellFor(serviceId));
+        replicaIdOf.set(serviceId, replicaId);
+      }
+      const replicaId = replicaIdOf.get(serviceId);
+      if (request.exportName === 'reduce') {
+        reduceInvocations.push({partials: request.partials});
+        // The coordinator's completeness gate merges partials into numeric
+        // [key, aggValue] tuples, but the guest reduce expects the emitted
+        // [key, partialJson] tuples. For this fixture key=id and
+        // aggValue=score, so translate the merged tuples back into the
+        // guest's [key, partialJson] shape at the adapter boundary.
+        const guestPartials = request.partials.map(([key, aggValue]) => [
+          key,
+          JSON.stringify({id: String(key), score: aggValue}),
+        ]);
+        const invocation = await invokeComponent(
+          serviceId,
+          'reduce',
+          [guestPartials, request.argumentsJson ?? '{}'],
+        );
+        return {componentResult: invocation.value, replicaId};
+      }
+      runInvocations.push({partitionId: request.partitionId});
+      const invocation = await invokeComponent(
+        serviceId,
+        'run',
+        [request.batch, request.argumentsJson ?? '{}'],
+      );
+      // The reduce completeness gate requires each published run partial to
+      // be a bounded [{groupKey, aggValue}] array. The shard's kept top-N
+      // rows are that partial (groupKey=id, aggValue=score); the guest's own
+      // return value carries bookkeeping, and `partials` is the host's
+      // captured emit log. Publish the shard partial in the gate's shape.
+      const kept = JSON.parse(invocation.value).kept;
+      const shardPartial = kept.map((entry) => ({
+        aggValue: entry.score,
+        groupKey: entry.id,
+      }));
+      return {
+        componentResult: JSON.stringify(shardPartial),
+        partials: invocation.partials,
+        replicaId,
+      };
+    },
+    counts() {
+      return {
+        reduce: reduceInvocations.length,
+        run: runInvocations.length,
+      };
+    },
+    async stop() {
+      for (const serviceId of replicaIdOf.keys()) {
+        await cellRuntime.stop(serviceId);
+      }
+    },
+  };
+  return adapter;
+}
+
+function wireEngineQueryPath(engine) {
+  engine.getTableInfo = (tableName) => (tableName === DECLARED_TABLE ? {
+    table_id: DECLARED_TABLE,
+    table_name: DECLARED_TABLE,
+  } : null);
+  engine.getTablePartitions = (tableName) => (tableName === DECLARED_TABLE ?
+    [
+      {partition_id: PARTITION_ONE, status: 'active'},
+      {partition_id: PARTITION_TWO, status: 'active'},
+    ] :
+    []);
+  const realBuildSelectSql =
+    engine.queryExecutor.buildSelectSQL.bind(engine.queryExecutor);
+  engine.queryExecutor.buildSelectSQL = () => CALL_STATEMENT;
+  engine.queryExecutor.executeOnPartitions = async (partitionIds) =>
+    partitionIds.map((partitionId) => ({
+      partitionId,
+      rows: (SEEDED_ROWS[partitionId] || []).map((row) => ({...row})),
+      success: true,
+    }));
+  return () => {
+    engine.queryExecutor.buildSelectSQL = realBuildSelectSql;
+  };
+}
