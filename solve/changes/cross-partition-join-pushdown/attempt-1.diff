+    return;
+  }
+  for (const [key, value] of Object.entries(node)) {
+    if (Array.isArray(value)) {
+      value.forEach((entry, entryIndex) => {
+        if (entry?.type === EXPR_TYPE.PARAMETER) {
+          value[entryIndex] = {
+            type: EXPR_TYPE.LITERAL,
+            value: params[entry.index],
