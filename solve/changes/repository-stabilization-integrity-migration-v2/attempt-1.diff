++  hasExactOwnDataKeys,
++  isNonNegativeSafeInteger,
++  isSha256Digest,
++} from './benchmark-semantic-integrity.js';
++import {
++  BENCHMARK_CAPACITY_PHASE,
++  BENCHMARK_CAPACITY_MAX_TEXT_CODE_UNITS,
++  BENCHMARK_CAPACITY_RECEIPT_CLOCK,
++  BENCHMARK_CAPACITY_RECEIPT_INTERVAL,
