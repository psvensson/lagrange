++export async function resolveBenchmarkLocalModuleSourcePaths({
++  entryPaths,
++  additionalPaths = [],
++}) {
++  assertPathList(entryPaths);
++  assertPathList(additionalPaths);
++  const root = process.cwd();
++  const pending = [];
++  for (let index = 0; index < entryPaths.length; index += 1) {
++    pending.push(path.resolve(root, entryPaths[index]));
++  }
++  const visited = new Set();
++  const sourcePaths = [];
++  while (pending.length > 0) {
++    const absolutePath = pending.pop();
++    const sourcePath = repositoryPath(absolutePath, root);
++    if (visited.has(sourcePath)) continue;
++    visited.add(sourcePath);
++    sourcePaths.push(sourcePath);
