++  if (!Array.isArray(values)) fail(localText.ROOT_SHAPE);
++  for (let index = 0; index < values.length; index += 1) {
++    if (typeof values[index] !== 'string' || values[index].length === 0) {
++      fail(localText.ROOT_SHAPE);
++    }
++  }
++}
