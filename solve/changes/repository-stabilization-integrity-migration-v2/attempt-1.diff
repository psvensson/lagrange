++      pending.push(
++        path.resolve(path.dirname(absolutePath), specifiers[index]),
++      );
++    }
++  }
++  for (let index = 0; index < additionalPaths.length; index += 1) {
++    const sourcePath = repositoryPath(
++      path.resolve(root, additionalPaths[index]),
++      root,
++    );
++    if (!visited.has(sourcePath)) sourcePaths.push(sourcePath);
++  }
++  arraySort(sourcePaths);
++  return objectFreeze(sourcePaths);
++}
