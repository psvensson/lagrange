+    for (const sibling of siblings.values()) {
+      attemptSibling(sibling).catch((error) => {
+        record(EVENT.SIBLING_REFUSED, {
+          tableId: sibling.tableId,
+          reason: error.message,
+        });
+      });
+    }
+  };
