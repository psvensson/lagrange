+    liveEvidence.candidate,
+    liveCandidateKeys,
+    localText.PATH_LIVE_CANDIDATE,
+  );
+  assertBenchmarkResourceExactRecord(
+    liveEvidence.alternative,
+    liveAlternativeKeys,
+    localText.PATH_LIVE_ALTERNATIVE,
+  );
