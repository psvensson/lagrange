+    payload.version !== localText.PREREGISTRATION_VERSION ||
+    payload.outcomePolicy !== localText.OUTCOME_POLICY ||
+    payload.invalidCellPolicy !== localText.INVALID_CELL_POLICY ||
+    payload.candidateEngagementRequired !== true ||
