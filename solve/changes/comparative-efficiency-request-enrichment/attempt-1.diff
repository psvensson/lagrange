+    fail(`${path}:iso_timestamp_required`);
+  }
+}
+
+function expectedWorkloadCell(cell) {
+  return {
+    datasetSize: cell.datasetSize,
+    fanout: cell.fanout,
+    readLocality: cell.readLocality,
+    skew: cell.skew,
+    requestCount: cell.requestCount,
