+    inventorySides: [
+      {
+        sideId: 'lagrange',
+        components: [
+          component(
+            'lagrange-node',
+            BENCHMARK_RESOURCE_COMPONENT_ROLE.LAGRANGE_NODE,
+          ),
+        ],
+      },
+      {
+        sideId: 'postgresql',
+        components: [
+          component(
+            'postgresql-database',
+            BENCHMARK_RESOURCE_COMPONENT_ROLE.DATABASE,
+          ),
+          component(
+            'postgresql-client',
+            BENCHMARK_RESOURCE_COMPONENT_ROLE.CLIENT,
