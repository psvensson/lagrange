+    ],
+  });
+  await captureBenchmarkResourceLiveObservation(session);
+  cleaned = true;
+  const finalized = await finalizeBenchmarkResourceLiveObservation(session);
+  return writeExternallyObservedBenchmarkResourceCalibration(
