+    fail();
+  }
+}
+
+function assertSourceDisposition(payload) {
+  if (
+    payload.state !== BENCHMARK_RESOURCE_CELL_STATE.NON_MEASURING ||
+    payload.candidateEngaged !== false ||
+    payload.alternativeEngaged !== true ||
