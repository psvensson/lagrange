+      } catch (error) {
+        observedError = error;
+      }
+
+      assert.equal(observedError instanceof OciHostAgentDurableStateError, true);
+      assert.equal(
+        observedError.code,
+        OCI_HOST_AGENT_DURABLE_ERROR.RECEIPT_UNAVAILABLE,
+        'the ledger recovery failure remains authoritative',
+      );
+      assert.equal(
+        observedError.message,
+        OCI_HOST_AGENT_DURABLE_ERROR.RECEIPT_UNAVAILABLE,
+      );
+      assert.equal(
