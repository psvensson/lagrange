+    appendOwnArrayValue(
+      orders,
+      forward ? [sideIds[0], sideIds[1]] : [sideIds[1], sideIds[0]],
+    );
+    if (index + 1 < maximum) {
+      appendOwnArrayValue(
+        orders,
+        forward ? [sideIds[1], sideIds[0]] : [sideIds[0], sideIds[1]],
+      );
+    }
