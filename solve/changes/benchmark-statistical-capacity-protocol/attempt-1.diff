+  for (let loadIndex = 0;
+    loadIndex < sealed.offeredLoadPerSecond.length;
+    loadIndex += 1) {
+    const offeredLoad = sealed.offeredLoadPerSecond[loadIndex];
+    let matched;
+    for (let index = 0; index < summaries.length; index += 1) {
+      const candidate = summaries[index];
+      if (
+        candidate.blockIndex === blockIndex &&
+        candidate.sideId === sideId &&
+        candidate.offeredLoadPerSecond === offeredLoad
