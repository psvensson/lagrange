+
+function sumAccounting(samples) {
+  const counts = {
+    offered: 0,
+    dispatched: 0,
+    correct: 0,
+    rejected: 0,
+    timedOut: 0,
+    errored: 0,
+    queueOverflow: 0,
+    undispatched: 0,
+    cancelled: 0,
+  };
+  const rejectedByReason = {queueFull: 0, flowControl: 0, admission: 0};
+  const countKeys = objectKeys(counts);
+  const reasonKeys = objectKeys(rejectedByReason);
