+    sealed.sampling.tailSampleMinimum;
+  const quantilesMs = {
+    p50: quantile(
+      sample.endToEndLatencyMs,
+      BENCHMARK_CAPACITY_PERCENTILE_P50,
+    ),
+    p95: quantile(
+      sample.endToEndLatencyMs,
+      BENCHMARK_CAPACITY_PERCENTILE_P95,
+    ),
+    p99: quantile(
+      sample.endToEndLatencyMs,
+      BENCHMARK_CAPACITY_PERCENTILE_P99,
+    ),
+  };
