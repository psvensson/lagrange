+  if (values.length === 0) {
+    return {estimate: 0, lower: 0, upper: 0};
+  }
+  const random = createMulberry32(seed);
+  const estimates = [];
+  for (let sampleIndex = 0; sampleIndex < resamples; sampleIndex += 1) {
+    const resample = [];
