new file mode 100644
index 0000000000000000000000000000000000000000..7f9883c3a74240cf68a2fc5ec54d33257adcb1bd
--- /dev/null
+++ b/scripts/solve/attempt-base-correction.js
@@ -0,0 +1,216 @@
+import {
+  appendEvent,
+  loadQuest,
+  readLog,
+} from './store.js';
+import {
+  baseCommitReachable,
+  canonicalSourceDelta,
+  sourceChangingAttempts,
+  VERIFICATION_CONTRACT_VERSION,
+  VERIFICATION_SCOPE,
+} from './verification.js';
+import {
+  EVENT_ATTEMPT_BASE_CORRECTED,
+} from './attempt-base-correction-projection.js';
+
+const VERIFIER_KINDS = new Set([
+  'verifier-approval',
+  'verifier-rejection',
+]);
+const COMMIT_PATTERN = /^[0-9a-f]{40}$/u;
+
+function requireText(args, name) {
+  const value = args[name];
+  if (typeof value !== 'string' || value.trim().length === 0) {
+    throw new Error(`correct-attempt-base: --${name} is required`);
+  }
+  return value.trim();
+}
+
+function exactArrayEqual(left, right) {
+  return left.length === right.length &&
+    left.every((value, index) => value === right[index]);
+}
+
+function verifierReceiptCoversAttempt(event, attempt) {
+  if (
+    event.type !== 'finding' ||
+    !VERIFIER_KINDS.has(event.kind) ||
+    !event.verification ||
+    typeof event.verification !== 'object'
+  ) {
+    return false;
+  }
+  const receipt = event.verification;
+  if (receipt.fingerprint === attempt.fingerprint) return true;
+  return receipt.schemaVersion === VERIFICATION_CONTRACT_VERSION &&
+    [VERIFICATION_SCOPE.CANDIDATE, VERIFICATION_SCOPE.AGGREGATE,
+      VERIFICATION_SCOPE.BOTH].includes(receipt.scope) &&
+    Number.isInteger(receipt.firstAttemptIndex) &&
+    Number.isInteger(receipt.lastAttemptIndex) &&
+    receipt.firstAttemptIndex <= attempt.index &&
+    receipt.lastAttemptIndex >= attempt.index;
+}
+
+function isCandidateReceipt(event, frontier) {
+  return [
+    event.type === 'finding',
+    event.frontier === frontier,
+    event.verification?.schemaVersion === VERIFICATION_CONTRACT_VERSION,
+    event.verification?.scope === VERIFICATION_SCOPE.CANDIDATE,
+  ].every(Boolean);
+}
+
+function isStandingRejection(event, attempt) {
+  const receipt = event?.verification;
+  return [
+    event?.kind === 'verifier-rejection',
+    receipt?.verdict === 'rejected',
+    Number.isInteger(receipt?.lastAttemptIndex),
+    receipt?.lastAttemptIndex < attempt.index,
+    COMMIT_PATTERN.test(String(receipt?.baseCommit || '')),
+  ].every(Boolean);
+}
+
+function latestCandidateRejection(log, attempt) {
+  const event = log.slice(0, attempt.index).findLast((candidate) =>
+    isCandidateReceipt(candidate, attempt.event.frontier));
+  return isStandingRejection(event, attempt) ?
+    {event, receipt: event.verification} :
+    null;
+}
+
+function requireMatchingDelta(root, base, attempt, label) {
+  const paths = [...attempt.inspection.changedPaths].sort();
+  const delta = canonicalSourceDelta(root, base, paths);
+  if (!delta.ok) {
+    throw new Error(
+      `correct-attempt-base: ${label} delta is unavailable: ${delta.problem}`,
+    );
+  }
+  if (
+    delta.fingerprint !== attempt.fingerprint ||
+    !exactArrayEqual(delta.paths, paths)
+  ) {
+    throw new Error(
+      `correct-attempt-base: ${label} delta does not reproduce ` +
+        `${attempt.fingerprint}`,
+    );
+  }
+  return delta.fingerprint;
+}
+
+function requireCorrectableAttempt(root, quest, log, attemptIndex) {
+  const duplicate = log.some((event) =>
+    event.type === EVENT_ATTEMPT_BASE_CORRECTED &&
+    event.attemptIndex === attemptIndex);
+  if (duplicate) {
+    throw new Error(
+      `correct-attempt-base: attempt ${attemptIndex} already has a correction`,
+    );
+  }
+  const attempt = sourceChangingAttempts(root, quest, log)
+    .find((candidate) => candidate.index === attemptIndex);
+  if (
+    !attempt ||
+    !attempt.candidateContract ||
+    attempt.event.integrityAccepted !== true
+  ) {
+    throw new Error(
+      'correct-attempt-base: target must be an accepted version-2 source attempt',
+    );
+  }
+  return attempt;
+}
+
+function requireNoReview(log, attempt) {
+  const reviewed = log.slice(attempt.index + 1).some((event) =>
+    verifierReceiptCoversAttempt(event, attempt));
+  if (reviewed) {
+    throw new Error(
+      'correct-attempt-base: an exact verifier receipt already covers the attempt',
+    );
+  }
+}
+
+function requireRejectionBase(log, attempt, targetBase) {
+  const rejection = latestCandidateRejection(log, attempt);
+  if (!rejection || rejection.receipt.baseCommit !== targetBase) {
+    throw new Error(
+      'correct-attempt-base: target must equal the standing earlier ' +
+        'candidate-rejection base on the same frontier',
+    );
+  }
+}
+
+function requireRecordedBase(root, attempt, targetBase) {
+  const recordedBase = attempt.event.workspaceBaseCommit;
+  const usable = [
+    COMMIT_PATTERN.test(String(recordedBase || '')),
+    baseCommitReachable(root, recordedBase),
+    recordedBase !== targetBase,
+  ].every(Boolean);
+  if (!usable) {
+    throw new Error(
+      'correct-attempt-base: recorded base must be a different reachable commit',
+    );
+  }
+  return recordedBase;
+}
+
+export function runAttemptBaseCorrectionCommand(root, args = {}) {
+  const id = args.id || args._?.[0];
+  if (!id) throw new Error('correct-attempt-base: --id is required');
+  const attemptIndex = Number(args['attempt-index']);
+  if (!Number.isInteger(attemptIndex) || attemptIndex < 0) {
+    throw new Error(
+      'correct-attempt-base: --attempt-index must be a non-negative integer',
+    );
+  }
+  const targetBase = requireText(args, 'to-base');
+  const reason = requireText(args, 'reason');
+  if (!COMMIT_PATTERN.test(targetBase) ||
+      !baseCommitReachable(root, targetBase)) {
+    throw new Error(
+      'correct-attempt-base: --to-base must name a reachable Git commit',
+    );
+  }
+
+  const quest = loadQuest(root, id);
+  const log = readLog(root, id);
+  const attempt = requireCorrectableAttempt(root, quest, log, attemptIndex);
+  requireNoReview(log, attempt);
+  requireRejectionBase(log, attempt, targetBase);
+  const recordedBase = requireRecordedBase(root, attempt, targetBase);
+  const recordedBaseFingerprint = requireMatchingDelta(
+    root,
+    recordedBase,
+    attempt,
+    'recorded-base',
+  );
+  const targetBaseFingerprint = requireMatchingDelta(
+    root,
+    targetBase,
+    attempt,
+    'target-base',
+  );
+  const paths = [...attempt.inspection.changedPaths].sort();
+  const stamped = appendEvent(root, id, {
+    type: EVENT_ATTEMPT_BASE_CORRECTED,
+    attemptIndex,
+    frontier: attempt.event.frontier,
+    fromBase: recordedBase,
+    toBase: targetBase,
+    fingerprint: attempt.fingerprint,
+    paths,
+    reason,
+    proof: {
+      changeRefFingerprint: attempt.fingerprint,
+      recordedBaseFingerprint,
+      targetBaseFingerprint,
+    },
+  });
+  return `corrected attempt ${attemptIndex} base ${recordedBase} -> ` +
+    `${targetBase} at ${stamped.ts}`;
+}
