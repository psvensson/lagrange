diff --git a/scripts/solve/attempt-base-correction-projection.js b/scripts/solve/attempt-base-correction-projection.js
new file mode 100644
index 0000000000000000000000000000000000000000..0462286734ee126dd006864480bc980500a7e7ac
--- /dev/null
+++ b/scripts/solve/attempt-base-correction-projection.js
@@ -0,0 +1,115 @@
+export const EVENT_ATTEMPT_BASE_CORRECTED = 'attempt-base-corrected';
+
+const COMMIT_PATTERN = /^[0-9a-f]{40}$/u;
+const FINGERPRINT_PATTERN = /^sha256:[0-9a-f]{64}$/u;
+const EVENT_KEYS = Object.freeze([
+  'attemptIndex',
+  'fingerprint',
+  'fromBase',
+  'frontier',
+  'paths',
+  'proof',
+  'reason',
+  'toBase',
+  'ts',
+  'type',
+]);
+const PROOF_KEYS = Object.freeze([
+  'changeRefFingerprint',
+  'recordedBaseFingerprint',
+  'targetBaseFingerprint',
+]);
+
+function exactKeys(value, expected) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const keys = Reflect.ownKeys(value);
+  return keys.length === expected.length &&
+    expected.every((key) => Object.hasOwn(value, key));
+}
+
+function exactStringArray(value, expected) {
+  return Array.isArray(value) &&
+    value.length === expected.length &&
+    value.every((entry, index) =>
+      typeof entry === 'string' && entry === expected[index]);
+}
+
+function nonEmptyString(value) {
+  return typeof value === 'string' && value.trim().length > 0;
+}
+
+function correctionBindingIsExact(correction, attempt, paths) {
+  return [
+    correction.type === EVENT_ATTEMPT_BASE_CORRECTED,
+    Number.isInteger(correction.attemptIndex),
+    correction.attemptIndex === attempt.index,
+    correction.frontier === attempt.event.frontier,
+    correction.fromBase === attempt.event.workspaceBaseCommit,
+    COMMIT_PATTERN.test(String(correction.fromBase || '')),
+    COMMIT_PATTERN.test(String(correction.toBase || '')),
+    correction.fromBase !== correction.toBase,
+    correction.fingerprint === attempt.fingerprint,
+    FINGERPRINT_PATTERN.test(String(correction.fingerprint || '')),
+    exactStringArray(correction.paths, paths),
+    nonEmptyString(correction.reason),
+    nonEmptyString(correction.ts),
+    exactKeys(correction.proof, PROOF_KEYS),
+    correction.proof?.changeRefFingerprint === attempt.fingerprint,
+    correction.proof?.recordedBaseFingerprint === attempt.fingerprint,
+    correction.proof?.targetBaseFingerprint === attempt.fingerprint,
+  ].every(Boolean);
+}
+
+function correctionShapeProblem(correction, attempt) {
+  const paths = [...attempt.inspection.changedPaths].sort();
+  if (!exactKeys(correction, EVENT_KEYS)) {
+    return 'attempt base correction has an inexact event shape';
+  }
+  if (!correctionBindingIsExact(correction, attempt, paths)) {
+    return 'attempt base correction does not bind the exact recorded attempt';
+  }
+  return null;
+}
+
+export function projectAttemptBaseCorrections(attempts, log) {
+  const byIndex = new Map(attempts.map((attempt) => [attempt.index, attempt]));
+  const corrections = new Map();
+  const problems = [];
+  for (const [eventIndex, event] of log.entries()) {
+    if (event.type !== EVENT_ATTEMPT_BASE_CORRECTED) continue;
+    const attempt = byIndex.get(event.attemptIndex);
+    if (!attempt || eventIndex <= event.attemptIndex) {
+      problems.push('attempt base correction names no earlier source attempt');
+      continue;
+    }
+    if (corrections.has(event.attemptIndex)) {
+      problems.push(
+        `attempt ${event.attemptIndex} has more than one base correction`,
+      );
+      continue;
+    }
+    const problem = correctionShapeProblem(event, attempt);
+    if (problem) {
+      problems.push(`attempt ${event.attemptIndex}: ${problem}`);
+      continue;
+    }
+    corrections.set(event.attemptIndex, event);
+  }
+  return {
+    attempts: attempts.map((attempt) => {
+      const correction = corrections.get(attempt.index);
+      if (!correction) return attempt;
+      return {
+        ...attempt,
+        event: {
+          ...attempt.event,
+          baseCorrection: correction,
+          recordedWorkspaceBaseCommit:
+            attempt.event.workspaceBaseCommit,
+          workspaceBaseCommit: correction.toBase,
+        },
+      };
+    }),
+    problems,
+  };
+}
