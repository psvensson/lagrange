+{
+  "id": "solver-candidate-rejection-base-correction",
+  "authoringContractVersion": 1,
+  "verificationContractVersion": 2,
+  "statement": "Solver pins replacement steps for a version-2 candidate rejection to that rejection's common base, and an accepted but not-yet-verified attempt whose recorded base was procedurally wrong may receive one append-only base correction only when the exact change artifact and canonical current delta are byte-identical at both reachable bases, the target is the standing rejected-candidate base, no review covers the mistaken attempt, and every projection preserves the original event while using the validated effective base; drift, path changes, content changes, arbitrary bases, repeated correction, or post-review correction fail closed.",
+  "priority": 1,
+  "class": "process",
+  "links": {
+    "roadmapRow": null,
+    "specRef": null,
+    "closesCL": [],
+    "parentQuest": null,
+    "planDoc": "docs/steering/workflow-guidelines/solver-quests.md",
+    "draftedAtCommit": "3320683e05dcc23f0d1b6d39cf8f5762e7e60038"
+  },
+  "doneWhen": {
+    "probe": "scenario-harness",
+    "args": {
+      "scenario": "solver-candidate-rejection-base-correction",
+      "consecutive": 3,
+      "metric": "priority"
+    }
+  },
+  "frontiers": [
+    {
+      "id": "solver-candidate-rejection-base-correction-main",
+      "priority": 1,
+      "metric": {
+        "probe": "scenario-harness",
+        "args": {
+          "scenario": "solver-candidate-rejection-base-correction",
+          "metric": "priority"
+        }
+      }
+    }
+  ],
+  "constraints": [
+    {
+      "id": "source-change-subagent-verification",
+      "statement": "If this Quest changes source code, spawn a subagent verifier before audit and git handoff, then record a Solver finding with evidence subagent:<id>."
+    },
+    {
+      "id": "append-only-correction",
+      "statement": "Never rewrite or delete an attempt or finding. Record one typed correction event that retains the original base and names the effective base used by every verification, preflight, audit, handoff, and scope projection."
+    },
+    {
+      "id": "proof-checked-equivalence",
+      "statement": "Accept a correction only for a version-2 source attempt when the recorded and target commits both resolve, the target is the standing candidate-rejection base on the same frontier, the exact path union is unchanged, and the sealed change artifact plus canonical current deltas at both bases have the same fingerprint."
+    },
+    {
+      "id": "review-fence",
+      "statement": "Refuse correction after any exact verifier receipt covers the attempt fingerprint or attempt range, refuse a second correction, and refuse missing, malformed, drifted, path-changing, content-changing, arbitrary-base, or cross-frontier requests."
+    },
