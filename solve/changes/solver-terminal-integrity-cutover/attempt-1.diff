+  "statement": "Solver terminal events are emitted only from accepted measured evidence; honest non-measurements use a dedicated bounded event and cannot progress or solve; unresolved version-2 integrity violations and unverifiable legacy accepted-after-violation histories fail audit; terminal report and next projections omit active blocker and continuation sections.",
+  "priority": 1,
+  "class": "process",
+  "links": {
+    "roadmapRow": null,
+    "specRef": "solve/specs/owner-boundary-hardening-and-unification/implementation-plan.md#W1",
