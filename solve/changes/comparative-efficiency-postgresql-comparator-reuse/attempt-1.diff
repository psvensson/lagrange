+  LIFECYCLE_RETRY_EXHAUSTED:
+    'authenticated lifecycle retry loop exhausted',
+  OWNER_VISIBILITY_FAILURE: 'did not become owner-visible',
+  POSTGRESQL_PROTOCOL: 'postgresql',
+  SERVICE_ID: 'service_id',
+  SQL_LITERAL_TEXT_REQUIRED: 'SQL literal value must be text',
+  SQL_INGRESS_NOT_READY:
+    'authenticated PostgreSQL ingress did not become ready',
+  UPDATE_RUNTIME_DEFINITION:
+    'UPDATE service_definitions SET replica_count = 1, ',
+  X_LAGRANGE_CELL: 'x-lagrange-cell',
+});
+
+export const MOVIELENS_MEASURED_P0_DISTRIBUTED_INGRESS_POLICY =
+  objectFreeze({
+    version: POLICY_VERSION,
+    environmentProvisioning: objectFreeze({
+      attemptLimit: ENVIRONMENT_PROVISIONING_ATTEMPT_LIMIT,
+      failedAttemptEvidence: FAILED_ATTEMPT_EVIDENCE,
+      measuredBlockRetry: MEASURED_BLOCK_RETRY,
+      retryDelayMs: ENVIRONMENT_PROVISIONING_RETRY_DELAY_MS,
+      retryPolicy: SETUP_RETRY_POLICY,
+    }),
+    controlPlaneAdmission: objectFreeze({
+      criticalSystemRequiredDistinctNodeCount:
+        CONTROL_PLANE_TARGET_VOTER_COUNT,
+      ignoreStaleInFlightReplicaOperations: true,
+      maximumInFlightReplicaOperations: 0,
+      noProgressTimeoutMs: CONTROL_PLANE_NO_PROGRESS_TIMEOUT_MS,
+      requireCriticalSystemSpread: true,
+      stableWindowMs: CONTROL_PLANE_STABLE_WINDOW_MS,
+      targetVoterCount: CONTROL_PLANE_TARGET_VOTER_COUNT,
+      timeoutMs: CONTROL_PLANE_QUIESCENCE_TIMEOUT_MS,
+    }),
+    requestCell: objectFreeze({
+      deadlineMs: MOVIELENS_MEASURED_P0_OPERATION_TIMEOUT_MS,
+      deadlineSource: SEALED_CAPACITY_OPERATION_TIMEOUT,
+      distinctNodeCount:
+        MOVIELENS_MEASURED_P0_REQUEST_CELL_TARGET_REPLICA_COUNT,
+      postBindingQuiescenceRequired: true,
+      stableWindowMs: CONTROL_PLANE_STABLE_WINDOW_MS,
+      targetReplicaCount:
+        MOVIELENS_MEASURED_P0_REQUEST_CELL_TARGET_REPLICA_COUNT,
+    }),
+    lifecycle: objectFreeze({
+      ingress: AUTHENTICATED_POSTGRESQL,
+      retryDelayMs: LIFECYCLE_RETRY_DELAY_MS,
+      retryLimit: LIFECYCLE_RETRY_LIMIT,
+      retryOwnerCodes:
+        MOVIELENS_MEASURED_P0_LIFECYCLE_RETRY_OWNER_CODES,
+    }),
+    measured: objectFreeze({
+      ingress: AUTHENTICATED_HTTP_REQUEST_BINDING,
+      retry: NO_RETRY,
+    }),
+    operatorRuntimeActivation: objectFreeze({
+      authMode: PASSWORD_AUTH_MODE,
+      reconcileIntervalMs: PGWIRE_ACTIVATION_RECONCILE_INTERVAL_MS,
+      replicaCount: 1,
+      tls: EPHEMERAL_BRIDGE_TLS_POLICY,
+      timeoutMs: REQUEST_READY_TIMEOUT_MS,
+    }),
+    observerAndBootstrap: objectFreeze({
+      ingress: CLUSTER_ADMIN_INGRESS,
+      measurementEligibility: OBSERVER_MEASUREMENT_ELIGIBILITY,
+    }),
+  });
+
+function fail(reason) {
+  throw new Error(`MovieLens measured P0 ingress failed: ${reason}`);
+}
+
+function delayMilliseconds(durationMs) {
+  return new Promise((resolve) => setTimeout(resolve, durationMs));
+}
+
+class MovielensMeasuredP0LifecycleAttemptOwner {
+  constructor(sqlClient, onTransient, evidence) {
+    this.sqlClient = sqlClient;
+    this.onTransient = onTransient;
+    this.evidence = evidence;
+  }
+
+  async execute(statement, parameters, attempt = 1) {
+    try {
+      return await this.sqlClient.query({
+        text: statement,
+        values: parameters,
+      });
+    } catch (error) {
+      if (
+        attempt >= LIFECYCLE_RETRY_LIMIT ||
+        !isMovielensMeasuredP0RetryableLifecycleError(error)
+      ) {
+        throw error;
+      }
+      arrayPush(this.evidence, objectFreeze({
+        attempt,
+        detail: error.detail,
+        statement,
+      }));
+      await delayMilliseconds(LIFECYCLE_RETRY_DELAY_MS);
+      await this.onTransient();
+      return this.execute(statement, parameters, attempt + 1);
+    }
+  }
+}
+
+function basicAuthorization() {
+  return `Basic ${bufferFrom(
+    `${EXAMPLE_NODE.USER}:${EXAMPLE_NODE.PASSWORD}`,
+    UTF8,
+  ).toString(BASE64)}`;
+}
+
+function requestUrl(node, definition) {
+  return `http://${node.ip}:${PORTS.REST}${definition.PATH}`;
+}
+
+function sqlStringLiteral(value) {
+  if (typeof value !== 'string') fail(localText.SQL_LITERAL_TEXT_REQUIRED);
+  return `'${stringReplace(value, SINGLE_QUOTE, ESCAPED_SQL_QUOTE)}'`;
+}
+
+async function responseBody(response) {
+  const text = await response.text();
+  const contentType = response.headers.get('content-type') || '';
+  return stringIncludes(contentType, REQUEST_CONTENT_TYPE) ?
+    jsonParse(text) :
+    text;
+}
+
+function usesAuthenticatedLifecycleIngress(statement) {
+  return statement === localText.INSTALL_SERVICE ||
+    statement === localText.CREATE_BINDING ||
+    statement === localText.CONFIGURE_SERVICE_ACCESS;
+}
+
+export function createMovielensMeasuredP0DistributedPorts(
+  cluster,
+  node,
+  sqlClient,
+) {
+  let bindingDigest = null;
+  let bindingVersionId = null;
+  let installedPackageId = null;
+  let lifecycleAdmissionState =
+    objectFreeze({state: LIFECYCLE_ADMISSION_IDLE});
+  let lifecycleAdmissionPromiseState =
+    objectFreeze({state: LIFECYCLE_ADMISSION_IDLE});
+  const attemptEvidence = [];
+  let serviceId = null;
+  let requestCellTopologyAdmission = UNRESOLVED_REQUEST_CELL_ADMISSION;
+
+  async function refreshBindingIdentity() {
+    const definitions = await node.query(
+      'SELECT service_id, binding_version_id, binding_digest, status ' +
+        'FROM service_definitions',
+    );
+    const rows = definitions.rows || [];
+    for (let index = 0; index < rows.length; index += 1) {
+      const actual = rows[index];
+      if (
+        actual.status === localText.ACTIVE &&
+        typeof actual[localText.BINDING_VERSION_ID] === 'string' &&
+        actual[localText.BINDING_VERSION_ID] === bindingVersionId &&
+        typeof actual[localText.BINDING_DIGEST] === 'string' &&
+        typeof actual[localText.SERVICE_ID] === 'string'
+      ) {
+        bindingVersionId = actual[localText.BINDING_VERSION_ID];
+        bindingDigest = actual[localText.BINDING_DIGEST];
+        serviceId = actual[localText.SERVICE_ID];
+        return true;
+      }
+    }
+    return false;
+  }
+
+  async function refreshBindingRecord() {
+    const bindings = await node.query(
+      'SELECT binding_version_id, binding_digest, package_id ' +
+        'FROM service_bindings',
+    );
+    const rows = bindings.rows || [];
+    for (let index = 0; index < rows.length; index += 1) {
+      const actual = rows[index];
+      if (
+        actual.package_id === installedPackageId &&
+        typeof actual[localText.BINDING_VERSION_ID] === 'string' &&
+        typeof actual[localText.BINDING_DIGEST] === 'string'
+      ) {
+        bindingVersionId = actual[localText.BINDING_VERSION_ID];
+        bindingDigest = actual[localText.BINDING_DIGEST];
+        return true;
+      }
+    }
+    return false;
+  }
+
+  async function refreshInstalledPackage() {
+    const packages = await node.query(
+      'SELECT package_id FROM service_packages',
+    );
+    const rows = packages.rows || [];
+    for (let index = 0; index < rows.length; index += 1) {
+      if (rows[index].package_id === installedPackageId) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  async function waitForOwnerVisibility(refresh, description) {
+    const deadline = Date.now() + REQUEST_READY_TIMEOUT_MS;
+    while (Date.now() < deadline) {
+      if (await refresh()) return;
+      await new Promise((resolve) => setTimeout(
+        resolve,
+        REQUEST_READY_POLL_MS,
+      ));
+    }
+    fail(`${description} did not become owner-visible`);
+  }
+
+  function ensureLifecycleAdmission() {
+    if (
+      lifecycleAdmissionPromiseState.state ===
+        LIFECYCLE_ADMISSION_IDLE
+    ) {
+      const promise = admitMovielensMeasuredP0DistributedCluster(
+        cluster,
+      ).then((admission) => {
+        lifecycleAdmissionState =
+          objectFreeze({
+            state: LIFECYCLE_ADMISSION_RESOLVED,
+            receipt: admission,
+          });
+        return admission;
+      });
+      lifecycleAdmissionPromiseState =
+        objectFreeze({state: LIFECYCLE_ADMISSION_PENDING, promise});
+    }
+    return lifecycleAdmissionPromiseState.promise;
+  }
+
+  const lifecycleAttemptOwner =
+    new MovielensMeasuredP0LifecycleAttemptOwner(
+      sqlClient,
+      async () => {
+        lifecycleAdmissionPromiseState =
+          objectFreeze({state: LIFECYCLE_ADMISSION_IDLE});
+        await ensureLifecycleAdmission();
+      },
+      attemptEvidence,
+    );
+
+  async function executeSql(statement, parameters = []) {
+    const authenticatedLifecycle =
+      usesAuthenticatedLifecycleIngress(statement);
+    if (authenticatedLifecycle) {
+      await ensureLifecycleAdmission();
+    }
+    const result = authenticatedLifecycle ?
+      await lifecycleAttemptOwner.execute(statement, parameters) :
+      await node.query(statement, parameters);
+    const row = result.rows?.[0] || null;
+    if (statement === localText.INSTALL_SERVICE && row !== null) {
+      installedPackageId = row.package_id;
+      await waitForOwnerVisibility(
+        refreshInstalledPackage,
+        localText.INSTALLED_PACKAGE_DESCRIPTION,
+      );
+    }
+    if (statement === localText.CREATE_BINDING) {
+      if (row !== null) {
+        bindingVersionId = row[localText.BINDING_VERSION_ID];
+        bindingDigest = row[localText.BINDING_DIGEST];
+      }
+      await waitForOwnerVisibility(
+        refreshBindingRecord,
+        localText.BINDING_DESCRIPTION,
+      );
+    }
+    if (statement === localText.CONFIGURE_SERVICE_ACCESS) {
+      if (row !== null) {
+        serviceId = row[localText.SERVICE_ID];
+      }
+      await waitForOwnerVisibility(
+        refreshBindingIdentity,
+        localText.COMPILED_DEFINITION_DESCRIPTION,
+      );
+    }
+    return {...result, success: true};
+  }
+
+  function hasResolvedBindingIdentity() {
+    return typeof bindingVersionId === 'string' &&
+      typeof bindingDigest === 'string' &&
+      typeof serviceId === 'string';
+  }
+
+  async function readRuntimeServiceTopology() {
+    const services = await node.query(
+      'SELECT service_id, service_type, node_id, status ' +
+        'FROM services',
+    );
+    const operations = await node.query(
+      'SELECT operation_id, entity_id, type, status, workflow_step ' +
+        'FROM replica_operations',
+    );
+    const serviceRows = services.rows || [];
+    const operationRows = operations.rows || [];
+    return {
+      operationRows,
+      serviceRows,
+      topology: inspectMovielensMeasuredP0BindingCellTopology(
+        serviceRows,
+        serviceId,
+        operationRows,
+      ),
+    };
+  }
+
+  function readyCellRoute(definition, ready) {
+    return objectFreeze({
+      bindingDigest,
+      bindingVersionId,
+      method: definition.METHOD,
+      nodeId: ready.routeTarget.value.node_id,
+      path: definition.PATH,
+      replicaId: ready.routeTarget.value[localText.SERVICE_ID],
+      serviceId,
+      tenantId: EXAMPLE_NODE.DATABASE,
+    });
+  }
+
+  async function waitForReadyCell(definition, signal = null) {
+    const admitted =
+      await waitForMovielensMeasuredP0RequestCellAdmission({
+        admitCluster() {
+          return admitMovielensMeasuredP0DistributedCluster(cluster);
+        },
+        clock: dateNow,
+        delay: delayMilliseconds,
+        async observeTopology() {
+          if (!hasResolvedBindingIdentity()) {
+            await refreshBindingRecord();
+            await refreshBindingIdentity();
+          }
+          return readRuntimeServiceTopology();
+        },
+        pollIntervalMs: REQUEST_READY_POLL_MS,
+        priorAdmission: requestCellTopologyAdmission,
+        signal,
+        stableWindowMs: CONTROL_PLANE_STABLE_WINDOW_MS,
+        timeoutMs: REQUEST_READY_TIMEOUT_MS,
+      });
+    requestCellTopologyAdmission = admitted.admission;
+    return readyCellRoute(definition, admitted.topology);
+  }
+
+  return objectFreeze({
+    authenticatedPrincipal() {
+      return EXAMPLE_NODE.USER;
+    },
+    lifecycleAdmission() {
+      return lifecycleAdmissionState;
+    },
+    lifecycleRetries() {
+      return objectFreeze([...attemptEvidence]);
+    },
+    requestCellTopologyAdmission() {
+      return requestCellTopologyAdmission;
+    },
+    cellWitness() {
+      fail(localText.CELL_WITNESS_FORBIDDEN);
+    },
+    executeSql,
+    async invokeRequest(definition, invocation, signal = null) {
+      const route = await waitForReadyCell(definition, signal);
+      const requestWitness =
+        preregisterRequestWitness(definition, invocation, route);
+      const response = await fetch(requestUrl(node, definition), {
+        body: jsonStringify(invocation.body),
+        headers: {
+          'accept': REQUEST_ACCEPT,
+          'authorization': basicAuthorization(),
+          'content-type': REQUEST_CONTENT_TYPE,
+          'idempotency-key': invocation.idempotencyKey,
+        },
+        method: definition.METHOD,
+        signal,
+      });
+      return objectFreeze({
+        body: await responseBody(response),
+        headers: objectFreeze({
+          'x-lagrange-cell':
+            response.headers.get(localText.X_LAGRANGE_CELL),
+        }),
+        requestWitness,
+        status: response.status,
+      });
+    },
+    async probeUnauthenticated(definition, body) {
+      const response = await fetch(requestUrl(node, definition), {
+        body: jsonStringify(body),
+        headers: {'content-type': REQUEST_CONTENT_TYPE},
+        method: definition.METHOD,
+      });
+      const parsed = await responseBody(response);
+      if (response.status !== HTTP_STATUS_UNAUTHORIZED) {
+        fail(`unauthenticated request status ${response.status}`);
+      }
+      return objectFreeze({body: parsed, status: response.status});
+    },
+    async readInvocationJournal(idempotencyKey) {
+      const invocationIdentity = createInvocationIdentity(
+        EXAMPLE_NODE.DATABASE,
+        idempotencyKey,
+      );
+      const result = await node.query(
+        'SELECT operation_id, tenant_id, idempotency_key, command, ' +
+          'state, result, error, created_at, updated_at ' +
+          'FROM wasm_operations WHERE tenant_id = ' +
+          `${sqlStringLiteral(EXAMPLE_NODE.DATABASE)} ` +
+          'AND idempotency_key = ' +
+          sqlStringLiteral(invocationIdentity),
+      );
+      return result.rows || [];
+    },
+    waitForReadyCell,
+  });
+}
+
+export async function openMovielensMeasuredP0AuthenticatedSqlIngress(cluster) {
+  const nodes = cluster.getNodes();
+  const seed = nodes[0];
+  const runtimeConfig = jsonStringify({
+    authMode: 'password',
+    host: '0.0.0.0',
+    port: PGWIRE_PORT,
+    tlsMode: 'disable',
+  });
+
+  const deadline = Date.now() + REQUEST_READY_TIMEOUT_MS;
+  let activationAttempts = 0;
+  let lastRows = [];
+  let nextActivationAtMs = 0;
+  while (Date.now() < deadline) {
+    const nowMs = Date.now();
+    if (nowMs >= nextActivationAtMs) {
+      await seed.query(
+        localText.UPDATE_RUNTIME_DEFINITION +
+          `runtime_config = '${runtimeConfig}', updated_at = ${nowMs} ` +
+          `WHERE service_id = '${META_SERVICE_ID.POSTGRES_WIRE}'`,
+      );
+      activationAttempts += 1;
+      nextActivationAtMs =
+        nowMs + PGWIRE_ACTIVATION_RECONCILE_INTERVAL_MS;
+    }
+    const result = await seed.query(
+      'SELECT service_id, node_id, status FROM services',
+    );
+    lastRows = result.rows || [];
+    for (let index = 0; index < lastRows.length; index += 1) {
+      const actual = lastRows[index];
+      if (
+        actual.status === localText.ACTIVE &&
+        runtimeServiceReplicaBelongsToEntity(
+          actual[localText.SERVICE_ID],
+          META_SERVICE_ID.POSTGRES_WIRE,
+        )
+      ) {
+        const target =
+          arrayFind(nodes, (node) => node.id === actual.node_id);
+        if (!target) {
+          fail(`PostgreSQL ingress target node is unknown: ${actual.node_id}`);
+        }
+        const client = new Client({
+          connectionTimeoutMillis: REQUEST_READY_TIMEOUT_MS,
+          database: EXAMPLE_NODE.DATABASE,
+          host: target.ip,
+          password: EXAMPLE_NODE.PASSWORD,
+          port: PGWIRE_PORT,
+          ssl: false,
+          user: EXAMPLE_NODE.USER,
+        });
+        await client.connect();
+        return objectFreeze({
+          client,
+          nodeId: target.id,
+          port: PGWIRE_PORT,
+          protocol: localText.POSTGRESQL_PROTOCOL,
+          activationAttempts,
+          activationReconcileIntervalMs:
+            PGWIRE_ACTIVATION_RECONCILE_INTERVAL_MS,
+          serviceId: actual[localText.SERVICE_ID],
+        });
+      }
+    }
+    await new Promise((resolve) => setTimeout(
+      resolve,
+      REQUEST_READY_POLL_MS,
+    ));
+  }
+  fail(`${localText.SQL_INGRESS_NOT_READY}: ${jsonStringify(lastRows)}`);
+}
+
+export async function admitMovielensMeasuredP0DistributedCluster(cluster) {
+  const convergence = await cluster.waitForConvergence({
+    settleTimeoutMs: CONTROL_PLANE_QUIESCENCE_TIMEOUT_MS,
+    quietWindowMs: CONTROL_PLANE_STABLE_WINDOW_MS,
+    targetVoterCount: CONTROL_PLANE_TARGET_VOTER_COUNT,
+    noProgressTimeoutMs: null,
+  });
+  const quiescence = await cluster.waitForControlPlaneQuiescence({
+    timeoutMs: CONTROL_PLANE_QUIESCENCE_TIMEOUT_MS,
+    stableWindowMs: CONTROL_PLANE_STABLE_WINDOW_MS,
+    noProgressTimeoutMs: CONTROL_PLANE_NO_PROGRESS_TIMEOUT_MS,
+    maxInFlightCount: 0,
+    ignoreStaleInFlightReplicaOperations: true,
+    requireCriticalSystemSpread: true,
+    criticalSystemRequiredDistinctNodeCount:
+      CONTROL_PLANE_TARGET_VOTER_COUNT,
+  });
+  return objectFreeze({
+    convergence: objectFreeze({
+      leaderChanges: convergence.leaderChanges,
+      maxOverTargetMs: convergence.maxOverTargetMs,
+      settledAfterMs: convergence.settledAfterMs,
+    }),
+    quiescence: objectFreeze({
+      attempts: quiescence.attempts,
+      criticalSystemTopology: quiescence.criticalSystemTopology,
+      effectiveInFlightCount: quiescence.effectiveInFlightCount,
+      elapsedMs: quiescence.elapsedMs,
+      leaderQuietElapsedMs: quiescence.leaderQuietElapsedMs,
+      state: quiescence.state,
+    }),
+  });
+}
