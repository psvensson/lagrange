+    'test/distributed/harness/' +
+      'benchmark-capacity-independent-side-protocol.js',
+    'test/distributed/harness/benchmark-capacity-open-loop.js',
+    'test/distributed/harness/benchmark-capacity-preregistration.js',
+    'test/distributed/harness/benchmark-capacity-protocol.js',
+    'test/distributed/harness/benchmark-capacity-run-sample.js',
+    'test/distributed/harness/benchmark-capacity-statistics.js',
+    'test/distributed/harness/benchmark-capacity-window-receipt.js',
+    'test/distributed/harness/benchmark-capacity-reusable-comparator.js',
+    'test/distributed/harness/' +
+      'benchmark-resource-live-observation-authority.js',
+    'test/distributed/harness/benchmark-resource-evidence-data.js',
+    'test/distributed/harness/benchmark-semantic-integrity.js',
+    'test/distributed/harness/docker-provider.js',
+  ]);
