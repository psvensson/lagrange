+async function closePreflightPostgres(postgres, priorError = null) {
+  try {
+    await postgres.close();
+  } catch (cleanupError) {
+    if (priorError !== null) {
+      throw new AggregateError(
+        [priorError, cleanupError],
+        localText.CLEANUP_FAILED,
+      );
+    }
+    throw cleanupError;
+  }
+  if (priorError !== null) throw priorError;
