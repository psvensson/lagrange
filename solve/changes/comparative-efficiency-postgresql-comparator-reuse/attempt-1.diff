+  'test/distributed/harness/' +
+    'benchmark-capacity-independent-comparison.js',
+  'test/distributed/harness/benchmark-capacity-reusable-comparator.js',
+]);
+const localText = Object.freeze({
+  CAPTURE_REQUIRED: 'stored PostgreSQL comparator requires fresh capture',
+  COMPARATOR_ARGUMENT: '--comparator',
+  COMPARATOR_ARGUMENT_REQUIRED:
+    '--comparator <content-addressed bundle path> is required',
+  FAIL:
+    'comparative-efficiency-movielens-lagrange-with-comparator: FAIL\n',
+  LAGRANGE_NOT_SUFFICIENT:
+    'Lagrange independent capacity did not reach objective sufficiency',
+  FRESH_IMAGE_START: 'Lagrange-only fresh image build START\n',
+  INDEPENDENT_INTERVAL_LABEL: 'independentInterval: ',
+  REASON_SEPARATOR: ',',
+  REUSABLE_STATE: 'reusable',
+  REUSE_PASS: 'PostgreSQL comparator reuse PASS ',
+  PASS:
+    'comparative-efficiency-movielens-lagrange-with-comparator: PASS\n',
+  UTF8: 'utf8',
+  WRITE_EXCLUSIVE: 'wx',
+});
+
+function comparatorPathFromArguments(argumentsList) {
+  for (let index = 2; index < argumentsList.length; index += 1) {
+    if (
+      argumentsList[index] === localText.COMPARATOR_ARGUMENT &&
+      typeof argumentsList[index + 1] === 'string' &&
+      argumentsList[index + 1].length > 0
+    ) {
+      return resolve(argumentsList[index + 1]);
+    }
+  }
+  throw new TypeError(localText.COMPARATOR_ARGUMENT_REQUIRED);
+}
+
+async function loadComparatorBundle(artifactPath) {
+  const bundle = JSON.parse(await readFile(artifactPath, localText.UTF8));
+  const inspection =
+    inspectMovielensMeasuredP0PostgresqlComparatorBundle(bundle);
+  if (!inspection.valid) {
+    throw new TypeError(`invalid comparator bundle: ${inspection.reason}`);
+  }
+  return bundle;
+}
+
+function capacityProjection(capacity) {
+  return {
+    estimate: capacity.estimate,
+    confidenceInterval: {
+      lower: capacity.confidenceInterval.lower,
+      upper: capacity.confidenceInterval.upper,
+    },
+    completedBlocks: capacity.completedBlocks,
+  };
+}
+
+function calibrationEvidence(windowEvidence) {
+  const calibrations = [];
+  for (let index = 0; index < windowEvidence.length; index += 1) {
+    const calibration = windowEvidence[index].calibration;
+    calibrations.push({
+      digest: calibration.digest,
+      byteLength: calibration.byteLength,
+      artifact: calibration.artifact,
+    });
+  }
+  return calibrations;
+}
+
+async function persistIterationBundle(body) {
+  const bundle = {
+    ...body,
+    bundleDigest: digestBenchmarkSemanticData(body),
+  };
+  await mkdir(OUTPUT_DIRECTORY, {recursive: true});
+  const name =
+    bundle.bundleDigest.slice('sha256:'.length);
+  const artifactPath = resolve(OUTPUT_DIRECTORY, `${name}.json`);
+  await writeFile(
+    artifactPath,
+    `${JSON.stringify(bundle)}\n`,
+    {
+      encoding: localText.UTF8,
+      flag: localText.WRITE_EXCLUSIVE,
+    },
+  );
+  return artifactPath;
+}
+
+async function executeLagrange({
+  plan,
+  provenance,
+  image,
+}) {
+  const environment =
+    await openMovielensMeasuredP0LagrangeEnvironment({
+      runId: plan.runId,
+      sideId: LAGRANGE_SIDE_ID,
+      dataset: plan.dataset,
+      replicationFactor: plan.cell.replicationFactor,
+      image: image.imageId,
+      expectedSeal: plan.seal,
+    });
+  const captured = [];
+  const admitted =
+    await executeAfterComparatorSetupAdmission({
+      environment,
+      async execute(setupDiscriminator) {
+        const protocol =
+          await runBenchmarkCapacityHeterogeneousSideProtocol({
+            preregistration: plan.capacityPreregistration,
+            adapter: environment.adapters[0],
+            sideId: LAGRANGE_SIDE_ID,
+            ...createComparatorResourceObservationHooks({
+              blockedOrderIndex: plan.blockedOrderIndex,
+              captured,
+              environment,
+              preregistration: plan.capacityPreregistration,
+              provenance,
+              runId: plan.runId,
+            }),
+          });
+        return {protocol, setupDiscriminator};
+      },
+    });
+  const cleanupReceipt = await environment.close();
+  const windowEvidence =
+    await finalizeComparatorWindowEvidence(captured, admitted.protocol);
+  return {
+    protocol: admitted.protocol,
+    setupDiscriminator: admitted.setupDiscriminator,
+    cleanupReceipt,
+    resourceCalibrations: calibrationEvidence(windowEvidence),
+  };
+}
+
+async function main() {
+  const comparatorPath = comparatorPathFromArguments(process.argv);
+  const comparatorBundle = await loadComparatorBundle(comparatorPath);
+  const comparator = comparatorBundle.comparator;
+  const datasetDirectory = await mkdtemp(
+    path.join(os.tmpdir(), 'movielens-lagrange-comparator-'),
+  );
+  try {
+    const variants =
+      await createMovielensGroupedReduceMatrixDatasets(datasetDirectory);
+    const dataset = selectMovielensGroupedReduceMatrixDataset(
+      variants,
+      DATASET_SIZE,
+      DATASET_SKEW,
+    );
+    const provenance =
+      await collectBenchmarkResourceSourceProvenance(
+        LAGRANGE_SOURCE_PATHS,
+      );
+    const previewPlan = planMovielensMeasuredP0ComparatorCell({
+      dataset,
+      preflight: comparatorBundle.workloadSeal,
+      identity: comparator.comparatorId,
+    });
+    const measurementSourceDigest =
+      await digestMovielensMeasuredP0PostgresqlComparatorSource();
+    const hostEnvelope =
+      createMovielensMeasuredP0ComparatorHostEnvelope();
+    const reuseDecision =
+      revalidateBenchmarkCapacityReusableComparator({
+        artifact: comparator,
+        expectedCompatibility:
+          expectedMovielensMeasuredP0PostgresqlCompatibility({
+            plan: previewPlan,
+            comparator,
+            measurementSourceDigest,
+            hostEnvelope,
+          }),
+        driftWitness:
+          createMovielensMeasuredP0ComparatorDriftWitness(comparator),
+        nowMs: Date.now(),
+      });
+    if (reuseDecision.state !== localText.REUSABLE_STATE) {
+      throw new Error(
+        `${localText.CAPTURE_REQUIRED}: ` +
+        `${reuseDecision.reasons.join(localText.REASON_SEPARATOR)}`,
+      );
+    }
+    process.stdout.write(
+      localText.REUSE_PASS +
+      `digest=${comparator.artifactDigest}\n` +
+      localText.FRESH_IMAGE_START,
+    );
+    const image = await buildComparatorLagrangeImage(provenance);
+    const plan = planMovielensMeasuredP0ComparatorCell({
+      dataset,
+      preflight: comparatorBundle.workloadSeal,
+      identity: comparator.comparatorId,
+    });
+    const lagrange = await executeLagrange({plan, provenance, image});
+    if (!lagrange.protocol.report.summary.objectiveSufficiency.reusable) {
+      throw new Error(localText.LAGRANGE_NOT_SUFFICIENT);
+    }
+    const comparison = createBenchmarkCapacityIndependentComparison({
+      numeratorSideId: LAGRANGE_SIDE_ID,
+      numeratorCapacity:
+        capacityProjection(lagrange.protocol.report.summary.capacity),
+      numeratorEvidenceDigest: lagrange.protocol.report.reportDigest,
+      denominatorSideId: comparator.sideId,
+      denominatorCapacity: capacityProjection(comparator.capacity),
+      denominatorEvidenceDigest: comparator.artifactDigest,
+    });
+    const body = {
+      version: 'movielens-lagrange-comparator-iteration-bundle-v1',
+      claimEligible: false,
+      paired: false,
+      comparatorArtifactDigest: comparator.artifactDigest,
+      comparatorBundleDigest: comparatorBundle.bundleDigest,
+      reuseDecision,
+      lagrangeProtocolReport: lagrange.protocol.report,
+      lagrangeResourceCalibrations: lagrange.resourceCalibrations,
+      setupDiscriminator: lagrange.setupDiscriminator,
+      cleanupReceipt: lagrange.cleanupReceipt,
+      comparison,
+      image,
+      sourceProvenance: provenance,
+    };
+    const artifactPath = await persistIterationBundle(body);
+    process.stdout.write(
+      localText.PASS +
+      `artifact: ${artifactPath}\n` +
+      `comparisonDigest: ${comparison.comparisonDigest}\n` +
+      `lagrangeToPostgresqlCapacityRatio: ${comparison.estimate}\n` +
+      localText.INDEPENDENT_INTERVAL_LABEL +
+      `[${comparison.confidenceInterval.lower},` +
+      `${comparison.confidenceInterval.upper}]\n`,
+    );
+  } finally {
+    await rm(datasetDirectory, {recursive: true, force: true});
+  }
+}
+
+if (
+  typeof process.argv[1] === 'string' &&
+  pathToFileURL(resolve(process.argv[1])).href === import.meta.url
+) {
+  main().catch((error) => {
+    process.stderr.write(
+      localText.FAIL +
+      `${error?.stack || error}\n`,
+    );
+    process.exitCode = 1;
+  });
+}
