@@ -0,0 +1,31 @@
+const REQUEST_CELL_RUNTIME_ENV = Object.freeze({
+  DEADLINE_MS: 'REQUEST_CELL_DEADLINE_MS',
+});
+
+const REQUEST_CELL_RUNTIME_CONFIGURATION_MESSAGE = Object.freeze({
+  DEADLINE_INVALID:
+    `${REQUEST_CELL_RUNTIME_ENV.DEADLINE_MS} must be a positive integer`,
+});
+
+function resolveRequestCellDeadlineMs(options = {}) {
+  if (options.deadlineMs !== undefined) {
+    return options.deadlineMs;
+  }
+  const rawDeadlineMs =
+    options.env?.[REQUEST_CELL_RUNTIME_ENV.DEADLINE_MS];
+  if (rawDeadlineMs === undefined) {
+    return undefined;
+  }
+  const deadlineMs = Number(rawDeadlineMs);
+  if (!Number.isSafeInteger(deadlineMs) || deadlineMs <= 0) {
+    throw new TypeError(
+      REQUEST_CELL_RUNTIME_CONFIGURATION_MESSAGE.DEADLINE_INVALID,
+    );
+  }
+  return deadlineMs;
+}
+
+export {
+  REQUEST_CELL_RUNTIME_ENV,
+  resolveRequestCellDeadlineMs,
+};
