+} from
+  '../../examples/service-data-affinity/movielens-grouped-reduce-matrix-dataset.js';
+import {
+  createBenchmarkCapacityIndependentComparison,
+} from
+  '../../test/distributed/harness/benchmark-capacity-independent-comparison.js';
+import {
+  runBenchmarkCapacityHeterogeneousSideProtocol,
