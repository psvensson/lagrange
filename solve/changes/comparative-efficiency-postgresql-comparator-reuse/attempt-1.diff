+  'scripts/checks/movielens-measured-p0-comparator-live-support.js',
+  'scripts/checks/movielens-measured-p0-lagrange-iteration-support.js',
+  'scripts/checks/movielens-measured-p0-distributed-environment.js',
+  'scripts/checks/movielens-measured-p0-distributed-ingress.js',
+  'scripts/checks/movielens-measured-p0-postgresql-comparator.js',
+  'scripts/checks/movielens-measured-p0-request-cell-admission.js',
+  'scripts/checks/movielens-measured-p0-request-cell-topology.js',
+  'scripts/checks/movielens-measured-p0-setup-failure.js',
+  'scripts/checks/' +
+    'run-comparative-efficiency-movielens-lagrange-with-comparator-live.js',
+  'src/bootstrap/shared/runtime-service-rebalancer-setup.js',
+  'src/rebalancer/replica-operation-progress.js',
+  'src/rebalancer/runtime-service-replica-identity.js',
