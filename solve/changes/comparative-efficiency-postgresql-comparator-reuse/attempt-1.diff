+import {
+  hasExactOwnDataKeys,
+  ownDataValue,
+} from
+  '../../test/distributed/harness/benchmark-semantic-integrity.js';
+import {
+  DockerProvider,
+} from '../../test/distributed/harness/docker-provider.js';
+import {
+  closeComparatorEnvironmentAfterFailure,
+} from './movielens-measured-p0-comparator-live-support.js';
+
+const DOCKER_SOCKET = '/var/run/docker.sock';
+const DOCKERFILE = 'Dockerfile';
+const objectFreeze = Object.freeze;
+const ADMISSION_KEYS = objectFreeze(['receipt', 'state']);
+const localText = objectFreeze({
+  FRESH_IMAGE_ABSENT: 'fresh distributed image is absent',
+  IMAGE_TAG: 'lagrange-movielens-measured-p0:local',
+  RECEIPT_FIELD: 'receipt',
+  SETUP_ADMISSION_INVALID:
+    'Lagrange comparator setup admission did not resolve',
+  SETUP_ADMISSION_RESOLVED: 'resolved',
+  STATE_FIELD: 'state',
+});
+
+function fail(reason) {
+  throw new Error(`Lagrange comparator iteration support failed: ${reason}`);
+}
+
+export async function buildComparatorLagrangeImage(provenance) {
+  const provider = new DockerProvider({socketPath: DOCKER_SOCKET});
+  await provider.buildImage(
+    process.cwd(),
+    localText.IMAGE_TAG,
+    DOCKERFILE,
+    null,
+    {'ddb.git-hash': provenance.sourceRevision},
+  );
+  const inspection = await provider.inspectImage(localText.IMAGE_TAG);
+  if (inspection === null) fail(localText.FRESH_IMAGE_ABSENT);
+  return {
+    imageId: inspection.Id,
+    sourceRevision: provenance.sourceRevision,
+  };
+}
+
+function requireSetupAdmission(environment) {
+  const metadata = ownDataValue(environment, 'metadata');
+  const ingress = ownDataValue(metadata, 'ingress');
+  const admission = ownDataValue(
+    ingress,
+    'requestCellTopologyAdmission',
+  );
+  if (
+    !hasExactOwnDataKeys(admission, ADMISSION_KEYS) ||
+    ownDataValue(admission, localText.STATE_FIELD) !==
+      localText.SETUP_ADMISSION_RESOLVED
+  ) fail(localText.SETUP_ADMISSION_INVALID);
+  return ownDataValue(admission, localText.RECEIPT_FIELD);
+}
+
+export async function executeAfterComparatorSetupAdmission({
+  environment,
+  execute,
+}) {
+  try {
+    return await execute(requireSetupAdmission(environment));
+  } catch (error) {
+    await closeComparatorEnvironmentAfterFailure(environment, error);
+    throw error;
+  }
+}
