+      'run-comparative-efficiency-movielens-postgresql-comparator-live.js',
+    'test/distributed/harness/benchmark-capacity-cache-reset-receipt.js',
+    'test/distributed/harness/' +
+      'benchmark-capacity-heterogeneous-observation.js',
