+++ b/scripts/checks/movielens-measured-p0-distributed-environment.js
@@ -0,0 +1,900 @@
+import {createHash} from 'node:crypto';
+import {chmod, mkdir, mkdtemp, readFile, rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+
+import {
+  createMovielensLagrangeCapacityAdapter,
+  createMovielensPostgresqlCapacityAdapter,
+  movielensCapacityOperationManifest,
+  movielensCapacityOperationManifestDigest,
+  movielensCapacitySemanticOracleDigest,
+} from
+  '../../examples/service-data-affinity/movielens-capacity-runtime-adapters.js';
+import {
+  prepareMovielensPublicRequestWorkload,
+} from
+  '../../examples/service-data-affinity/movielens-public-request-workload-adapter.js';
+import {
+  MOVIELENS_PUBLIC_REQUEST,
+  buildMovielensPublicRequestComponent,
+} from
+  '../../examples/service-data-affinity/movielens-public-request-workload-contract.js';
+import {
+  loadMovielensPublicRequestDatasetVariant,
+} from
+  '../../examples/service-data-affinity/movielens-public-request-workload-dataset.js';
+import {
+  openPostgresBaselineSession,
+} from
+  '../../examples/service-data-affinity/postgres-baseline-session.js';
+import {
+  EXAMPLE_NODE,
+} from
+  '../../examples/request-binding-deployment/request-binding-example-node.js';
+import {
+  createCluster,
+} from '../../test/distributed/harness/cluster.js';
+import {
+  digestBenchmarkSemanticData,
+} from '../../test/distributed/harness/benchmark-semantic-integrity.js';
+import {
+  MOVIELENS_MEASURED_P0_SIDE_IDS,
+} from
+  '../../test/distributed/harness/comparative-efficiency-movielens-measured-p0-constants.js';
+import {
+  DOCKER_CONTAINER_WRITABLE_LAYER_STORAGE_PATH,
+  DockerProvider,
+} from '../../test/distributed/harness/docker-provider.js';
+import {
+  MOVIELENS_MEASURED_P0_DISTRIBUTED_INGRESS_POLICY,
+  admitMovielensMeasuredP0DistributedCluster,
+  createMovielensMeasuredP0DistributedPorts,
+  openMovielensMeasuredP0AuthenticatedSqlIngress,
+} from './movielens-measured-p0-distributed-ingress.js';
+import {
+  movielensMeasuredP0SetupFailureReceipt,
+} from './movielens-measured-p0-setup-failure.js';
+
+const ARTIFACT_DIRECTORY = 'oci-layouts';
+const COMPONENT_CACHE_DIRECTORY = 'installable-service-components';
+const COMPONENT_CACHE_CONTAINER_DIRECTORY =
+  '/data/installable-service-components';
+const COMPONENT_CACHE_DIRECTORY_MODE = 0o777;
+const COMPONENT_DIRECTORY = 'component';
+const DOCKER_SOCKET = '/var/run/docker.sock';
+const CLUSTER_NODE_COUNT = 7;
+const CLUSTER_NODE_STARTUP_TIMEOUT_MS = 120_000;
+const CLUSTER_CONVERGENCE_TIMEOUT_MS = 120_000;
+const CLUSTER_QUIET_WINDOW_MS = 5_000;
+const CLUSTER_SCENARIO_TIMEOUT_MS = 900_000;
+const CONTAINER_MEMORY_LIMIT = '2g';
+const CONTAINER_CPU_LIMIT = '1.0';
+const RAFT_PROVIDER = 'liferaft';
+const PREFLIGHT_REPLICATION_FACTORS = Object.freeze([1, 3]);
+const LAGRANGE_SIDE_ID = MOVIELENS_MEASURED_P0_SIDE_IDS[0];
+const POSTGRESQL_SIDE_ID = MOVIELENS_MEASURED_P0_SIDE_IDS[1];
+const ENVIRONMENT_PROVISIONING_ATTEMPT_LIMIT = 2;
+const ENVIRONMENT_PROVISIONING_RETRY_DELAY_MS = 1_000;
+const SHA256 = 'sha256';
+const HEX = 'hex';
+const arrayMap = Function.call.bind(Array.prototype.map);
+const arrayPush = Function.call.bind(Array.prototype.push);
+const objectFreeze = Object.freeze;
+const localText = objectFreeze({
+  CLEANUP_FAILED: 'measured P0 distributed environment cleanup failed',
+  DISTRIBUTED_STORAGE: DOCKER_CONTAINER_WRITABLE_LAYER_STORAGE_PATH,
+  LAGRANGE_COMPONENT_PREFIX: 'lagrange-node-',
+  NETWORK_ID: 'movielens-measured-p0-network-bundle',
+  NETWORK_NAME: 'movielens-measured-p0-network-bundle',
+  POSTGRES_COMPONENT_PREFIX: 'postgresql-node-',
+  LAGRANGE_ITERATION_PROVISIONING_MODE: 'lagrange_iteration_only',
+  PROVISIONING_RETRY_EXHAUSTED:
+    'environment provisioning retry loop exhausted',
+  SEALED_PREFLIGHT_MISMATCH:
+    'measured environment differs from its sealed preflight',
+  TEMPORARY_PREFIX: 'movielens-measured-p0-distributed-',
+});
+
+export {MOVIELENS_MEASURED_P0_DISTRIBUTED_INGRESS_POLICY};
+
+function fail(reason) {
+  throw new Error(`MovieLens measured P0 environment failed: ${reason}`);
+}
+
+function delayMilliseconds(durationMs) {
+  return new Promise((resolve) => setTimeout(resolve, durationMs));
+}
+
+function sha256(bytes) {
+  return `${SHA256}:${createHash(SHA256).update(bytes).digest(HEX)}`;
+}
+
+export function createMovielensMeasuredP0ClusterConfig({
+  image,
+  temporaryRoot,
+}) {
+  const componentCacheDirectory =
+    path.join(temporaryRoot, COMPONENT_CACHE_DIRECTORY);
+  return {
+    size: CLUSTER_NODE_COUNT,
+    docker: {
+      socketPath: DOCKER_SOCKET,
+      binds: [
+        `${temporaryRoot}:${temporaryRoot}:ro`,
+        `${componentCacheDirectory}:` +
+          COMPONENT_CACHE_CONTAINER_DIRECTORY,
+      ],
+    },
+    image,
+    timeouts: {
+      nodeStartup: CLUSTER_NODE_STARTUP_TIMEOUT_MS,
+      convergence: CLUSTER_CONVERGENCE_TIMEOUT_MS,
+      quietWindow: CLUSTER_QUIET_WINDOW_MS,
+      scenarioDefault: CLUSTER_SCENARIO_TIMEOUT_MS,
+    },
+    resourceLimits: {
+      memory: CONTAINER_MEMORY_LIMIT,
+      cpus: CONTAINER_CPU_LIMIT,
+    },
+    requestCellCredentials: {
+      database: EXAMPLE_NODE.DATABASE,
+      password: EXAMPLE_NODE.PASSWORD,
+      user: EXAMPLE_NODE.USER,
+    },
+    requestCellDeadlineMs:
+      MOVIELENS_MEASURED_P0_DISTRIBUTED_INGRESS_POLICY
+        .requestCell.deadlineMs,
+    raftProvider: RAFT_PROVIDER,
+    memoryLeak: {
+      enabled: false,
+      failOnDetection: false,
+      requireSamples: false,
+    },
+  };
+}
+
+async function prepareSharedComponentCache(temporaryRoot) {
+  const directory = path.join(
+    temporaryRoot,
+    COMPONENT_CACHE_DIRECTORY,
+  );
+  await mkdir(directory, {
+    recursive: true,
+    mode: COMPONENT_CACHE_DIRECTORY_MODE,
+  });
+  await chmod(directory, COMPONENT_CACHE_DIRECTORY_MODE);
+}
+
+async function openMovielensMeasuredP0Cluster({
+  image,
+  temporaryRoot,
+}) {
+  await prepareSharedComponentCache(temporaryRoot);
+  const cluster = createCluster(createMovielensMeasuredP0ClusterConfig({
+    image,
+    temporaryRoot,
+  }));
+  await cluster.start();
+  return cluster;
+}
+
+function compositeProvider(provider, networkNames) {
+  return objectFreeze({
+    getContainerResourceSnapshot(containerId, storagePath) {
+      return provider.getContainerResourceSnapshot(containerId, storagePath);
+    },
+    inspectContainer(containerId) {
+      return provider.inspectContainer(containerId);
+    },
+    inspectContainerIfExists(containerId) {
+      return provider.inspectContainerIfExists(containerId);
+    },
+    async getNetworkByName(networkName) {
+      if (networkName !== localText.NETWORK_NAME) {
+        return provider.getNetworkByName(networkName);
+      }
+      for (let index = 0; index < networkNames.length; index += 1) {
+        const network = await provider.getNetworkByName(networkNames[index]);
+        if (network !== null) {
+          return {id: localText.NETWORK_ID};
+        }
+      }
+      return null;
+    },
+  });
+}
+
+function resourceComponents(cluster, postgres) {
+  const components = [];
+  const nodes = cluster.getNodes();
+  for (let index = 0; index < nodes.length; index += 1) {
+    arrayPush(components, {
+      sideId: LAGRANGE_SIDE_ID,
+      componentId: `${localText.LAGRANGE_COMPONENT_PREFIX}${index + 1}`,
+      containerId: nodes[index].containerId,
+      storagePath: localText.DISTRIBUTED_STORAGE,
+    });
+  }
+  for (let index = 0; index < postgres.containers.length; index += 1) {
+    arrayPush(components, {
+      sideId: POSTGRESQL_SIDE_ID,
+      componentId: `${localText.POSTGRES_COMPONENT_PREFIX}${index + 1}`,
+      containerId: postgres.containers[index].containerId,
+      storagePath: localText.DISTRIBUTED_STORAGE,
+    });
+  }
+  return components;
+}
+
+function lagrangeResourceComponents(cluster) {
+  const components = [];
+  const nodes = cluster.getNodes();
+  for (let index = 0; index < nodes.length; index += 1) {
+    arrayPush(components, {
+      sideId: LAGRANGE_SIDE_ID,
+      componentId: `${localText.LAGRANGE_COMPONENT_PREFIX}${index + 1}`,
+      containerId: nodes[index].containerId,
+      storagePath: localText.DISTRIBUTED_STORAGE,
+    });
+  }
+  return components;
+}
+
+async function buildArtifact(temporaryRoot, dataset) {
+  const componentDirectory = path.join(
+    temporaryRoot,
+    COMPONENT_DIRECTORY,
+  );
+  const componentPath = path.join(
+    componentDirectory,
+    MOVIELENS_PUBLIC_REQUEST.COMPONENT_FILE,
+  );
+  await mkdir(componentDirectory, {recursive: true});
+  const artifactReceipt =
+    await buildMovielensPublicRequestComponent({
+      componentPath,
+      componentSourcePath: dataset.componentSourcePath,
+      ociOutputRoot: path.join(temporaryRoot, ARTIFACT_DIRECTORY),
+    });
+  const executableBytes = await readFile(componentPath);
+  return {
+    artifactReceipt,
+    artifact: objectFreeze({
+      buildInputFingerprint: artifactReceipt.buildInputFingerprint,
+      componentSourceDigest: dataset.componentSourceDigest,
+      executableDigest: sha256(executableBytes),
+      ociManifestDigest: artifactReceipt.topManifestDescriptor.digest,
+    }),
+  };
+}
+
+function postgresSeal(postgres) {
+  return {
+    imageId: postgres.imageId,
+    imageInspection: postgres.imageInspection,
+    postgresVersion: postgres.postgresVersion,
+    postgresVersionSql: postgres.postgresVersionSql,
+    queryPlan: postgres.queryPlan,
+    querySql: postgres.querySql,
+    replicationFactor: postgres.replicationFactor,
+    replicationState: postgres.replicationState,
+  };
+}
+
+function environmentSeal({
+  built,
+  dataset,
+  loadedDataset,
+  postgres,
+  alternative,
+}) {
+  const operationManifest = movielensCapacityOperationManifest(
+    loadedDataset,
+    postgres.querySql,
+  );
+  const semanticOracleDigest =
+    movielensCapacitySemanticOracleDigest(alternative);
+  return objectFreeze({
+    artifact: built.artifact,
+    dataset: objectFreeze({
+      cardinality: dataset.cardinality,
+      componentSourceDigest: dataset.componentSourceDigest,
+      digest: dataset.digest,
