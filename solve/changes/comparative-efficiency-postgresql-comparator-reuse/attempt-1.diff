+export async function preflightMovielensMeasuredP0DistributedEnvironments({
+  variants,
+  replicationFactors = PREFLIGHT_REPLICATION_FACTORS,
+}) {
+  const temporaryRoot = await mkdtemp(
+    path.join(tmpdir(), `${localText.TEMPORARY_PREFIX}preflight-`),
+  );
+  const cells = [];
+  try {
+    for (let datasetIndex = 0;
+      datasetIndex < variants.length;
+      datasetIndex += 1) {
+      const dataset = variants[datasetIndex];
+      const loadedDataset =
+        await loadMovielensPublicRequestDatasetVariant(
+          dataset.path,
+          dataset,
+        );
+      const built = await buildArtifact(temporaryRoot, dataset);
+      for (const replicationFactor of replicationFactors) {
+        let postgres = null;
+        let preflightError = null;
+        try {
+          postgres = await openPostgresBaselineSession({
+            ratingsBytes: dataset.bytes,
+            ratingsDigest: dataset.digest,
+            replicationFactor,
+            poolSize: 1,
+            resourceLimits: {
+              memory: CONTAINER_MEMORY_LIMIT,
+              cpus: CONTAINER_CPU_LIMIT,
+            },
+          });
+          const oracleOperation = await postgres.executeGroupedReduce({
+            requestId:
+              `movielens-measured-p0-preflight-${datasetIndex}-` +
+              `${replicationFactor}`,
+          });
+          await postgres.resetRunState();
+          arrayPush(cells, environmentSeal({
+            built,
+            dataset,
+            loadedDataset,
+            postgres,
+            alternative: objectFreeze({
+              topMovies: oracleOperation.topMovies,
+            }),
+          }));
+        } catch (error) {
+          preflightError = error;
+        }
+        if (postgres !== null) {
+          await closePreflightPostgres(postgres, preflightError);
+        } else if (preflightError !== null) {
+          throw preflightError;
+        }
+      }
+    }
+    return objectFreeze(cells);
+  } finally {
+    await rm(temporaryRoot, {recursive: true, force: true});
+  }
+}
+
+async function closeAll(
+  cluster,
+  postgres,
+  prepared,
+  sqlIngress,
+  temporaryRoot,
+) {
+  const errors = [];
+  const receipts = {};
+  try {
+    receipts.drain = await prepared?.drainOperations();
+  } catch (error) {
+    arrayPush(errors, error);
+  }
+  try {
+    await sqlIngress?.client.end();
+    receipts.sqlIngressClosed = true;
+  } catch (error) {
+    arrayPush(errors, error);
+  }
+  try {
+    receipts.cluster = await cluster?.stop();
+  } catch (error) {
+    arrayPush(errors, error);
+  }
+  try {
+    receipts.postgresql = await postgres?.close();
+  } catch (error) {
+    arrayPush(errors, error);
+  }
+  try {
+    await rm(temporaryRoot, {recursive: true, force: true});
+    receipts.temporaryRootRemoved = true;
+  } catch (error) {
+    arrayPush(errors, error);
+  }
+  if (errors.length > 0) {
+    throw new AggregateError(errors, localText.CLEANUP_FAILED);
+  }
+  return objectFreeze(receipts);
+}
