@@ -0,0 +1,267 @@
+import {
+  createMovielensPostgresqlCapacityAdapter,
+  movielensCapacityOperationManifest,
+  movielensCapacityOperationManifestDigest,
+  movielensCapacitySemanticOracleDigest,
+} from
+  '../../examples/service-data-affinity/movielens-capacity-runtime-adapters.js';
+import {
+  loadMovielensPublicRequestDatasetVariant,
+} from
+  '../../examples/service-data-affinity/movielens-public-request-workload-dataset.js';
+import {
+  openPostgresBaselineSession,
+} from
+  '../../examples/service-data-affinity/postgres-baseline-session.js';
+import {
+  digestBenchmarkSemanticData,
+} from
+  '../../test/distributed/harness/benchmark-semantic-integrity.js';
+import {
+  MOVIELENS_MEASURED_P0_SIDE_IDS,
+} from
+  '../../test/distributed/harness/comparative-efficiency-movielens-measured-p0-constants.js';
+import {
+  DOCKER_CONTAINER_WRITABLE_LAYER_STORAGE_PATH,
+  DockerProvider,
+} from '../../test/distributed/harness/docker-provider.js';
+
+const DOCKER_SOCKET = '/var/run/docker.sock';
+const CONTAINER_MEMORY_LIMIT = '2g';
+const CONTAINER_CPU_LIMIT = '1.0';
+const POSTGRESQL_SIDE_ID = MOVIELENS_MEASURED_P0_SIDE_IDS[1];
+const POSTGRES_COMPONENT_PREFIX = 'postgresql-node-';
+const objectFreeze = Object.freeze;
+const arrayPush = Function.call.bind(Array.prototype.push);
+const localText = objectFreeze({
+  CLEANUP_FAILED: 'PostgreSQL comparator environment cleanup failed',
+  PROVISIONING_MODE: 'postgresql_comparator_only',
+  SEALED_PREFLIGHT_MISMATCH:
+    'PostgreSQL comparator environment differs from its sealed preflight',
+});
+
+function fail(reason) {
+  throw new Error(`MovieLens PostgreSQL comparator failed: ${reason}`);
+}
+
+function postgresSeal(postgres) {
+  return {
+    imageId: postgres.imageId,
+    imageInspection: postgres.imageInspection,
+    postgresVersion: postgres.postgresVersion,
+    postgresVersionSql: postgres.postgresVersionSql,
+    queryPlan: postgres.queryPlan,
+    querySql: postgres.querySql,
+    replicationFactor: postgres.replicationFactor,
+    replicationState: postgres.replicationState,
+  };
+}
+
+function planningArtifact(dataset) {
+  const identity = {
+    purpose: 'postgresql-comparator-planning-placeholder',
+    componentSourceDigest: dataset.componentSourceDigest,
+  };
+  const digest = digestBenchmarkSemanticData(identity);
+  return objectFreeze({
+    buildInputFingerprint: digest,
+    componentSourceDigest: dataset.componentSourceDigest,
+    executableDigest: digest,
+    ociManifestDigest: digest,
+  });
+}
+
+function postgresqlSeal({
+  dataset,
+  loadedDataset,
+  postgres,
+  alternative,
+  includePlanningArtifact,
+}) {
+  const operationManifest = movielensCapacityOperationManifest(
+    loadedDataset,
+    postgres.querySql,
+  );
+  const body = {
+    dataset: objectFreeze({
+      cardinality: dataset.cardinality,
+      componentSourceDigest: dataset.componentSourceDigest,
+      digest: dataset.digest,
+      sizeBytes: dataset.bytes.length,
+      skew: dataset.skew,
+    }),
+    alternative,
+    operationManifest,
+    operationManifestDigest:
+      movielensCapacityOperationManifestDigest(
+        loadedDataset,
+        postgres.querySql,
+      ),
+    semanticOracleDigest:
+      movielensCapacitySemanticOracleDigest(alternative),
+    postgres: objectFreeze(postgresSeal(postgres)),
+  };
+  return objectFreeze(includePlanningArtifact ?
+    {...body, artifact: planningArtifact(dataset)} :
+    body);
+}
+
+function expectedPostgresqlSeal(expectedSeal) {
+  if (expectedSeal === undefined) return null;
+  return objectFreeze({
+    dataset: expectedSeal.dataset,
+    alternative: expectedSeal.alternative,
+    operationManifest: expectedSeal.operationManifest,
+    operationManifestDigest: expectedSeal.operationManifestDigest,
+    semanticOracleDigest: expectedSeal.semanticOracleDigest,
+    postgres: expectedSeal.postgres,
+  });
+}
+
+function resourceComponents(postgres) {
+  const components = [];
+  for (let index = 0; index < postgres.containers.length; index += 1) {
+    arrayPush(components, {
+      sideId: POSTGRESQL_SIDE_ID,
+      componentId: `${POSTGRES_COMPONENT_PREFIX}${index + 1}`,
+      containerId: postgres.containers[index].containerId,
+      storagePath: DOCKER_CONTAINER_WRITABLE_LAYER_STORAGE_PATH,
+    });
+  }
+  return components;
+}
+
+async function openSession(dataset, replicationFactor) {
+  return openPostgresBaselineSession({
+    ratingsBytes: dataset.bytes,
+    ratingsDigest: dataset.digest,
+    replicationFactor,
+    poolSize: 1,
+    resourceLimits: {
+      memory: CONTAINER_MEMORY_LIMIT,
+      cpus: CONTAINER_CPU_LIMIT,
+    },
+  });
+}
+
+async function prepareSeal({
+  runId,
+  dataset,
+  replicationFactor,
+  includePlanningArtifact,
+}) {
+  const loadedDataset =
+    await loadMovielensPublicRequestDatasetVariant(
+      dataset.path,
+      dataset,
+    );
+  const postgres = await openSession(dataset, replicationFactor);
+  try {
+    const oracleOperation = await postgres.executeGroupedReduce({
+      requestId: `${runId}-postgresql-comparator-oracle`,
+    });
+    await postgres.resetRunState();
+    const alternative = objectFreeze({
+      topMovies: oracleOperation.topMovies,
+    });
+    return {
+      postgres,
+      loadedDataset,
+      seal: postgresqlSeal({
+        dataset,
+        loadedDataset,
+        postgres,
+        alternative,
+        includePlanningArtifact,
+      }),
+    };
+  } catch (error) {
+    try {
+      await postgres.close();
+    } catch (cleanupError) {
+      throw new AggregateError(
+        [error, cleanupError],
+        localText.CLEANUP_FAILED,
+      );
+    }
+    throw error;
+  }
+}
+
+export async function preflightMovielensMeasuredP0PostgresqlComparator({
+  runId,
+  dataset,
+  replicationFactor,
+}) {
+  const prepared = await prepareSeal({
+    runId,
+    dataset,
+    replicationFactor,
+    includePlanningArtifact: true,
+  });
+  await prepared.postgres.close();
+  return prepared.seal;
+}
+
+export async function openMovielensMeasuredP0PostgresqlEnvironment({
+  runId,
+  sideId,
+  dataset,
+  replicationFactor,
+  expectedSeal,
+}) {
+  const prepared = await prepareSeal({
+    runId,
+    dataset,
+    replicationFactor,
+    includePlanningArtifact: false,
+  });
+  const observedSeal = prepared.seal;
+  if (
+    sideId !== POSTGRESQL_SIDE_ID ||
+    digestBenchmarkSemanticData(observedSeal) !==
+      digestBenchmarkSemanticData(expectedPostgresqlSeal(expectedSeal))
+  ) {
+    await prepared.postgres.close();
+    fail(localText.SEALED_PREFLIGHT_MISMATCH);
+  }
+  const postgres = prepared.postgres;
+  const provider = new DockerProvider({socketPath: DOCKER_SOCKET});
+  const operationManifest = observedSeal.operationManifest;
+  let closePromise = null;
+  return objectFreeze({
+    runId,
+    sideIds: objectFreeze([sideId]),
+    postgres,
+    provider,
+    networkId: postgres.networkId,
+    networkName: postgres.networkName,
+    networkNames: objectFreeze([postgres.networkName]),
+    components: objectFreeze(resourceComponents(postgres)),
+    operationManifestDigest: observedSeal.operationManifestDigest,
+    semanticOracleDigest: observedSeal.semanticOracleDigest,
+    adapters: objectFreeze([
+      createMovielensPostgresqlCapacityAdapter({
+        session: postgres,
+        sideId,
+        operationManifest,
+        semanticOracleDigest: observedSeal.semanticOracleDigest,
+      }),
+    ]),
+    metadata: objectFreeze({
+      seal: observedSeal,
+      postgres: objectFreeze(postgresSeal(postgres)),
+      provisioning: objectFreeze({
+        mode: localText.PROVISIONING_MODE,
+        resourceLimits: objectFreeze({
+          memory: CONTAINER_MEMORY_LIMIT,
+          cpus: CONTAINER_CPU_LIMIT,
+        }),
+      }),
+    }),
+    close() {
+      if (closePromise === null) closePromise = postgres.close();
+      return closePromise;
+    },
+  });
+}
diff --git a/scripts/checks/movielens-measured-p0-request-cell-admission.js b/scripts/checks/movielens-measured-p0-request-cell-admission.js
new file mode 100644
index 0000000000000000000000000000000000000000..26caa958e993d613a2e5dc4ee306a5ffd9ed9b3c
--- /dev/null
+++ b/scripts/checks/movielens-measured-p0-request-cell-admission.js
@@ -0,0 +1,83 @@
+const objectFreeze = Object.freeze;
+const jsonStringify = JSON.stringify;
+const ADMISSION_RESOLVED = 'resolved';
+const TOPOLOGY_READY = 'ready';
+const localText = objectFreeze({
+  ABORTED_READY_WAIT: 'request Cell readiness wait aborted',
+  CELL_NOT_READY: 'request Cell did not become ready',
+});
+
+function fail(reason) {
+  throw new Error(`MovieLens measured P0 ingress failed: ${reason}`);
+}
+
+function throwIfReadyWaitAborted(signal) {
+  if (signal?.aborted !== true) return;
+  throw signal.reason ??
+    new Error(localText.ABORTED_READY_WAIT);
+}
+
+function resolvedAdmission(cluster, topology) {
+  return objectFreeze({
+    receipt: objectFreeze({cluster, topology}),
+    state: ADMISSION_RESOLVED,
+  });
+}
+
+export async function waitForMovielensMeasuredP0RequestCellAdmission({
+  admitCluster,
+  clock,
+  delay,
+  observeTopology,
+  pollIntervalMs,
+  priorAdmission,
+  signal,
+  stableWindowMs,
+  timeoutMs,
+}) {
+  const deadline = clock() + timeoutMs;
+  let lastObservation = objectFreeze({
+    operationRows: objectFreeze([]),
+    serviceRows: objectFreeze([]),
+  });
+  let stableSinceMs = null;
+  while (clock() < deadline) {
+    throwIfReadyWaitAborted(signal);
+    const observation = await observeTopology();
+    lastObservation = observation;
+    const topology = observation.topology;
+    if (topology.failedOperationCount > 0) {
+      fail(
+        `${localText.CELL_NOT_READY}: ` +
+          `${jsonStringify(lastObservation)}`,
+      );
+    }
+    if (topology.state === TOPOLOGY_READY) {
+      if (priorAdmission?.state === ADMISSION_RESOLVED) {
+        return objectFreeze({admission: priorAdmission, topology});
+      }
+      const observedAtMs = clock();
+      if (stableSinceMs === null) stableSinceMs = observedAtMs;
+      if (observedAtMs - stableSinceMs >= stableWindowMs) {
+        const cluster = await admitCluster();
+        const confirmation = await observeTopology();
+        lastObservation = confirmation;
+        if (confirmation.topology.state === TOPOLOGY_READY) {
+          const admission =
+            resolvedAdmission(cluster, confirmation.topology);
+          return objectFreeze({
+            admission,
+            topology: confirmation.topology,
+          });
+        }
+        stableSinceMs = null;
+      }
+    } else {
+      stableSinceMs = null;
+    }
+    await delay(pollIntervalMs);
+  }
+  fail(
+    `${localText.CELL_NOT_READY}: ${jsonStringify(lastObservation)}`,
+  );
+}
diff --git a/scripts/checks/movielens-measured-p0-request-cell-topology.js b/scripts/checks/movielens-measured-p0-request-cell-topology.js
new file mode 100644
index 0000000000000000000000000000000000000000..27c86de959a25c5ce1a986cc89ebd2a174555419
--- /dev/null
+++ b/scripts/checks/movielens-measured-p0-request-cell-topology.js
@@ -0,0 +1,183 @@
+import {WORKFLOW_STEP} from '../../src/constants/index.js';
+import {
+  ReplicaStatus,
+  isTerminalReplicaOperationRecord,
+} from '../../src/rebalancer/replica-status.js';
+import {
+  runtimeServiceReplicaBelongsToEntity,
+} from '../../src/rebalancer/runtime-service-replica-identity.js';
+import {
+  MOVIELENS_MEASURED_P0_REQUEST_CELL_TARGET_REPLICA_COUNT,
+} from
+  '../../test/distributed/harness/comparative-efficiency-movielens-measured-p0-constants.js';
+import {
+  hasExactOwnDataKeys,
+  isDenseDataArray,
+  ownDataValue,
+} from
+  '../../test/distributed/harness/benchmark-semantic-integrity.js';
+
+const objectFreeze = Object.freeze;
+const arrayPush = Function.call.bind(Array.prototype.push);
+const CanonicalSet = Set;
+const setAdd = Function.call.bind(Set.prototype.add);
+const setSize = Function.call.bind(
+  Object.getOwnPropertyDescriptor(Set.prototype, 'size').get,
+);
+const EMPTY_ROWS = objectFreeze([]);
+const SERVICE_ROW_KEYS = objectFreeze([
+  'service_id',
+  'service_type',
+  'node_id',
+  'status',
+]);
+const OPERATION_ROW_KEYS = objectFreeze([
+  'operation_id',
+  'entity_id',
+  'type',
+  'status',
+  'workflow_step',
+]);
+const ROUTE_TARGET_ABSENT = objectFreeze({state: 'absent'});
+const ROUTE_TARGET_PRESENT = 'present';
+const RUNTIME_SERVICE = 'runtime_service';
+const TOPOLOGY_PENDING = 'pending';
+const TOPOLOGY_READY = 'ready';
+
+function pendingTopology() {
+  return objectFreeze({
+    activeCount: 0,
+    distinctNodeCount: 0,
+    failedOperationCount: 0,
+    inFlightOperationCount: 0,
+    operationCount: 0,
+    routeTarget: ROUTE_TARGET_ABSENT,
+    state: TOPOLOGY_PENDING,
+  });
+}
+
+function hasCanonicalTopologyInputs(serviceRows, entityId, operationRows) {
+  if (
+    typeof entityId !== 'string' ||
+    entityId.length === 0 ||
+    !isDenseDataArray(serviceRows) ||
+    !isDenseDataArray(operationRows)
+  ) {
+    return false;
+  }
+  for (let index = 0; index < serviceRows.length; index += 1) {
+    if (!hasExactOwnDataKeys(serviceRows[index], SERVICE_ROW_KEYS)) {
+      return false;
+    }
+  }
+  for (let index = 0; index < operationRows.length; index += 1) {
+    if (!hasExactOwnDataKeys(operationRows[index], OPERATION_ROW_KEYS)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+function collectActiveBindingCells(serviceRows, entityId) {
+  const active = [];
+  const nodeIds = new CanonicalSet();
+  for (let index = 0; index < serviceRows.length; index += 1) {
+    const actual = serviceRows[index];
+    const serviceId = ownDataValue(actual, 'service_id');
+    const serviceType = ownDataValue(actual, 'service_type');
+    const nodeId = ownDataValue(actual, 'node_id');
+    const status = ownDataValue(actual, 'status');
+    if (
+      serviceType === RUNTIME_SERVICE &&
+      status === ReplicaStatus.ACTIVE &&
+      typeof nodeId === 'string' &&
+      nodeId.length > 0 &&
+      runtimeServiceReplicaBelongsToEntity(
+        serviceId,
+        entityId,
+      )
+    ) {
+      arrayPush(active, objectFreeze({
+        node_id: nodeId,
+        service_id: serviceId,
+        service_type: serviceType,
+        status,
+      }));
+      setAdd(nodeIds, nodeId);
+    }
+  }
+  return {active, distinctNodeCount: setSize(nodeIds)};
+}
+
+function inspectBindingCellOperations(operationRows, entityId) {
+  let failedOperationCount = 0;
+  let inFlightOperationCount = 0;
+  let operationCount = 0;
+  for (let index = 0; index < operationRows.length; index += 1) {
+    const operation = operationRows[index];
+    const operationEntityId = ownDataValue(operation, 'entity_id');
+    if (operationEntityId !== entityId) continue;
+    const operationType = ownDataValue(operation, 'type');
+    const status = ownDataValue(operation, 'status');
+    const workflowStep = ownDataValue(operation, 'workflow_step');
+    operationCount += 1;
+    if (
+      status === ReplicaStatus.FAILED ||
+      workflowStep === WORKFLOW_STEP.FAILED
+    ) {
+      failedOperationCount += 1;
+    } else if (!isTerminalReplicaOperationRecord({
+      status,
+      type: operationType,
+      workflow_step: workflowStep,
+    })) {
+      inFlightOperationCount += 1;
+    }
+  }
+  return {
+    failedOperationCount,
+    inFlightOperationCount,
+    operationCount,
+  };
+}
+
+export function inspectMovielensMeasuredP0BindingCellTopology(
+  serviceRows,
+  entityId,
+  operationRows = EMPTY_ROWS,
+) {
+  if (!hasCanonicalTopologyInputs(serviceRows, entityId, operationRows)) {
+    return pendingTopology();
+  }
+  const {
+    active,
+    distinctNodeCount,
+  } = collectActiveBindingCells(serviceRows, entityId);
+  const {
+    failedOperationCount,
+    inFlightOperationCount,
+    operationCount,
+  } = inspectBindingCellOperations(operationRows, entityId);
+
+  const ready =
+    active.length ===
+      MOVIELENS_MEASURED_P0_REQUEST_CELL_TARGET_REPLICA_COUNT &&
+    distinctNodeCount ===
+      MOVIELENS_MEASURED_P0_REQUEST_CELL_TARGET_REPLICA_COUNT &&
+    failedOperationCount === 0 &&
+    inFlightOperationCount === 0;
+  return objectFreeze({
+    activeCount: active.length,
+    distinctNodeCount,
+    failedOperationCount,
+    inFlightOperationCount,
+    operationCount,
+    routeTarget: ready ?
+      objectFreeze({
+        state: ROUTE_TARGET_PRESENT,
+        value: objectFreeze({...active[0]}),
+      }) :
+      ROUTE_TARGET_ABSENT,
+    state: ready ? TOPOLOGY_READY : TOPOLOGY_PENDING,
+  });
+}
diff --git a/scripts/checks/movielens-measured-p0-setup-failure.js b/scripts/checks/movielens-measured-p0-setup-failure.js
new file mode 100644
index 0000000000000000000000000000000000000000..b23fa2a5873ea753a8fa5ddd35ac319751fe8d47
--- /dev/null
+++ b/scripts/checks/movielens-measured-p0-setup-failure.js
@@ -0,0 +1,133 @@
+const objectFreeze = Object.freeze;
+const objectGetOwnPropertyDescriptor = Object.getOwnPropertyDescriptor;
+const objectHasOwn = Object.hasOwn;
+const stringIncludes = Function.call.bind(String.prototype.includes);
+const EVIDENCE_PRESENT = 'present';
+const ABSENT_EVIDENCE = objectFreeze({state: 'absent'});
+const DATA_VALUE_KEY = 'value';
+const ERROR_CODE_KEY = 'code';
+const ERROR_DETAIL_KEY = 'detail';
+const ERROR_MESSAGE_KEY = 'message';
+const ERROR_NAME_KEY = 'name';
+const ERROR_QUIESCENCE_KEY = 'quiescence';
+const MOVIELENS_MEASURED_P0_LIFECYCLE_RETRY_OWNER_CODES = objectFreeze([
+  'corrupt_catalog_record',
+  'package_not_found',
+  'concurrent_catalog_modification',
+]);
+const localText = objectFreeze({
+  CELL_NOT_READY: 'request Cell did not become ready',
+  ERROR_NAME: 'Error',
+  OWNER_CODE_CONCURRENT:
+    '"ownerCode":"concurrent_catalog_modification"',
+  OWNER_CODE_CORRUPT: '"ownerCode":"corrupt_catalog_record"',
+  OWNER_CODE_MISSING: '"ownerCode":"package_not_found"',
+  OWNER_VISIBILITY_FAILURE: 'did not become owner-visible',
+  SQL_INGRESS_NOT_READY:
+    'authenticated PostgreSQL ingress did not become ready',
+  UNKNOWN_ERROR: 'unknown error',
+});
+
+function ownDataValue(record, key) {
+  if (record === null || typeof record !== 'object') return undefined;
+  const descriptor = objectGetOwnPropertyDescriptor(record, key);
+  if (
+    descriptor === undefined ||
+    !objectHasOwn(descriptor, DATA_VALUE_KEY)
+  ) {
+    return undefined;
+  }
+  return descriptor.value;
+}
+
+function setupErrorSnapshot(error) {
+  return objectFreeze({
+    code: ownDataValue(error, ERROR_CODE_KEY),
+    detail: ownDataValue(error, ERROR_DETAIL_KEY),
+    message: ownDataValue(error, ERROR_MESSAGE_KEY),
+    name: ownDataValue(error, ERROR_NAME_KEY),
+    quiescence: ownDataValue(error, ERROR_QUIESCENCE_KEY),
+  });
+}
+
+function isRetryableLifecycleSnapshot(snapshot) {
+  const detail =
+    typeof snapshot.detail === 'string' ? snapshot.detail : '';
+  return stringIncludes(detail, localText.OWNER_CODE_CORRUPT) ||
+    stringIncludes(detail, localText.OWNER_CODE_MISSING) ||
+    stringIncludes(detail, localText.OWNER_CODE_CONCURRENT);
+}
+
+function isRetryableSetupSnapshot(snapshot) {
+  const message =
+    typeof snapshot.message === 'string' ? snapshot.message : '';
+  return snapshot.quiescence !== undefined ||
+    isRetryableLifecycleSnapshot(snapshot) ||
+    stringIncludes(message, localText.SQL_INGRESS_NOT_READY) ||
+    stringIncludes(message, localText.OWNER_VISIBILITY_FAILURE) ||
+    stringIncludes(message, localText.CELL_NOT_READY);
+}
+
+function optionalStringEvidence(value) {
+  if (typeof value !== 'string') return ABSENT_EVIDENCE;
+  return objectFreeze({state: EVIDENCE_PRESENT, value});
+}
+
+function optionalValueEvidence(value) {
+  if (value === undefined) return ABSENT_EVIDENCE;
+  return objectFreeze({state: EVIDENCE_PRESENT, value});
+}
+
+function setupQuiescenceEvidence(quiescence) {
+  if (quiescence === undefined) return ABSENT_EVIDENCE;
+  return objectFreeze({
+    state: EVIDENCE_PRESENT,
+    value: objectFreeze({
+      canonicalBlocker:
+        optionalStringEvidence(quiescence.canonicalBlocker),
+      criticalSystemDistribution:
+        optionalValueEvidence(quiescence.criticalSystemDistribution),
+      effectiveInFlightCount:
+        optionalValueEvidence(quiescence.effectiveInFlightCount),
+      leaderQuietElapsedMs:
+        optionalValueEvidence(quiescence.leaderQuietElapsedMs),
+      stableElapsedMs:
+        optionalValueEvidence(quiescence.stableElapsedMs),
+      state: optionalStringEvidence(quiescence.state),
+    }),
+  });
+}
+
+function isMovielensMeasuredP0RetryableLifecycleError(error) {
+  return isRetryableLifecycleSnapshot(setupErrorSnapshot(error));
+}
+
+function isMovielensMeasuredP0RetryableSetupError(error) {
+  return isRetryableSetupSnapshot(setupErrorSnapshot(error));
+}
+
+function movielensMeasuredP0SetupFailureReceipt(error, attempt) {
+  const snapshot = setupErrorSnapshot(error);
+  return objectFreeze({
+    attempt,
+    code: optionalStringEvidence(snapshot.code),
+    detail: optionalStringEvidence(snapshot.detail),
+    message:
+      typeof snapshot.message === 'string' ?
+        snapshot.message :
+        localText.UNKNOWN_ERROR,
+    name:
+      typeof snapshot.name === 'string' ?
+        snapshot.name :
+        localText.ERROR_NAME,
+    quiescence: setupQuiescenceEvidence(snapshot.quiescence),
+    retryable: isRetryableSetupSnapshot(snapshot),
+  });
+}
+
+export {
+  MOVIELENS_MEASURED_P0_LIFECYCLE_RETRY_OWNER_CODES,
+  isMovielensMeasuredP0RetryableLifecycleError,
+  isMovielensMeasuredP0RetryableSetupError,
+  movielensMeasuredP0SetupFailureReceipt,
+};
