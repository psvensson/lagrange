+      resourceReceiptDigests: [
+        digest('resource-a'),
+        digest('resource-b'),
+      ],
+    },
+    revalidationPolicy: {
+      driftMetric: 'host-control-throughput',
+      baselineValue: 100,
+      maximumRelativeDrift: 0.05,
+    },
+    capturedAtMs: CAPTURED_AT_MS,
