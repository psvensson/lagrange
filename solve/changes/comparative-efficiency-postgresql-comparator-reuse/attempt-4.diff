+  'capacity',
+  'observedPeak',
+  'headroomRatio',
+]);
+const HEADROOM_MEASUREMENT_RECEIPT_KEYS = Object.freeze([
+  'externalEmitter',
+  'clientQueue',
+  'observerCpu',
+  'hostCpu',
