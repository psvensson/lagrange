+    dialect,
+    compiledOperations: counts.dispatched,
+    validatedOperations: counts.correct,
+    successfulOperations: counts.correct,
+    oracleFailures: 0,
+    resultSet: buildBenchmarkResultSetEvidence(observations),
+    accounting: {
