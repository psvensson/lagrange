diff --git a/scripts/checks/movielens-measured-p0-postgresql-comparator.js b/scripts/checks/movielens-measured-p0-postgresql-comparator.js
new file mode 100644
index 00000000..d2d68743
--- /dev/null
+++ b/scripts/checks/movielens-measured-p0-postgresql-comparator.js
@@ -0,0 +1,545 @@
+import {createHash} from 'node:crypto';
+import {readFile} from 'node:fs/promises';
+import os from 'node:os';
+
+import {
+  createBenchmarkCapacityComparatorDriftWitness,
