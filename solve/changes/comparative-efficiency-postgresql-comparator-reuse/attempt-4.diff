+  for (let index = 0; index < FIXTURE_LOADS.length; index += 1) {
+    windows.push({
+      offeredLoadPerSecond: FIXTURE_LOADS[index],
+      warmupMs: FIXTURE_WARMUP_MS,
+      measuredMs: FIXTURE_MEASURED_MS,
+    });
+  }
