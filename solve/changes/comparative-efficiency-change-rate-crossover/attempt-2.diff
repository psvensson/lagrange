+}
+
+function copyReasonCodes(reasonCodes, index) {
+  assertBenchmarkResourceArray(
+    reasonCodes,
+    `changeRateCrossover.attempts.${index}.reasonCodes`,
+    maximumReasonCodes,
+  );
+  if (
+    reasonCodes.length === 0 ||
+    !arrayContains(reasonCodes, COMPARATIVE_CHANGE_RATE_CROSSOVER_REASON)
