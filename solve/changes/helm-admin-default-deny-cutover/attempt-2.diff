+  EVAL: '-e',
+  SOURCE_ENTRY: 'src/index.js',
+  SOURCE_DIR: 'src',
+  ERROR_SEPARATOR: '; ',
+  MEMORY: '2g',
+  CPU: '1.0',
+  START_TIMEOUT_MS: 60_000,
