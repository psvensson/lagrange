+  literalEnvironment,
+  REPO_ROOT,
+  renderLagrangeNode,
+  workloadContainers,
+} from './helm/lagrange-node-render.js';
+
+const LIVE_PROOF = Object.freeze({
+  SCENARIO: 'helm-admin-default-deny-cutover',
+  PRODUCER: 'helm-admin-default-deny-live-scenario',
