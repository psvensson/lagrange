diff --git a/test/bootstrap/connect-websocket-phase-mesh-test-cases.js b/test/bootstrap/connect-websocket-phase-mesh-test-cases.js
index 72a4b393..40862b1e 100644
--- a/test/bootstrap/connect-websocket-phase-mesh-test-cases.js
