-# forgejo-runner daemon config for the lagrange release runner.
-# setup.sh copies this to data/config.yml and appends the `server.connections`
-# block (URL + UUID + token from the Codeberg "Create new runner" screen).
-#
-# Forgejo 15 replaced the old `register` command + .runner file with this
-# declarative connection model — credentials live in config, the daemon
-# connects on start. data/config.yml is gitignored (it holds the token).
-log:
-  # debug is REQUIRED for a local copy of job logs: below debug the runner
-  # installs a NullLogger and job/step output exists only on the Codeberg side
-  # (runner source internal/app/run/runner.go: WithJobLoggerFactory guarded by
-  # IsLevelEnabled(DebugLevel)). At debug, full step output lands in the
-  # daemon's stdout -> `docker logs` (rotated via docker-compose.yml); read
-  # per-job slices with ./job-log.sh.
-  level: debug
-
-runner:
-  # One job at a time: the release workflow runs the full test:ci and gates
-  # are load-sensitive (repo memory: gates run SOLO).
-  capacity: 1
-  # test:ci alone is ~40-60 min; leave generous headroom for build/publish.
-  timeout: 2h
-  fetch_timeout: 5s
-  fetch_interval: 2s
-  # Labels our workflows target. `docker` = what ci.yml/release.yml use
-  # (runs-on: docker); the catthehacker act image ships docker CLI, git,
-  # curl, so setup-node/helm/docker steps all work. ubuntu-latest is a
-  # convenience alias for future third-party workflows.
-  labels:
-    - "docker:docker://ghcr.io/catthehacker/ubuntu:act-latest"
-    - "ubuntu-latest:docker://ghcr.io/catthehacker/ubuntu:act-latest"
-
-container:
-  # docker_host as a unix socket makes the runner AUTO-MOUNT it into every job
-  # container, so release steps can docker build/push. Do NOT also add it via
-  # options (-v ...) — that double-mounts and docker rejects the container with
-  # "Duplicate mount point: /var/run/docker.sock".
-  docker_host: unix:///var/run/docker.sock
-  force_pull: false
-
-cache:
-  enabled: false
