+# GitHub Actions CI — the required pull-request and main-branch gate.
+#
+# The statistical rolling-restart convergence gate is deliberately not run
+# here: its pass rate is variance-bounded and is promoted only through the
+# sealed Wilson-95 rule documented in docs/convergence-donewhen-metric.md.
+name: ci
+
+on:
+  push:
+    branches: [main]
+    paths-ignore:
+      - "solve/changes/**"
+      - "solve/log/**"
+      - "solve/report/**"
+      - "solve/autonomous/**"
+  pull_request:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  gate:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    steps:
+      - name: Checkout
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+
+      - name: Set up Node 22
+        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
+        with:
+          node-version: "22"
+          cache: npm
+
+      - name: Install gate CLI tools
+        run: |
+          set -euo pipefail
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            ripgrep jq default-jre-headless postgresql-client curl
+          HELM_VERSION=v3.16.3
+          HELM_ARCHIVE="helm-${HELM_VERSION}-linux-amd64.tar.gz"
+          cd "$RUNNER_TEMP"
+          curl -fsSLO "https://get.helm.sh/${HELM_ARCHIVE}"
+          curl -fsSLO "https://get.helm.sh/${HELM_ARCHIVE}.sha256sum"
+          sha256sum --check "${HELM_ARCHIVE}.sha256sum"
+          tar -xzf "$HELM_ARCHIVE"
+          sudo install linux-amd64/helm /usr/local/bin/helm
+          helm version --short
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Full gate
+        run: npm run test:gate
