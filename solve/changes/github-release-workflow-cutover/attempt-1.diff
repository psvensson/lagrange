-# Self-hosted Forgejo Actions runner for codeberg.org/psvensson/lagrange.
-#
-# Host-socket pattern: the runner talks to the host Docker daemon, and job
-# containers get the same socket mounted (see config.yml container.options),
-# so workflow steps can `docker build`/`docker push` directly. This trades
-# isolation for simplicity — appropriate for a personal machine running CI
-# for its owner's own repository. If this runner ever serves untrusted
-# repositories, switch to the docker-in-docker sidecar pattern instead.
-#
-# Usage: see README.md (register first, then `docker compose up -d`).
-services:
-  runner:
-    image: data.forgejo.org/forgejo/runner:12
-    container_name: lagrange-forgejo-runner
-    restart: unless-stopped
-    # The runner runs as uid 1001 but must reach the host docker socket
-    # (owned by the host docker group). setup.sh detects that group's GID and
-    # writes it to .env; adding it here grants socket access without root.
-    group_add:
-      - "${DOCKER_GID:-999}"
-    volumes:
-      - /var/run/docker.sock:/var/run/docker.sock
-      - ./data:/data
-    working_dir: /data
-    command: forgejo-runner daemon --config /data/config.yml
-    # The daemon runs at log.level debug (config.yml) so full job/step output
-    # is duplicated into this container's stdout — the local copy of pipeline
-    # logs. Bound it: ~2 full release runs of history, then the oldest file is
-    # overwritten. Read the latest job with ./job-log.sh.
-    logging:
-      driver: json-file
-      options:
-        max-size: "100m"
-        max-file: "3"
