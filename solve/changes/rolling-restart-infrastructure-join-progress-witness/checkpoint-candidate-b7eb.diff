+  if (!record || typeof record !== 'object' || !objectHasOwn(record, field)) {
+    return false;
+  }
+  const descriptor = objectGetOwnPropertyDescriptor(record, field);
+  return descriptor ? objectHasOwn(descriptor, FIELD_VALUE) : false;
