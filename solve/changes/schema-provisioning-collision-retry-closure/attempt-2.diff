+// Bootstrap DDL on a lone forming seed is retryable BY CONTRACT: the schema
+// job owner answers with explicit pending/retry outcomes when its prologue
+// or a replica-operation visibility read is still converging (the round-7
+// race closures), and the admin client's 15s cap can also fire while the
+// seed's schema_operations partition is still routing. Retry both shapes,
+// bounded, the same way the data loader already does for its own writes.
+const BOOTSTRAP_DDL_ATTEMPTS = 6;
+const BOOTSTRAP_DDL_RETRY_DELAY_MS = 5000;
+
+function isRetryableBootstrapDdlOutcome(result) {
+  return result?.provisioningDeadlineExpired === true ||
+    result?.deferRetry === true ||
+    result?.contractState === 'pending';
+}
+
+async function runBootstrapDdl(sql, target = TARGET) {
+  let lastError = null;
+  for (let attempt = 1; attempt <= BOOTSTRAP_DDL_ATTEMPTS; attempt += 1) {
+    try {
+      const result = await queryAdmin(sql, target);
+      if (!isRetryableBootstrapDdlOutcome(result)) {
+        return result;
+      }
+      lastError = new Error(
+        `bootstrap DDL pending (attempt ${attempt}/${BOOTSTRAP_DDL_ATTEMPTS})`,
+      );
+    } catch (error) {
+      lastError = error;
+      const message = String(error?.message || '');
+      if (!message.includes('Timed out waiting for admin response')) {
+        throw error;
+      }
+    }
+    await sleep(BOOTSTRAP_DDL_RETRY_DELAY_MS);
+  }
+  throw lastError;
+}
