+      stop: true,
+      workflowStep: handoffTimeoutDecision.workflowStep,
+      operationBudgetDeadlineMs:
+        handoffTimeoutDecision.operationBudgetDeadlineMs,
+    };
+  }
+  return {stop: false};
+}
