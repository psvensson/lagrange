@@ -0,0 +1,74 @@
+import {test} from '../../src/test-helpers/tap.js';
+import {
+  CONTROL_PLANE_MUTATION_OUTCOME,
+} from '../../src/control-plane/control-plane-system-table-gateway.js';
+import {
+  CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION,
+  classifyControlPlaneMutationResult,
+  didControlPlaneMutationApply,
+} from '../../src/control-plane/control-plane-mutation-outcome-classifier.js';
+
+const EXPECTED_APPLIED_BY_OUTCOME = Object.freeze({
+  [CONTROL_PLANE_MUTATION_OUTCOME.APPLIED]: true,
+  [CONTROL_PLANE_MUTATION_OUTCOME.NO_OP]: false,
+  [CONTROL_PLANE_MUTATION_OUTCOME.PENDING_VISIBILITY]: true,
+  [CONTROL_PLANE_MUTATION_OUTCOME.DEFERRED]: false,
+  [CONTROL_PLANE_MUTATION_OUTCOME.REJECTED]: false,
+  [CONTROL_PLANE_MUTATION_OUTCOME.OWNER_NOT_READY]: false,
+  [CONTROL_PLANE_MUTATION_OUTCOME.OBSERVED_STATE_CHANGED]: false,
+});
+
+test('control-plane mutation classification exhaustively owns every gateway outcome',
+  (t) => {
+    const outcomes = Object.values(CONTROL_PLANE_MUTATION_OUTCOME).sort();
+    t.same(
+      Object.keys(CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION).sort(),
+      outcomes,
+      'the classification table must change with the frozen gateway enum',
+    );
+    t.same(
+      Object.keys(EXPECTED_APPLIED_BY_OUTCOME).sort(),
+      outcomes,
+      'the apply-effect oracle must cover every gateway outcome',
+    );
+
+    for (const outcome of outcomes) {
+      const classification = classifyControlPlaneMutationResult({outcome});
+      t.equal(classification.known, true, `${outcome} should be recognized`);
+      t.equal(
+        classification.applied,
+        EXPECTED_APPLIED_BY_OUTCOME[outcome],
+        `${outcome} should have one canonical apply effect`,
+      );
+    }
+    t.end();
+  });
+
+test('control-plane mutation apply classification rejects non-apply envelopes ' +
+  'without relying on success:false', (t) => {
+  t.equal(
+    didControlPlaneMutationApply({
+      outcome: CONTROL_PLANE_MUTATION_OUTCOME.NO_OP,
+    }),
+    false,
+    'no_op is not a durable apply when success is absent',
+  );
+  t.equal(
+    didControlPlaneMutationApply({
+      outcome: CONTROL_PLANE_MUTATION_OUTCOME.DEFERRED,
+    }),
+    false,
+    'deferred is not a durable apply when success is absent',
+  );
+  t.equal(
+    didControlPlaneMutationApply({success: true, affectedRows: 0}),
+    false,
+    'legacy zero-row envelopes remain non-applies',
+  );
+  t.equal(
+    didControlPlaneMutationApply({success: true}),
+    true,
+    'legacy successful envelopes without typed outcomes remain compatible',
+  );
+  t.end();
+});
