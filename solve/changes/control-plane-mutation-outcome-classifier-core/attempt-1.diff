index 0000000000000000000000000000000000000000..d1ea5edd286c4c789f6691ff5d56d1b1c0e68a1e
--- /dev/null
+++ b/src/control-plane/control-plane-mutation-outcome-classifier.js
@@ -0,0 +1,104 @@
+import {
+  CONTROL_PLANE_MUTATION_OUTCOME,
+} from './control-plane-system-table-gateway-constants.js';
+
+function freezeClassification(outcome, options) {
+  return Object.freeze({
+    outcome,
+    known: true,
+    applied: options.applied === true,
+    accepted: options.accepted === true,
+    deferred: options.deferred === true,
+    retryable: options.retryable === true,
+    terminal: options.terminal === true,
+  });
+}
+
+const CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION = Object.freeze({
+  [CONTROL_PLANE_MUTATION_OUTCOME.APPLIED]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.APPLIED,
+    {applied: true, accepted: true},
+  ),
+  [CONTROL_PLANE_MUTATION_OUTCOME.NO_OP]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.NO_OP,
+    {accepted: true, retryable: true},
+  ),
+  [CONTROL_PLANE_MUTATION_OUTCOME.PENDING_VISIBILITY]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.PENDING_VISIBILITY,
+    {applied: true, accepted: true, deferred: true, retryable: true},
+  ),
+  [CONTROL_PLANE_MUTATION_OUTCOME.DEFERRED]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.DEFERRED,
+    {accepted: true, deferred: true, retryable: true},
+  ),
+  [CONTROL_PLANE_MUTATION_OUTCOME.REJECTED]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.REJECTED,
+    {terminal: true},
+  ),
+  [CONTROL_PLANE_MUTATION_OUTCOME.OWNER_NOT_READY]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.OWNER_NOT_READY,
+    {accepted: true, deferred: true, retryable: true},
+  ),
+  [CONTROL_PLANE_MUTATION_OUTCOME.OBSERVED_STATE_CHANGED]: freezeClassification(
+    CONTROL_PLANE_MUTATION_OUTCOME.OBSERVED_STATE_CHANGED,
+    {accepted: true, retryable: true},
+  ),
+});
+
+const UNKNOWN_CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION = Object.freeze({
+  outcome: null,
+  known: false,
+  applied: false,
+  accepted: false,
+  deferred: false,
+  retryable: false,
+  terminal: false,
+});
+
+function classifyControlPlaneMutationOutcome(outcome) {
+  return CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION[outcome] ||
+    UNKNOWN_CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION;
+}
+
+function extractControlPlaneMutationAffectedRows(result) {
+  const affectedRows = Number(
+    result?.partitionResult?.affectedRows ?? result?.affectedRows,
+  );
+  return Number.isFinite(affectedRows) ? affectedRows : null;
+}
+
+function classifyControlPlaneMutationResult(result) {
+  const outcomeClassification = classifyControlPlaneMutationOutcome(
+    result?.outcome,
+  );
+  const affectedRows = extractControlPlaneMutationAffectedRows(result);
+  const explicitlyFailed = result === false || result?.success === false;
+  let applied = outcomeClassification.applied;
+  if (!outcomeClassification.known) {
+    applied = affectedRows === null ? !explicitlyFailed : affectedRows > 0;
+  } else if (affectedRows !== null) {
+    applied = applied && affectedRows > 0;
+  }
+  if (explicitlyFailed) {
+    applied = false;
+  }
+
+  return Object.freeze({
+    ...outcomeClassification,
+    applied,
+    affectedRows,
+  });
+}
+
+function didControlPlaneMutationApply(result) {
+  return classifyControlPlaneMutationResult(result).applied;
+}
+
+export {
+  CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION,
+  UNKNOWN_CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION,
+  classifyControlPlaneMutationOutcome,
+  classifyControlPlaneMutationResult,
+  didControlPlaneMutationApply,
+  extractControlPlaneMutationAffectedRows,
+};
