+++ b/src/control-plane/control-plane-mutation-outcome-classifier.js
@@ -0,0 +1,161 @@
+import {
+  CONTROL_PLANE_MUTATION_OUTCOME,
+} from './control-plane-system-table-gateway-constants.js';
+
+const objectCreate = Object.create;
+const objectFreeze = Object.freeze;
+const objectGetOwnPropertyDescriptor = Object.getOwnPropertyDescriptor;
+const objectHasOwn = Object.hasOwn;
+const numberIsSafeInteger = Number.isSafeInteger;
+const reflectHas = Reflect.has;
+const DATA_DESCRIPTOR_VALUE_PROPERTY = 'value';
+
+function freezeClassification(outcome, options) {
+  return objectFreeze({
+    outcome,
+    known: true,
+    applied: options.applied === true,
+    accepted: options.accepted === true,
+    deferred: options.deferred === true,
+    retryable: options.retryable === true,
+    terminal: options.terminal === true,
+  });
+}
+
+const OUTCOME_CLASSIFICATION_ENTRIES = [
+  [CONTROL_PLANE_MUTATION_OUTCOME.APPLIED,
+    {applied: true, accepted: true}],
+  [CONTROL_PLANE_MUTATION_OUTCOME.NO_OP,
+    {accepted: true, retryable: true}],
+  [CONTROL_PLANE_MUTATION_OUTCOME.PENDING_VISIBILITY,
+    {applied: true, accepted: true, deferred: true, retryable: true}],
+  [CONTROL_PLANE_MUTATION_OUTCOME.DEFERRED,
+    {accepted: true, deferred: true, retryable: true}],
+  [CONTROL_PLANE_MUTATION_OUTCOME.REJECTED,
+    {terminal: true}],
+  [CONTROL_PLANE_MUTATION_OUTCOME.OWNER_NOT_READY,
+    {accepted: true, deferred: true, retryable: true}],
+  [CONTROL_PLANE_MUTATION_OUTCOME.OBSERVED_STATE_CHANGED,
+    {accepted: true, retryable: true}],
+];
+const CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION = objectCreate(null);
+for (const [outcome, options] of OUTCOME_CLASSIFICATION_ENTRIES) {
+  CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION[outcome] =
+    freezeClassification(outcome, options);
+}
+objectFreeze(CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION);
+
+const UNKNOWN_CLASSIFICATION = objectFreeze({
+  outcome: null,
+  known: false,
+  applied: false,
+  accepted: false,
+  deferred: false,
+  retryable: false,
+  terminal: false,
+});
+
+function isRecord(value) {
+  return value !== null &&
+    (typeof value === 'object' || typeof value === 'function');
+}
+
+function readOwnDataProperty(target, property) {
+  if (!isRecord(target)) {
+    return {present: false, valid: true, value: undefined};
+  }
+  let descriptor;
+  let inherited;
+  try {
+    descriptor = objectGetOwnPropertyDescriptor(target, property);
+    inherited = !descriptor && reflectHas(target, property);
+  } catch {
+    return {present: true, valid: false, value: undefined};
+  }
+  if (!descriptor) {
+    return {
+      present: inherited,
+      valid: !inherited,
+      value: undefined,
+    };
+  }
+  if (!objectHasOwn(descriptor, DATA_DESCRIPTOR_VALUE_PROPERTY)) {
+    return {present: true, valid: false, value: undefined};
+  }
+  return {present: true, valid: true, value: descriptor.value};
+}
+
+function readAffectedRows(result) {
+  const partitionResultProperty = readOwnDataProperty(
+    result,
+    'partitionResult',
+  );
+  if (partitionResultProperty.present && !partitionResultProperty.valid) {
+    return {present: true, valid: false, value: null};
+  }
+  const partitionAffectedRows = readOwnDataProperty(
+    partitionResultProperty.value,
+    'affectedRows',
+  );
+  if (partitionAffectedRows.present && !partitionAffectedRows.valid) {
+    return {present: true, valid: false, value: null};
+  }
+  const topLevelAffectedRows = readOwnDataProperty(result, 'affectedRows');
+  if (topLevelAffectedRows.present && !topLevelAffectedRows.valid) {
+    return {present: true, valid: false, value: null};
+  }
+  const selected = partitionAffectedRows.present ?
+    partitionAffectedRows :
+    topLevelAffectedRows;
+  if (!selected.present) {
+    return {present: false, valid: true, value: null};
+  }
+  const valid = typeof selected.value === 'number' &&
+    numberIsSafeInteger(selected.value) &&
+    selected.value >= 0;
+  return {present: true, valid, value: valid ? selected.value : null};
+}
+
+function classifyControlPlaneMutationResult(result) {
+  const outcomeProperty = readOwnDataProperty(result, 'outcome');
+  const successProperty = readOwnDataProperty(result, 'success');
+  const affectedRows = readAffectedRows(result);
+  const outcomeIsPrimitive = typeof outcomeProperty.value === 'string';
+  const outcomeIsKnown = outcomeProperty.present &&
+    outcomeProperty.valid &&
+    outcomeIsPrimitive &&
+    objectHasOwn(
+      CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION,
+      outcomeProperty.value,
+    );
+  const outcomeClassification = outcomeIsKnown ?
+    CONTROL_PLANE_MUTATION_OUTCOME_CLASSIFICATION[outcomeProperty.value] :
+    UNKNOWN_CLASSIFICATION;
+  const successIsValid = !successProperty.present ||
+    (successProperty.valid && typeof successProperty.value === 'boolean');
+  const shapeIsValid = successIsValid && affectedRows.valid &&
+    (!outcomeProperty.present || outcomeIsKnown);
+  const explicitlyFailed = result === false ||
+    (successProperty.present && successProperty.value === false);
+  let applied = false;
+  if (shapeIsValid && !explicitlyFailed) {
+    if (outcomeIsKnown) {
+      applied = outcomeClassification.applied &&
+        (!affectedRows.present || affectedRows.value > 0);
+    } else if (!outcomeProperty.present) {
+      applied = affectedRows.present ?
+        affectedRows.value > 0 :
+        (!successProperty.present || successProperty.value === true);
+    }
+  }
+
+  return objectFreeze({
+    ...outcomeClassification,
+    applied,
+    affectedRows: affectedRows.value,
+    affectedRowsPresent: affectedRows.present,
+    affectedRowsValid: affectedRows.valid,
+  });
+}
+
+export {classifyControlPlaneMutationResult};
