+    const timeoutMs = 250;
+
+    const result = await coordinator.executePlan(plan, [], {
+      timeoutMs,
+      timeoutBudget: {
+        configuredBudgetMs: timeoutMs,
+        startedAtMs: Date.now(),
+        deadlineMs: Date.now() + timeoutMs,
+      },
