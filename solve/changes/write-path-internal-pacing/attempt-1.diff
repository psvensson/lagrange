+        partition_id: 'ratings-p1',
+        node_id: 'node-stuck',
+        raft_role: 'leader',
+        address: 'node-stuck/partition/ratings-r1',
+        status: 'active',
+      }],
+      get(type, key) {
+        if (type === 'partitions') {
+          return this.partitions.find(
+            (partition) => partition.partition_id === key,
