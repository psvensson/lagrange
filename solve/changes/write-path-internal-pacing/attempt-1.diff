+}
+
+test(
+  'write routing consumes the original absolute request budget',
+  async (t) => {
+    const configuredBudgetMs = 80;
+    const timeoutBudget = {
+      configuredBudgetMs,
+      startedAtMs: Date.now(),
+      deadlineMs: Date.now() + configuredBudgetMs,
