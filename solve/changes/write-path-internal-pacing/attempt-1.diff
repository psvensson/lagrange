+test(
+  'response-loss retry reuses one participant identity and commits once',
+  async (t) => {
+    const replicaIds = ['counters-r1', 'counters-r2', 'counters-r3'];
+    const leader = createCounterPartition(replicaIds[0], replicaIds);
