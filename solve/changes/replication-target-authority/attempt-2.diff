index 0000000000000000000000000000000000000000..1010d15a2bfb3437f3092bd076b4098ee303015d
--- /dev/null
+++ b/src/bootstrap/replication-target-authority.js
@@ -0,0 +1,96 @@
+import {
+  PARTITIONS_SCHEMA,
+} from './system-table-core-schema-definitions.js';
+
+const LOCAL_STR_OBJECT = 'object';
+const REPLICA_COUNT_COLUMN = 'replica_count';
+const DESCRIPTOR_VALUE_FIELD = 'value';
+const objectGetOwnPropertyDescriptor = Object.getOwnPropertyDescriptor;
+const objectHasOwn = Object.hasOwn;
+const numberIsSafeInteger = Number.isSafeInteger;
+
+// The distinction this module exists to enforce:
+//
+//   desired replication factor = immutable table/schema/policy value
+//   current replica identities = mutable runtime state
+//
+// They were conflated: desired RF was inferred from the LENGTH of
+// INITIAL_REPLICA_IDS[table], an array handed out by reference and pushed into
+// by replica wiring. Measured inside a running cluster, a minted
+// `replace-replica-<hex>` made replica_operations report a desired RF of 4
+// where a fresh process reports 3 — so the denominator of the distinct-node
+// invariant drifted with identity churn. A replacement replica is a NEW
+// IDENTITY; it does not restate policy.
+const DECLARED_REPLICA_COUNT_DEFAULT = (() => {
+  const column = PARTITIONS_SCHEMA.columns.find(
+    (candidate) => candidate.name === REPLICA_COUNT_COLUMN,
+  );
+  return numberIsSafeInteger(column?.defaultValue) ? column.defaultValue : 0;
+})();
+
+const REPLICATION_TARGET_SOURCE = Object.freeze({
+  PARTITION_ROW: 'partition_row_replica_count',
+  SCHEMA_DEFAULT: 'schema_declared_default',
+  UNDECLARED: 'undeclared',
+});
+
+function readOwnReplicaCount(partitionRow) {
+  if (!partitionRow || typeof partitionRow !== LOCAL_STR_OBJECT) {
+    return null;
+  }
+  const descriptor = objectGetOwnPropertyDescriptor(
+    partitionRow,
+    REPLICA_COUNT_COLUMN,
+  );
+  if (!descriptor || !objectHasOwn(descriptor, DESCRIPTOR_VALUE_FIELD)) {
+    return null;
+  }
+  const value = descriptor.value;
+  return numberIsSafeInteger(value) && value > 0 ? value : null;
+}
+
+/**
+ * The desired replication factor for one partition, from its declared policy.
+ * A partition row's own replica_count wins; otherwise the schema's declared
+ * default. Never derived from how many replica identities happen to exist.
+ *
+ * @param {Object} options
+ * @param {Object|null} [options.partitionRow]
+ * @return {Object} frozen {replicationFactor, source}
+ */
+function resolveDesiredReplicationFactor(options = {}) {
+  const partitionRow = options.partitionRow;
+  // NO partitions row means no declared policy for this partition, which is an
+  // unreadable requirement and must fail closed. The schema default is the
+  // policy for a row that omits the column — it is not a policy for a
+  // partition that has no row at all.
+  // An array is not a policy row: it satisfies typeof 'object' and would
+  // fall through to the schema default, inventing a requirement from a
+  // shape that declares nothing.
+  if (!partitionRow || typeof partitionRow !== LOCAL_STR_OBJECT ||
+    Array.isArray(partitionRow)) {
+    return Object.freeze({
+      replicationFactor: 0,
+      source: REPLICATION_TARGET_SOURCE.UNDECLARED,
+    });
+  }
+  const declared = readOwnReplicaCount(partitionRow);
+  if (declared !== null) {
+    return Object.freeze({
+      replicationFactor: declared,
+      source: REPLICATION_TARGET_SOURCE.PARTITION_ROW,
+    });
+  }
+  return Object.freeze({
+    replicationFactor: DECLARED_REPLICA_COUNT_DEFAULT,
+    source: DECLARED_REPLICA_COUNT_DEFAULT > 0 ?
+      REPLICATION_TARGET_SOURCE.SCHEMA_DEFAULT :
+      REPLICATION_TARGET_SOURCE.UNDECLARED,
+  });
+}
+
+export {
+  DECLARED_REPLICA_COUNT_DEFAULT,
+  REPLICATION_TARGET_SOURCE,
+  resolveDesiredReplicationFactor,
+};
