diff --git a/test/bootstrap/replication-target-authority.test.js b/test/bootstrap/replication-target-authority.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..2c9e625e867ef1516e52102778cbd0af3c9864fa
--- /dev/null
+++ b/test/bootstrap/replication-target-authority.test.js
@@ -0,0 +1,112 @@
+// Witness for the replication-target-authority quest.
+// Raw node:test so --test-name-pattern selects exactly one scenario.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  DECLARED_REPLICA_COUNT_DEFAULT,
+  REPLICATION_TARGET_SOURCE,
+  resolveDesiredReplicationFactor,
+} from '../../src/bootstrap/replication-target-authority.js';
+import {
+  PARTITIONS_SCHEMA,
+} from '../../src/bootstrap/system-table-core-schema-definitions.js';
+import {
+  INITIAL_REPLICA_IDS,
+  SYSTEM_TABLE_NAME,
+  getInitialReplicaIds,
+} from '../../src/bootstrap/system-table-schemas-constants.js';
+
+test('target-comes-from-declared-schema-not-identity-count', () => {
+  // The default is READ from the partitions schema, not restated as a literal,
+  // so changing the declaration moves the target.
+  const column = PARTITIONS_SCHEMA.columns.find(
+    (candidate) => candidate.name === 'replica_count');
+  assert.equal(DECLARED_REPLICA_COUNT_DEFAULT, column.defaultValue);
+  assert.equal(DECLARED_REPLICA_COUNT_DEFAULT, 3);
+
+  const fromSchema = resolveDesiredReplicationFactor({
+    partitionRow: {partition_id: 'services-p1'},
+  });
+  assert.equal(fromSchema.replicationFactor, 3);
+  assert.equal(fromSchema.source, REPLICATION_TARGET_SOURCE.SCHEMA_DEFAULT);
+});
+
+test('partition-row-policy-overrides-the-default', () => {
+  const declared = resolveDesiredReplicationFactor({
+    partitionRow: {partition_id: 'services-p1', replica_count: 5},
+  });
+  assert.equal(declared.replicationFactor, 5);
+  assert.equal(declared.source, REPLICATION_TARGET_SOURCE.PARTITION_ROW);
+});
+
+test('absent-partition-row-is-undeclared-not-defaulted', () => {
+  // No row means no declared policy for THIS partition. Borrowing the schema
+  // default would invent a requirement the partition was never given, and
+  // would erase the fail-closed unreadable-requirement case.
+  for (const partitionRow of [undefined, null, 'row', 7, []]) {
+    const target = resolveDesiredReplicationFactor({partitionRow});
+    assert.equal(target.replicationFactor, 0, String(partitionRow));
+    assert.equal(target.source, REPLICATION_TARGET_SOURCE.UNDECLARED);
+  }
+});
+
+test('identity-churn-cannot-move-the-target', () => {
+  // The measured defect: getInitialReplicaIds handed out the declaration BY
+  // REFERENCE and replica wiring pushed into it, so a minted
+  // replace-replica-<hex> made replica_operations report a desired RF of 4
+  // where a fresh process reports 3. A replacement replica is a new IDENTITY;
+  // it does not restate policy.
+  const table = SYSTEM_TABLE_NAME.REPLICA_OPERATIONS;
+  const declaredLength = INITIAL_REPLICA_IDS[table].length;
+
+  const handedOut = getInitialReplicaIds(table);
+  assert.notEqual(handedOut, INITIAL_REPLICA_IDS[table],
+    'the declaration must not be handed out by reference');
+  handedOut.push(`${table}-p1-replace-replica-deadbeefdeadbeef`);
+
+  assert.equal(INITIAL_REPLICA_IDS[table].length, declaredLength,
+    'a caller mutating its copy cannot mutate the declaration');
+  assert.equal(getInitialReplicaIds(table).length, declaredLength);
+
+  // And the target is unmoved, because it never counted identities at all.
+  const target = resolveDesiredReplicationFactor({
+    partitionRow: {partition_id: `${table}-p1`},
+  });
+  assert.equal(target.replicationFactor, DECLARED_REPLICA_COUNT_DEFAULT);
+});
+
+test('every-critical-table-declares-the-same-target', () => {
+  // A fresh process reports 3 for all of them; this pins that the authority
+  // agrees, so no table silently carries a different requirement.
+  for (const tableName of Object.values(SYSTEM_TABLE_NAME)) {
+    const target = resolveDesiredReplicationFactor({
+      partitionRow: {partition_id: `${tableName}-p1`},
+    });
+    assert.equal(target.replicationFactor, 3, tableName);
+  }
+});
+
+test('authority-mints-no-runtime-state', () => {
+  const target = resolveDesiredReplicationFactor({
+    partitionRow: {partition_id: 'services-p1'},
+  });
+  assert.equal(Object.isFrozen(target), true);
+  assert.deepEqual(Object.keys(target).sort(),
+    ['replicationFactor', 'source']);
+  for (const key of ['holders', 'replicaIds', 'converged', 'ready']) {
+    assert.equal(Object.hasOwn(target, key), false,
+      `the target must not mint ${key}`);
+  }
+});
+
+test('witness-deterministic', () => {
+  const shape = () => JSON.stringify([
+    resolveDesiredReplicationFactor({}),
+    resolveDesiredReplicationFactor({partitionRow: {}}),
+    resolveDesiredReplicationFactor({partitionRow: {replica_count: 5}}),
+  ]);
+  const first = shape();
+  assert.equal(shape(), first);
+  assert.equal(shape(), first);
+});
