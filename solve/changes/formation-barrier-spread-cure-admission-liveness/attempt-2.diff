diff --git a/test/rebalancer/formation-barrier-recovery-mutation-admission.test.js b/test/rebalancer/formation-barrier-recovery-mutation-admission.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..877dd8ee60a46b9f144229d09c9a8fe3927ba75f
--- /dev/null
+++ b/test/rebalancer/formation-barrier-recovery-mutation-admission.test.js
@@ -0,0 +1,235 @@
+/**
+ * CL-044 residual falsifier: the recovery planner reaches operation creation,
+ * but the coordinator's strict readiness read can be replaced by a token-stale
+ * deferred snapshot that erases priorityRecovery.active. The already-proven
+ * operation-creation authority must survive the move handoff so admission does
+ * not veto the cure on the two dimensions that cure reopens.
+ *
+ * On the pre-fix candidate, the first two tests are intentionally RED: the
+ * owner-minted move carries no authority and admission re-derives the lane from
+ * the deferred snapshot. The remaining tests pin the fail-closed boundary.
+ */
+
+import {test} from '../../src/test-helpers/tap.js';
+import {
+  CONTROL_PLANE_READINESS_DIMENSION,
+  CONTROL_PLANE_READINESS_REASON,
+} from '../../src/control-plane/control-plane-readiness-constants.js';
+import {TOKEN_STATUS} from
+  '../../src/control-plane/readiness-planning-version-contract.js';
+import {ProvisioningAdmissionPolicy} from
+  '../../src/rebalancer/provisioning-admission-policy.js';
+import {REBALANCER_SKIP_REASON} from
+  '../../src/rebalancer/rebalancer-constants.js';
+import {UnifiedRebalancerFollowUpMove} from
+  '../../src/rebalancer/unified-rebalancer-follow-up-move.js';
+import {UnifiedRebalancerMoveExecution} from
+  '../../src/rebalancer/unified-rebalancer-move-execution.js';
+
+const LOCAL_NODE_ID = 'formation-seed';
+const TARGET_NODE_ID = 'formation-cohort-4';
+const PRIORITY_PARTITION_ID = 'sql_transactions-p1';
+const ORDINARY_PARTITION_ID = 'partition-ordinary';
+const RECOVERY_AUTHORITY_FIELD =
+  'priorityRecoveryOperationCreationRequired';
+
+function createPolicy(readiness) {
+  return new ProvisioningAdmissionPolicy({
+    nodeId: LOCAL_NODE_ID,
+    logger: {warn() {}},
+    delegates: {
+      getNodeId: () => LOCAL_NODE_ID,
+      getControlPlaneReadinessService: () => ({
+        getNodeReadinessSync: () => readiness,
+      }),
+    },
+  });
+}
+
+function buildDeferredReadiness() {
+  return {
+    nodeId: LOCAL_NODE_ID,
+    readinessPlanningTokenStatus: TOKEN_STATUS.STALE,
+    dimensions: {
+      [CONTROL_PLANE_READINESS_DIMENSION.CONTROL_PLANE_WRITABLE]: false,
+      [CONTROL_PLANE_READINESS_DIMENSION.METADATA_PUBLICATION_HEALTHY]: false,
+      [CONTROL_PLANE_READINESS_DIMENSION
+        .CONTROL_PLANE_RECOVERY_ELIGIBLE]: false,
+    },
+    projectionReadinessContract: {
+      priorityRecovery: {active: false, durableSpreadPending: true},
+    },
+    reasons: [{
+      code: CONTROL_PLANE_READINESS_REASON.PLANNING_SNAPSHOT_REFRESH_PENDING,
+    }],
+  };
+}
+
+function buildFreshClosedReadiness() {
+  return {
+    ...buildDeferredReadiness(),
+    readinessPlanningTokenStatus: TOKEN_STATUS.CURRENT,
+    reasons: [{code: 'control_plane_write_unhealthy'}],
+  };
+}
+
+function buildBackgroundMove(partitionId, authorized = false) {
+  return {
+    type: 'ADD',
+    partitionId,
+    entityId: partitionId,
+    nodeId: TARGET_NODE_ID,
+    controlPlaneMutationWorkClass: 'background',
+    ...(authorized ? {[RECOVERY_AUTHORITY_FIELD]: true} : {}),
+  };
+}
+
+function catchAdmissionError(policy, move) {
+  return Promise.resolve()
+    .then(() => policy.assertLocalControlPlaneMutationReady(move))
+    .catch((error) => error);
+}
+
+function buildOwnerMintedRecoveryMove() {
+  const rebalancer = Object.create(UnifiedRebalancerFollowUpMove.prototype);
+  rebalancer.entityId = PRIORITY_PARTITION_ID;
+  rebalancer.isPriorityRecoveryFollowUpOperationRequired = () => true;
+  rebalancer.resolvePriorityRecoveryFollowUpPartitionId = () =>
+    PRIORITY_PARTITION_ID;
+  rebalancer.resolvePriorityRecoveryFollowUpCurrentReplicas = (
+    _decision,
+    currentReplicas,
+  ) => currentReplicas;
+  rebalancer.resolvePriorityRecoveryFollowUpOwnerOperationObservation = () =>
+    null;
+  rebalancer.getHealthyReplicas = (replicas) => replicas;
+  rebalancer.resolvePriorityRecoveryFollowUpTargetReplicaCount = () => 3;
+  rebalancer.selectPriorityRecoveryFollowUpTargetNodeId = () => TARGET_NODE_ID;
+  rebalancer.buildPriorityRecoveryFollowUpSerialWaitMoveFields = () => ({});
+  rebalancer.selectPriorityRecoveryFollowUpSourceReplica = () => null;
+  rebalancer.getReadyNodeOccupiedReplicas = (replicas) => replicas;
+  rebalancer.isPriorityRecoveryFollowUpDeficitSatisfiedByInFlightAdds = () =>
+    false;
+
+  const currentReplicas = [
+    {node_id: LOCAL_NODE_ID, status: 'active'},
+    {node_id: 'formation-ready-2', status: 'active'},
+  ];
+  return rebalancer.buildPriorityRecoveryFollowUpMove({
+    decision: {decisionSnapshot: {semanticState: 'needs_operation'}},
+    currentReplicas,
+    targetState: {
+      targetReplicaCount: 3,
+      topologyTransitionSnapshot: {
+        inventory: {
+          entityId: PRIORITY_PARTITION_ID,
+          accounting: {activeCount: currentReplicas.length},
+          provenance: {topologyIncreaseUsable: true},
+        },
+      },
+    },
+  });
+}
+
+test('CL-044 recovery move minter carries the owner-issued operation-creation ' +
+  'authority into coordinator admission', (t) => {
+  const move = buildOwnerMintedRecoveryMove();
+
+  t.equal(move.type, 'add', 'fixture mints the real deficit ADD cure');
+  t.equal(
+    move[RECOVERY_AUTHORITY_FIELD],
+    true,
+    'the move must carry the authority already established by its decision',
+  );
+  t.end();
+});
+
+test('CL-044 coordinator request preserves the recovery operation-creation ' +
+  'authority', async (t) => {
+  const move = buildOwnerMintedRecoveryMove();
+  const requests = [];
+  const rebalancer = Object.create(UnifiedRebalancerMoveExecution.prototype);
+  rebalancer.entityId = PRIORITY_PARTITION_ID;
+  rebalancer.entityType = 'partition';
+  rebalancer.isShuttingDown = false;
+  rebalancer.resolveCoordinatorOperationType = (moveType) =>
+    moveType.toUpperCase();
+  rebalancer.resolvePublishedMembershipPlanningEpoch = () => 7;
+  rebalancer.buildRebalanceResult = (success, payload) => ({success, ...payload});
+  rebalancer.rebalanceCoordinator = {
+    getMoveSafetyError: async () => null,
+    createOperation: async (request) => {
+      requests.push(request);
+      return {operationId: 'formation-cure-op-1'};
+    },
+  };
+
+  await rebalancer.executeMoveViaCoordinator(move);
+
+  t.equal(requests.length, 1, 'one coordinator request is created');
+  t.equal(
+    requests[0][RECOVERY_AUTHORITY_FIELD],
+    true,
+    'the enumerating handoff cannot silently drop the owner capability',
+  );
+});
+
+test('CL-044 token-stale deferred readiness cannot veto an authorized ' +
+  'priority-recovery cure', async (t) => {
+  const policy = createPolicy(buildDeferredReadiness());
+  const error = await catchAdmissionError(
+    policy,
+    buildBackgroundMove(PRIORITY_PARTITION_ID, true),
+  );
+
+  t.equal(
+    error,
+    undefined,
+    'owner-authorized recovery actuation reopens the two deferred dimensions',
+  );
+});
+
+test('CL-044 token-stale deferred readiness still rejects a priority move ' +
+  'without operation-creation authority', async (t) => {
+  const policy = createPolicy(buildDeferredReadiness());
+  const error = await catchAdmissionError(
+    policy,
+    buildBackgroundMove(PRIORITY_PARTITION_ID),
+  );
+
+  t.equal(
+    error?.rebalanceSkipReason,
+    REBALANCER_SKIP_REASON.LOCAL_MUTATION_UNHEALTHY,
+    'a partition name alone cannot mint recovery admission authority',
+  );
+});
+
+test('CL-044 operation-creation authority cannot exempt ordinary partition ' +
+  'background churn', async (t) => {
+  const policy = createPolicy(buildDeferredReadiness());
+  const error = await catchAdmissionError(
+    policy,
+    buildBackgroundMove(ORDINARY_PARTITION_ID, true),
+  );
+
+  t.equal(
+    error?.rebalanceSkipReason,
+    REBALANCER_SKIP_REASON.LOCAL_MUTATION_UNHEALTHY,
+    'the admission exception remains priority-control-plane scoped',
+  );
+});
+
+test('CL-044 a fresh closed recovery lane rejects even a stale move ' +
+  'authority marker', async (t) => {
+  const policy = createPolicy(buildFreshClosedReadiness());
+  const error = await catchAdmissionError(
+    policy,
+    buildBackgroundMove(PRIORITY_PARTITION_ID, true),
+  );
+
+  t.equal(
+    error?.rebalanceSkipReason,
+    REBALANCER_SKIP_REASON.LOCAL_MUTATION_UNHEALTHY,
+    'only a deferred token-stale read may consume the cycle-owned authority',
+  );
+});
diff --git a/test/rebalancer/formation-barrier-spread-cure-lane-discrimination.test.js b/test/rebalancer/formation-barrier-spread-cure-lane-discrimination.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..4479abaf33297e14c9cd22b142a1e36cc6336750
--- /dev/null
+++ b/test/rebalancer/formation-barrier-spread-cure-lane-discrimination.test.js
@@ -0,0 +1,418 @@
+/**
+ * CL-044 fail-honest lane-discrimination witness.
+ *
+ * The fixture models the run-4 cold-formation split: three READY nodes and
+ * two startup-authority cohort members whose READY leases are withheld by the
+ * global formation barrier. Both joiners remain CONNECTED and are admitted by
+ * the real startup-authority placement predicate as spread-cure targets.
+ *
+ * Reverting the fix makes the first three tests fail: the cure subjects become
+ * topology-settling blockers, an in-flight ADD target wins the defer row above
+ * operation-creation-required, and progress edges retain the escalated
+ * interval. The lane pin uses placement-ineligible transitional members to
+ * prove the priority blocked-spread sleep is not the binding branch.
+ */
+
+import {test} from '../../src/test-helpers/tap.js';
+import {
+  EntityType,
+  UnifiedRebalancer,
+} from '../../src/rebalancer/unified-rebalancer.js';
+import {
+  REBALANCE_COORDINATOR_EVENT,
+} from '../../src/rebalancer/rebalancer-constants.js';
+import {
+  REBALANCE_PLANNING_GATE,
+  TOPOLOGY_SETTLING_PLANNING_STATE,
+} from '../../src/rebalancer/rebalancer-planning-gate-constants.js';
+import {
+  CONTROL_PLANE_READINESS_DIMENSION,
+} from '../../src/control-plane/control-plane-readiness-constants.js';
+import {ConfigurationManager} from '../../src/config/configuration-manager.js';
+import {LoggingService} from '../../src/logging/logging-service.js';
+
+const FAKE_NOW_MS = 1_800_000_000_000;
+const READY_LEASE_EXPIRES_AT_MS = FAKE_NOW_MS + 600_000;
+const SEED_NODE_ID = 'formation-seed';
+const READY_NODE_IDS = Object.freeze([
+  SEED_NODE_ID,
+  'formation-ready-2',
+  'formation-ready-3',
+]);
+const COHORT_NODE_IDS = Object.freeze([
+  'formation-cohort-4',
+  'formation-cohort-5',
+]);
+const STARTUP_AUTHORITY_NODE_IDS = Object.freeze([
+  ...READY_NODE_IDS,
+  ...COHORT_NODE_IDS,
+]);
+const PRIORITY_PARTITION_ID = 'control_plane_publications-p1';
+const OPEN_SPREAD_GAP = 1;
+const TARGET_REPLICA_COUNT = 3;
+const TERMINAL_OPERATION_ID = 'formation-cure-add-1';
+
+function initializeTestEnvironment() {
+  ConfigurationManager.resetInstance();
+  const config = ConfigurationManager.getInstance();
+  if (!config.isInitialized()) {
+    config.initialize({
+      node: {id: SEED_NODE_ID},
+      logging: {level: 'error'},
+    });
+  }
+  const logging = LoggingService.getInstance();
+  if (!logging.isInitialized()) {
+    logging.initialize({level: 'error'});
+  }
+}
+
+function createNodeRows() {
+  return [
+    ...READY_NODE_IDS.map((nodeId) => ({
+      node_id: nodeId,
+      status: 'active',
+      connection_state: 'ready',
+      ready_lease_expires_at: READY_LEASE_EXPIRES_AT_MS,
+    })),
+    ...COHORT_NODE_IDS.map((nodeId) => ({
+      node_id: nodeId,
+      status: 'joining',
+      connection_state: 'connected',
+      ready_lease_expires_at: 0,
+    })),
+  ];
+}
+
+function createCache() {
+  const rows = {
+    nodes: createNodeRows(),
+    partitions: [
+      {
+        partition_id: PRIORITY_PARTITION_ID,
+        table_id: 'control_plane_publications',
+      },
+    ],
+    tables: [],
+    services: [],
+    replica_operations: [],
+    node_endpoints: READY_NODE_IDS.map((nodeId) => ({
+      node_id: nodeId,
+      transport_type: 'ws',
+      status: 'active',
+    })),
+    service_endpoints: READY_NODE_IDS.map((nodeId) => ({
+      node_id: nodeId,
+      service_id: 'sys-postgres-wire',
+      health_status: 'healthy',
+    })),
+    control_plane_publications: [],
+  };
+  return {
+    get(tableName, key) {
+      return (rows[tableName] || []).find((row) =>
+        row.node_id === key || row.partition_id === key,
+      ) || null;
+    },
+    getAll(tableName) {
+      return rows[tableName] || [];
+    },
+    filter(tableName, predicate) {
+      return (rows[tableName] || []).filter(predicate);
+    },
+  };
+}
+
+function buildReadiness(nodeId) {
+  const ready = READY_NODE_IDS.includes(nodeId);
+  return {
+    nodeId,
+    dimensions: {
+      [CONTROL_PLANE_READINESS_DIMENSION.PROCESS_ALIVE]: true,
+      [CONTROL_PLANE_READINESS_DIMENSION.CLUSTER_MEMBER_HEALTHY]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION.ROUTING_READY]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION.LOAD_READY]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION.PLACEMENT_ELIGIBLE]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION.CONTROL_PLANE_WRITABLE]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION.REPAIR_ELIGIBLE]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION
+        .CONTROL_PLANE_RECOVERY_ELIGIBLE]: ready,
+      [CONTROL_PLANE_READINESS_DIMENSION.SERVE_ELIGIBLE]: ready,
+    },
+    reasons: ready ? [] : [{code: 'ready_lease_missing'}],
+  };
+}
+
+function createReadinessService() {
+  const publicationRow = {
+    status: 'PUBLISHED',
+    priorityPartitionSummary: {
+      satisfied: false,
+      blockedPartitions: buildOpenSpreadBlocker().blockedPartitions,
+    },
+  };
+  return {
+    getNodeReadinessSync: buildReadiness,
+    membershipPublicationService: {
+      getLatestClusterPublicationSync: () => publicationRow,
+      getLatestPublishedClusterPublicationSync: () => publicationRow,
+    },
+    getStartupAuthoritySnapshotSync() {
+      return {
+        authorityAvailable: true,
+        ready: false,
+        state: 'recovery_pending',
+        priorityRecoveryActive: true,
+        priorityRecoveryReasonCodes: ['priority_partitions_not_spread'],
+        canonicalStartupNodeIds: [...STARTUP_AUTHORITY_NODE_IDS],
+      };
+    },
+  };
+}
+
+function createCoordinator() {
+  return {
+    getMoveSafetyError: () => null,
+    getStats: () => ({inFlightOperations: 0, totalOperations: 0}),
+    storageAccountingService: {estimateReplicaBytes: () => 1},
+    storageAdmissionService: {
+      checkAdd: async () => ({decision: 'allow'}),
+      checkReplace: async () => ({decision: 'allow'}),
+    },
+  };
+}
+
+function buildOpenSpreadBlocker() {
+  return {
+    requiredDistinctNodeCount: TARGET_REPLICA_COUNT,
+    blockedPartitions: [{
+      partitionId: PRIORITY_PARTITION_ID,
+      expectedReplicaCount: TARGET_REPLICA_COUNT,
+      readyReplicaCount: TARGET_REPLICA_COUNT,
+      readyDistinctNodeCount: TARGET_REPLICA_COUNT - OPEN_SPREAD_GAP,
+      spreadGap: OPEN_SPREAD_GAP,
+      exclusionReasonCounts: {ready_lease_missing: COHORT_NODE_IDS.length},
+    }],
+  };
+}
+
+function createRebalancer(
+  entityId = PRIORITY_PARTITION_ID,
+  options = {},
+) {
+  const rebalancer = new UnifiedRebalancer({
+    entityId,
+    entityType: EntityType.PARTITION,
+    nodeId: SEED_NODE_ID,
+    systemTableCache: createCache(),
+    cdcIntegrationService: {
+      insertSystemTableRow: async () => ({success: true}),
+      updateSystemTableRow: async () => ({success: true}),
+    },
+    tablePolicyService: {
+      getPolicyForPartition: () => ({targetReplicaCount: TARGET_REPLICA_COUNT}),
+    },
+    messageRouter: {
+      getConnectionState: (nodeId) =>
+        options.disconnectCohort === true && COHORT_NODE_IDS.includes(nodeId) ?
+          'disconnected' :
+          'connected',
+      getConnectedNodes: () => [...STARTUP_AUTHORITY_NODE_IDS],
+      isOutboundQueueAvailable: () => true,
+    },
+    rebalanceCoordinator: createCoordinator(),
+    sqlQueryEngine: {
+      async executeQuery() {
+        return {success: true, rows: []};
+      },
+    },
+    controlPlaneReadinessService: createReadinessService(),
+    nowFn: () => FAKE_NOW_MS,
+    randomSource: {random: () => 0},
+  });
+  rebalancer.getControlPlanePrioritySpreadBlocker = buildOpenSpreadBlocker;
+  return rebalancer;
+}
+
+function assertRecoveryCohortTargets(t, rebalancer) {
+  const availableNodeIds = rebalancer.getAvailableNodes()
+    .map((node) => node.node_id);
+  for (const cohortNodeId of COHORT_NODE_IDS) {
+    t.ok(
+      availableNodeIds.includes(cohortNodeId),
+      `${cohortNodeId} is admitted by the real recovery-target predicate`,
+    );
+  }
+}
+
+test('CL-044 cohort-not-a-blocker: valid barrier-held recovery targets do ' +
+  'not defer priority cure planning', async (t) => {
+  initializeTestEnvironment();
+  const rebalancer = createRebalancer();
+
+  assertRecoveryCohortTargets(t, rebalancer);
+  const blocker = rebalancer.getCriticalSystemTopologySettlingBlocker();
+  t.equal(
+    blocker,
+    null,
+    'valid cohort members do not produce NODE_READY_LEASE_INCOMPLETE',
+  );
+
+  const decision = await rebalancer.resolveTopologySettlingPlanningGateDecision();
+  t.equal(
+    decision,
+    null,
+    `valid recovery-cohort cure targets must not defer planning; blocker=${JSON.stringify(blocker)}`,
+  );
+});
+
+test('CL-044 target-in-flight: a cure ADD aimed at a barrier-held cohort ' +
+  'member does not win the defer row', (t) => {
+  initializeTestEnvironment();
+  const rebalancer = createRebalancer();
+  assertRecoveryCohortTargets(t, rebalancer);
+  const targetNodeId = COHORT_NODE_IDS[0];
+  const blocker = {
+    reason: 'topology_operations_in_flight',
+    inFlightReplicaOperations: 1,
+    inFlightReplicaOperationDetails: [{
+      operationId: TERMINAL_OPERATION_ID,
+      partitionId: PRIORITY_PARTITION_ID,
+      targetNodeId,
+      operationType: 'add',
+    }],
+  };
+  const evaluationContext = {
+    resolvePriorityRecoveryOperationCreationGate: () => ({
+      operationCreationRequired: true,
+      operationCreationPartitionId: PRIORITY_PARTITION_ID,
+      operationCreationScope: 'current_partition',
+    }),
+  };
+
+  const snapshot = rebalancer.buildTopologySettlingPlanningGateSnapshot(
+    blocker,
+    evaluationContext,
+  );
+  t.equal(
+    snapshot.shouldDefer,
+    false,
+    `cure target ${targetNodeId} is a cohort member, not a target-in-flight blocker; state=${snapshot.planningState}`,
+  );
+
+  const nonAddSnapshot = rebalancer.buildTopologySettlingPlanningGateSnapshot(
+    {
+      ...blocker,
+      inFlightReplicaOperationDetails: [{
+        ...blocker.inFlightReplicaOperationDetails[0],
+        operationType: 'remove',
+      }],
+    },
+    evaluationContext,
+  );
+  t.equal(
+    nonAddSnapshot.shouldDefer,
+    true,
+    'non-ADD operations targeting cohort members retain serialization',
+  );
+  t.equal(
+    nonAddSnapshot.planningState,
+    TOPOLOGY_SETTLING_PLANNING_STATE.TOPOLOGY_OPERATION_TARGET_IN_FLIGHT,
+    'the exception is scoped to the ADD that cures the spread gap',
+  );
+  t.end();
+});
+
+test('CL-044 operation-terminal edge resets an escalated settle interval ' +
+  'to the priority base cadence', (t) => {
+  initializeTestEnvironment();
+  const rebalancer = createRebalancer();
+  rebalancer.isLeader = true;
+  const enqueuedReasons = [];
+  rebalancer.enqueueRebalanceCheck = (reason) => {
+    enqueuedReasons.push(reason);
+    return true;
+  };
+  rebalancer.currentInterval = rebalancer.maxInterval;
+
+  const handled = rebalancer.handleCoordinatorProgressEvent(
+    REBALANCE_COORDINATOR_EVENT.OPERATION_COMPLETED,
+    {
+      operation: {
+        operationId: TERMINAL_OPERATION_ID,
+        entityType: EntityType.PARTITION,
+        entityId: PRIORITY_PARTITION_ID,
+        partitionId: PRIORITY_PARTITION_ID,
+        targetNodeId: COHORT_NODE_IDS[0],
+      },
+    },
+  );
+
+  t.equal(handled, true, 'the existing terminal edge re-enqueues evaluation');
+  t.equal(enqueuedReasons.length, 1, 'one terminal edge produces one wake');
+  t.equal(
+    rebalancer.currentInterval,
+    rebalancer.getPriorityRetryDelayMs(),
+    'terminal progress re-arms the next evaluation at base cadence',
+  );
+
+  rebalancer.currentInterval = rebalancer.maxInterval;
+  const visibilityHandled = rebalancer.handlePriorityRecoveryVisibilityEvent({
+    tableName: 'services',
+    operation: 'UPDATE',
+    data: {
+      service_id: 'formation-cure-service',
+      node_id: COHORT_NODE_IDS[0],
+      partition_id: PRIORITY_PARTITION_ID,
+      service_type: 'partition',
+      status: 'active',
+    },
+  });
+  t.equal(
+    visibilityHandled,
+    true,
+    'the existing placement-visibility edge re-enqueues evaluation',
+  );
+  t.equal(
+    rebalancer.currentInterval,
+    rebalancer.getPriorityRetryDelayMs(),
+    'placement visibility re-arms the next evaluation at base cadence',
+  );
+  t.end();
+});
+
+test('CL-044 lane pin: settle-gate escalation binds while the blocked-spread ' +
+  'sleep is not applicable to priority partitions', async (t) => {
+  initializeTestEnvironment();
+  const settlingRebalancer = createRebalancer(
+    PRIORITY_PARTITION_ID,
+    {disconnectCohort: true},
+  );
+  const baseSettleIntervalMs = settlingRebalancer.currentInterval;
+  const settleDecision =
+    await settlingRebalancer.resolveTopologySettlingPlanningGateDecision();
+
+  t.equal(
+    settleDecision?.gate,
+    REBALANCE_PLANNING_GATE.TOPOLOGY_SETTLING,
+    'the run-4 cohort state reaches topology settling',
+  );
+  t.ok(
+    settleDecision.scheduleDelayMs > baseSettleIntervalMs,
+    'topology settling consumes the escalating 75-120s interval lane',
+  );
+
+  const priorityRebalancer = createRebalancer();
+  const prioritySpreadDecision =
+    priorityRebalancer.resolvePrioritySpreadPlanningGateDecision();
+  t.equal(
+    prioritySpreadDecision,
+    null,
+    'the 70-80s blocked-spread branch is NOT_APPLICABLE to priority partitions',
+  );
+  t.not(
+    settleDecision?.logContext?.planningState,
+    TOPOLOGY_SETTLING_PLANNING_STATE.CLEAR,
+    'lane discrimination remains pinned to the settle-gate state',
+  );
+});
