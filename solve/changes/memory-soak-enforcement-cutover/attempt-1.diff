diff --git a/scripts/checks/run-memory-soak-enforcement-cutover-scenarios.js b/scripts/checks/run-memory-soak-enforcement-cutover-scenarios.js
new file mode 100644
index 0000000000000000000000000000000000000000..8de786e19fbcd68f8cebfd7ee60fa280b915d876
