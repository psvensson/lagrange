+test(
+  'RebalanceCoordinator admits only a typed priority-recovery relocation ' +
+    'when the services owner is transiently unavailable',
+  async (t) => {
+    initializeTestEnvironment();
+    const partitionId = 'sql_write_operations-p1';
+    const sourceNode = 'source-node';
+    const peerNode = 'peer-node';
+    const thirdNode = 'third-node';
+    const targetNode = 'target-node';
+    const sourceReplicaId = `${partitionId}-r1`;
+    const services = [
+      createServiceRow(sourceReplicaId, sourceNode, {partitionId}),
+      createServiceRow(`${partitionId}-r2`, peerNode, {partitionId}),
+      createServiceRow(`${partitionId}-r3`, thirdNode, {partitionId}),
+    ];
+    const ownerRead = async (tableName) => {
+      if (tableName === 'services') {
+        return {
+          success: false,
+          rows: [],
+          error: 'services owner transiently unavailable',
+        };
+      }
+      if (tableName === 'replica_operations') {
+        return {
+          success: true,
+          rows: [{
+            operation_id: 'non-conflicting-operation',
+            type: 'ADD',
+            entity_type: SERVICE_TYPE.PARTITION,
+            entity_id: partitionId,
+            partition_id: partitionId,
+            target_node_id: 'prior-target-node',
+            replica_id: `${partitionId}-prior-target`,
+            status: 'pending',
+            workflow_step: 'sending',
+          }],
+        };
+      }
+      return {success: true, rows: []};
+    };
+    let recoveryInventory = null;
+    const {coordinator} = createCoordinator({
+      cacheNodes: [sourceNode, peerNode, thirdNode, targetNode].map(
+        (nodeId) => ({node_id: nodeId, connection_state: 'ready'}),
+      ),
+      cacheServices: services,
+      cachePartitions: [{partition_id: partitionId, replica_count: 3}],
+      controlPlaneSystemTableGateway: {
+        readAuthoritativeRows: ownerRead,
+        readRows: ownerRead,
+        executeQuery: async () => ({success: true, rows: []}),
+      },
+      replicaInventoryBuilder: (options) => {
+        recoveryInventory = buildReplicaInventorySnapshot(options);
+        return recoveryInventory;
+      },
+    });
+    const context = {
+      normalizedMoveType: TEST_REPLACE_OPERATION_TYPE,
+      entityType: SERVICE_TYPE.PARTITION,
+      entityId: partitionId,
+      partitionId,
+      move: {
+        nodeId: targetNode,
+        replicaId: sourceReplicaId,
+        placementCureCondition: 'unhealthy_source_at_target',
+        enforceConcurrentOperationBudget: true,
+      },
+    };
+
+    const recovery = await coordinator.buildTopologyGuardSnapshot(context);
+    t.equal(recovery.state, 'allowed',
+      'the typed count-neutral recovery cure may use the safe cache actuals');
+    t.equal(
+      recoveryInventory?.provenance?.inFlightOperationsState,
+      'present',
+      'the live owner-unavailable shape retains a usable operation observation',
+    );
+
+    const ordinaryReplace = await coordinator.buildTopologyGuardSnapshot({
+      ...context,
+      move: {...context.move, placementCureCondition: undefined},
+    });
+    t.equal(ordinaryReplace.state, 'inventory_unusable',
+      'an ordinary REPLACE remains fail-closed');
+
+    const differentCure = await coordinator.buildTopologyGuardSnapshot({
+      ...context,
+      move: {...context.move, placementCureCondition: 'paired_relocation'},
+    });
+    t.equal(differentCure.state, 'inventory_unusable',
+      'a different placement cure cannot impersonate priority recovery');
+
+    const occupiedTarget = await coordinator.buildTopologyGuardSnapshot({
+      ...context,
+      move: {...context.move, nodeId: peerNode},
+    });
+    t.equal(occupiedTarget.state, 'target_node_occupied',
+      'the typed cure never permits two replicas on one node');
+
+    const missingSource = await coordinator.buildTopologyGuardSnapshot({
+      ...context,
+      move: {...context.move, replicaId: `${partitionId}-missing`},
+    });
+    t.equal(missingSource.state, 'inventory_unusable',
+      'the typed cure must name an actual cache-visible source');
+
+    const genericAdd = await coordinator.buildTopologyGuardSnapshot({
+      ...context,
+      normalizedMoveType: TEST_ADD_OPERATION_TYPE,
+      move: {...context.move, replicaId: null},
+    });
+    t.equal(genericAdd.state, 'inventory_unusable',
+      'an owner-unavailable ADD never inherits the relocation exception');
+    coordinator.shutdown();
+
+    const {coordinator: operationOwnerUnavailable} = createCoordinator({
+      cacheNodes: [sourceNode, peerNode, thirdNode, targetNode].map(
+        (nodeId) => ({node_id: nodeId, connection_state: 'ready'}),
+      ),
+      cacheServices: services,
+      cachePartitions: [{partition_id: partitionId, replica_count: 3}],
+      controlPlaneSystemTableGateway: {
+        readAuthoritativeRows: ownerRead,
+        readRows: ownerRead,
+        executeQuery: async () => ({success: true, rows: []}),
+      },
+      replicaInventoryBuilder: (options) => buildReplicaInventorySnapshot({
+        ...options,
+        inFlightOperationObservation: {
+          ...options.inFlightOperationObservation,
+          state: 'unavailable',
+        },
+      }),
+    });
+    const unavailableOperations =
+      await operationOwnerUnavailable.buildTopologyGuardSnapshot(context);
+    t.equal(unavailableOperations.state, 'inventory_unusable',
+      'unavailable operation visibility keeps the typed cure fail-closed');
+    operationOwnerUnavailable.shutdown();
+
+    const failedSourceServices = services.map((row) =>
+      row.replica_id === sourceReplicaId ? {...row, status: 'failed'} : row,
+    );
+    const {coordinator: failedSourceCoordinator} = createCoordinator({
+      cacheNodes: [sourceNode, peerNode, thirdNode, targetNode].map(
+        (nodeId) => ({node_id: nodeId, connection_state: 'ready'}),
+      ),
+      cacheServices: failedSourceServices,
+      cachePartitions: [{partition_id: partitionId, replica_count: 3}],
+      controlPlaneSystemTableGateway: {
+        readAuthoritativeRows: ownerRead,
+        readRows: ownerRead,
+        executeQuery: async () => ({success: true, rows: []}),
+      },
+    });
+    const failedSource =
+      await failedSourceCoordinator.buildTopologyGuardSnapshot(context);
+    t.equal(failedSource.state, 'inventory_unusable',
