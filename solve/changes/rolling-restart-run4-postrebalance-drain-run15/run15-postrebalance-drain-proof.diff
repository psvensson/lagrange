+const RUN15_IN_FLIGHT_REPLICA_OPERATION_COUNT = 6;
+const RUN15_STALE_IN_FLIGHT_REPLICA_OPERATION_COUNT = 3;
+const RUN15_EFFECTIVE_IN_FLIGHT_REPLICA_OPERATION_COUNT = 2;
