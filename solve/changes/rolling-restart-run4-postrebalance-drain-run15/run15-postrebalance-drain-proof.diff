@@ -105,0 +116,4 @@ const TARGET_VOTER_COUNTS = Object.freeze({
+const RUN15_OVERTARGET_DURATIONS = Object.freeze({
+  [RUN15_OVERTARGET_PARTITION_ONE]: RUN15_MAX_OVERTARGET_MS,
