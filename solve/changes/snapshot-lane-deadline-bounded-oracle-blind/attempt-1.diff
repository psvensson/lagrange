+const SNAPSHOT_LANE_DEADLINE_BOUNDED_OUTCOME = 'deadline_bounded';
+
+function isDeadlineBoundedSnapshotCoverage(snapshotCoverage) {
+  return snapshotCoverage?.laneOutcome ===
+    SNAPSHOT_LANE_DEADLINE_BOUNDED_OUTCOME;
+}
