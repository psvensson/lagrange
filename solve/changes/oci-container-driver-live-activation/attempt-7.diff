+    durableStateError(OCI_HOST_AGENT_DURABLE_ERROR.RETIREMENT_REQUIRED);
+  }
+  requireDiscardedEngineDataRoot(options);
+  const lock = acquireDirectoryLock(options.authorityRoot, options.lockOptions);
