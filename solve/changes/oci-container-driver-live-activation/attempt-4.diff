+    assert.throws(
+      () => parseExactOciHostAgentJson('{"a":1,"\\u0061":2}'),
+      (error) => error.code ===
+        OCI_HOST_AGENT_PROTOCOL_ERROR.DUPLICATE_OBJECT_KEY,
+    );
+    assert.throws(
+      () => parseExactOciHostAgentJson(Buffer.from([0xc3, 0x28])),
+      (error) => error.code ===
