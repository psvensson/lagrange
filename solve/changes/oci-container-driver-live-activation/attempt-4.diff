+    assert.throws(
+      () => encodeOciHostAgentResponseFrame(responseEnvelope(request, {
+        result: resultFor('ambiguous', 'create', {
+          errorCode: 'engine_outcome_unknown',
+          lastObservation: {kind: 'not_observed'},
