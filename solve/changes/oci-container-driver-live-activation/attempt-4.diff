+    maximumBytes,
+    pattern: OWNER_ID_PATTERN,
+  });
+}
+
+function assertKeyId(value) {
+  assertCleanString(value, {
+    maximumBytes: MAXIMUM.KEY_ID_BYTES,
+    pattern: KEY_ID_PATTERN,
+  });
+}
+
