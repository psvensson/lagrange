+  OPERATION_ID_BYTES: 128,
+  KEY_ID_BYTES: 128,
+  AGENT_ID_BYTES: 128,
+  ARTIFACT_REF_BYTES: 2_048,
+  ENTRYPOINT_ITEMS: 32,
+  ARG_ITEMS: 128,
+  COMMAND_ITEM_BYTES: 4_096,
+  ENVIRONMENT_ITEMS: 128,
+  SECRET_ITEMS: 32,
+  ENVIRONMENT_VALUE_BYTES: 8_192,
+  PORT_ITEMS: 32,
+  CONTAINER_PORT: 65_535,
