+const REJECTED_ERROR_CODE = new Set([
+  'invalid_request',
+  'deadline_invalid',
+  'unsupported_operation',
+  'policy_denied',
+  'credential_unavailable',
+  'digest_mismatch',
+  'identity_conflict',
+  'intent_conflict',
+  'resource_conflict',
