+    assert.throws(
+      () => encodeOciHostAgentResponseFrame(responseEnvelope(request, {
+        result: resultFor('retryable_failure', 'create', {
+          errorCode: 'cleanup_incomplete',
+          lastObservation: {kind: 'not_observed'},
+          cleanup: {
+            state: 'retryable',
