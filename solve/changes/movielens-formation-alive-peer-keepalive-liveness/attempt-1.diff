+function buildRecentPeerLivenessEvidence(
+  lastInboundAt,
+  livenessWindowMs,
+  nowMs = Date.now(),
+) {
+  const lastInboundAgoMs = nowMs - lastInboundAt;
+  return {
+    lastInboundAgoMs,
+    recent:
+      Number.isFinite(livenessWindowMs) &&
+      livenessWindowMs > TRANSPORT_NUM.ZERO &&
+      Number.isFinite(lastInboundAt) &&
