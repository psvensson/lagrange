diff --git a/src/diagnostics/playback-evidence-file.js b/src/diagnostics/playback-evidence-file.js
new file mode 100644
index 0000000000000000000000000000000000000000..e90b3915076581e0e04c00d2df717d97191df111
--- /dev/null
+++ b/src/diagnostics/playback-evidence-file.js
@@ -0,0 +1,268 @@
+/**
+ * Shared playback snapshot evidence codec and artifact resolver.
+ *
+ * Logical snapshot paths retain the historical `snapshots.ndjson` name. New
+ * captures are written to the adjacent `.gz` artifact; exact paths always win
+ * so retained plain-text evidence remains readable without migration.
+ */
+
+import {createReadStream, createWriteStream, lstatSync, readFileSync} from 'node:fs';
+import {lstat, readFile, rm} from 'node:fs/promises';
+import {Transform} from 'node:stream';
+import {once} from 'node:events';
+import {pipeline} from 'node:stream/promises';
+import {
+  createGunzip,
+  createGzip,
+  gunzip,
+  gunzipSync,
+  constants as zlibConstants,
+} from 'node:zlib';
+import {promisify} from 'node:util';
+
+const GZIP_SUFFIX = '.gz';
+const NEWLINE = '\n';
+const UTF8_ENCODING = 'utf8';
+const FILE_FLAGS_TRUNCATE = 'w';
+const EMPTY_BUFFER = Buffer.alloc(0);
+const ERROR_CODE_MISSING_FILE = 'ENOENT';
+const STREAM_EVENT_ERROR = 'error';
+const STREAM_EVENT_CLOSE = 'close';
+const STREAM_EVENT_OPEN = 'open';
+const STREAM_EVENT_DRAIN = 'drain';
+const ERROR_MESSAGE_OUTPUT_CLOSED_EARLY =
+  'Playback evidence output closed before opening';
+const ERROR_MESSAGE_WRITER_CLOSED = 'Playback evidence writer is closed';
+const ERROR_MESSAGE_CAPTURE_ABORTED = 'Playback evidence capture aborted';
+const gunzipAsync = promisify(gunzip);
+
+function isMissingFileError(error) {
+  return error?.code === ERROR_CODE_MISSING_FILE;
+}
+
+function gzipPlaybackEvidencePath(logicalPath) {
+  return logicalPath.endsWith(GZIP_SUFFIX) ?
+    logicalPath :
+    logicalPath + GZIP_SUFFIX;
+}
+
+function resolvePlaybackEvidencePathSync(requestedPath) {
+  try {
+    lstatSync(requestedPath);
+    return requestedPath;
+  } catch (error) {
+    if (!isMissingFileError(error)) {
+      throw error;
+    }
+  }
+  if (requestedPath.endsWith(GZIP_SUFFIX)) {
+    return null;
+  }
+  const compressedPath = gzipPlaybackEvidencePath(requestedPath);
+  try {
+    lstatSync(compressedPath);
+    return compressedPath;
+  } catch (error) {
+    if (isMissingFileError(error)) {
+      return null;
+    }
+    throw error;
+  }
+}
+
+async function resolvePlaybackEvidencePath(requestedPath) {
+  try {
+    await lstat(requestedPath);
+    return requestedPath;
+  } catch (error) {
+    if (!isMissingFileError(error)) {
+      throw error;
+    }
+  }
+  if (requestedPath.endsWith(GZIP_SUFFIX)) {
+    return null;
+  }
+  const compressedPath = gzipPlaybackEvidencePath(requestedPath);
+  try {
+    await lstat(compressedPath);
+    return compressedPath;
+  } catch (error) {
+    if (isMissingFileError(error)) {
+      return null;
+    }
+    throw error;
+  }
+}
+
+function requireResolvedPath(requestedPath, resolvedPath) {
+  if (resolvedPath) {
+    return resolvedPath;
+  }
+  readFileSync(requestedPath);
+  return requestedPath;
+}
+
+function readPlaybackEvidenceFileSync(requestedPath, encoding = UTF8_ENCODING) {
+  const resolvedPath = requireResolvedPath(
+    requestedPath,
+    resolvePlaybackEvidencePathSync(requestedPath),
+  );
+  const payload = readFileSync(resolvedPath);
+  const decoded = resolvedPath.endsWith(GZIP_SUFFIX) ?
+    gunzipSync(payload) :
+    payload;
+  return encoding ? decoded.toString(encoding) : decoded;
+}
+
+async function readPlaybackEvidenceFile(requestedPath, encoding = UTF8_ENCODING) {
+  const resolvedPath = await resolvePlaybackEvidencePath(requestedPath);
+  const payload = await readFile(resolvedPath || requestedPath);
+  const decoded = resolvedPath?.endsWith(GZIP_SUFFIX) ?
+    await gunzipAsync(payload) :
+    payload;
+  return encoding ? decoded.toString(encoding) : decoded;
+}
+
+class CompleteNdjsonRecords extends Transform {
+  constructor() {
+    super();
+    this._remainder = EMPTY_BUFFER;
+  }
+
+  _transform(chunk, _encoding, callback) {
+    const combined = this._remainder.length === 0 ?
+      chunk :
+      Buffer.concat([this._remainder, chunk]);
+    const lastNewline = combined.lastIndexOf(NEWLINE);
+    if (lastNewline < 0) {
+      this._remainder = combined;
+      callback();
+      return;
+    }
+    this.push(combined.subarray(0, lastNewline + 1));
+    this._remainder = combined.subarray(lastNewline + 1);
+    callback();
+  }
+}
+
+function pipeWithErrorForwarding(source, destination) {
+  source.on(STREAM_EVENT_ERROR, (error) => destination.destroy(error));
+  // Tear the producer down when the consumer goes away so an aborted
+  // download can never leak the underlying file descriptor.
+  destination.on(STREAM_EVENT_CLOSE, () => source.destroy());
+  return source.pipe(destination);
+}
+
+async function createPlaybackEvidenceReadStream(requestedPath, options = {}) {
+  const resolvedPath = await resolvePlaybackEvidencePath(requestedPath);
+  const filePath = resolvedPath || requestedPath;
+  const source = createReadStream(filePath);
+  if (!filePath.endsWith(GZIP_SUFFIX)) {
+    return source;
+  }
+  const active = options.allowIncomplete === true;
+  const gunzipOptions = active ?
+    {finishFlush: zlibConstants.Z_SYNC_FLUSH} :
+    {};
+  const decoded = pipeWithErrorForwarding(source, createGunzip(gunzipOptions));
+  return active ?
+    pipeWithErrorForwarding(decoded, new CompleteNdjsonRecords()) :
+    decoded;
+}
+
+function waitForWrite(stream, value) {
+  let resolveWrite;
+  let rejectWrite;
+  const callbackResult = new Promise((resolve, reject) => {
+    resolveWrite = resolve;
+    rejectWrite = reject;
+  });
+  const accepted = stream.write(value, (error) => {
+    if (error) {
+      rejectWrite(error);
+      return;
+    }
+    resolveWrite();
+  });
+  const drainResult = accepted ?
+    Promise.resolve() :
+    once(stream, STREAM_EVENT_DRAIN);
+  return Promise.all([callbackResult, drainResult]);
+}
+
+function flushGzip(stream) {
+  return new Promise((resolve, reject) => {
+    stream.flush(zlibConstants.Z_SYNC_FLUSH, (error) => {
+      if (error) {
+        reject(error);
+        return;
+      }
+      resolve();
+    });
+  });
+}
+
+async function createPlaybackEvidenceWriter(targetPath) {
+  const destination = createWriteStream(targetPath, {
+    flags: FILE_FLAGS_TRUNCATE,
+  });
+  const gzip = createGzip();
+  const pipelineResult = pipeline(gzip, destination);
+  pipelineResult.catch(() => {});
+  await Promise.race([
+    once(destination, STREAM_EVENT_OPEN),
+    pipelineResult.then(() => {
+      throw new Error(ERROR_MESSAGE_OUTPUT_CLOSED_EARLY);
+    }),
+  ]);
+
+  let tail = Promise.resolve();
+  let closed = false;
+  let failure = null;
+  const latchFailure = (error) => {
+    failure ||= error;
+  };
+
+  return {
+    path: targetPath,
+    appendRecord(record) {
+      if (closed) {
+        return Promise.reject(new Error(ERROR_MESSAGE_WRITER_CLOSED));
+      }
+      tail = tail.then(async () => {
+        if (failure) {
+          throw failure;
+        }
+        await waitForWrite(gzip, JSON.stringify(record) + NEWLINE);
+        await flushGzip(gzip);
+      });
+      tail.catch(latchFailure);
+      return tail;
+    },
+    async close() {
+      closed = true;
+      await tail;
+      gzip.end();
+      await pipelineResult;
+      if (failure) {
+        throw failure;
+      }
+    },
+    async abort() {
+      closed = true;
+      gzip.destroy(failure || new Error(ERROR_MESSAGE_CAPTURE_ABORTED));
+      await pipelineResult.catch(() => {});
+      await rm(targetPath, {force: true});
+    },
+  };
+}
+
+export {
+  createPlaybackEvidenceReadStream,
+  createPlaybackEvidenceWriter,
+  gzipPlaybackEvidencePath,
+  readPlaybackEvidenceFile,
+  readPlaybackEvidenceFileSync,
+  resolvePlaybackEvidencePath,
+  resolvePlaybackEvidencePathSync,
+};
diff --git a/test/admin/admin-test-run-output-asset.test.js b/test/admin/admin-test-run-output-asset.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..70add175dd9fbdfac33333a381347f39af177bf8
--- /dev/null
+++ b/test/admin/admin-test-run-output-asset.test.js
@@ -0,0 +1,198 @@
+/**
+ * Output-asset serving tests for AdminTestRunService: legacy plain
+ * playback evidence, compressed sibling fallback, running-run
+ * incomplete-gzip tolerance, and strict decoding for archived evidence.
+ */
+
+import {Buffer} from 'node:buffer';
+import {mkdir, mkdtemp, readFile, rm, writeFile} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {gzipSync} from 'node:zlib';
+import {test} from '../../src/test-helpers/tap.js';
+import {AdminTestRunService} from '../../src/admin/admin-test-run-service.js';
+import {
+  createPlaybackEvidenceWriter,
+} from '../../src/diagnostics/playback-evidence-file.js';
+
+const TMP_PREFIX = 'lagrange-admin-output-asset-';
+const SCENARIO_RELATIVE_DIR = '.playback/run-1/rolling-restart';
+const SNAPSHOTS_WILDCARD = `${SCENARIO_RELATIVE_DIR}/snapshots.ndjson`;
+const SNAPSHOTS_GZ_WILDCARD = `${SNAPSHOTS_WILDCARD}.gz`;
+const NDJSON_CONTENT_TYPE = 'application/x-ndjson; charset=utf-8';
+const PLAIN_EVIDENCE = '{"seq":1}\n{"seq":2}\n';
+const RUN_ID = 'run-1';
+
+async function createWorkspace() {
+  const root = await mkdtemp(join(tmpdir(), TMP_PREFIX));
+  await mkdir(
+    join(root, 'test-output', SCENARIO_RELATIVE_DIR),
+    {recursive: true},
+  );
+  return root;
+}
+
+function snapshotsAbsolutePath(root, suffix = '') {
+  return join(root, 'test-output', `${SNAPSHOTS_WILDCARD}${suffix}`);
+}
+
+async function collectBody(body) {
+  if (Buffer.isBuffer(body)) {
+    return body;
+  }
+  const chunks = [];
+  for await (const chunk of body) {
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks);
+}
+
+async function writeActiveGzipBytes(root, records) {
+  const targetPath = snapshotsAbsolutePath(root, '.gz');
+  const writer = await createPlaybackEvidenceWriter(targetPath);
+  for (const record of records) {
+    await writer.appendRecord(record);
+  }
+  const activeBytes = await readFile(targetPath);
+  await writer.abort();
+  await writeFile(targetPath, activeBytes);
+  return activeBytes;
+}
+
+function registerRun(service, status) {
+  service.runs.set(RUN_ID, {
+    runId: RUN_ID,
+    status,
+    playbackSnapshotsPath: join('test-output', SNAPSHOTS_WILDCARD),
+  });
+}
+
+test('readOutputAsset serves legacy plain evidence unchanged', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  await writeFile(snapshotsAbsolutePath(root), PLAIN_EVIDENCE);
+  const service = new AdminTestRunService({workspaceRoot: root});
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.ok(payload, 'plain evidence should be served');
+  t.equal(payload.contentType, NDJSON_CONTENT_TYPE);
+  t.equal((await collectBody(payload.body)).toString('utf8'), PLAIN_EVIDENCE);
+});
+
+test('readOutputAsset decodes an archived gzip sibling strictly', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  await writeFile(
+    snapshotsAbsolutePath(root, '.gz'), gzipSync(PLAIN_EVIDENCE));
+  const service = new AdminTestRunService({workspaceRoot: root});
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.ok(payload, 'archived compressed evidence should be served');
+  t.equal(payload.contentType, NDJSON_CONTENT_TYPE);
+  t.equal((await collectBody(payload.body)).toString('utf8'), PLAIN_EVIDENCE);
+});
+
+test('readOutputAsset prefers the exact plain file over the gz sibling', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  await writeFile(snapshotsAbsolutePath(root), PLAIN_EVIDENCE);
+  await writeFile(
+    snapshotsAbsolutePath(root, '.gz'), gzipSync('{"other":true}\n'));
+  const service = new AdminTestRunService({workspaceRoot: root});
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.equal((await collectBody(payload.body)).toString('utf8'), PLAIN_EVIDENCE);
+});
+
+test('readOutputAsset tolerates an incomplete tail only for a running run', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  const activeBytes = await writeActiveGzipBytes(root, [
+    {seq: 1},
+    {seq: 2, marker: 'tail'},
+  ]);
+  await writeFile(
+    snapshotsAbsolutePath(root, '.gz'),
+    activeBytes.subarray(0, activeBytes.length - 6),
+  );
+  const service = new AdminTestRunService({workspaceRoot: root});
+  registerRun(service, 'running');
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.ok(payload, 'active evidence should be served');
+  const text = (await collectBody(payload.body)).toString('utf8');
+  const lines = text.split('\n').filter((line) => line.length > 0);
+  t.ok(lines.length >= 1, 'at least one complete record is visible');
+  for (const line of lines) {
+    t.doesNotThrow(() => JSON.parse(line), 'every served line is complete');
+  }
+});
+
+test('readOutputAsset decodes strictly when the run is not running', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  const activeBytes = await writeActiveGzipBytes(root, [{seq: 1}]);
+  await writeFile(snapshotsAbsolutePath(root, '.gz'), activeBytes);
+  const service = new AdminTestRunService({workspaceRoot: root});
+  registerRun(service, 'failed');
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.ok(payload, 'payload resolves before decoding begins');
+  await t.rejects(
+    collectBody(payload.body),
+    'unfinalized evidence must fail strict decoding for finished runs',
+  );
+});
+
+test('readOutputAsset decodes strictly when no run is registered', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  const activeBytes = await writeActiveGzipBytes(root, [{seq: 1}]);
+  await writeFile(snapshotsAbsolutePath(root, '.gz'), activeBytes);
+  const service = new AdminTestRunService({workspaceRoot: root});
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.ok(payload);
+  await t.rejects(
+    collectBody(payload.body),
+    'offline evidence must use strict decoding',
+  );
+});
+
+test('readOutputAsset never falls back on corrupt archives', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  const corrupt = gzipSync(PLAIN_EVIDENCE);
+  corrupt[corrupt.length - 5] ^= 0xff;
+  await writeFile(snapshotsAbsolutePath(root, '.gz'), corrupt);
+  const service = new AdminTestRunService({workspaceRoot: root});
+  registerRun(service, 'running');
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_WILDCARD);
+  t.ok(payload);
+  await t.rejects(
+    collectBody(payload.body),
+    'corruption must surface as an error, not a fallback',
+  );
+});
+
+test('readOutputAsset serves explicit gz requests as raw bytes', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  const compressed = gzipSync(PLAIN_EVIDENCE);
+  await writeFile(snapshotsAbsolutePath(root, '.gz'), compressed);
+  const service = new AdminTestRunService({workspaceRoot: root});
+
+  const payload = await service.readOutputAsset(SNAPSHOTS_GZ_WILDCARD);
+  t.ok(payload, 'explicit gz path should be served');
+  t.ok((await collectBody(payload.body)).equals(compressed));
+});
+
+test('readOutputAsset returns null when no artifact exists', async (t) => {
+  const root = await createWorkspace();
+  t.teardown(() => rm(root, {recursive: true, force: true}));
+  const service = new AdminTestRunService({workspaceRoot: root});
+
+  t.equal(await service.readOutputAsset(SNAPSHOTS_WILDCARD), null);
+  t.equal(await service.readOutputAsset(SNAPSHOTS_GZ_WILDCARD), null);
+});
diff --git a/test/diagnostics/playback-evidence-file.test.js b/test/diagnostics/playback-evidence-file.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..290eddb11afaf7f2f0666d98f12bc72c582cb50d
--- /dev/null
+++ b/test/diagnostics/playback-evidence-file.test.js
@@ -0,0 +1,268 @@
+import {describe, it, beforeEach, afterEach} from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp, readdir, readFile, rm, stat, writeFile} from 'node:fs/promises';
+import {createReadStream} from 'node:fs';
+import {once} from 'node:events';
+import {randomBytes} from 'node:crypto';
+import os from 'node:os';
+import path from 'node:path';
+import {gzipSync} from 'node:zlib';
+import {
+  createPlaybackEvidenceReadStream,
+  createPlaybackEvidenceWriter,
+  gzipPlaybackEvidencePath,
+  readPlaybackEvidenceFile,
+  readPlaybackEvidenceFileSync,
+  resolvePlaybackEvidencePath,
+  resolvePlaybackEvidencePathSync,
+} from '../../src/diagnostics/playback-evidence-file.js';
+
+const TMP_PREFIX = 'playback-evidence-file-';
+const LOGICAL_NAME = 'snapshots.ndjson';
+const PLAIN_CONTENT = '{"seq":1}\n{"seq":2}\n';
+const COMPRESSED_CONTENT = '{"seq":10}\n{"seq":11}\n';
+const ERROR_CODE_MISSING = 'ENOENT';
+
+async function collectStream(stream) {
+  const chunks = [];
+  for await (const chunk of stream) {
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+describe('playback evidence file owner', () => {
+  let workspace;
+  let logicalPath;
+  let compressedPath;
+
+  beforeEach(async () => {
+    workspace = await mkdtemp(path.join(os.tmpdir(), TMP_PREFIX));
+    logicalPath = path.join(workspace, LOGICAL_NAME);
+    compressedPath = gzipPlaybackEvidencePath(logicalPath);
+  });
+
+  afterEach(async () => {
+    await rm(workspace, {recursive: true, force: true});
+  });
+
+  describe('resolver precedence matrix', () => {
+    it('prefers the exact plain file even when a gz sibling exists', async () => {
+      await writeFile(logicalPath, PLAIN_CONTENT);
+      await writeFile(compressedPath, gzipSync(COMPRESSED_CONTENT));
+      assert.equal(resolvePlaybackEvidencePathSync(logicalPath), logicalPath);
+      assert.equal(await resolvePlaybackEvidencePath(logicalPath), logicalPath);
+    });
+
+    it('falls back to the gz sibling when the plain file is missing', async () => {
+      await writeFile(compressedPath, gzipSync(COMPRESSED_CONTENT));
+      assert.equal(
+        resolvePlaybackEvidencePathSync(logicalPath), compressedPath);
+      assert.equal(
+        await resolvePlaybackEvidencePath(logicalPath), compressedPath);
+    });
+
+    it('resolves explicit gz paths exact-only', async () => {
+      await writeFile(logicalPath, PLAIN_CONTENT);
+      assert.equal(resolvePlaybackEvidencePathSync(compressedPath), null);
+      assert.equal(await resolvePlaybackEvidencePath(compressedPath), null);
+      await writeFile(compressedPath, gzipSync(COMPRESSED_CONTENT));
+      assert.equal(
+        resolvePlaybackEvidencePathSync(compressedPath), compressedPath);
+      assert.equal(
+        await resolvePlaybackEvidencePath(compressedPath), compressedPath);
+    });
+
+    it('returns null when neither artifact exists', async () => {
+      assert.equal(resolvePlaybackEvidencePathSync(logicalPath), null);
+      assert.equal(await resolvePlaybackEvidencePath(logicalPath), null);
+    });
+  });
+
+  describe('sync and async read compatibility', () => {
+    it('reads legacy plain evidence identically in both modes', async () => {
+      await writeFile(logicalPath, PLAIN_CONTENT);
+      assert.equal(readPlaybackEvidenceFileSync(logicalPath), PLAIN_CONTENT);
+      assert.equal(
+        await readPlaybackEvidenceFile(logicalPath), PLAIN_CONTENT);
+    });
+
+    it('reads compressed evidence through the logical path', async () => {
+      await writeFile(compressedPath, gzipSync(COMPRESSED_CONTENT));
+      assert.equal(
+        readPlaybackEvidenceFileSync(logicalPath), COMPRESSED_CONTENT);
+      assert.equal(
+        await readPlaybackEvidenceFile(logicalPath), COMPRESSED_CONTENT);
+    });
+
+    it('reads an explicit gz path directly', async () => {
+      await writeFile(compressedPath, gzipSync(COMPRESSED_CONTENT));
+      assert.equal(
+        readPlaybackEvidenceFileSync(compressedPath), COMPRESSED_CONTENT);
+      assert.equal(
+        await readPlaybackEvidenceFile(compressedPath), COMPRESSED_CONTENT);
+    });
+
+    it('throws ENOENT for missing evidence in both modes', async () => {
+      assert.throws(
+        () => readPlaybackEvidenceFileSync(logicalPath),
+        {code: ERROR_CODE_MISSING},
+      );
+      await assert.rejects(
+        readPlaybackEvidenceFile(logicalPath),
+        {code: ERROR_CODE_MISSING},
+      );
+    });
+
+    it('surfaces corruption instead of falling back', async () => {
+      const corrupt = gzipSync(COMPRESSED_CONTENT);
+      corrupt[corrupt.length - 5] ^= 0xff;
+      await writeFile(compressedPath, corrupt);
+      await writeFile(logicalPath + '.unrelated', PLAIN_CONTENT);
+      assert.throws(() => readPlaybackEvidenceFileSync(logicalPath));
+      await assert.rejects(readPlaybackEvidenceFile(logicalPath));
+    });
+  });
+
+  describe('writer', () => {
+    it('preserves append ordering across serialized writes', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      const total = 50;
+      await Promise.all(
+        Array.from({length: total}, (_v, index) =>
+          writer.appendRecord({seq: index})),
+      );
+      await writer.close();
+      const lines = readPlaybackEvidenceFileSync(logicalPath)
+        .split('\n')
+        .filter((line) => line.length > 0)
+        .map((line) => JSON.parse(line).seq);
+      assert.deepEqual(lines, Array.from({length: total}, (_v, i) => i));
+    });
+
+    it('absorbs large-record backpressure without loss', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      const bigPayload = 'x'.repeat(1024 * 1024);
+      for (let index = 0; index < 4; index++) {
+        await writer.appendRecord({seq: index, payload: bigPayload});
+      }
+      await writer.close();
+      const records = readPlaybackEvidenceFileSync(logicalPath)
+        .split('\n')
+        .filter((line) => line.length > 0)
+        .map((line) => JSON.parse(line));
+      assert.equal(records.length, 4);
+      assert.equal(records[3].payload.length, bigPayload.length);
+    });
+
+    it('makes flushed records visible before finalization', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      await writer.appendRecord({seq: 1});
+      await writer.appendRecord({seq: 2});
+      const activeStream = await createPlaybackEvidenceReadStream(
+        logicalPath, {allowIncomplete: true});
+      const visible = await collectStream(activeStream);
+      assert.equal(visible, '{"seq":1}\n{"seq":2}\n');
+      await writer.close();
+    });
+
+    it('produces a strictly decodable stream after close', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      await writer.appendRecord({seq: 1});
+      await writer.close();
+      const strictStream =
+        await createPlaybackEvidenceReadStream(logicalPath);
+      assert.equal(await collectStream(strictStream), '{"seq":1}\n');
+    });
+
+    it('rejects appends after close', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      await writer.close();
+      await assert.rejects(writer.appendRecord({seq: 1}));
+    });
+
+    it('abort removes the partially written artifact', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      await writer.appendRecord({seq: 1});
+      await writer.abort();
+      await assert.rejects(stat(compressedPath), {code: ERROR_CODE_MISSING});
+    });
+  });
+
+  describe('read streams', () => {
+    it('strict decoding rejects an unfinalized gzip stream', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      await writer.appendRecord({seq: 1});
+      const activeBytes = await readFile(compressedPath);
+      await writer.abort();
+      await writeFile(compressedPath, activeBytes);
+      const strictStream =
+        await createPlaybackEvidenceReadStream(logicalPath);
+      await assert.rejects(collectStream(strictStream));
+    });
+
+    it('incomplete decoding emits only newline-complete records', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      await writer.appendRecord({seq: 1});
+      await writer.appendRecord({seq: 2, marker: 'tail-record'});
+      const activeBytes = await readFile(compressedPath);
+      await writer.abort();
+      // Simulate a mid-write capture: drop trailing bytes of the tail flush.
+      await writeFile(
+        compressedPath, activeBytes.subarray(0, activeBytes.length - 6));
+      const activeStream = await createPlaybackEvidenceReadStream(
+        logicalPath, {allowIncomplete: true});
+      const visible = await collectStream(activeStream);
+      const lines = visible.split('\n').filter((line) => line.length > 0);
+      assert.ok(lines.length >= 1);
+      for (const line of lines) {
+        assert.doesNotThrow(() => JSON.parse(line));
+      }
+      assert.equal(JSON.parse(lines[0]).seq, 1);
+    });
+
+    it('streams plain evidence unchanged', async () => {
+      await writeFile(logicalPath, PLAIN_CONTENT);
+      const stream = await createPlaybackEvidenceReadStream(logicalPath);
+      assert.equal(await collectStream(stream), PLAIN_CONTENT);
+      assert.ok(stream instanceof createReadStream(logicalPath).constructor);
+    });
+
+    it('destroying a decoded stream releases the file descriptor', async () => {
+      const writer = await createPlaybackEvidenceWriter(compressedPath);
+      // Incompressible payloads keep the artifact multi-chunk so the
+      // source stream cannot drain on the first read.
+      for (let index = 0; index < 8; index++) {
+        await writer.appendRecord({
+          seq: index,
+          bulk: randomBytes(256 * 1024).toString('hex'),
+        });
+      }
+      await writer.close();
+
+      const fdDir = '/proc/self/fd';
+      let baselineFdCount;
+      try {
+        baselineFdCount = (await readdir(fdDir)).length;
+      } catch {
+        return; // fd introspection unavailable on this platform
+      }
+
+      for (let index = 0; index < 10; index++) {
+        const stream = await createPlaybackEvidenceReadStream(
+          logicalPath, {allowIncomplete: index % 2 === 0});
+        await once(stream, 'data');
+        stream.destroy();
+        await once(stream, 'close');
+      }
+      await new Promise((resolve) => setTimeout(resolve, 50));
+
+      const finalFdCount = (await readdir(fdDir)).length;
+      assert.ok(
+        finalFdCount <= baselineFdCount + 1,
+        'aborted decoded streams leaked file descriptors: ' +
+          `${baselineFdCount} -> ${finalFdCount}`,
+      );
+    });
+  });
+});
diff --git a/test/distributed/harness/__tests__/playback-evidence-consumer-parity.test.js b/test/distributed/harness/__tests__/playback-evidence-consumer-parity.test.js
