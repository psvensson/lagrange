+  const versions = new Map();
+  const cache = {
+    bump(tableName) {
+      versions.set(tableName, (versions.get(tableName) || 0) + 1);
+    },
+    getTableMutationVersion(tableName) {
+      return versions.get(tableName) || 0;
+    },
