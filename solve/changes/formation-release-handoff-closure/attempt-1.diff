diff --git a/docs/specs/decision-tables/formation-release-handoff-closure.json b/docs/specs/decision-tables/formation-release-handoff-closure.json
new file mode 100644
index 0000000000000000000000000000000000000000..6a06e33275a90d9c4708b8576aa01c3cd9c64580
--- /dev/null
+++ b/docs/specs/decision-tables/formation-release-handoff-closure.json
@@ -0,0 +1,237 @@
+{
+  "schema": "decision-table-v1",
+  "id": "formation-release-handoff-closure",
+  "owner": "control_plane_readiness_startup_authority",
+  "boundary": "global_spread_release_to_joining_cohort_ready_publication",
+  "inputs": [
+    {
+      "name": "closureEvidence",
+      "values": [
+        "first_spread_satisfied_with_positive_current_connection_incarnations",
+        "captured_generation_waiting_for_durable_readback",
+        "durable_generation_acknowledged_for_current_authority_boot",
+        "first_spread_satisfied_with_zero_or_missing_connection_identity",
+        "published_generation_consumed_on_joiner",
+        "published_generation_missing_or_incompatible",
+        "seed_restart_with_compatible_active_publication",
+        "compatible_reopen_joiners_pending",
+        "compatible_reopen_partially_ready",
+        "all_captured_incarnations_ready",
+        "captured_member_missing_or_disconnected",
+        "captured_incarnation_changed",
+        "substantive_authority_block",
+        "no_satisfied_cohort_or_malformed"
+      ]
+    },
+    {
+      "name": "generation",
+      "values": ["compatible", "incompatible"]
+    }
+  ],
+  "outputs": [
+    {
+      "name": "action",
+      "values": [
+        "capture_publish_and_retain_release",
+        "persist_without_release",
+        "acknowledge_and_rearm_release",
+        "consume_published_release",
+        "restore_seed_owned_release",
+        "retain_release",
+        "complete_and_close_release",
+        "revoke_fail_closed",
+        "remain_idle"
+      ]
+    }
+  ],
+  "invariants": [
+    {
+      "id": "single-interaction-owner",
+      "statement": "Only the seed startup-authority readiness owner captures and closes the formation-release generation; the generic publications owner stores that exact contract, while bootstrap, joiners, and rebalancer only validate or consume it."
+    },
+    {
+      "id": "first-observation-positive-identity",
+      "statement": "The first satisfied observation captures the boot incarnation of each adopted current primary connection; node id alone, boot incarnation zero, or a high-water not bound to the adopted socket is non-authorizing."
+    },
+    {
+      "id": "durable-consumer-parity",
+      "statement": "A distinct joiner process receives the same seed-owned generation through the durable publication row and cannot locally mint, promote, or rotate formation-release authority."
+    },
+    {
+      "id": "durable-ack-before-release",
+      "statement": "First satisfaction captures a non-authorizing intent. Release becomes true only after the boot-disjoint publication write is read back through the canonical grammar, acknowledged by the interaction owner, and the readiness lane is rearmed."
+    },
+    {
+      "id": "bounded-publication-coordinator",
+      "statement": "Publication has exactly one in-flight write and one latest desired value; observations coalesce, shutdown discards pending desire, and no timer or unbounded promise tail owns progress."
+    },
+    {
+      "id": "authority-boot-disjoint-storage",
+      "statement": "The durable key and generation bind the seed authority node and positive current-primary boot incarnation, so an in-flight writer from an earlier seed boot cannot overwrite or authorize the current seed boot."
+    },
+    {
+      "id": "durable-recovery-replay",
+      "statement": "A restarted seed rehydrates its compatible active generation from the canonical publication row before observing new state; a changed peer boot, stale epoch, or malformed row cannot be restored."
+    },
+    {
+      "id": "non-monotone-spread-safe",
+      "statement": "A compatible priority-spread reopening cannot withdraw release before every captured JOINING incarnation publishes a current READY lease."
+    },
+    {
+      "id": "incarnation-and-safety-fenced",
+      "statement": "Missing membership, disconnect, boot-incarnation change, incompatible publication identity, substantive safety denial, or malformed authority revokes release fail closed."
+    }
+  ],
+  "rules": [
+    {
+      "id": "incompatible-generation-revokes",
+      "when": {
+        "closureEvidence": "*",
+        "generation": "incompatible"
+      },
+      "outcome": {"action": "revoke_fail_closed"},
+      "reason": "Regressed publication epoch or changed incarnation fence cannot inherit release authority.",
+      "invariantRefs": ["incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "first-satisfaction-captures-and-publishes-generation",
+      "when": {
+        "closureEvidence": "first_spread_satisfied_with_positive_current_connection_incarnations",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "persist_without_release"},
+      "reason": "The first whole-plane satisfaction event captures the seed and peer current-primary boot incarnations as a non-authorizing desired generation. The bounded publication coordinator persists it before recovery activity can close.",
+      "invariantRefs": ["single-interaction-owner", "first-observation-positive-identity", "durable-ack-before-release", "bounded-publication-coordinator", "authority-boot-disjoint-storage"]
+    },
+    {
+      "id": "durable-readback-authorizes-and-rearms",
+      "when": {
+        "closureEvidence": "durable_generation_acknowledged_for_current_authority_boot",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "acknowledge_and_rearm_release"},
+      "reason": "Only exact canonical readback for the current seed boot acknowledges the captured generation; acknowledgement rearms the existing readiness owner, which then projects release authority.",
+      "invariantRefs": ["single-interaction-owner", "durable-ack-before-release", "authority-boot-disjoint-storage"]
+    },
+    {
+      "id": "pending-publication-remains-non-authorizing",
+      "when": {
+        "closureEvidence": "captured_generation_waiting_for_durable_readback",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "persist_without_release"},
+      "reason": "Write failure, delayed storage, or shutdown cannot turn process-local capture into release authority.",
+      "invariantRefs": ["durable-ack-before-release", "bounded-publication-coordinator"]
+    },
+    {
+      "id": "zero-or-missing-identity-remains-idle",
+      "when": {
+        "closureEvidence": "first_spread_satisfied_with_zero_or_missing_connection_identity",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "remain_idle"},
+      "reason": "A provisional node-id cohort cannot later inherit release authority; durable node-row confirmation may confirm an already captured positive connection identity but cannot create it retroactively.",
+      "invariantRefs": ["first-observation-positive-identity", "incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "joiner-consumes-durable-generation",
+      "when": {
+        "closureEvidence": "published_generation_consumed_on_joiner",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "consume_published_release"},
+      "reason": "The joiner validates the seed publication against current authority, durable rows, and current process identity; its local formation owner remains idle.",
+      "invariantRefs": ["single-interaction-owner", "durable-consumer-parity", "incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "missing-publication-fails-closed",
+      "when": {
+        "closureEvidence": "published_generation_missing_or_incompatible",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "remain_idle"},
+      "reason": "A joiner cannot substitute its local view when the seed-owned durable contract is absent, stale, malformed, or bound to another incarnation.",
+      "invariantRefs": ["single-interaction-owner", "durable-consumer-parity", "incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "seed-restart-restores-one-owner-generation",
+      "when": {
+        "closureEvidence": "seed_restart_with_compatible_active_publication",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "restore_seed_owned_release"},
+      "reason": "Recovery resumes the exact seed-owned generation and reevaluates its captured cohort; it does not wait for a second globally satisfied observation or mint a replacement owner.",
+      "invariantRefs": ["single-interaction-owner", "durable-recovery-replay", "incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "compatible-reopen-retains-release",
+      "when": {
+        "closureEvidence": "compatible_reopen_joiners_pending",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "retain_release"},
+      "reason": "Spread is explicitly non-monotone until the captured cohort publishes READY; the retained owner remains cure and join-release authority.",
+      "invariantRefs": ["non-monotone-spread-safe"]
+    },
+    {
+      "id": "partial-ready-retains-release",
+      "when": {
+        "closureEvidence": "compatible_reopen_partially_ready",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "retain_release"},
+      "reason": "READY publication is a whole captured-cohort closure, not a first-node or majority threshold.",
+      "invariantRefs": ["non-monotone-spread-safe"]
+    },
+    {
+      "id": "all-current-ready-completes",
+      "when": {
+        "closureEvidence": "all_captured_incarnations_ready",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "complete_and_close_release"},
+      "reason": "Every exact captured incarnation has crossed the existing stable window and owns a fresh READY lease.",
+      "invariantRefs": ["single-interaction-owner", "incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "missing-or-disconnected-revokes",
+      "when": {
+        "closureEvidence": "captured_member_missing_or_disconnected",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "revoke_fail_closed"},
+      "reason": "The captured cohort cannot silently shrink while its process authority is unresolved.",
+      "invariantRefs": ["incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "incarnation-change-revokes",
+      "when": {
+        "closureEvidence": "captured_incarnation_changed",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "revoke_fail_closed"},
+      "reason": "A READY lease from one boot cannot close another boot's captured obligation.",
+      "invariantRefs": ["incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "substantive-block-revokes",
+      "when": {
+        "closureEvidence": "substantive_authority_block",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "revoke_fail_closed"},
+      "reason": "Only the exact priority-not-spread reopening is retainable; admission, writability, eligibility, and evidence failures remain safety blocks.",
+      "invariantRefs": ["incarnation-and-safety-fenced"]
+    },
+    {
+      "id": "no-cohort-remains-idle",
+      "when": {
+        "closureEvidence": "no_satisfied_cohort_or_malformed",
+        "generation": "compatible"
+      },
+      "outcome": {"action": "remain_idle"},
+      "reason": "Absent a complete first-satisfaction witness with a valid JOINING cohort, no release generation is minted.",
+      "invariantRefs": ["single-interaction-owner", "incarnation-and-safety-fenced"]
+    }
+  ]
+}
diff --git a/models/formation-release-handoff-closure/FormationReleaseHandoffClosure.tla b/models/formation-release-handoff-closure/FormationReleaseHandoffClosure.tla
new file mode 100644
index 0000000000000000000000000000000000000000..4793da90e6b0cdbf3301fca5616bb7389159deba
--- /dev/null
+++ b/models/formation-release-handoff-closure/FormationReleaseHandoffClosure.tla
@@ -0,0 +1,368 @@
+--------------------- MODULE FormationReleaseHandoffClosure -------------------
+EXTENDS Naturals, TLC
+
+CONSTANTS FixEnabled, CohortSize, StableWindowTicks,
+          PublicationCadenceTicks, BarrierBudgetTicks
+
+VARIABLES phase, openGap, releaseAuthority, identityCount,
+          capturedIdentityCount, durableIdentityCount,
+          authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+          generationPublished, durableAck, consumerCount,
+          stableTicks, readyCount, elapsedTicks, sawSatisfied, sawReopen,
+          incarnationChanged, ownerAvailable, ownerReloadExercised,
+          staleWriterAttempted
+
+vars == <<phase, openGap, releaseAuthority, identityCount,
+          capturedIdentityCount, durableIdentityCount,
+          authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+          generationPublished, durableAck, consumerCount,
+          stableTicks, readyCount, elapsedTicks, sawSatisfied, sawReopen,
+          incarnationChanged, ownerAvailable, ownerReloadExercised,
+          staleWriterAttempted>>
+
+Init ==
+  /\ phase = 0
+  /\ openGap = TRUE
+  /\ releaseAuthority = FALSE
+  /\ identityCount = 0
+  /\ capturedIdentityCount = 0
+  /\ durableIdentityCount = 0
+  /\ authorityBoot = 1
+  /\ capturedAuthorityBoot = 0
+  /\ durableAuthorityBoot = 0
+  /\ generationPublished = FALSE
+  /\ durableAck = FALSE
+  /\ consumerCount = 0
+  /\ stableTicks = 0
+  /\ readyCount = 0
+  /\ elapsedTicks = 0
+  /\ sawSatisfied = FALSE
+  /\ sawReopen = FALSE
+  /\ incarnationChanged = FALSE
+  /\ ownerAvailable = TRUE
+  /\ ownerReloadExercised = FALSE
+  /\ staleWriterAttempted = FALSE
+
+ObserveOneCurrentPrimaryIdentity ==
+  /\ phase = 0
+  /\ identityCount < CohortSize
+  /\ identityCount' = identityCount + 1
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ UNCHANGED <<phase, openGap, releaseAuthority,
+                  capturedIdentityCount, durableIdentityCount,
+                  authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount, stableTicks,
+                  readyCount, sawSatisfied, sawReopen, incarnationChanged,
+                  ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+FirstSpreadSatisfied ==
+  /\ phase = 0
+  /\ openGap
+  /\ identityCount = CohortSize
+  /\ phase' = 1
+  /\ openGap' = FALSE
+  /\ capturedIdentityCount' = IF FixEnabled THEN identityCount ELSE 0
+  /\ capturedAuthorityBoot' = IF FixEnabled THEN authorityBoot ELSE 0
+  /\ releaseAuthority' = IF FixEnabled THEN FALSE ELSE TRUE
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ sawSatisfied' = TRUE
+  /\ UNCHANGED <<identityCount, durableIdentityCount, authorityBoot,
+                  durableAuthorityBoot, generationPublished, durableAck,
+                  consumerCount, stableTicks, readyCount, sawReopen,
+                  incarnationChanged, ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+PublishSeedGeneration ==
+  /\ FixEnabled
+  /\ phase \in {1, 2}
+  /\ ownerAvailable
+  /\ ~generationPublished
+  /\ capturedIdentityCount = CohortSize
+  /\ capturedAuthorityBoot = authorityBoot
+  /\ generationPublished' = TRUE
+  /\ durableAuthorityBoot' = capturedAuthorityBoot
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ UNCHANGED <<phase, openGap, releaseAuthority, identityCount,
+                  capturedIdentityCount, durableIdentityCount, authorityBoot,
+                  capturedAuthorityBoot, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  incarnationChanged, ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+AcknowledgeDurableReadback ==
+  /\ FixEnabled
+  /\ phase \in {1, 2}
+  /\ ownerAvailable
+  /\ generationPublished
+  /\ ~durableAck
+  /\ durableAuthorityBoot = authorityBoot
+  /\ durableAck' = TRUE
+  /\ releaseAuthority' = TRUE
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ UNCHANGED <<phase, openGap, identityCount, capturedIdentityCount,
+                  durableIdentityCount, authorityBoot, capturedAuthorityBoot,
+                  durableAuthorityBoot, generationPublished, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  incarnationChanged, ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+SpreadGapReopens ==
+  /\ phase = 1
+  /\ ~openGap
+  /\ readyCount < CohortSize
+  /\ phase' = 2
+  /\ openGap' = TRUE
+  /\ releaseAuthority' = IF FixEnabled THEN releaseAuthority ELSE FALSE
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ sawReopen' = TRUE
+  /\ UNCHANGED <<identityCount, capturedIdentityCount, durableIdentityCount,
+                  authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, incarnationChanged,
+                  ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+ConfirmOneDurableNodeIncarnation ==
+  /\ FixEnabled
+  /\ phase \in {1, 2}
+  /\ durableIdentityCount < capturedIdentityCount
+  /\ durableIdentityCount' = durableIdentityCount + 1
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ UNCHANGED <<phase, openGap, releaseAuthority, identityCount,
+                  capturedIdentityCount, authorityBoot,
+                  capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  incarnationChanged, ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+ConsumeSeedGenerationOnOneJoiner ==
+  /\ phase = 2
+  /\ ownerAvailable
+  /\ releaseAuthority
+  /\ generationPublished
+  /\ durableAck
+  /\ durableAuthorityBoot = authorityBoot
+  /\ consumerCount < CohortSize
+  /\ consumerCount' = consumerCount + 1
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ UNCHANGED <<phase, openGap, releaseAuthority, identityCount,
+                  capturedIdentityCount, durableIdentityCount,
+                  authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, stableTicks, readyCount,
+                  sawSatisfied, sawReopen, incarnationChanged,
+                  ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+StableWindowEvent ==
+  /\ phase = 2
+  /\ ownerAvailable
+  /\ releaseAuthority
+  /\ durableIdentityCount = CohortSize
+  /\ consumerCount = CohortSize
+  /\ stableTicks < StableWindowTicks
+  /\ stableTicks' = stableTicks + 1
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ UNCHANGED <<phase, openGap, releaseAuthority, identityCount,
+                  capturedIdentityCount, durableIdentityCount,
+                  authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount, readyCount,
+                  sawSatisfied, sawReopen, incarnationChanged,
+                  ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+PublishOneReadyLease ==
+  /\ phase = 2
+  /\ ownerAvailable
+  /\ releaseAuthority
+  /\ stableTicks = StableWindowTicks
+  /\ readyCount < CohortSize
+  /\ readyCount' = readyCount + 1
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ phase' = IF readyCount' = CohortSize THEN 3 ELSE phase
+  /\ releaseAuthority' = IF readyCount' = CohortSize THEN FALSE ELSE TRUE
+  /\ UNCHANGED <<openGap, identityCount, capturedIdentityCount,
+                  durableIdentityCount, authorityBoot,
+                  capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, sawSatisfied, sawReopen, incarnationChanged,
+                  ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+CrashInteractionOwner ==
+  /\ FixEnabled
+  /\ phase = 2
+  /\ ownerAvailable
+  /\ durableAck
+  /\ ~ownerReloadExercised
+  /\ ownerAvailable' = FALSE
+  /\ ownerReloadExercised' = TRUE
+  /\ releaseAuthority' = FALSE
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ UNCHANGED <<phase, openGap, identityCount, capturedIdentityCount,
+                  durableIdentityCount, authorityBoot,
+                  capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  incarnationChanged, staleWriterAttempted>>
+
+RehydrateSameBootGeneration ==
+  /\ FixEnabled
+  /\ phase = 2
+  /\ ~ownerAvailable
+  /\ generationPublished
+  /\ durableAck
+  /\ durableAuthorityBoot = authorityBoot
+  /\ ownerAvailable' = TRUE
+  /\ releaseAuthority' = TRUE
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ UNCHANGED <<phase, openGap, identityCount, capturedIdentityCount,
+                  durableIdentityCount, authorityBoot,
+                  capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  incarnationChanged, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+RestartAuthorityBoot ==
+  /\ FixEnabled
+  /\ phase \in {1, 2}
+  /\ ~incarnationChanged
+  /\ authorityBoot' = 2
+  /\ phase' = 4
+  /\ releaseAuthority' = FALSE
+  /\ ownerAvailable' = FALSE
+  /\ incarnationChanged' = TRUE
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ UNCHANGED <<openGap, identityCount, capturedIdentityCount,
+                  durableIdentityCount, capturedAuthorityBoot,
+                  durableAuthorityBoot, generationPublished, durableAck,
+                  consumerCount, stableTicks, readyCount, sawSatisfied,
+                  sawReopen, ownerReloadExercised, staleWriterAttempted>>
+
+CapturedPeerIncarnationChanges ==
+  /\ FixEnabled
+  /\ phase \in {1, 2}
+  /\ ~incarnationChanged
+  /\ phase' = 4
+  /\ releaseAuthority' = FALSE
+  /\ incarnationChanged' = TRUE
+  /\ elapsedTicks' = elapsedTicks + 1
+  /\ UNCHANGED <<openGap, identityCount, capturedIdentityCount,
+                  durableIdentityCount, authorityBoot,
+                  capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  ownerAvailable, ownerReloadExercised,
+                  staleWriterAttempted>>
+
+OldAuthorityWriterCompletes ==
+  /\ FixEnabled
+  /\ phase = 4
+  /\ incarnationChanged
+  /\ ~staleWriterAttempted
+  /\ staleWriterAttempted' = TRUE
+  /\ elapsedTicks' = elapsedTicks + PublicationCadenceTicks
+  /\ UNCHANGED <<phase, openGap, releaseAuthority, identityCount,
+                  capturedIdentityCount, durableIdentityCount,
+                  authorityBoot, capturedAuthorityBoot, durableAuthorityBoot,
+                  generationPublished, durableAck, consumerCount,
+                  stableTicks, readyCount, sawSatisfied, sawReopen,
+                  incarnationChanged, ownerAvailable, ownerReloadExercised>>
+
+Next ==
+  ObserveOneCurrentPrimaryIdentity \/
+  FirstSpreadSatisfied \/
+  PublishSeedGeneration \/
+  AcknowledgeDurableReadback \/
+  SpreadGapReopens \/
+  ConfirmOneDurableNodeIncarnation \/
+  ConsumeSeedGenerationOnOneJoiner \/
+  StableWindowEvent \/
+  PublishOneReadyLease \/
+  CrashInteractionOwner \/
+  RehydrateSameBootGeneration \/
+  RestartAuthorityBoot \/
+  CapturedPeerIncarnationChanges \/
+  OldAuthorityWriterCompletes
+
+Spec ==
+  /\ Init
+  /\ [][Next]_vars
+  /\ WF_vars(ObserveOneCurrentPrimaryIdentity)
+  /\ WF_vars(FirstSpreadSatisfied)
+  /\ WF_vars(PublishSeedGeneration)
+  /\ WF_vars(AcknowledgeDurableReadback)
+  /\ WF_vars(SpreadGapReopens)
+  /\ WF_vars(ConfirmOneDurableNodeIncarnation)
+  /\ WF_vars(ConsumeSeedGenerationOnOneJoiner)
+  /\ WF_vars(StableWindowEvent)
+  /\ WF_vars(PublishOneReadyLease)
+  /\ WF_vars(RehydrateSameBootGeneration)
+
+TypeInvariant ==
+  /\ phase \in 0..4
+  /\ openGap \in BOOLEAN
+  /\ releaseAuthority \in BOOLEAN
+  /\ identityCount \in 0..CohortSize
+  /\ capturedIdentityCount \in 0..CohortSize
+  /\ durableIdentityCount \in 0..CohortSize
+  /\ authorityBoot \in {1, 2}
+  /\ capturedAuthorityBoot \in 0..2
+  /\ durableAuthorityBoot \in 0..2
+  /\ generationPublished \in BOOLEAN
+  /\ durableAck \in BOOLEAN
+  /\ consumerCount \in 0..CohortSize
+  /\ stableTicks \in 0..StableWindowTicks
+  /\ readyCount \in 0..CohortSize
+  /\ elapsedTicks \in Nat
+  /\ sawSatisfied \in BOOLEAN
+  /\ sawReopen \in BOOLEAN
+  /\ incarnationChanged \in BOOLEAN
+  /\ ownerAvailable \in BOOLEAN
+  /\ ownerReloadExercised \in BOOLEAN
+  /\ staleWriterAttempted \in BOOLEAN
+
+ReleaseRequiresDurableAck ==
+  releaseAuthority =>
+    generationPublished /\ durableAck /\ ownerAvailable /\
+    capturedIdentityCount = CohortSize /\
+    capturedAuthorityBoot = authorityBoot /\
+    durableAuthorityBoot = authorityBoot
+
+PublishedGenerationIsIdentityBound ==
+  generationPublished =>
+    capturedIdentityCount = CohortSize /\
+    capturedAuthorityBoot > 0 /\
+    durableAuthorityBoot = capturedAuthorityBoot
+
+ConsumerRequiresExactDurableGeneration ==
+  consumerCount > 0 =>
+    generationPublished /\ durableAck /\
+    durableAuthorityBoot = capturedAuthorityBoot
+
+NoReleaseAfterIncarnationChange ==
+  incarnationChanged => ~releaseAuthority
+
+StaleAuthorityWriteCannotAuthorizeCurrentBoot ==
+  (staleWriterAttempted /\ authorityBoot # capturedAuthorityBoot) =>
+    ~releaseAuthority /\ durableAuthorityBoot # authorityBoot
+
+ReloadRestoresOnlySameBootGeneration ==
+  (ownerReloadExercised /\ ownerAvailable /\ releaseAuthority) =>
+    durableAuthorityBoot = authorityBoot
+
+ReleaseRetainedAcrossReopen ==
+  (sawReopen /\ durableAck /\ ownerAvailable /\
+   readyCount < CohortSize /\ ~incarnationChanged) => releaseAuthority
+
+ReleaseClosesOnlyAfterReady ==
+  (phase = 3) => (readyCount = CohortSize /\ ~releaseAuthority)
+
+JoinerCohortEventuallyReadyWithinBudget ==
+  <> (incarnationChanged \/
+      (sawReopen /\ readyCount = CohortSize /\
+       elapsedTicks <= BarrierBudgetTicks))
+
+=============================================================================
