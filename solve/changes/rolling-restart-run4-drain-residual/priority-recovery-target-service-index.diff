+    partitionService({partition_id: PARTITION_TWO, replica_id: REPLICA_TWO}),
+    partitionService({node_id: NODE_C, partition_id: PARTITION_ONE}),
+  ]);
+
+  const contexts = indexedContexts(operationRows, tracked.rows);
+
+  t.equal(
