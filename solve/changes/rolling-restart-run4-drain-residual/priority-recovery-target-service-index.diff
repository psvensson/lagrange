+test('target-service index scans the source service rows once per snapshot build', (t) => {
+  const operationRows = [
+    replicaOperation({
+      operation_id: OPERATION_ONE,
+      partition_id: PARTITION_ONE,
+      entity_id: PARTITION_ONE,
+      replica_id: REPLICA_ONE,
