+    replicaOperationDrainRows
+      .map((row) => String(row.operationId || '').trim())
+      .filter((operationId) => operationId.length > 0),
+  );
+  return [...canonicalInFlightOperationIds].every((operationId) =>
+    coveredOperationIds.has(operationId),
+  );
+}
