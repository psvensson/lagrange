diff --git a/test/solve/commit-changeref.test.js b/test/solve/commit-changeref.test.js
index abb32a44a062226f3da83a120262d59d425233b1..56218141c79247ed37fa3237cc49039cf4417d6e 100644
--- a/test/solve/commit-changeref.test.js
