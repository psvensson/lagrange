+  replaceRows(rows, PUBLICATION_STATES[2]);
+  const after = resolveMergeMemo.call(ctx, 'node-a', iso(3), {}, null);
+  assert.notEqual(after, first, 'an epoch advance re-merges');
+  assert.equal(builds.length, 2,
