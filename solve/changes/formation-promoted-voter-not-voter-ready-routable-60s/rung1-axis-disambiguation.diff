--- /dev/null
+++ b/test/rebalancer/promoted-voter-voter-ready-routable-60s-axis.test.js
@@ -0,0 +1,231 @@
+/**
+ * RUNG-1 deterministic reproduction + axis disambiguation
+ * Quest: formation-promoted-voter-not-voter-ready-routable-60s
+ *
+ * On cold formation of a critical control-plane ledger partition that transiently
+ * reaches 4 raft voters over target 3, the surplus voter fails
+ * `isVoterReadyRoutableReplica` (src/rebalancer/priority-publication-safety-topology.js),
+ * so the promotion guard (`would_exceed_target`) AND the drain floor
+ * (`would-drop-voter-ready-below-minimum`) both persist and the surplus never drains.
+ *
+ * The load-bearing RUNG-1 question is WHICH axis of `isVoterReadyRoutableReplica`
+ * fails, using the REAL predicates on both sides of the deadlock:
+ *   GUARD count : PartitionServiceLearnerPromotionMethods.isActiveVoterServiceRowForPromotion
+ *                 (status live incl. creating/syncing AND raft_role in voter roles)
+ *   FLOOR ready : PriorityPublicationSafetyTopology.isVoterReadyRoutableReplica
+ *                 = isVoterReadyReplicaTopology (status in {active,syncing} AND raft_role != learner)
+ *                   AND isNodeReadyForRouting (host node control-plane routing readiness)
+ *
+ * DISAMBIGUATION BY THE OBSERVED DEFERRAL SIGNATURE (real instrumented run2, s14:
+ *   solve/changes/voter-ready-60s-promotion-timeout/instrumented-run-evidence-s14/):
+ *   the real deadlock shows BOTH `would_exceed_target` (guard counts 4 voters) AND
+ *   `would-drop-voter-ready-below-minimum` (floor sees < min voter-ready) firing at once,
+ *   with EVERY surplus voter row observed at status active/syncing + raft_role follower
+ *   (guard-defer record: activeVoterCount 4, laggingStatusVoterCount 0, all voterRows
+ *   {raftRole:'follower', status:'active'}). The three candidate axes are tested against
+ *   that signature; only ONE axis can produce guard-counts-it AND floor-rejects-it while
+ *   the row is status active/syncing + follower:
+ *
+ *   - raft_role-lag (raft_role reads 'learner' on the evaluator): the guard EXCLUDES
+ *     learners, so it would count only 3 -> `would_exceed` (needs 4 at maxAllowed 4)
+ *     could NOT fire. CONTRADICTED by the 345 would_exceed deferrals at count 4.
+ *   - status-lag (status 'creating' + follower): guard counts it, floor rejects on the
+ *     status gate -> COULD deadlock, but real data shows laggingStatusVoterCount 0 / all
+ *     voters active|syncing. ELIMINATED by real data.
+ *   - ROUTING (status active/syncing + follower, host node not routing-ready): guard
+ *     counts it (would_exceed) AND floor rejects it via isNodeReadyForRouting=false
+ *     (would-drop-below-min). The UNIQUE axis consistent with both deferrals co-occurring.
+ *
+ * This test is DT-only (discovery); the affinity-demo A/B is validation, not the seal.
+ */
+import {test} from '../../src/test-helpers/tap.js';
+import {PriorityPublicationSafetyRows} from '../../src/rebalancer/priority-publication-safety-rows.js';
+import {createPartitionServiceLearnerPromotionMethods} from '../../src/partition/partition-service-learner-promotion-methods.js';
+import {PARTITION_SERVICE_SHARED} from '../../src/partition/partition-service-shared.js';
+
+const {ReplicaStatus, PARTITION_RAFT_ROLE, SERVICE_TYPE} = PARTITION_SERVICE_SHARED;
+
+const PARTITION = 'sql_transaction_participants-p1';
+const MIN_REPLICAS = 3;
+
+// Real guard per-row predicate (drives the `would_exceed_target` voter count).
+const guard = createPartitionServiceLearnerPromotionMethods();
+function guardCountsAsVoter(row) {
+  return guard.isActiveVoterServiceRowForPromotion.call(guard, row);
+}
+
+// Real floor predicate holder. isNodeReadyForRouting reads the control-plane readiness
+// service; stub it to return per-node routing readiness for the resolved dimension.
+function makeFloor(routableByNodeId) {
+  const inst = Object.create(PriorityPublicationSafetyRows.prototype);
+  inst.controlPlaneReadinessService = {
+    getNodeReadinessSync(nodeId, {decisionDimension}) {
+      return {dimensions: {[decisionDimension]: routableByNodeId[nodeId] === true}};
+    },
+  };
+  return inst;
+}
+
+function voterRow({replicaId, nodeId, status, raftRole}) {
+  return {
+    replica_id: replicaId,
+    service_id: replicaId,
+    partition_id: PARTITION,
+    service_type: SERVICE_TYPE.PARTITION,
+    node_id: nodeId,
+    address: `ws://127.0.0.1/${nodeId}`,
+    status,
+    raft_role: raftRole,
+  };
+}
+
+// Evaluate a row against BOTH real predicates and name the failing floor axis.
+function evaluate(floor, row) {
+  const topologyOk = floor.isVoterReadyReplicaTopology(row);
+  const routingOk = floor.isNodeReadyForRouting(row.node_id, {
+    partitionId: row.partition_id,
+  });
+  const routableOk = floor.isVoterReadyRoutableReplica(row, {
+    partitionId: row.partition_id,
+  });
+  return {
+    guardCounts: guardCountsAsVoter(row),
+    topologyOk,
+    routingOk,
+    routableOk,
+    failingAxis: !topologyOk ? 'TOPOLOGY' : !routingOk ? 'ROUTING' : 'NONE',
+  };
+}
+
+// A partition transiently at 4 raft voters over target 3. Three original voters are
+// active/follower on routing-ready nodes; the surplus 4th is the promoted replacement.
+function surplusVoterSet(surplus) {
+  return [
+    voterRow({replicaId: `${PARTITION}-r2`, nodeId: 'node-a', status: ReplicaStatus.ACTIVE, raftRole: PARTITION_RAFT_ROLE.FOLLOWER}),
+    voterRow({replicaId: `${PARTITION}-r3`, nodeId: 'node-b', status: ReplicaStatus.ACTIVE, raftRole: PARTITION_RAFT_ROLE.FOLLOWER}),
+    voterRow({replicaId: `${PARTITION}-r4`, nodeId: 'node-c', status: ReplicaStatus.ACTIVE, raftRole: PARTITION_RAFT_ROLE.FOLLOWER}),
+    surplus,
+  ];
+}
+
+function countGuardVoters(rows) {
+  return rows.filter((r) => guardCountsAsVoter(r)).length;
+}
+function countVoterReadyRoutable(floor, rows) {
+  return rows.filter((r) =>
+    floor.isVoterReadyRoutableReplica(r, {partitionId: r.partition_id}),
+  ).length;
+}
+
+// ---------------------------------------------------------------------------
+// ROUTING axis: the surplus voter is status active/syncing + follower (topology
+// voter-ready) but its host node is NOT control-plane routing-ready. This is the
+// UNIQUE axis that makes the guard count it (would_exceed) AND the floor reject it
+// (would-drop-below-min) at the same time, matching the real run2 signature.
+// ---------------------------------------------------------------------------
+test('ROUTING axis: topology-ready surplus voter on a non-routing-ready node deadlocks both gates', async (t) => {
+  const routable = {'node-a': true, 'node-b': true, 'node-c': true, 'node-surplus': false};
+  const floor = makeFloor(routable);
+  const surplus = voterRow({
+    replicaId: `${PARTITION}-r5`,
+    nodeId: 'node-surplus',
+    status: ReplicaStatus.SYNCING, // syncing is in the voter-ready topology set
+    raftRole: PARTITION_RAFT_ROLE.FOLLOWER,
+  });
+  const rows = surplusVoterSet(surplus);
+  const r = evaluate(floor, surplus);
+
+  // Floor: topology passes, routing fails => not voter-ready-routable, failing axis ROUTING.
+  t.equal(r.topologyOk, true, 'surplus voter passes the TOPOLOGY axis (active/syncing + follower)');
+  t.equal(r.routingOk, false, 'surplus voter host node is NOT routing-ready');
+  t.equal(r.routableOk, false, 'surplus voter is NOT voter-ready-routable');
+  t.equal(r.failingAxis, 'ROUTING', 'binding failing axis is ROUTING');
+
+  // Guard: still counts the surplus as an active voter -> 4 voters -> would_exceed a 5th.
+  t.equal(r.guardCounts, true, 'promotion guard counts the surplus as an active voter');
+  t.equal(countGuardVoters(rows), 4, 'guard sees 4 active voters (would_exceed_target for target 3)');
+
+  // Floor drain: only 3 of 4 are voter-ready-routable, so draining any routable source
+  // drops voter-ready to 2 < min 3 (would-drop-voter-ready-below-minimum persists).
+  t.equal(countVoterReadyRoutable(floor, rows), 3, 'only 3 of 4 raft voters are voter-ready-routable');
+  const afterDrainingRoutableSource = countVoterReadyRoutable(
+    floor,
+    rows.filter((row) => row.replica_id !== `${PARTITION}-r2`),
+  );
+  t.ok(afterDrainingRoutableSource < MIN_REPLICAS, 'draining a routable source drops voter-ready below minimum');
+  t.end();
+});
+
+// ---------------------------------------------------------------------------
+// raft_role-lag axis is CONTRADICTED: a learner is NOT counted by the guard, so the
+// observed `would_exceed_target` (which requires the guard to count 4) cannot arise
+// from a raft_role that reads learner.
+// ---------------------------------------------------------------------------
+test('raft_role-lag axis is contradicted by the would_exceed_target signature', async (t) => {
+  const floor = makeFloor({'node-a': true, 'node-b': true, 'node-c': true, 'node-surplus': true});
+  const laggedLearner = voterRow({
+    replicaId: `${PARTITION}-r5`,
+    nodeId: 'node-surplus',
+    status: ReplicaStatus.ACTIVE,
+    raftRole: PARTITION_RAFT_ROLE.LEARNER, // raft_role still reads learner on the evaluator
+  });
+  const rows = surplusVoterSet(laggedLearner);
+  const r = evaluate(floor, laggedLearner);
+
+  t.equal(r.guardCounts, false, 'guard does NOT count a learner as an active voter');
+  t.equal(countGuardVoters(rows), 3, 'guard sees only 3 voters -> would_exceed_target could not fire at 4');
+  t.equal(r.topologyOk, false, 'topology rejects the learner');
+  // The floor also rejects it, but with only 3 guard voters there is no over-target
+  // surplus and no would_exceed deferral -> inconsistent with the real 345/at-count-4 data.
+  t.end();
+});
+
+// ---------------------------------------------------------------------------
+// status-lag axis is ELIMINATED by real data: it CAN deadlock in principle (guard counts
+// a creating+follower row, floor rejects it on the status gate), but the real run2
+// guard-defer records show laggingStatusVoterCount 0 / every voter active|syncing.
+// ---------------------------------------------------------------------------
+test('status-lag axis can deadlock in principle but is eliminated by observed all-active voters', async (t) => {
+  const floor = makeFloor({'node-a': true, 'node-b': true, 'node-c': true, 'node-surplus': true});
+  const creatingVoter = voterRow({
+    replicaId: `${PARTITION}-r5`,
+    nodeId: 'node-surplus',
+    status: ReplicaStatus.CREATING, // creating is NOT in the voter-ready topology set
+    raftRole: PARTITION_RAFT_ROLE.FOLLOWER,
+  });
+  const r = evaluate(floor, creatingVoter);
+
+  t.equal(r.guardCounts, true, 'guard counts a creating+follower row (creating is "live")');
+  t.equal(r.topologyOk, false, 'floor rejects creating on the TOPOLOGY status gate');
+  t.equal(r.failingAxis, 'TOPOLOGY', 'in principle the status-lag axis is a TOPOLOGY failure');
+  // Real data (instrumented run2 guard-defer): laggingStatusVoterCount === 0, so no live
+  // surplus voter is at creating -> this axis is not the live binding one.
+  t.end();
+});
+
+// ---------------------------------------------------------------------------
+// Positive control: once the surplus voter's host node becomes routing-ready, the row is
+// voter-ready-routable -> the floor sees 4 routable, draining the source keeps >= min, and
+// the surplus resolves. Confirms the fix direction (make the node routable, not weaken the gate).
+// ---------------------------------------------------------------------------
+test('routing-ready host clears the surplus: 4 voter-ready-routable, drain safe, both gates release', async (t) => {
+  const floor = makeFloor({'node-a': true, 'node-b': true, 'node-c': true, 'node-surplus': true});
+  const surplus = voterRow({
+    replicaId: `${PARTITION}-r5`,
+    nodeId: 'node-surplus',
+    status: ReplicaStatus.SYNCING,
+    raftRole: PARTITION_RAFT_ROLE.FOLLOWER,
+  });
+  const rows = surplusVoterSet(surplus);
+  const r = evaluate(floor, surplus);
+
+  t.equal(r.routableOk, true, 'surplus voter is voter-ready-routable once its node is routing-ready');
+  t.equal(r.failingAxis, 'NONE', 'no failing axis');
+  t.equal(countVoterReadyRoutable(floor, rows), 4, 'all 4 raft voters are voter-ready-routable');
+  const afterDrain = countVoterReadyRoutable(
+    floor,
+    rows.filter((row) => row.replica_id !== `${PARTITION}-r2`),
+  );
+  t.ok(afterDrain >= MIN_REPLICAS, 'draining the source keeps voter-ready at/above minimum (drain floor releases)');
+  t.end();
+});
