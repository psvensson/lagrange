+  const rowsByPartition = new Map();
+  for (const row of rows) {
+    const partitionId = resolveSplitTargetPartitionId(
+      row?.[metadata.primaryKeyColumn],
+      metadata,
+    );
+    const partitionRows = rowsByPartition.get(partitionId) || [];
