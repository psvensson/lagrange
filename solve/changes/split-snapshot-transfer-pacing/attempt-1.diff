+      typeof options.resolveDescriptorEpochEvidence ===
+        PARTITION_SERVICE_TYPE.FUNCTION ?
+        options.resolveDescriptorEpochEvidence() :
+        options.descriptorEpochEvidence;
+    assertSplitRoutingDescriptorEpoch(metadata, {
+      ...options,
