+      (row) => columns.map((column) => row[column]),
+    );
+    await routeSplitMirroredWrite(partitionId, sql, params, {
+      ...options,
+      splitMirrorOrigin: PARTITION_SPLIT_MIRROR_ORIGIN.SNAPSHOT,
+    });
