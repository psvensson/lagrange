+
+function collectFunctionByName(entries) {
+  const functionByName = new Map();
+  for (const {node} of entries) {
+    if (node.type === NODE_TYPE.FUNCTION_DECLARATION && node.id?.name) {
+      functionByName.set(node.id.name, node);
+    }
