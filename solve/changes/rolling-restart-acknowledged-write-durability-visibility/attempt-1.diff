diff --git a/src/admin/admin-write-receipt.js b/src/admin/admin-write-receipt.js
new file mode 100644
index 000000000..e2f37e9e7
--- /dev/null
+++ b/src/admin/admin-write-receipt.js
@@ -0,0 +1,51 @@
+function hasCommitWitnessShape(value) {
+  const strings = [
+    value?.partitionId,
+    value?.leaderNodeId,
+    value?.leaderReplicaId,
+  ];
+  const integers = [value?.term, value?.logIndex];
+  return strings.every(
+    (entry) => typeof entry === 'string' && entry.trim().length > 0,
+  ) && integers.every(Number.isSafeInteger);
+}
+
+function normalizeCommitWitness(value) {
+  const partitionId = String(value?.partitionId || '').trim();
+  const leaderNodeId = String(value?.leaderNodeId || '').trim();
+  const leaderReplicaId = String(value?.leaderReplicaId || '').trim();
+  const term = Number(value?.term);
+  const logIndex = Number(value?.logIndex);
+  if (!hasCommitWitnessShape(value)) {
+    return null;
+  }
+  return {
+    partitionId,
+    leaderNodeId,
+    leaderReplicaId,
+    term,
+    logIndex,
+  };
+}
+
+function buildAdminWriteReceipt(result) {
+  const participantResults = Array.isArray(result?.participantResults) ?
+    result.participantResults : [];
+  const durableCommitWitnesses = participantResults
+    .filter((participant) => participant?.success === true)
+    .map((participant) =>
+      normalizeCommitWitness(participant?.durableCommitWitness))
+    .filter(Boolean);
+  const operationId = String(result?.operationId || '').trim();
+  const idempotencyKey = String(result?.idempotencyKey || '').trim();
+  const receipt = {durableCommitWitnesses};
+  if (operationId.length > 0) {
+    receipt.operationId = operationId;
+  }
+  if (idempotencyKey.length > 0) {
+    receipt.idempotencyKey = idempotencyKey;
+  }
+  return receipt;
+}
+
+export {buildAdminWriteReceipt, normalizeCommitWitness};
