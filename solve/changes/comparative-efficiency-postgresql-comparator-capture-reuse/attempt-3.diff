+      0,
+      SOURCE_CLOSURE_ENTRY_PATH,
+    );
+    try {
+      await assert.rejects(
+        resolveBenchmarkLocalModuleSourcePaths({
+          entryPaths: inheritedPaths,
+        }),
+        /dense entry and additional paths/,
+      );
+    } finally {
+      restore();
+    }
+  },
+);
