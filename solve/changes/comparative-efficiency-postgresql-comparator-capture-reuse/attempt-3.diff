+
+function primitiveText(value, name) {
+  if (typeof value !== 'string' || value.length === 0) {
+    fail(`${name}:primitive_text_required`);
+  }
+  return value;
+}
+
+function copyDigestArray(values, name) {
+  if (!isDenseDataArray(values) || values.length === 0) {
