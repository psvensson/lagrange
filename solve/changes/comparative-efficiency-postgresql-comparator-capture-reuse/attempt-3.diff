+  CAPACITY_TAIL_SUFFICIENT: 'capacity.tailSufficientByBlock',
+  COMPARATOR_ID: 'comparatorId',
+  DATASET_SKEW: 'datasetSkew',
+  DRIFT_METRIC: 'driftMetric',
+  DRIFT_WITNESS_METRIC: 'driftWitness.metric',
+  SIDE_ID: 'sideId',
