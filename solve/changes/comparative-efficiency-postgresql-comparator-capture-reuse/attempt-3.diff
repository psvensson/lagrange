+  for (let index = 0; index < samples.length; index += 1) {
+    if (
+      !inspectBenchmarkCapacityRunSample(samples[index]).valid ||
+      !isSha256Digest(digests[index]) ||
+      samples[index].sampleDigest !== digests[index]
