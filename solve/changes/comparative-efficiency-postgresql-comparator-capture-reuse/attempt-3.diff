+        sealed,
+        offeredLoadPerSecond,
+      );
+      if (sampling.warmupMs > 0) {
+        const warmup = report.warmupSamples[warmupIndex];
+        assertSampleMatches(warmup, sealed, {
+          ...context,
+          phase: BENCHMARK_CAPACITY_PHASE.WARMUP,
+          windowDurationMs: sampling.warmupMs,
+        });
