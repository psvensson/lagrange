+export function independentPreregistrationInput() {
+  return {
+    studyId: localText.STUDY,
+    ...fixtureSemanticRegistration(),
+    offeredLoadPerSecond: [...FIXTURE_LOADS],
+    slo: {
+      maxP99LatencyMs: FIXTURE_P99_SLO_MS,
+      maxErrorRate: FIXTURE_ERROR_SLO,
