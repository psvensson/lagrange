+  });
+}
+
+function artifactBody(input) {
+  if (!isSha256Digest(input.protocolReportDigest)) {
+    fail(ERROR.PROTOCOL_REPORT_DIGEST_INVALID);
+  }
+  const compatibility = copyCompatibility(input.compatibility);
