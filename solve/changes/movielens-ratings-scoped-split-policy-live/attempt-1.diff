+test('MovieLens persists one sparse ratings split-policy override',
+  async (t) => {
+    const queries = [];
+    let reads = 0;
+    let clientsCreated = 0;
+    let clientsClosed = 0;
+    const retryAttempts = [];
+    const waitDelays = [];
+    const result = await applyRatingsSplitPolicyWithRetry({
+      target: 'ws://demo',
+      maxAttempts: 2,
+      clientFactory: () => {
+        clientsCreated += 1;
+        return {
+          query: async (sql) => {
+            queries.push(sql);
+            if (sql.startsWith('SELECT table_id')) {
+              const policy = clientsCreated === 1 ?
+                {} : RATINGS_TABLE_SPLIT_POLICY;
+              return {rows: [{
+                table_id: 'tbl-ratings',
+                table_policies: JSON.stringify(policy),
+              }]};
+            }
+            if (sql.startsWith('SELECT table_policies')) {
+              reads += 1;
+              return {
+                rows: [{
+                  table_policies: JSON.stringify(RATINGS_TABLE_SPLIT_POLICY),
+                }],
+              };
+            }
+            return {rows: []};
+          },
+          close: async () => {
+            clientsClosed += 1;
+          },
+        };
+      },
+      wait: async (delayMs) => {
+        waitDelays.push(delayMs);
+      },
+      onRetry: ({attempt}) => {
+        retryAttempts.push(attempt);
+      },
+    });
+
+    t.same(result, {
+      attempts: 2,
+      policy: RATINGS_TABLE_SPLIT_POLICY,
+    });
+    t.equal(reads, 1,
+      'the first attempt verifies its authoritative mutation');
+    t.equal(clientsCreated, 2,
+      'each stable-read attempt uses a fresh admin client');
+    t.equal(clientsClosed, 2,
+      'every fresh admin client is closed, including the successful one');
+    t.same(retryAttempts, [1],
+      'the first confirmation schedules exactly one retry');
+    t.same(waitDelays, [5000],
+      'the confirmation retry uses the bounded policy retry cadence');
+    t.equal(queries.filter((sql) => sql.startsWith('UPDATE')).length, 1,
+      'the second fresh-session confirmation is read-only');
+    t.ok(queries.some((sql) =>
+      sql.includes('UPDATE tables SET table_policies') &&
+      sql.includes('WHERE table_id = \'tbl-ratings\'')),
+    'the scenario persists policy through the ratings primary key');
+    t.notOk(queries.some((sql) =>
+      sql.includes('UPDATE tables SET table_policies') &&
+      sql.includes('WHERE table_name')),
+    'the scenario does not mutate table policy through a secondary key');
+    t.same(Object.keys(RATINGS_TABLE_SPLIT_POLICY),
+      ['splitStorageThreshold'],
+      'the scenario does not materialize inherited table-policy defaults');
+    t.end();
+  });
+
+test('MovieLens ratings policy confirmation resets after mismatch and error',
+  async (t) => {
+    const attemptOutcomes = [
+      {observe: 'mismatch', persist: 'match'},
+      {observe: 'mismatch', persist: 'mismatch'},
+      {observe: 'mismatch', persist: 'match'},
+      {observe: 'error'},
+      {observe: 'mismatch', persist: 'match'},
+      {observe: 'match'},
+    ];
+    let clientsCreated = 0;
+    let clientsClosed = 0;
+    const retryErrors = [];
+    const waitDelays = [];
+
+    const result = await applyRatingsSplitPolicyWithRetry({
+      target: 'ws://demo',
+      maxAttempts: attemptOutcomes.length,
+      clientFactory: () => {
+        const attemptIndex = clientsCreated;
+        clientsCreated += 1;
+        return {
+          query: async (sql) => {
+            if (sql.startsWith('SELECT table_id')) {
+              if (attemptOutcomes[attemptIndex].observe === 'error') {
+                throw new Error('transient admin read failure');
+              }
+              const policy =
+                attemptOutcomes[attemptIndex].observe === 'match' ?
+                  RATINGS_TABLE_SPLIT_POLICY : {};
+              return {rows: [{
+                table_id: 'tbl-ratings',
+                table_policies: JSON.stringify(policy),
+              }]};
+            }
+            if (sql.startsWith('SELECT table_policies')) {
+              const policy =
+                attemptOutcomes[attemptIndex].persist === 'match' ?
+                  RATINGS_TABLE_SPLIT_POLICY : {};
+              return {rows: [{table_policies: JSON.stringify(policy)}]};
+            }
+            return {rows: []};
+          },
+          close: async () => {
+            clientsClosed += 1;
+          },
+        };
+      },
+      wait: async (delayMs) => {
+        waitDelays.push(delayMs);
+      },
+      onRetry: ({error}) => {
+        retryErrors.push(error.message);
+      },
+    });
+
+    t.equal(result.attempts, 6,
+      'neither a pre-mismatch nor pre-error confirmation leaks forward');
+    t.equal(clientsCreated, 6);
+    t.equal(clientsClosed, 6,
+      'exception attempts still close their fresh client');
+    t.equal(waitDelays.length, 5,
+      'every nonterminal attempt waits before retrying');
+    t.ok(waitDelays.every((delayMs) => delayMs === 5000));
+    t.match(retryErrors[1], /read-back did not match/);
+    t.match(retryErrors[3], /transient admin read failure/);
+    t.end();
+  });
+
+test('MovieLens ratings policy retry exhausts loudly at its fixed bound',
+  async (t) => {
+    let clientsCreated = 0;
+    let clientsClosed = 0;
+    let retryCount = 0;
+    let waitCount = 0;
+    const maxAttempts = 3;
+    await t.rejects(
+      applyRatingsSplitPolicyWithRetry({
+        target: 'ws://demo',
+        maxAttempts,
+        clientFactory: () => {
+          clientsCreated += 1;
+          return {
+            query: async (sql) => {
+              if (sql.startsWith('SELECT table_id')) {
+                return {rows: [{
+                  table_id: 'tbl-ratings',
+                  table_policies: JSON.stringify({}),
+                }]};
+              }
+              if (sql.startsWith('SELECT table_policies')) {
+                return {rows: [{table_policies: JSON.stringify({})}]};
+              }
+              return {rows: []};
+            },
+            close: async () => {
+              clientsClosed += 1;
+            },
+          };
+        },
+        wait: async () => {
+          waitCount += 1;
+        },
+        onRetry: () => {
+          retryCount += 1;
+        },
+      }),
+      /ratings split policy read-back did not match/,
+      'the last mismatch is surfaced instead of silently accepting policy',
+    );
+    t.equal(clientsCreated, maxAttempts,
+      'the loop stops at the configured attempt bound');
+    t.equal(clientsClosed, maxAttempts);
+    t.equal(retryCount, maxAttempts - 1,
+      'the terminal failure does not claim another retry');
+    t.equal(waitCount, maxAttempts - 1,
+      'the terminal failure does not sleep after exhaustion');
+    t.end();
+  });
+
