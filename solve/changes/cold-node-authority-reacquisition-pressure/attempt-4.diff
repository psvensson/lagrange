+          success: true,
+          seedNodeId: DURABLE_PEER_B_NODE_ID,
+          seedNodeWsAddress: DURABLE_PEER_B_WS_ADDRESS,
+          startupAuthority: CANONICAL_STARTUP_AUTHORITY,
+        };
