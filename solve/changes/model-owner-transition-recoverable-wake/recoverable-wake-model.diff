+++ b/models/readiness-handoff/ReadinessHandoff_lost_wake.cfg
@@ -0,0 +1,11 @@
+\* Forbidden route: a deferred owner outcome can be committed without a
+\* recoverable wake. TLC is expected to find a violation.
+SPECIFICATION Spec
+CONSTANTS
+  AllowUnsafeReadiness = FALSE
+  LoseWake = TRUE
+INVARIANT TypeOK
+INVARIANT ReadyRequiresCanonicalServiceability
+INVARIANT DeferredOutcomeHasRecoverableWake
+INVARIANT StaleProjectionNeverPromotes
+PROPERTY EventuallyTerminal
