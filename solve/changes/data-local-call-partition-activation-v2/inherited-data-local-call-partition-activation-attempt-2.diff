+const CELL_BUDGETS = Object.freeze({
+  context_bytes: 4096,
+  cpu_time_ms: 60000,
+  input_bytes: 1048576,
+  memory_bytes: 512 * 1024 * 1024,
+  output_bytes: 1048576,
