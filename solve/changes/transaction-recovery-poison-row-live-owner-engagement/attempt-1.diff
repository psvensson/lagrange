 );
+
+test(
+  'StartupRuntimeHandoffOwner engages transaction recovery when control-plane ' +
+    'background writers are already active',
+  async (t) => {
+    const recoveryError = buildRecoveryError();
+    recoveryError.decisionDimension = 'commit_mode';
+    let recoveryActivationCount = 0;
+    const owner = new StartupRuntimeHandoffOwner({
+      delegates: {
+        isShuttingDown: () => false,
+        getLeaseService: () => ({state: 'running'}),
+        getLeaseRunningState: () => 'running',
+        getHeartbeatService: () => ({state: 'running'}),
+        getHeartbeatRunningState: () => 'running',
+        isDistributedTransactionRecoveryAvailable: () => true,
+        activateDistributedTransactionRecovery: () => {
+          recoveryActivationCount += 1;
+          throw recoveryError;
+        },
+        getRouteSource: () => SEED_AUTHORITY_SOURCE,
+      },
+    });
+
+    await owner.activateControlPlaneBackgroundWriters();
+    await owner.activateControlPlaneBackgroundWriters();
+
+    const snapshot = owner.getDistributedTransactionRecoverySnapshot();
+    t.equal(
+      recoveryActivationCount,
+      1,
+      'already-active writers do not suppress or duplicate recovery activation',
+    );
+    t.equal(
+      snapshot.state,
+      'failed',
+      'the startup owner records the poison-row replay failure',
+    );
+    t.equal(
+      snapshot.outcome?.decisionDimension,
+      'commit_mode',
+      'the startup owner retains the failed recovery decision dimension',
+    );
+    t.equal(
+      snapshot.outcome?.routeSource,
+      SEED_AUTHORITY_SOURCE,
+      'the startup owner retains the canonical seed route source',
+    );
+  },
+);
diff --git a/test/distributed/harness/transaction-recovery-poison-row-live-contract.test.js b/test/distributed/harness/transaction-recovery-poison-row-live-contract.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..8f16652f0c23776767a030e1d226b11be297b562
--- /dev/null
+++ b/test/distributed/harness/transaction-recovery-poison-row-live-contract.test.js
@@ -0,0 +1,80 @@
+import {test} from '../../../src/test-helpers/tap.js';
+import {
+  assertPoisonRowHandoffEvidence,
+} from '../../scenarios/transaction-recovery-poison-row-live.js';
+
+const RECOVERY_OUTCOME_INCOMPLETE = 'transaction_recovery_incomplete';
+const POISON_DIMENSION = 'commit_mode';
+const SEED_ROUTE_SOURCE = 'ddb-test-reuse-7-1:8080';
+
+function buildValidCapture() {
+  const evidence = {
+    ready: false,
+    transactionRecoveryState: 'failed',
+    transactionRecoveryReady: false,
+    outcome: {
+      kind: RECOVERY_OUTCOME_INCOMPLETE,
+      errorCode: 'TRANSACTION_RECOVERY_INCOMPLETE',
+      decisionDimension: POISON_DIMENSION,
+      routeSource: SEED_ROUTE_SOURCE,
+    },
+  };
+  return {
+    sampleCount: 2,
+    firstFailedSample: evidence,
+    typedOutcomeSample: evidence,
+    lastSample: {at: 1, evidence},
+  };
+}
+
+test(
+  'poison-row live validation fails closed when the startup handoff owner ' +
+    'publishes no typed sample',
+  (t) => {
+    const capture = buildValidCapture();
+    capture.typedOutcomeSample = null;
+    t.throws(
+      () => assertPoisonRowHandoffEvidence(capture),
+      {message: /typed transaction_recovery_incomplete outcome/},
+      'a null typed sample cannot produce a live PASS',
+    );
+    t.end();
+  },
+);
+
+test(
+  'poison-row live validation requires failed owner state, decision dimension, ' +
+    'and canonical route source',
+  (t) => {
+    const missingFailure = buildValidCapture();
+    missingFailure.firstFailedSample = null;
+    t.throws(
+      () => assertPoisonRowHandoffEvidence(missingFailure),
+      {message: /failed transaction recovery sample/},
+      'the live vehicle requires an owner-recorded failure sample',
+    );
+
+    const wrongDimension = buildValidCapture();
+    wrongDimension.typedOutcomeSample.outcome.decisionDimension =
+      'frozen_participant_count';
+    t.throws(
+      () => assertPoisonRowHandoffEvidence(wrongDimension),
+      {message: /commit_mode/},
+      'the live vehicle requires the poison-row decision dimension',
+    );
+
+    const missingRoute = buildValidCapture();
+    missingRoute.typedOutcomeSample.outcome.routeSource = null;
+    t.throws(
+      () => assertPoisonRowHandoffEvidence(missingRoute),
+      {message: /route source/},
+      'the live vehicle requires canonical route attribution',
+    );
+
+    t.doesNotThrow(
+      () => assertPoisonRowHandoffEvidence(buildValidCapture()),
+      'a complete typed owner witness satisfies the live contract',
+    );
+    t.end();
+  },
+);
