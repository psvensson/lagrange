+
+export function comparativeNegativeControlEvidenceDigest(evidence) {
+  if (!objectHasOwn(evidence, localText.ROOT)) fail(localText.ROOT_INVALID);
+  return digestBenchmarkSemanticData(evidence.root.artifact.payload);
+}
