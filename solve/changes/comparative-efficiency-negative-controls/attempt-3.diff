+      return resourceStats(
+        calls <= 2 ? CALIBRATION_STARTED_AT : CALIBRATION_ENDED_AT,
+        calls <= 2 ? 1 : 2,
+      );
+    },
+    async getNetworkByName() {
+      return cleaned ? null : {id: 'negative-control-network'};
