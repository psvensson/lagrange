index 0000000000000000000000000000000000000000..f615e8fd4877e2e514785f0127f81c8a74a77605
--- /dev/null
+++ b/test/bootstrap/replication-target-consumers.test.js
@@ -0,0 +1,177 @@
+// Witness for the CONSUMERS routed through the replication-target authority.
+// The authority being correct proves nothing about whether the deciders use
+// it; a previous round routed four readers and left every one unwitnessed.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import {MessageGroupService} from '../../src/message-group/message-group-service.js';
+import {
+  INITIAL_MESSAGE_GROUP_REPLICA_IDS,
+} from '../../src/bootstrap/system-table-schemas-constants.js';
+import {
+  applyUnifiedRebalancerControlPlaneReadinessMethods,
+} from '../../src/rebalancer/unified-rebalancer-control-plane-readiness-methods.js';
+import {
+  NodeJoiningOperationLedgerFormationReadiness,
+} from '../../src/bootstrap/node-joining-operation-ledger-formation-readiness.js';
+import {
+  DECLARED_REPLICA_COUNT_DEFAULT,
+} from '../../src/bootstrap/replication-target-authority.js';
+import {
+  evaluateOperationLedgerQuorumConcentration,
+} from '../../src/rebalancer/operation-ledger-quorum-concentration.js';
+
+test('message-group-handoff-cannot-mutate-the-declaration', () => {
+  // The exact sibling of the partition leak, left open one line short: the
+  // seed phase hands INITIAL_MESSAGE_GROUP_REPLICA_IDS to the service by
+  // reference and raft lifecycle pushes onto service.replicaIds.
+  const declaredLength = INITIAL_MESSAGE_GROUP_REPLICA_IDS.length;
+  const service = new MessageGroupService({
+    // A MessageRouter-shaped transport: deliver + initialize +
+    // setServiceNodeResolver is what the service validates.
+    transport: {
+      deliver: () => {},
+      initialize: () => {},
+      setServiceNodeResolver: () => {},
+    },
+    groupId: 'mg-1',
+    replicaId: INITIAL_MESSAGE_GROUP_REPLICA_IDS[0],
+    replicaIds: INITIAL_MESSAGE_GROUP_REPLICA_IDS,
+    nodeId: 'seed',
+  });
+
+  assert.notEqual(service.replicaIds, INITIAL_MESSAGE_GROUP_REPLICA_IDS,
+    'the service peer list must not BE the declaration');
+  service.replicaIds.push('mg-1-replace-replica-a1b2c3d4e5f60718');
+  assert.equal(INITIAL_MESSAGE_GROUP_REPLICA_IDS.length, declaredLength,
+    'a minted replacement identity must not grow the declaration');
+});
+
+class ReadinessHost {}
+applyUnifiedRebalancerControlPlaneReadinessMethods(ReadinessHost);
+
+test('readiness-target-reads-declared-policy', () => {
+  const call = (partitionRow) =>
+    ReadinessHost.prototype
+      .getPriorityControlPlaneTargetReplicaCount.call({
+        entityId: 'replica_operations-p1',
+        isControlPlanePriorityPartition: () => true,
+        systemTableCache: {
+          get: () => partitionRow,
+          filter: () => (partitionRow ? [partitionRow] : []),
+        },
+      });
+
+  assert.equal(call({partition_id: 'replica_operations-p1', replica_count: 5}),
+    5, 'a declared policy of five is the target');
+  // Previously this floored a non-integral value and read through the
+  // prototype chain, so the same persisted row meant different things to
+  // different consumers.
+  // 5.7 discriminates: flooring yields 5, the undeclared fallback does not.
+  assert.notEqual(call({partition_id: 'x', replica_count: 5.7}), 5,
+    'a non-integral value is not silently floored into policy');
+  /* eslint-disable no-extend-native */
+  Object.prototype.replica_count = 99;
+  try {
+    assert.notEqual(call({partition_id: 'x'}), 99,
+      'an inherited replica_count is not this row\'s policy');
+  } finally {
+    delete Object.prototype.replica_count;
+  }
+  /* eslint-enable no-extend-native */
+});
+
+test('formation-target-is-declared-policy-and-fails-closed', () => {
+  // The safety property is NOT "a zero target is insufficient". A false cohort
+  // never latches barrierEngaged, and after the discovery window the state is
+  // BYPASSED_INSUFFICIENT_COHORT — a RELEASE state. So a zero target DISARMS
+  // the barrier in 50ms in exactly the window it polices. The property that
+  // matters is that an un-hydrated cache still yields a workable target.
+  const snapshotFor = (partitionRow) =>
+    NodeJoiningOperationLedgerFormationReadiness.prototype
+      .resolveFormationLedgerTargetReplicaCount.call({}, {
+        systemTableCache: {get: () => partitionRow, filter: () => []},
+        partitionId: 'replica_operations-p1',
+      });
+
+  assert.equal(snapshotFor({partition_id: 'replica_operations-p1',
+    replica_count: 5}), 5, 'a declared policy of five is the target');
+  assert.equal(snapshotFor(undefined), DECLARED_REPLICA_COUNT_DEFAULT,
+    'an un-hydrated ledger row resolves to the creation default, never zero');
+  assert.notEqual(snapshotFor(undefined), 0,
+    'a zero target would disarm the barrier, not fail it closed');
+
+  // And the cohort check can never be satisfied by an absent target.
+  const cohort = (targetReplicaCount, candidateCount) =>
+    NodeJoiningOperationLedgerFormationReadiness.prototype
+      .hasSufficientOperationLedgerFormationCohort.call({}, {
+        targetReplicaCount,
+        candidateNodeIds: Array.from({length: candidateCount}, (v, i) => `n${i}`),
+        preReadyCandidateNodeIds: Array.from(
+          {length: candidateCount}, (v, i) => `n${i}`),
+      });
+  assert.equal(cohort(DECLARED_REPLICA_COUNT_DEFAULT, 3), true);
+  assert.equal(cohort(undefined, 3), true,
+    'an absent target still sizes the cohort from the creation default, so ' +
+    'the barrier engages instead of bypassing');
+  assert.equal(cohort(DECLARED_REPLICA_COUNT_DEFAULT + 1, 3), false,
+    'the declared target decides the cohort, not a constant');
+});
+
+test('camel-alias-is-decoded-as-policy', () => {
+  // The decoder accepts both persisted spellings because one routed reader
+  // previously honoured the camel alias; without a witness the alias branch
+  // was speculative.
+  const call = (partitionRow) =>
+    ReadinessHost.prototype
+      .getPriorityControlPlaneTargetReplicaCount.call({
+        entityId: 'replica_operations-p1',
+        isControlPlanePriorityPartition: () => true,
+        systemTableCache: {get: () => partitionRow, filter: () => []},
+      });
+  assert.equal(call({partition_id: 'x', replicaCount: 4}), 4);
+});
+
+test('quorum-concentration-target-reads-declared-policy', () => {
+  // Reverting this decoder was invisible: the previous reader used a plain
+  // `Number(row?.replica_count)`, which inherits through the prototype chain
+  // and ignores the camel alias. Both are discriminating inputs.
+  const ledgerPartition = 'replica_operations-p1';
+  const serviceRow = (nodeId, replicaId) => ({
+    service_id: `svc-${replicaId}`, service_type: 'partition',
+    node_id: nodeId, partition_id: ledgerPartition, replica_id: replicaId,
+    raft_role: 'follower', status: 'active',
+  });
+  const cacheWith = (partitionRow) => ({
+    filter: (table) => (table === 'services' ? [
+      serviceRow('seed', `${ledgerPartition}-r1`),
+      serviceRow('seed', `${ledgerPartition}-r2`),
+      serviceRow('seed', `${ledgerPartition}-r3`),
+    ] : []),
+    get: () => partitionRow,
+  });
+
+  // A camel-only row carries policy; the reverted reader saw none and
+  // answered null, which changes whether concentration is reported at all.
+  const camel = evaluateOperationLedgerQuorumConcentration(
+    cacheWith({partition_id: ledgerPartition, replicaCount: 3}), {});
+  assert.equal(typeof camel, 'object');
+  assert.equal(Array.isArray(camel.concentratedPartitions), true);
+
+  /* eslint-disable no-extend-native */
+  Object.prototype.replica_count = 99;
+  try {
+    const polluted = evaluateOperationLedgerQuorumConcentration(
+      cacheWith({partition_id: ledgerPartition}), {});
+    // An inherited value must not become this partition's target; with the
+    // plain read it did, and 99 changes the concentration verdict.
+    assert.equal(Array.isArray(polluted.concentratedPartitions), true);
+    assert.deepEqual(
+      polluted.concentratedPartitions.map((p) => p.targetReplicaCount)
+        .filter((n) => n === 99),
+      [], 'an inherited replica_count must never become the target');
+  } finally {
+    delete Object.prototype.replica_count;
+  }
+  /* eslint-enable no-extend-native */
+});
