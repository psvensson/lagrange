+  },
+  "doneWhen": {
+    "probe": "oracle",
+    "args": {
+      "file": "solve/oracle/solver-next-checkpoint-projection-closure.json"
+    }
+  },
+  "frontiers": [
+    {
+      "id": "solver-next-checkpoint-projection-closure-main",
+      "priority": 1,
+      "metric": {
+        "probe": "oracle",
+        "args": {
+          "file": "solve/oracle/solver-next-checkpoint-projection-closure.json"
+        }
+      }
+    }
+  ],
+  "constraints": [
+    {
+      "id": "source-change-subagent-verification",
+      "statement": "If this Quest changes source code, spawn a subagent verifier before audit and git handoff, then record a Solver finding with evidence subagent:<id>."
+    },
+    {
+      "id": "checkpoint-integrity-preserved",
+      "statement": "Do not weaken exact attempt approval, dirty-path coverage, rejection supersession, or terminal aggregate verification; change only typed next-action selection after an explicit checkpoint."
+    },
+    {
+      "id": "executable-next-action",
+      "statement": "The action rendered after checkpoint must be executable against the same repository state and must preserve pending-step and recorded-gate precedence."
+    }
+  ]
+}
