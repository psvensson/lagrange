+  for (let index = 0; index < keys.length; index += 1) {
+    deepFreeze(value[keys[index]]);
+  }
+  return value;
+}
+
+export function createComparativeEfficiencyClaimRow(input) {
+  assertClaimCanonicalData(input);
+  const body = structuredCloneValue(input);
