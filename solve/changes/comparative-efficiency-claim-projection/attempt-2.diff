+function replaceProperty(owner, key, value) {
+  const descriptor = objectGetOwnPropertyDescriptor(owner, key);
+  reflectDefineProperty(owner, key, {
+    configurable: true,
+    writable: true,
+    value,
+  });
+  return () => reflectDefineProperty(owner, key, descriptor);
