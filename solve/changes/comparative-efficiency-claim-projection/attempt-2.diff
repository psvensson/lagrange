+import {
+  assertBenchmarkResourceArray,
+  assertBenchmarkResourceDigest,
+  assertBenchmarkResourceExactRecord,
+  assertBenchmarkResourceText,
+} from './benchmark-resource-evidence-data.js';
+import {
