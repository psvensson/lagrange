+    rowId: digestClaimData(body),
+    ...body,
+  });
+}
+
+export function createComparativeEfficiencyClaimTable(evaluatedAt, rows) {
+  const body = {
+    schemaVersion: COMPARATIVE_CLAIM_PROJECTION_SCHEMA_VERSION,
+    evaluatedAt,
+    rows: structuredCloneValue(rows),
+  };
