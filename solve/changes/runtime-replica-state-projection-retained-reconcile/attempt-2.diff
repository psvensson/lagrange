+        success: true,
+        partitionResult: {affectedRows: 1},
+      };
+    },
+    async insertService(row) {
+      calls.push({kind: 'insert', row});
+      return {success: true};
+    },
+    async removeService(serviceId) {
+      calls.push({kind: 'delete', serviceId});
+      return {success: true};
+    },
+  };
