+    (event) => event.status === RUNTIME_REPLICA_STATUS.STOPPED,
+  );
+
+  try {
+    owner.submit(SERVICE_ID, {
+      status: RUNTIME_REPLICA_STATUS.ACTIVE,
+      service_type: 'runtime_service',
+      node_id: HOST_NODE_ID,
+      updated_at: 1,
+    });
