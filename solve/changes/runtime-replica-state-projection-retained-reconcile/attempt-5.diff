+  APPLIED: 'runtime_replica_state_projection_applied',
+  RETRYING: 'runtime_replica_state_projection_retrying',
+  FAILED: 'runtime_replica_state_projection_failed',
+  SHUTDOWN: 'runtime_replica_state_projection_shutdown',
+});
