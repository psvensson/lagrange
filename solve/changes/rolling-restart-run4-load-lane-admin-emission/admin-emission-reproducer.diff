+++ b/test/admin/admin-websocket-load-lane-priority-recovery-emission.test.js
@@ -0,0 +1,172 @@
+import {test} from '../../src/test-helpers/tap.js';
+import {AdminWebSocketAPI, MessageType, ErrorCode} from
+  '../../src/admin/admin-websocket-api.js';
+import {
+  CONTROL_PLANE_PRIORITY_RECOVERY_REASON,
+  CONTROL_PLANE_PUBLICATION_MODE,
+  CONTROL_PLANE_READINESS_REASON,
+  READINESS_SNAPSHOT_KEY,
+  RUNTIME_AUTHORITY_STATE,
+} from '../../src/control-plane/control-plane-readiness-constants.js';
+import {
+  ControlPlaneReadinessService,
+} from '../../src/control-plane/control-plane-readiness-service.js';
+import {
+  connectAndReceive,
+  createPopulatedCache,
+  waitForMessage,
+} from './admin-websocket-api-test-support.js';
+import {
+  createAccountingService,
+  createActiveNode,
+  createCache,
+  createMessageGroupService,
+  createPublicationService,
+} from '../control-plane/control-plane-readiness-service-test-support.js';
+
+const TEST_NODE_ID = 'admin-load-lane-priority-node';
+const TEST_NOW_MS = 1500;
+const TEST_BUDGET_BYTES = 1000;
+const TEST_PUBLICATION_EPOCH = 23;
+const TEST_RETRY_AFTER_MS = 250;
+const TEST_QUERY_ID = 'q-load-lane-priority-recovery-admission';
+const TEST_QUERY_SQL = 'SELECT 1';
+const TEST_LOAD_LANE = 'load';
+const TEST_READ_PROFILE_DIAGNOSTICS = 'diagnostics';
+const TEST_READ_PROFILE_PLANNING = 'planning';
+const TEST_PUBLICATION_STATUS_ACK_PENDING = 'ACK_PENDING';
+const TEST_PRESSURE_STATE_NORMAL = 'normal';
+const TEST_PUBLICATION_ENTERED_AT = '2026-03-04T00:00:00.000Z';
+const TEST_ADMIN_REASON_CODE =
+  CONTROL_PLANE_READINESS_REASON.PRIORITY_CONTROL_PLANE_RECOVERY_PENDING;
+const TEST_RECOVERY_REASON_CODE =
+  CONTROL_PLANE_PRIORITY_RECOVERY_REASON.PUBLICATION_EPOCH_PENDING;
+const TEST_SERVE_NOT_READY_PATTERN = /serve not ready/;
+
+function createPriorityRecoveryReadinessService(readProfiles) {
+  return new ControlPlaneReadinessService({
+    nodeId: TEST_NODE_ID,
+    systemTableCache: createCache({
+      nodes: [createActiveNode(TEST_NODE_ID)],
+      services: [createMessageGroupService(TEST_NODE_ID)],
+    }),
+    storageAccountingService: createAccountingService({
+      [TEST_NODE_ID]: {
+        nodeId: TEST_NODE_ID,
+        budgetBytes: TEST_BUDGET_BYTES,
+        pressureState: TEST_PRESSURE_STATE_NORMAL,
+      },
+    }),
+    cdcGroupPropagationService: createPublicationService({
+      currentMode: CONTROL_PLANE_PUBLICATION_MODE.GROUPED,
+      reasonCode: null,
+      enteredAt: TEST_PUBLICATION_ENTERED_AT,
+      recentTransitions: [],
+    }),
+    membershipPublicationService: {
+      async getLatestPublicationForNode(targetNodeId, options = {}) {
+        if (targetNodeId !== TEST_NODE_ID) {
+          return null;
+        }
+        readProfiles.push(options.readProfile || null);
+        if (options.readProfile === TEST_READ_PROFILE_DIAGNOSTICS) {
+          return null;
+        }
+        return {
+          publicationEpoch: TEST_PUBLICATION_EPOCH,
+          status: TEST_PUBLICATION_STATUS_ACK_PENDING,
+          publishedActiveNodeIds: [TEST_NODE_ID],
+          requiredAckNodeIds: [TEST_NODE_ID],
+          acknowledgedNodeIds: [],
+        };
+      },
+      getLatestPublicationForNodeSync(targetNodeId, options = {}) {
+        if (targetNodeId !== TEST_NODE_ID) {
+          return null;
+        }
+        readProfiles.push(options.readProfile || null);
+        if (options.readProfile === TEST_READ_PROFILE_DIAGNOSTICS) {
+          return null;
+        }
+        return {
+          publicationEpoch: TEST_PUBLICATION_EPOCH,
+          status: TEST_PUBLICATION_STATUS_ACK_PENDING,
+          publishedActiveNodeIds: [TEST_NODE_ID],
+          requiredAckNodeIds: [TEST_NODE_ID],
+          acknowledgedNodeIds: [],
+        };
+      },
+    },
+    now: () => TEST_NOW_MS,
+  });
+}
+
+function assertPriorityRecoveryEnvelope(t, result) {
+  const loadLaneAdmission = result.details.loadLaneAdmission;
+  const runtimeAuthority =
+    loadLaneAdmission[READINESS_SNAPSHOT_KEY.RUNTIME_AUTHORITY];
+
+  t.equal(result.type, MessageType.QUERY_RESULT);
+  t.equal(result.queryId, TEST_QUERY_ID);
+  t.equal(result.errorCode, ErrorCode.INTERNAL_ERROR);
+  t.equal(result.deferRetry, true);
+  t.equal(result.retryAfterMs, TEST_RETRY_AFTER_MS);
+  t.match(String(result.error), TEST_SERVE_NOT_READY_PATTERN);
+  t.match(String(result.error), new RegExp(TEST_ADMIN_REASON_CODE));
+  t.ok(
+    loadLaneAdmission.reasonCodes.includes(TEST_ADMIN_REASON_CODE),
+    'load-lane details should include the readiness owner pressure reason',
+  );
+  t.equal(loadLaneAdmission.serveEligible, false);
+  t.equal(runtimeAuthority.state, RUNTIME_AUTHORITY_STATE.CONFIRMED);
+  t.ok(
+    runtimeAuthority.reasonCodes.includes(TEST_RECOVERY_REASON_CODE),
+    'runtime authority details should preserve priority recovery planning',
+  );
+}
+
+function assertPublicationReadsUsed(t, publicationReadProfiles) {
+  t.ok(publicationReadProfiles.includes(TEST_READ_PROFILE_DIAGNOSTICS));
+  t.ok(publicationReadProfiles.includes(TEST_READ_PROFILE_PLANNING));
+}
+
+test('AdminWebSocketAPI emits priority recovery load-lane pressure from real readiness',
+  async (t) => {
+    const publicationReadProfiles = [];
+    let executedQueryCount = 0;
+    const api = new AdminWebSocketAPI({
+      nodeId: TEST_NODE_ID,
+      systemTableCache: createPopulatedCache(),
+      sqlQueryEngine: {
+        executeRequest: async () => {
+          executedQueryCount += 1;
+          return {
+            success: true,
+            rows: [{id: TEST_NODE_ID}],
+            count: 1,
+          };
+        },
+      },
+      controlPlaneReadinessService:
+        createPriorityRecoveryReadinessService(publicationReadProfiles),
+    });
+
+    await api.initialize(0, {listen: false});
+    const {ws} = await connectAndReceive(api, 2000, {
+      query: {lane: TEST_LOAD_LANE},
+    });
+
+    ws.send(JSON.stringify({
+      type: MessageType.QUERY,
+      queryId: TEST_QUERY_ID,
+      sql: TEST_QUERY_SQL,
+    }));
+
+    const result = await waitForMessage(ws);
+    assertPriorityRecoveryEnvelope(t, result);
+    t.equal(executedQueryCount, 0);
+    assertPublicationReadsUsed(t, publicationReadProfiles);
+
+    ws.close();
+    await api.shutdown();
+  });
