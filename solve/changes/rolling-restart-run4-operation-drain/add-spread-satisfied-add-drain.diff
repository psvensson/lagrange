+    t.same(
+      failedOperationIds,
+      [],
+      TEST_ASSERT_SPREAD_SATISFIED_ADD_TARGET_DRAIN,
+    );
+    t.same(
+      [deliveries.length, deferredTimers.length],
+      [NUM.ZERO, NUM.ZERO],
+      TEST_ASSERT_SPREAD_SATISFIED_NO_REMOTE_WAKE,
+    );
+  } finally {
+    await coordinator.shutdown();
+  }
+});
