+              requiredDistinctNodeCount:
+                PRIORITY_RECOVERY_REQUIRED_DISTINCT_NODE_COUNT,
+              readyDistinctNodeCount: 1,
+              spreadGap: 2,
+            }],
+            missingPartitionIds: [
+              SQL_TRANSACTION_PRIORITY_PARTITION_ID,
+            ],
+            requiredDistinctNodeCount:
+              PRIORITY_RECOVERY_REQUIRED_DISTINCT_NODE_COUNT,
