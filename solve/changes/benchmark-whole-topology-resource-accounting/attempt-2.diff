+
+export const BENCHMARK_RESOURCE_ARTIFACT_KIND = Object.freeze({
+  ALTERNATIVE_TOPOLOGY: 'alternative_topology',
+  CAPACITY_REPORT: 'capacity_report',
+  CAPACITY_SAMPLE: 'capacity_sample',
