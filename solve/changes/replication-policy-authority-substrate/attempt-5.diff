+  // creation path writes is the value policy then reads.
+  assert.equal(
+    resolveDesiredReplicationFactor({
+      partitionRow: {replica_count: DECLARED_REPLICA_COUNT_DEFAULT},
+    }).replicationFactor,
+    declared);
+});
