--- /dev/null
+++ b/scripts/quest-evidence-replication-policy-authority-substrate.js
@@ -0,0 +1,308 @@
+// Deterministic evidence harness for the replication-policy-authority-substrate
+// quest (S1.1-A). The witnesses use raw node:test (not the repo tap shim), so
+// --test-name-pattern selects exactly one anchored scenario per receipt.
+//
+// SCOPE: this quest proves the policy AUTHORITY and the identity/policy
+// separation only. It deliberately makes no claim that every behaviour-changing
+// consumer already resolves through that authority — that claim, its inventory
+// and the transferred move-planner exception belong to the successor quest
+// behaviour-changing-consumer-convergence.
+
+import path from 'node:path';
+
+import {
+  runQuestEvidenceHarness,
+} from './quest-evidence-harness-runtime.js';
+
+const AUTHORITY_TEST = 'test/bootstrap/replication-target-authority.test.js';
+// NOT a bare `node --test --test-name-pattern` run. That exits 0 when the
+// pattern matches NOTHING and reports `# tests 1 / # pass 1` (the file-level
+// subtest), so a renamed or deleted scenario is indistinguishable from a
+// passing one and every receipt in this file would be a shell. The runner
+// requires the named top-level `ok <n> - <scenario>` TAP line.
+const ANCHORED_RUNNER =
+  'node test/bootstrap/run-anchored-scenario-helper.js ';
+const SPACE = ' ';
+
+function scenarioCommand(scenarioName, testFile = AUTHORITY_TEST) {
+  return ANCHORED_RUNNER + testFile + SPACE + scenarioName;
+}
+
+// The one receipt that must NOT be graded by the runner alone. Every other
+// receipt trusts the runner, so a neutered runner keeps them all green while
+// the witness is genuinely red. Guarding only the ABSENT case was still a
+// point fix: a runner that accepts a FAILING scenario satisfied it. The
+// control now drives a fixture file covering all three outcome classes and
+// demands the runner's verdict on each, so a runner that is wrong in ANY
+// direction — or keyed to a particular probe NAME — fails this receipt.
+const RUNNER_FIXTURES = 'test/bootstrap/anchored-runner-fixture-cases.js';
+const FIXTURE_PASSES = 'anchored-runner-fixture-passes';
+const FIXTURE_FAILS = 'anchored-runner-fixture-fails';
+const FIXTURE_ABSENT = 'anchored-runner-fixture-absent-on-purpose';
+const SHELL_IF = 'if ';
+const SHELL_THEN_FAIL = '; then exit 1; fi; ';
+const SHELL_AND = ' && ';
+
+const WITNESS_ABSENT_PROBE = 'witness-absent-probe-that-does-not-exist';
+
+function mustReject(scenarioName, testFile = RUNNER_FIXTURES) {
+  return SHELL_IF + scenarioCommand(scenarioName, testFile) +
+    SHELL_THEN_FAIL;
+}
+
+// Grading the runner ONLY against the fixture file left one bypass open: a
+// runner honest for that path and permissive for every other one suppressed
+// its own detector, so the harness read 16/16 while three witness scenarios
+// were red. The control therefore ALSO runs the witness file directly, with
+// the runner out of the mediating position entirely, and requires it green.
+const WITNESS_DIRECT = 'node --test ' + AUTHORITY_TEST;
+
+function runnerVerdictIsTrustworthy(scenarioName) {
+  // A scenario that FAILED and one that is ABSENT must both be rejected, and
+  // one that genuinely passed must be accepted - on the fixture file AND on
+  // the witness itself, so no file-scoped cheat survives.
+  return mustReject(FIXTURE_FAILS) + mustReject(FIXTURE_ABSENT) +
+    mustReject(WITNESS_ABSENT_PROBE, AUTHORITY_TEST) +
+    scenarioCommand(FIXTURE_PASSES, RUNNER_FIXTURES) + SHELL_AND +
+    WITNESS_DIRECT + SHELL_AND +
+    scenarioCommand(scenarioName);
+}
+
+const RECEIPTS = Object.freeze([
+  Object.freeze({
+    id: 'target-comes-from-declared-schema-not-identity-count',
+    command: scenarioCommand(
+      'target-comes-from-declared-schema-not-identity-count'),
+    detail: 'a row present but carrying no usable ' +
+      'replica_count is an incomplete policy row that fails CLOSED. The schema ' +
+      'default seeds a NEW row; it is not a reading of a row that failed to ' +
+      'declare one, so a garbage value and an omitted column are both simply ' +
+      'undeclared. This scenario does NOT prove the read-not-restated ' +
+      'property - its asserts compare the constant to column.defaultValue and ' +
+      'to 3, which a restated literal also satisfies. That property is proved ' +
+      'by creation-default-tracks-schema-declaration (drift and re-import) ' +
+      'and, at the production sites, by the two creation-site receipts',
+  }),
+  Object.freeze({
+    id: 'partition-row-policy-overrides-the-default',
+    command: scenarioCommand('partition-row-policy-overrides-the-default'),
+    detail: 'a partition declaring its own replica_count wins over the schema ' +
+      'default, with the source typed, so policy is per-partition where the ' +
+      'schema says it is',
+  }),
+  Object.freeze({
+    id: 'absent-partition-row-is-undeclared-not-defaulted',
+    command: scenarioCommand(
+      'absent-partition-row-is-undeclared-not-defaulted'),
+    detail: 'a partition with NO policy row resolves undeclared with factor 0 ' +
+      'across six shapes including an empty ARRAY and an array carrying an own replica_count, which satisfies typeof ' +
+      'object and would otherwise fall through to the default. Borrowing the ' +
+      'default would invent a requirement the partition was never given and ' +
+      'would erase the fail-closed unreadable-requirement case landed in S1. ' +
+      'Mutation-verified: removing the guard reds this scenario',
+  }),
+  Object.freeze({
+    id: 'identity-churn-cannot-move-the-target',
+    command: scenarioCommand('identity-churn-cannot-move-the-target'),
+    detail: 'THE MEASURED DEFECT. getInitialReplicaIds handed out the ' +
+      'declaration BY REFERENCE and replica wiring pushed into it, so inside a ' +
+      'running cluster a minted replace-replica-<hex> made replica_operations ' +
+      'report a desired RF of 4 where a fresh process reports 3 — the ' +
+      'denominator of the distinct-node invariant drifted with identity ' +
+      'churn. The getter now returns a copy, a caller mutating its copy leaves ' +
+      'the declaration and every later reader unchanged, and the target is ' +
+      'unmoved because it never counted identities at all. Mutation-verified: ' +
+      'restoring the reference leak reds this scenario',
+  }),
+  Object.freeze({
+    id: 'every-critical-table-declares-the-same-target',
+    command: scenarioCommand('every-critical-table-declares-the-same-target'),
+    detail: 'PERSISTED policy per table, driven through the real seeding ' +
+      'path. This receipt was vacuous: it BUILT each row from the default and ' +
+      'asserted the decode equalled 3, so every iteration was ' +
+      'assert.equal(3, 3) with only a string differing, and it read no ' +
+      'per-table declaration. It now seeds the system tables for real and ' +
+      'asserts the DISTINCT set of persisted replica_count values is exactly ' +
+      'the one PARTITIONS declaration, that drifting that declaration moves ' +
+      'every table together, and that a longer identity list changes no ' +
+      'table\'s persisted value. It does NOT call the decoder, so it makes no ' +
+      'claim about what any consumer resolves - a consumer computing a ' +
+      'requirement from a table\'s identity-list length is the successor ' +
+      'quest\'s to catch, not this one\'s',
+  }),
+  Object.freeze({
+    id: 'authority-mints-no-runtime-state',
+    command: scenarioCommand('authority-mints-no-runtime-state'),
+    detail: 'the target is frozen and carries exactly replicationFactor and ' +
+      'source — no holders, replicaIds, converged or ready — so policy and ' +
+      'runtime state stay separate surfaces. Asserted on BOTH branches, and ' +
+      'over Reflect.ownKeys rather than Object.keys: the earlier form used a ' +
+      'row carrying no replica_count, which returns the frozen UNDECLARED ' +
+      'CONSTANT and never reaches the minted projection, so a key added on ' +
+      'the declared path survived. Mutation-verified: adding holders: [] to ' +
+      'the declared projection now reds this scenario, and previously did ' +
+      'not red anything. The typed source STRINGS are pinned too, since ' +
+      'comparing a target\'s source to the constant that produced it cannot ' +
+      'detect a renamed value. SCOPE: the claim is about the returned ' +
+      'projection and the exported surface. Internal memoisation inside the ' +
+      'module - a private WeakMap cache, say - is NOT distinguished by this ' +
+      'scenario and the receipt does not claim otherwise',
+  }),
+  Object.freeze({
+    id: 'hostile-policy-rows-cannot-forge-a-target',
+    command: scenarioCommand('hostile-policy-rows-cannot-forge-a-target'),
+    detail: 'an inherited Object.prototype.replica_count and an ' +
+      'accessor-backed column each measured a target of 99 while the bar ' +
+      'stayed green; -2, 0, 3.5, null, "3", NaN, Infinity and true were all ' +
+      'accepted as policy. Now every one resolves undeclared, and the accessor ' +
+      'is asserted NEVER to execute while the row is validated. ' +
+      'Mutation-verified: weakening the own-property descriptor read, or ' +
+      'dropping the safe-integer test, each red this scenario. Extended after review with the UNSAFE-integer case (2**53, '+
+      'without which Number.isSafeInteger could be weakened to '+
+      'Number.isInteger unnoticed), the camel-alias ACCEPTANCE case '+
+      '(without which the alias could be deleted unnoticed), and rows '+
+      'whose two spellings DISAGREE. The spelling loop used '+
+      'continue-on-invalid, so a rejected snake value was silently '+
+      'rescued by the alias: {replica_count: \'9\', replicaCount: 4} '+
+      'decoded to 4. The first spelling actually present now decides, '+
+      'and a disagreeing row fails closed',
+  }),
+  Object.freeze({
+    id: 'creation-default-tracks-schema-declaration',
+    command: scenarioCommand('creation-default-tracks-schema-declaration'),
+    detail: 'the claim is SEMANTIC, not syntactic: if the schema-declared ' +
+      'replica_count default changes, the creation default follows it. The ' +
+      'probe drifts the declaration to 4 and re-evaluates, so an ' +
+      'implementation restating a literal cannot track it and reds. How the ' +
+      'value is obtained — lookup, helper, or a later mechanism — is not the ' +
+      'claim, and no source-text proof is asserted',
+  }),
+  Object.freeze({
+    id: 'production-handoff-cannot-mutate-the-declaration',
+    command: scenarioCommand(
+      'production-handoff-cannot-mutate-the-declaration'),
+    detail: 'THE REAL ALIAS CHAIN. The seed phase reads ' +
+      'INITIAL_REPLICA_IDS[table] and hands it to PartitionService as ' +
+      'options.replicaIds; the service stored it BY REFERENCE and raft peer ' +
+      'reconciliation pushes onto service.replicaIds, so the mutable peer list ' +
+      'WAS the shared declaration and one minted replace-replica-<hex> raised ' +
+      'the apparent factor for every later reader. Copying inside ' +
+      'getInitialReplicaIds did nothing here, because this path never calls ' +
+      'it — the first fix protected a path with no production caller. This ' +
+      'drives the REAL PartitionService constructor with the exact production ' +
+      'hand-off and asserts the declaration is unchanged after a replacement ' +
+      'identity is appended. Mutation-verified: restoring the by-reference ' +
+      'assignment reds this scenario, which nothing else caught. The seed hand-offs are now uniform: every read of a '+
+      'declaration goes through getInitialReplicaIds, which returns a '+
+      'copy. Only the two SERVICE constructor copies and the getter '+
+      'itself have a behavioural witness, because they are the paths '+
+      'that reach an in-place mutator (raft peer reconciliation pushes '+
+      'and splices those lists). The remaining hand-off copies are '+
+      'defence-in-depth with no reachable mutator today, so reverting '+
+      'them alone reds nothing, and this receipt does not claim they '+
+      'are individually proven',
+  }),
+  Object.freeze({
+    id: 'message-group-handoff-cannot-mutate-the-declaration',
+    command: scenarioCommand(
+      'message-group-handoff-cannot-mutate-the-declaration'),
+    detail: 'the SIBLING of the partition leak, left open one line short: the ' +
+      'seed phase hands INITIAL_MESSAGE_GROUP_REPLICA_IDS to the service by ' +
+      'reference and raft lifecycle pushes onto service.replicaIds, so one ' +
+      'minted identity grew the declaration for every later reader. Drives the ' +
+      'REAL MessageGroupService constructor. Mutation-verified: restoring the ' +
+      'by-reference assignment reds this scenario',
+  }),
+  Object.freeze({
+    id: 'message-group-policy-comes-from-its-own-schema',
+    command: scenarioCommand(
+      'message-group-policy-comes-from-its-own-schema'),
+    detail: 'one cross-table authority leak must not be replaced by a shared ' +
+      'default. A MESSAGE_GROUPS row was being seeded from the PARTITIONS ' +
+      'schema default, leaving the message-group declaration read by nothing ' +
+      'while its rows followed another table\'s policy. The claim is proved ' +
+      'with TWO arrows because both schemas currently declare the SAME ' +
+      'number: drifting the MESSAGE_GROUPS declaration moves the ' +
+      'message-group creation default, and drifting the PARTITIONS ' +
+      'declaration does NOT move it. A one-arrow or source-text proof cannot ' +
+      'distinguish the two authorities while 3 == 3. Mutation-verified: ' +
+      're-pointing the message-group default at PARTITIONS_SCHEMA reds arrow ' +
+      '2 while arrow 1 stays green',
+  }),
+  Object.freeze({
+    id: 'creation-writes-declared-policy-not-identity-count',
+    command: scenarioCommand(
+      'creation-writes-declared-policy-not-identity-count'),
+    detail: 'the identity-count write, driven through the REAL creation path ' +
+      'rather than asserted against source text. A self-hosted group comes up ' +
+      'with ONE local replica; writing replicas.length persisted a DECLARED ' +
+      'target of 1, and every later reader decodes that row as authority, so ' +
+      'an accident of startup timing became policy. The staged row now ' +
+      'carries the declared default, is not equal to the identity count, and ' +
+      'decodes back through the authority to the same value. Mutation-' +
+      'verified: restoring replica_count: replicaIds.length reds this ' +
+      'scenario, and NO other receipt in this set caught that mutation',
+  }),
+  Object.freeze({
+    id: 'message-group-creation-site-follows-its-own-declaration',
+    command: scenarioCommand(
+      'message-group-creation-site-follows-its-own-declaration'),
+    detail: 'THE SITE, not the constant. Review mutation A re-pointed the ' +
+      'production message-group write at the PARTITIONS authority - the exact ' +
+      'cross-table leak this quest claims to close - and every receipt stayed ' +
+      'green, because nothing pinned which constant the site consumes and both ' +
+      'schemas declare 3. An in-process re-import cannot prove it either: ESM ' +
+      'caches by specifier, so the re-imported phase keeps the original ' +
+      'authority module. The drift therefore happens in a FRESH process before ' +
+      'the authority is first evaluated, and the REAL creation path is driven: ' +
+      'the staged row follows a drifted MESSAGE_GROUPS declaration and does ' +
+      'NOT follow a drifted PARTITIONS one. Mutation-verified: mutation A now ' +
+      'reds this scenario',
+  }),
+  Object.freeze({
+    id: 'partitions-creation-site-follows-its-own-declaration',
+    command: scenarioCommand(
+      'partitions-creation-site-follows-its-own-declaration'),
+    detail: 'the PARTITIONS half, which had NO witness at all: review mutation ' +
+      'B replaced the seed-registration write with a literal 1 - a bootstrap ' +
+      'persisting a declared target of 1 for every seeded system table - and ' +
+      'all receipts stayed green. SeedRegistrationPhase.registerSystemTables ' +
+      'is now driven under schema drift in a fresh process, proving every ' +
+      'seeded partitions row follows the PARTITIONS declaration and not the ' +
+      'message-group one. Mutation-verified: mutation B now reds this scenario',
+  }),
+  Object.freeze({
+    id: 'absent-scenario-cannot-pass-as-a-receipt',
+    command: runnerVerdictIsTrustworthy(
+      'absent-scenario-cannot-pass-as-a-receipt'),
+    detail: 'THE HARNESS-FIDELITY CONTROL, and the reason every receipt in ' +
+      'this file now runs through test/bootstrap/run-anchored-scenario-helper.js. ' +
+      '`node --test --test-name-pattern` exits 0 when the pattern matches ' +
+      'NOTHING and prints `# tests 1 / # pass 1` for the file-level subtest, ' +
+      'so counts cannot distinguish a match from a miss. Review mutation C ' +
+      'renamed one scenario and the harness reported 13/13 with it never run: ' +
+      'every receipt was a shell proving only that the FILE loaded. The runner ' +
+      'requires the named top-level `ok <n> - <scenario>` TAP line and clears ' +
+      'NODE_TEST_CONTEXT and NODE_OPTIONS from the child, which the ' +
+      'self-test caught as a real defect - an inherited test context switches ' +
+      'the reporter off TAP and would report a PRESENT scenario as absent. ' +
+      'Mutation-verified: mutation C now reds',
+  }),
+  Object.freeze({
+    id: 'witness-deterministic',
+    command: scenarioCommand('witness-deterministic'),
+    detail: 'repeated resolution of the full policy matrix produces one ' +
+      'identical projection, so no receipt passes by evaluation order',
+  }),
+]);
+
+const QUEST_ID = 'replication-policy-authority-substrate';
+const SOLVE_DIR = 'solve';
+const EVIDENCE_DIR = 'evidence';
+const RECEIPT_FILENAME = 'replication-policy-authority-substrate.receipt.json';
+
+runQuestEvidenceHarness({
+  questId: QUEST_ID,
+  outputFile: path.join(SOLVE_DIR, EVIDENCE_DIR, RECEIPT_FILENAME),
+  receipts: RECEIPTS,
+});
