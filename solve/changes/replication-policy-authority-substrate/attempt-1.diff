+// Deterministic evidence harness for the replication-policy-authority-substrate
+// quest (S1.1-A). The witnesses use raw node:test (not the repo tap shim), so
+// --test-name-pattern selects exactly one anchored scenario per receipt.
+//
+// SCOPE: this quest proves the policy AUTHORITY and the identity/policy
+// separation only. It deliberately makes no claim that every behaviour-changing
+// consumer already resolves through that authority — that claim, its inventory
+// and the transferred move-planner exception belong to the successor quest
+// behaviour-changing-consumer-convergence.
+
+import path from 'node:path';
+
+import {
+  runQuestEvidenceHarness,
+} from './quest-evidence-harness-runtime.js';
+
+const AUTHORITY_TEST = 'test/bootstrap/replication-target-authority.test.js';
+const NODE_TEST_COMMAND_PREFIX = 'node --test ';
+const TEST_NAME_PATTERN_FLAG_PREFIX = '--test-name-pattern="';
+const DOUBLE_QUOTE = '"';
+const SPACE = ' ';
+
+function scenarioCommand(scenarioPattern, testFile = AUTHORITY_TEST) {
+  return NODE_TEST_COMMAND_PREFIX +
+    TEST_NAME_PATTERN_FLAG_PREFIX + scenarioPattern + DOUBLE_QUOTE +
+    SPACE + testFile;
+}
+
+const RECEIPTS = Object.freeze([
+  Object.freeze({
+    id: 'target-comes-from-declared-schema-not-identity-count',
+    command: scenarioCommand(
+      '^target-comes-from-declared-schema-not-identity-count'),
+    detail: 'the CREATION default is READ from PARTITIONS_SCHEMA rather than ' +
+      'restated as a literal, and a row present but carrying no usable ' +
+      'replica_count is an incomplete policy row that fails CLOSED. The schema ' +
+      'default seeds a NEW row; it is not a reading of a row that failed to ' +
+      'declare one, so a garbage value and an omitted column are both simply ' +
+      'undeclared',
+  }),
+  Object.freeze({
+    id: 'partition-row-policy-overrides-the-default',
+    command: scenarioCommand('^partition-row-policy-overrides-the-default'),
+    detail: 'a partition declaring its own replica_count wins over the schema ' +
+      'default, with the source typed, so policy is per-partition where the ' +
+      'schema says it is',
+  }),
+  Object.freeze({
+    id: 'absent-partition-row-is-undeclared-not-defaulted',
+    command: scenarioCommand(
+      '^absent-partition-row-is-undeclared-not-defaulted'),
+    detail: 'a partition with NO policy row resolves undeclared with factor 0 ' +
+      'across five shapes including an empty ARRAY, which satisfies typeof ' +
+      'object and would otherwise fall through to the default. Borrowing the ' +
+      'default would invent a requirement the partition was never given and ' +
+      'would erase the fail-closed unreadable-requirement case landed in S1. ' +
+      'Mutation-verified: removing the guard reds this scenario',
+  }),
+  Object.freeze({
+    id: 'identity-churn-cannot-move-the-target',
+    command: scenarioCommand('^identity-churn-cannot-move-the-target'),
+    detail: 'THE MEASURED DEFECT. getInitialReplicaIds handed out the ' +
+      'declaration BY REFERENCE and replica wiring pushed into it, so inside a ' +
+      'running cluster a minted replace-replica-<hex> made replica_operations ' +
+      'report a desired RF of 4 where a fresh process reports 3 — the ' +
+      'denominator of the distinct-node invariant drifted with identity ' +
+      'churn. The getter now returns a copy, a caller mutating its copy leaves ' +
+      'the declaration and every later reader unchanged, and the target is ' +
+      'unmoved because it never counted identities at all. Mutation-verified: ' +
+      'restoring the reference leak reds this scenario',
+  }),
+  Object.freeze({
+    id: 'every-critical-table-declares-the-same-target',
+    command: scenarioCommand('^every-critical-table-declares-the-same-target'),
+    detail: 'all declared system tables resolve a target of 3, matching what a ' +
+      'fresh process reports, so no table silently carries a different ' +
+      'requirement that would make the invariant unsatisfiable for it alone',
+  }),
+  Object.freeze({
+    id: 'authority-mints-no-runtime-state',
+    command: scenarioCommand('^authority-mints-no-runtime-state'),
+    detail: 'the target is frozen and carries exactly replicationFactor and ' +
+      'source — no holders, replicaIds, converged or ready — so policy and ' +
+      'runtime state stay separate surfaces. Asserted on BOTH branches, and ' +
+      'over Reflect.ownKeys rather than Object.keys: the earlier form used a ' +
+      'row carrying no replica_count, which returns the frozen UNDECLARED ' +
+      'CONSTANT and never reaches the minted projection, so a key added on ' +
+      'the declared path survived. Mutation-verified: adding holders: [] to ' +
+      'the declared projection now reds this scenario, and previously did ' +
+      'not red anything',
+  }),
+  Object.freeze({
+    id: 'hostile-policy-rows-cannot-forge-a-target',
+    command: scenarioCommand('^hostile-policy-rows-cannot-forge-a-target'),
+    detail: 'an inherited Object.prototype.replica_count and an ' +
+      'accessor-backed column each measured a target of 99 while the bar ' +
+      'stayed green; -2, 0, 3.5, null, "3", NaN, Infinity and true were all ' +
+      'accepted as policy. Now every one resolves undeclared, and the accessor ' +
+      'is asserted NEVER to execute while the row is validated. ' +
+      'Mutation-verified: weakening the own-property descriptor read, or ' +
+      'dropping the safe-integer test, each red this scenario',
+  }),
+  Object.freeze({
+    id: 'creation-default-tracks-schema-declaration',
+    command: scenarioCommand('^creation-default-tracks-schema-declaration'),
+    detail: 'the claim is SEMANTIC, not syntactic: if the schema-declared ' +
+      'replica_count default changes, the creation default follows it. The ' +
+      'probe drifts the declaration to 4 and re-evaluates, so an ' +
+      'implementation restating a literal cannot track it and reds. How the ' +
+      'value is obtained — lookup, helper, or a later mechanism — is not the ' +
+      'claim, and no source-text proof is asserted',
+  }),
+  Object.freeze({
+    id: 'production-handoff-cannot-mutate-the-declaration',
+    command: scenarioCommand(
+      '^production-handoff-cannot-mutate-the-declaration'),
+    detail: 'THE REAL ALIAS CHAIN. The seed phase reads ' +
+      'INITIAL_REPLICA_IDS[table] and hands it to PartitionService as ' +
+      'options.replicaIds; the service stored it BY REFERENCE and raft peer ' +
+      'reconciliation pushes onto service.replicaIds, so the mutable peer list ' +
+      'WAS the shared declaration and one minted replace-replica-<hex> raised ' +
+      'the apparent factor for every later reader. Copying inside ' +
+      'getInitialReplicaIds did nothing here, because this path never calls ' +
+      'it — the first fix protected a path with no production caller. This ' +
+      'drives the REAL PartitionService constructor with the exact production ' +
+      'hand-off and asserts the declaration is unchanged after a replacement ' +
+      'identity is appended. Mutation-verified: restoring the by-reference ' +
+      'assignment reds this scenario, which nothing else caught',
+  }),
+  Object.freeze({
+    id: 'message-group-handoff-cannot-mutate-the-declaration',
+    command: scenarioCommand(
+      '^message-group-handoff-cannot-mutate-the-declaration'),
+    detail: 'the SIBLING of the partition leak, left open one line short: the ' +
+      'seed phase hands INITIAL_MESSAGE_GROUP_REPLICA_IDS to the service by ' +
+      'reference and raft lifecycle pushes onto service.replicaIds, so one ' +
+      'minted identity grew the declaration for every later reader. Drives the ' +
+      'REAL MessageGroupService constructor. Mutation-verified: restoring the ' +
+      'by-reference assignment reds this scenario',
+  }),
+  Object.freeze({
+    id: 'message-group-policy-comes-from-its-own-schema',
+    command: scenarioCommand(
+      '^message-group-policy-comes-from-its-own-schema'),
+    detail: 'one cross-table authority leak must not be replaced by a shared ' +
+      'default. A MESSAGE_GROUPS row was being seeded from the PARTITIONS ' +
+      'schema default, leaving the message-group declaration read by nothing ' +
+      'while its rows followed another table\'s policy. The claim is proved ' +
+      'with TWO arrows because both schemas currently declare the SAME ' +
+      'number: drifting the MESSAGE_GROUPS declaration moves the ' +
+      'message-group creation default, and drifting the PARTITIONS ' +
+      'declaration does NOT move it. A one-arrow or source-text proof cannot ' +
+      'distinguish the two authorities while 3 == 3. Mutation-verified: ' +
+      're-pointing the message-group default at PARTITIONS_SCHEMA reds arrow ' +
+      '2 while arrow 1 stays green',
+  }),
+  Object.freeze({
+    id: 'creation-writes-declared-policy-not-identity-count',
+    command: scenarioCommand(
+      '^creation-writes-declared-policy-not-identity-count'),
+    detail: 'the identity-count write, driven through the REAL creation path ' +
+      'rather than asserted against source text. A self-hosted group comes up ' +
+      'with ONE local replica; writing replicas.length persisted a DECLARED ' +
+      'target of 1, and every later reader decodes that row as authority, so ' +
+      'an accident of startup timing became policy. The staged row now ' +
+      'carries the declared default, is not equal to the identity count, and ' +
+      'decodes back through the authority to the same value. Mutation-' +
+      'verified: restoring replica_count: replicaIds.length reds this ' +
+      'scenario, and NO other receipt in this set caught that mutation',
+  }),
+  Object.freeze({
+    id: 'witness-deterministic',
+    command: scenarioCommand('^witness-deterministic'),
+    detail: 'repeated resolution of the full policy matrix produces one ' +
+      'identical projection, so no receipt passes by evaluation order',
+  }),
+]);
+
+const QUEST_ID = 'replication-policy-authority-substrate';
+const SOLVE_DIR = 'solve';
+const EVIDENCE_DIR = 'evidence';
+const RECEIPT_FILENAME = 'replication-policy-authority-substrate.receipt.json';
+
+runQuestEvidenceHarness({
+  questId: QUEST_ID,
+  outputFile: path.join(SOLVE_DIR, EVIDENCE_DIR, RECEIPT_FILENAME),
+  receipts: RECEIPTS,
+});
