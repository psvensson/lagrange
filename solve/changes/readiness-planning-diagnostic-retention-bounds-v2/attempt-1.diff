+function appendBoundedSnapshotValue(snapshot, value, index, capacity) {
+  if (snapshot.length < capacity) {
+    appendSnapshotValue(snapshot, value);
+  } else {
+    defineSnapshotValue(snapshot, index, value);
+  }
+  return (index + 1) % capacity;
