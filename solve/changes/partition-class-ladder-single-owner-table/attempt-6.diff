+
+function hasExactObjectProperties(node, expectedNames) {
+  if (node?.type !== NODE_TYPE.OBJECT ||
+      node.properties?.length !== expectedNames.length ||
+      node.properties.some((property) => property.type !== NODE_TYPE.PROPERTY)) {
+    return false;
+  }
