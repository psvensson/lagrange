+      "event": "steady_state_owner_already_active",
+      "to": "steady_state_owner_active",
+      "evidence": "No phase handoff is required because the selected steady-state owner remains the only authority."
+    }
+  ],
+  "forbiddenTransitions": [
+    {
+      "from": "ingress_normalized",
+      "event": "runtime_reopens_raw_shape",
+      "to": "semantic_owner_selected",
