+{
+  "schema": "statechart-v1",
+  "id": "core-system-logic",
+  "initial": "ingress_normalized",
+  "states": [
+    {
+      "id": "ingress_normalized",
+      "description": "External, runtime, cache, bootstrap, or diagnostic input has been normalized into the shared architecture vocabulary before semantic branching."
+    },
+    {
+      "id": "semantic_owner_selected",
+      "description": "Exactly one semantic owner and owner boundary has been selected for the normalized concern."
+    },
+    {
+      "id": "authoritative_evidence_resolved",
