+    artifact: {
+      type: 'oci',
+      ref: `registry.example.test/analytics-worker@${digest}`,
+      digest,
+      media_type: CONTAINER_MEDIA_TYPE,
+    },
+    runtime: {kind: 'oci_container'},
+  };
