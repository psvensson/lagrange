diff --git a/test/bootstrap/shared/executor-outcome-handler-binding.test.js b/test/bootstrap/shared/executor-outcome-handler-binding.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..0ee1383ca06b22fb1e43f39b7bf6419b1e2558ec
--- /dev/null
+++ b/test/bootstrap/shared/executor-outcome-handler-binding.test.js
@@ -0,0 +1,43 @@
+import {describe, it} from 'node:test';
+import assert from 'node:assert';
+import {
+  bindExecutorOutcomeEmitterToHandlers,
+} from '../../../src/bootstrap/shared/executor-outcome-handler-binding.js';
+
+describe('bindExecutorOutcomeEmitterToHandlers', () => {
+  it('binds the exact canonical emitter to every present handler', () => {
+    const staleEmitter = {ownerId: 'stale'};
+    const canonicalEmitter = {ownerId: 'canonical'};
+    const replicaHandler = {executorOutcomeEmitter: staleEmitter};
+    const runtimeServiceHandler = {executorOutcomeEmitter: staleEmitter};
+
+    bindExecutorOutcomeEmitterToHandlers({
+      executorOutcomeEmitter: canonicalEmitter,
+      handlers: [replicaHandler, null, runtimeServiceHandler],
+    });
+
+    assert.strictEqual(
+      replicaHandler.executorOutcomeEmitter,
+      canonicalEmitter,
+    );
+    assert.strictEqual(
+      runtimeServiceHandler.executorOutcomeEmitter,
+      canonicalEmitter,
+    );
+  });
+
+  it('leaves handlers unchanged when the canonical emitter is absent', () => {
+    const staleEmitter = {ownerId: 'stale'};
+    const runtimeServiceHandler = {executorOutcomeEmitter: staleEmitter};
+
+    bindExecutorOutcomeEmitterToHandlers({
+      executorOutcomeEmitter: null,
+      handlers: [runtimeServiceHandler],
+    });
+
+    assert.strictEqual(
+      runtimeServiceHandler.executorOutcomeEmitter,
+      staleEmitter,
+    );
+  });
+});
