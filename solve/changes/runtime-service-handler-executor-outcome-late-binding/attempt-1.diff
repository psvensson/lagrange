diff --git a/src/bootstrap/shared/executor-outcome-handler-binding.js b/src/bootstrap/shared/executor-outcome-handler-binding.js
new file mode 100644
index 0000000000000000000000000000000000000000..13a953f81d12ee6e7fd065d430cfdbb97df69497
--- /dev/null
+++ b/src/bootstrap/shared/executor-outcome-handler-binding.js
@@ -0,0 +1,22 @@
+/**
+ * Give startup-created service handlers the canonical executor-outcome owner
+ * after control-plane composition resolves it.
+ *
+ * @param {Object} options
+ * @param {Object|null} options.executorOutcomeEmitter
+ * @param {Array<Object|null>} options.handlers
+ * @return {void}
+ */
+function bindExecutorOutcomeEmitterToHandlers({
+  executorOutcomeEmitter,
+  handlers = [],
+}) {
+  if (!executorOutcomeEmitter) return;
+  for (const handler of handlers) {
+    if (handler) {
+      handler.executorOutcomeEmitter = executorOutcomeEmitter;
+    }
+  }
+}
+
+export {bindExecutorOutcomeEmitterToHandlers};
