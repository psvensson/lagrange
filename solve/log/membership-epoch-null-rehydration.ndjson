ld with Number(), parseInt, Math.*, or a ?? 0 / || 0 sentinel."},{"id":"null-is-not-zero","statement":"SQL NULL and an absent column decode to UNBOUND; integer 0 decodes to BOUND 0; the two are never collapsed in either direction."},{"id":"fail-closed-on-malformed","statement":"Any durable representation outside {NULL, absent, non-negative integer} fails closed with a typed error and is never coerced into an epoch."},{"id":"dispatch-policy-untouched","statement":"The dispatch stale-epoch policy (unbound passes, unreadable current defers, mismatch fails closed, match passes), the current-membership epoch owner, the topology settling gate, and Quest 2 planning generation are not changed by this Quest."}],"verificationTemplates":["adversarial-js-intrinsics","recovery-replay","admission-gating","harness-fidelity"],"landingRequirements":null,"frontierIds":["membership-epoch-null-rehydration-main"]}}
