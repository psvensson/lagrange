+  MEMBERSHIP: 'committed_membership_witness', GENERATION: 'current_replica_generation',
+  ROWID: 'own_table_rowid', DRAIN: 'accepted_work_owners',
+});
+const ROWID_KIND = Object.freeze({WITHOUT: 'without_rowid', ROWID: 'rowid'});
