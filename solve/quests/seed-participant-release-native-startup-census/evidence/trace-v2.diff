+        captureCompletion(record, null, error);
+        throw error;
+      }
+      try {
+        if (record !== null) {
+          void Promise.prototype.then.call(originalPromise,
+            (response) => captureCompletion(record, response, null),
+            (error) => captureCompletion(record, null, error));
+        }
+      } catch (_captureError) {
