+    restore() {
+      const errors = [];
+      for (const {router, originalDeliver} of installations) {
+        try {
+          router.deliver = originalDeliver;
+        } catch (error) {
+          captureErrorCount += 1;
+          errors.push(error);
+        }
+      }
+      if (errors.length > 0) throw errors[0];
+    },
