+test('C17 terminal transfer reacquires the exact claim after input capture',
+  (t) => {
+    for (const seam of ['descriptor', 'shutdownRecord', 'terminalize',
+      'optionsDescriptor']) {
+      const nodeId = `listener-capture-reentry-${seam}`;
+      const owner = {nodeId};
+      const shutdownRecord = {state: 'active', transport: {socket: true}};
+      const generation = `capture-reentry-${seam}`;
+      const claim = reserveCdcCoverageListenerBase(owner, {
+        bootIncarnation: 5, listenerGenerationId: generation,
+        shutdownRecord,
+      });
+      t.equal(enterCdcCoverageListenerTerminalCheck(owner, claim), true);
+      const successorOwner = {nodeId};
+      const successorRecord = {state: 'active', transport: {socket: true}};
+      let nestedResult = null;
+      let successor = null;
+      let fired = false;
+      const reenter = () => {
+        if (fired) return;
+        fired = true;
+        nestedResult = completeListener(owner, claim, shutdownRecord,
+          listenerTerminalDescriptor(generation));
+        successor = reserveCdcCoverageListenerBase(successorOwner, {
+          bootIncarnation: 5,
+          listenerGenerationId: `${generation}-next`,
+          shutdownRecord: successorRecord,
+        });
+      };
+      const rawOptions = {
+        shutdownRecord,
+        descriptor: listenerTerminalDescriptor(generation),
+        terminalize: (result) => result,
+      };
+      let outerCallbackCalls = 0;
+      rawOptions.terminalize = (result) => {
+        outerCallbackCalls += 1;
+        return result;
+      };
+      let options = rawOptions;
+      if (seam === 'descriptor') {
+        rawOptions.descriptor = new Proxy(rawOptions.descriptor, {
+          getOwnPropertyDescriptor(target, field) {
+            reenter();
+            return Reflect.getOwnPropertyDescriptor(target, field);
+          },
+        });
+      } else {
+        const optionField = seam === 'optionsDescriptor' ?
+          'descriptor' : seam;
+        options = new Proxy(rawOptions, {
+          getOwnPropertyDescriptor(target, field) {
+            if (field === optionField) reenter();
+            return Reflect.getOwnPropertyDescriptor(target, field);
+          },
+        });
+      }
+      t.equal(transferCdcCoverageListenerToTerminal(owner, claim, options),
+        false, `${seam} capture refuses the stale outer operation`);
+      t.equal(nestedResult, true,
+        `${seam} nested operation consumed the old claim once`);
+      t.equal(outerCallbackCalls, 0,
+        `${seam} stale operation cannot invoke its captured callback`);
+      t.ok(successor, `${seam} nested completion admitted a successor`);
+      t.match(readCdcCoverageTransferDiagnostics(successorOwner), {
+        retainedBytes: 16 * 1024 * 1024, listenerActive: true,
+        releases: 1, listenerGenerations: 2,
+      }, `${seam} stale refusal leaves successor accounting exact`);
+      t.equal(enterCdcCoverageListenerTerminalCheck(
+        successorOwner, successor), true);
+      t.equal(completeListener(successorOwner, successor, successorRecord,
+        listenerTerminalDescriptor(`${generation}-next`)), true,
+      `${seam} successor completes through the legitimate path`);
+      t.equal(retireCdcCoverageTransferOwner(owner), true);
+      t.equal(retireCdcCoverageTransferOwner(successorOwner), true);
+    }
+    t.end();
+  });
