+  return result === RAFT_OPERATION_OUTCOME.CORE_REFUSED ||
+    result === RAFT_OPERATION_OUTCOME.CORE_FATAL ||
+    result === RAFT_OPERATION_OUTCOME.HOST_FAILURE;
