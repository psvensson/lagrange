+function stableLabels(overrides = {}) {
+  return {
+    'io.lagrange.managed': 'true',
+    'io.lagrange.cluster_incarnation': IDENTITY.clusterIncarnation,
+    'io.lagrange.node_id': IDENTITY.nodeId,
