+    const originalTimeSource = handler.timeSource;
+    const invalidClockSamples = [Number.NaN, Number.POSITIVE_INFINITY,
+      Number.NEGATIVE_INFINITY, -1, 1.5, -0, Number.MAX_SAFE_INTEGER + 1,
