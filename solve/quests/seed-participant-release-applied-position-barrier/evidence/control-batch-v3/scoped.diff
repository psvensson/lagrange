+        const observation = membership.trackSettlement(`${control.label} observation`,
+          sendRegisteredObservation(handler, transport, request));
+        let failure = null;
+        try {
+          await membership.started;
+          control.mutate(leader.controllablePort, leader);
+          membership.release();
