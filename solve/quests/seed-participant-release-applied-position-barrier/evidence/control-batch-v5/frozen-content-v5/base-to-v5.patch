+function retainFailure(current, next, message) {
+  return current === null ? next : new AggregateError([current, next], message);
+}
+
+function deferCapturedMembership(service) {
+  const port = service.controllablePort;
+  const original = port.committedMembershipHandler;
+  const started = Promise.withResolvers();
+  const continuation = Promise.withResolvers();
+  let reads = 0;
+  const captured = async (...args) => {
+    const answer = await original(...args);
+    reads += 1;
+    started.resolve(answer);
+    await continuation.promise;
+    return answer;
+  };
+  port.committedMembershipHandler = captured;
+  const restore = () => {
+    if (port.committedMembershipHandler === original) return;
+    if (port.committedMembershipHandler !== captured) {
+      throw new Error('captured membership gate lost exact ownership');
+    }
+    port.committedMembershipHandler = original;
+  };
+  const retire = async (failure, message) => {
+    let retained = failure;
+    try {
+      continuation.resolve();
+    } catch (error) {
+      retained = retainFailure(retained, error, `${message}: release failed`);
+    }
+    try {
+      restore();
+    } catch (error) {
+      retained = retainFailure(retained, error, `${message}: restore failed`);
+    }
+    return retained;
+  };
+  return Object.freeze({started: started.promise, release: continuation.resolve,
+    reads: () => reads, retire});
+}
