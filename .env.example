# Node Configuration
# Leave NODE_ID unset: the node mints a UUID on first start and persists it
# in its data directory. Set SEED_NODE_ADDRESS only on joining nodes.
#NODE_ID=
#SEED_NODE_ADDRESS=
REST_API_PORT=8080

# Admin binds to loopback by default. External exposure requires both values
# and should sit behind authenticated ingress.
ADMIN_WEBSOCKET_HOST=127.0.0.1
ADMIN_ALLOW_INSECURE_EXTERNAL_BIND=false

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY_PRINT=false
