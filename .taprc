timeout: 5000
allow-incomplete-coverage: true
# Default worker parallelism for ad-hoc tap invocations. The fast lane
# (test:fast in package.json) overrides this to --jobs=4. A fresh-checkout
# release gate on 2026-08-01 reproduced a native crash and three exact-boundary
# timeouts at --jobs=8; the aggregate-sensitive evidence projection runs once
# in a serial pregate before concurrent readers start. The integration and
# bootstrap lanes stay serial within a lane (see `serial:`); cross-lane
# concurrency lives in scripts/run-sharded-lanes-concurrent.sh.
jobs: 4
node-arg:
  - --no-compilation-cache
  - --max-old-space-size=512
serial:
  - test/integration
  - test/bootstrap
