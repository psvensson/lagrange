{
  "name": "distributed-database-system",
  "version": "1.0.0",
  "description": "A scalable distributed database system with Raft consensus",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ddb-admin": "./src/cli/bin/ddb-admin.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli/bin/ddb-admin.js",
    "test": "tap",
    "test:coverage": "tap --coverage",
    "test:cli": "tap test/cli/**/*.test.js",
    "lint": "eslint src/ test/ --ignore-pattern 'test/.gitkeep'",
    "lint:fix": "eslint src/ test/ --fix --ignore-pattern 'test/.gitkeep'",
    "build:bundle": "node scripts/build-sea.js",
    "build:sea": "bash scripts/build-executables.sh",
    "build:all": "npm run build:bundle && npm run build:sea"
  },
  "keywords": [
    "distributed",
    "database",
    "raft",
    "consensus",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.7.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lodash": "^4.17.21",
    "node-fetch": "^3.3.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "piscina": "^4.8.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "eslint-config-google": "^0.14.0",
    "fast-check": "^3.23.2",
    "postject": "^1.0.0-alpha.6",
    "tap": "^21.5.0"
  }
}
