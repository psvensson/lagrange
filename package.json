{
  "name": "distributed-database-system",
  "version": "1.0.0",
  "description": "Lagrange experimental distributed SQL database and compute-near-data runtime",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ddb-admin": "./src/cli/bin/ddb-admin.js",
    "lagrange-admin": "./src/cli/bin/ddb-admin.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:endpoint-sync": "node scripts/start-endpoint-sync-controller.js",
    "start:test-dashboard": "node scripts/start-test-run-dashboard.js",
    "cli": "node src/cli/bin/ddb-admin.js",
    "pretest": "npm run audit:state-machine-pressure",
    "test": "tap",
    "test:fast": "tap $(find test -type f -name '*.test.js' ! -path 'test/integration/*' ! -path 'test/bootstrap/*' | sort)",
    "test:integration:1": "tap $(cat test/shards/integration-1.txt)",
    "test:integration:2": "tap $(cat test/shards/integration-2.txt)",
    "test:integration:3": "tap $(cat test/shards/integration-3.txt)",
    "test:bootstrap:1": "tap $(cat test/shards/bootstrap-1.txt)",
    "test:bootstrap:2": "tap $(cat test/shards/bootstrap-2.txt)",
    "test:pgwire": "tap $(cat test/shards/pgwire-unit.txt test/shards/pgwire-integration.txt)",
    "test:pgwire:unit": "tap $(cat test/shards/pgwire-unit.txt)",
    "test:pgwire:integration": "tap $(cat test/shards/pgwire-integration.txt)",
    "test:sharded:all": "npm run test:fast && npm run test:integration:1 && npm run test:integration:2 && npm run test:integration:3 && npm run test:bootstrap:1 && npm run test:bootstrap:2",
    "test:coverage": "tap --coverage",
    "test:cli": "tap test/cli/**/*.test.js",
    "test:unused": "knip --exclude exports",
    "test:unused:prod": "knip --production",
    "test:unused:exports": "knip --include exports",
    "test:deps": "depcruise --config dependency-cruiser.config.cjs src test",
    "test:complexity": "node scripts/check-complexity.js",
    "test:complexity:strict": "node scripts/check-complexity.js --strict",
    "test:complexity:scoped": "node scripts/check-complexity.js --scoped",
    "test:complexity:scoped:strict": "node scripts/check-complexity.js --scoped --strict",
    "test:complexity:cognitive": "node scripts/check-cognitive-complexity.js",
    "test:complexity:cognitive:strict": "node scripts/check-cognitive-complexity.js --strict",
    "test:complexity:cognitive:scoped": "node scripts/check-cognitive-complexity.js --scoped",
    "test:complexity:cognitive:scoped:strict": "node scripts/check-cognitive-complexity.js --scoped --strict",
    "test:cycles": "node scripts/check-circular-dependencies.js",
    "test:cycles:strict": "node scripts/check-circular-dependencies.js --strict",
    "test:duplication": "node scripts/check-duplication.js",
    "test:duplication:strict": "node scripts/check-duplication.js --strict",
    "test:metrics": "npm run test:complexity:cognitive && npm run test:cycles && npm run test:duplication",
    "test:metrics:scoped": "node scripts/check-scoped-ratchets.js",
    "test:metrics:scoped:strict": "node scripts/check-scoped-ratchets.js --strict",
    "audit:file-size": "node scripts/check-file-size-thresholds.js",
    "audit:file-size:strict": "node scripts/check-file-size-thresholds.js --strict",
    "audit:architecture-slices": "node scripts/check-architecture-slices.js",
    "test:metadata-gateway:audit": "node scripts/check-unified-system-metadata-gateway.js",
    "test:mutation": "stryker run",
    "test:analysis": "npm run test:unused && npm run test:deps && npm run test:complexity && npm run test:metrics",
    "test:static": "npm run test:unused && npm run test:unused:prod && npm run test:deps && npm run test:complexity && npm run test:metrics && npm run test:metadata-gateway:audit && npm run audit:runtime-grammar",
    "test:quality": "npm run test:static && npm run test:mutation",
    "test:chart:endpoint-sync": "node scripts/check-endpoint-sync-chart.js",
    "test:ci": "npm run test && npm run test:quality && npm run test:chart:endpoint-sync",
    "lint": "eslint src/ test/ --ignore-pattern 'test/.gitkeep'",
    "lint:fix": "eslint src/ test/ --fix --ignore-pattern 'test/.gitkeep'",
    "build:bundle": "node scripts/build-sea.js",
    "build:sea": "bash scripts/build-executables.sh",
    "build:all": "npm run build:bundle && npm run build:sea",
    "spike:raft-logic": "node scripts/run-raft-logic-investigation-spike.js",
    "migration:raft:benchmarks": "node scripts/run-raft-migration-benchmarks.js",
    "migration:raft:stage:dev": "node scripts/run-raft-migration-stage-gate.js --stage dev",
    "migration:raft:stage:canary": "node scripts/run-raft-migration-stage-gate.js --stage canary",
    "migration:raft:stage:limited": "node scripts/run-raft-migration-stage-gate.js --stage limited-production",
    "migration:raft:rollback-drill": "node scripts/run-raft-migration-rollback-drill.js",
    "distributed:all": "bash scripts/run-all-distributed-scenarios.sh --verbose",
    "distributed:rerun-failed": "bash scripts/rerun-failed-distributed-scenarios.sh --verbose",
    "test:task27:invariant-suite": "bash scripts/run-task27-deterministic-invariant-suite.sh",
    "test:task27:distributed-stall-gate": "bash scripts/run-task27-distributed-stall-gate.sh --verbose",
    "test:task27:ci": "npm run test:task27:invariant-suite && npm run test:task27:distributed-stall-gate",
    "test:topology-failure-gates": "node scripts/run-topology-failure-gates.js",
    "analyze:pg-baseline": "node scripts/analyze-pg-baseline-report.js",
    "analyze:topology-convergence": "node scripts/analyze-topology-convergence.js",
    "analyze:owner-decisions": "node scripts/analyze-topology-convergence.js --decision-table",
    "analyze:owner-explain": "node scripts/analyze-topology-convergence.js --explain",
    "analyze:owner-glossary": "node scripts/analyze-topology-convergence.js --glossary",
    "analyze:owner-files": "node scripts/analyze-owner-files.js",
    "analyze:priority-recovery-residuals": "node scripts/analyze-priority-recovery-residuals.js",
    "analyze:distributed-failure": "bash scripts/summarize-distributed-failure-report.sh",
    "summarize:harness": "node scripts/summarize-harness-runs.js",
    "debug:admin:ws": "node scripts/debug/admin-ws-connection-check.mjs",
    "debug:logs:parse": "node scripts/debug/parse-json-log-lines.cjs",
    "test-output:prune:dry": "node scripts/prune-test-output.js",
    "test-output:prune": "node scripts/prune-test-output.js --apply",
    "audit:guideline:literals": "node scripts/check-guideline-literals.js",
    "audit:guideline:decision-boundaries": "node scripts/check-guideline-decision-boundaries.js",
    "audit:guideline:boundary-mode-contracts": "node scripts/check-guideline-boundary-mode-contracts.js",
    "audit:runtime-grammar": "node scripts/check-runtime-grammar-contracts.js && npm run audit:state-machine-pressure",
    "audit:runtime-grammar:file": "node scripts/check-runtime-grammar-contracts.js",
    "audit:state-machine-pressure": "node scripts/check-state-machine-pressure-preflight.js",
    "audit:operation-progress-authority": "node scripts/check-operation-progress-authority.js",
    "audit:owner-boundary-segments": "node scripts/check-file-size-thresholds.js --owner-boundary-guidance",
    "steering:llm:pack": "node scripts/generate-steering-llm-pack.js",
    "steering:check": "npm run steering:llm:pack && git diff --quiet -- .kiro/steering/llm",
    "guard:scenario-policy:file": "node scripts/check-scenario-policy-sql.js",
    "guard:guideline:constant-names:file": "node scripts/check-guideline-constant-names.js",
    "commands": "node scripts/list-commands.js",
    "work:help": "node scripts/list-commands.js",
    "work:current-blocker": "node scripts/work-tracker.js current-blocker --write",
    "work:repair": "node scripts/work-tracker.js repair",
    "work:advance": "node scripts/work-advance.js",
    "work:context": "node scripts/work-context.js",
    "work:dirty-scope": "node scripts/work-context.js --dirty-scope",
    "work:llm-start": "node scripts/work-llm-start.js",
    "work:lane-picker": "node scripts/work-lane-picker.js",
    "work:model-ledger": "node scripts/model-ledger.js",
    "work:oversized-next": "node scripts/work-oversized-next.js",
    "work:oversized-refactor": "node scripts/work-oversized-refactor.js",
    "work:tracks": "node scripts/work-track-summary.js",
    "work:sprint:remaining": "node scripts/work-sprint-remaining.js",
    "work:sprint:advance": "node scripts/work-sprint-advance.js",
    "work:sprint:push": "node scripts/work-sprint-push.js",
    "work:package:evidence-block": "node scripts/analyze-topology-convergence.js --package-evidence-block",
    "work:package:doctor": "node scripts/work-tracker.js doctor",
    "work:package:new": "node scripts/work-package-new.js",
    "work:package:route-after-rerun": "node scripts/work-package-route-after-rerun.js",
    "work:package:schema": "node scripts/work-package-schema.js",
    "work:theory-ledger": "node scripts/work-theory-ledger.js",
    "work:subagent-next": "node scripts/work-subagent-next.js",
    "work:subagent-prompt": "node scripts/work-subagent-prompt.js",
    "work:evidence-summary": "node scripts/summarize-representative-evidence.js",
    "work:scenario-route": "node scripts/work-scenario-route.js",
    "work:scenario-triage": "node scripts/work-scenario-triage.js",
    "work:validate": "node scripts/work-tracker.js validate",
    "work:close": "node scripts/work-close.js",
    "work:audit:ceremony": "node scripts/work-audit-ceremony.js",
    "work:audit:siblings": "node scripts/work-audit-siblings.js",
    "work:audit:validators": "node scripts/work-audit-validator-coverage.js",
    "work:package:close": "node scripts/work-tracker.js close",
    "work:package:migrate": "node scripts/work-tracker.js migrate",
    "work:package:move": "node scripts/work-tracker.js move",
    "work:package:cost": "node scripts/work-package-cost.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "test:unit": "tap $(find test -type f -name '*.test.js' ! -name '*.integration.test.js' ! -path 'test/integration/*' ! -path 'test/bootstrap/*' | sort)",
    "test:distributed:boundary:transition": "node test/distributed/harness/__tests__/boundary-transition-scenarios.test.js",
    "test:distributed:checkpoint:7node:transaction-recovery": "node test/distributed/run.js --config test/distributed/config/local-benchmark-7node.json --scenario seven-node-read-write-load-transaction-recovery",
    "analyze:causal-model": "node scripts/analyze-causal-model.js"
  },
  "keywords": [
    "distributed",
    "database",
    "raft",
    "consensus",
    "sqlite"
  ],
  "author": "",
  "license": "AGPL",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@markwylde/liferaft": "^1.4.0",
    "@vscode/dwarf-debugging": "^0.0.2",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.7.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "fastify": "^5.2.1",
    "node-fetch": "^3.3.2",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.18.0",
    "pino": "^9.6.0",
    "piscina": "^4.8.0",
    "raft-logic": "^0.3.14",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/tap-runner": "^9.5.1",
    "dependency-cruiser": "^17.3.8",
    "dockerode": "^4.0.9",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-visitor-keys": "^4.2.1",
    "espree": "^10.4.0",
    "fast-check": "^3.23.2",
    "jscpd": "^4.0.9",
    "knip": "^5.83.1",
    "madge": "^8.0.0",
    "postject": "^1.0.0-alpha.6",
    "tap": "^21.5.0"
  }
}
